  "gui_wrapper_source": "import os,sys,subprocess,fcntl\nfrom pathlib import Path\nroot=Path(__file__).resolve().parents[2]\nout=Path(__file__).resolve().parent\nr,w=os.pipe()\nhigh=fcntl.fcntl(w,fcntl.F_DUPFD,64);os.close(w);w=high\nwith (out/(sys.argv[3]+'-xvfb.log')).open('w') as log:\n p=subprocess.Popen(['Xvfb','-displayfd',str(w),'-screen','0','1280x800x24','-nolisten','tcp','-noreset','-dpi','96'],pass_fds=(w,),stdout=log,stderr=subprocess.STDOUT)\n os.close(w);\n with os.fdopen(r) as ready: display=ready.readline().strip()\n if not display:\n  p.wait(timeout=10);raise RuntimeError('Xvfb failed before launching any game process')\n env=dict(os.environ,DISPLAY=':'+display,CWM_GUI_NO_WM='1',LIBGL_ALWAYS_SOFTWARE='1',ALSOFT_DRIVERS='null',CDDA_LANGUAGE='en',__GLX_VENDOR_LIBRARY_NAME='mesa');env.pop('XAUTHORITY',None)\n try:\n  cmd=[sys.executable,str(root/'tests'/sys.argv[1]),'--workspace',str(root) if os.environ.get('CWM_TEST_INSTALLED')=='1' else str(root/'artifacts/language-20261011/workspace'),'--artifacts',str(out/sys.argv[3]),*sys.argv[4:]]\n  if sys.argv[1]!='actor_gui_test.py':\n   cmd.extend(['--fixture',str(root/sys.argv[2]),'--native-reader',str(root/'artifacts/native-liquids-20261023/native-save-reader-warm')])\n  result=subprocess.run(cmd,env=env,timeout=420)\n finally:\n  p.terminate();p.wait(timeout=10)\n sys.exit(result.returncode)\n",
