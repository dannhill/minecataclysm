namespace CDDA.CWM;

enum EntityType : byte {
    PLAYER = 0,
    NPC = 1,
    MONSTER = 2,
    VEHICLE = 3,
    ITEM = 4,
    FIELD_EFFECT = 5
}

enum MoveDirection : byte {
    NONE = 0,
    NORTH = 1,
    NORTHEAST = 2,
    EAST = 3,
    SOUTHEAST = 4,
    SOUTH = 5,
    SOUTHWEST = 6,
    WEST = 7,
    NORTHWEST = 8,
    UP = 9,
    DOWN = 10
}

enum InteractAction : byte {
    EXAMINE = 0,
    OPEN = 1,
    CLOSE = 2,
    PICKUP = 3,
    DROP = 4,
    ATTACK = 5,
    SMASH = 6,
    USE = 7
}

struct Coord3i {
    x: int32;
    y: int32;
    z: int32;
}

struct Vec3f {
    x: float32;
    y: float32;
    z: float32;
}

table HelloRequest {
    protocol_version_major: uint16;
    protocol_version_minor: uint16;
    build_id: string;
    client_id: uint64;
}

table HelloResponse {
    protocol_version_major: uint16;
    protocol_version_minor: uint16;
    server_build_id: string;
    accepted: bool;
    reject_reason: string;
    next_command_id: uint64;
}

table Heartbeat {
    timestamp_ms: uint64;
}

table HeartbeatAck {
    timestamp_ms: uint64;
    server_time_ms: uint64;
}

struct CwmBlock {
    state_flags: uint32;
    material_id: uint16;
    light_level: uint8;
    orientation: uint8;
}

table ChunkSnapshot {
    chunk_x: int32;
    chunk_y: int32;
    chunk_z: int32;
    size_x: uint8;
    size_y: uint8;
    size_z: uint8;
    blocks: [CwmBlock];
}

table TileDelta {
    coord: Coord3i;
    block: CwmBlock;
}

table EntityState {
    id: uint64;
    type: EntityType;
    type_id: string;
    pos: Vec3f;
    rotation: float32;
    animation_hint: uint16;
    hp_percent: uint8;
    name: string;
    // CDDA sensory visibility, independent of the presentation camera.
    perceived: bool = true;
    // Native posture/environment cues; presentation offsets do not alter pos.
    state_flags: uint32 = 0;
    motion_seconds: float32 = 0.2;
}

table EntitySpawned {
    state: EntityState;
}

table EntityRemoved {
    id: uint64;
}

table VehicleComponentState {
    part_id: string;
    offset: Vec3f;
    broken: bool;
    open: bool;
}

table VehicleState {
    id: uint64;
    name: string;
    pivot: Vec3f;
    rotation: float32;
    velocity: Vec3f;
    components: [VehicleComponentState];
}

table FieldState {
    coord: Coord3i;
    field_type_id: uint16;
    density: uint8;
    age: uint32;
}

table WorldSnapshot {
    world_revision: uint64;
    origin: Coord3i;
    simulation_time_seconds: uint64;
    chunks: [ChunkSnapshot];
    entities: [EntityState];
    vehicles: [VehicleState];
    fields: [FieldState];
    // End-of-action terrain/furniture changes, applied before entity positions.
    tiles: [TileDelta];
    // Native safety/laser-targeting stop; presentation must offer explicit acknowledgement.
    safety_stop: bool;
    // A full replaces all projected domains; a batch advances base_revision atomically.
    full: bool;
    base_revision: uint64;
    state_id: uint64;
    resync_id: uint64;
    completed_command_id: uint64;
    spawned: [EntitySpawned];
    removed: [EntityRemoved];
    clock: SimulationState;
}

table SimulationState {
    realtime: bool;
    pause_reasons: uint32;
    time_scale: float32 = 1.0;
    continuous_motion: bool;
}

enum SimulationControl : byte { PAUSE = 0, RESUME = 1, SET_SPEED = 2, MENU_OPEN = 3, MENU_CLOSE = 4 }
table SimulationControlRequest {
    command_id: uint64;
    action: SimulationControl;
    time_scale: float32 = 1.0;
}
// An idempotent intent update; native actions are generated only while held.
table MovementIntentRequest {
    command_id: uint64;
    direction: MoveDirection;
}
// Normalized native XY direction, or (0,0) to release. Position is never
// supplied by the client. Length is checked and normalized by CDDA.
table ContinuousIntentRequest {
    command_id: uint64;
    x: float32;
    y: float32;
}

table MoveRequest {
    command_id: uint64;
    direction: MoveDirection;
}

table InteractRequest {
    command_id: uint64;
    target_coord: Coord3i;
    action: InteractAction;
}

table AttackRequest {
    command_id: uint64;
    target_entity_id: uint64;
}

table CommandAck {
    command_id: uint64;
    accepted: bool;
    error_message: string;
    result_revision: uint64;
}

table TimeEvent {
    world_revision: uint64;
    simulation_time: uint64;
    time_jump: bool;
    simulation_busy: bool;
}

table AcknowledgeThreatRequest {
    command_id: uint64;
}

table DecisionPrompt {
    decision_id: uint64;
    text: string;
    choices: [string];
}

table DecisionResponse {
    decision_id: uint64;
    choice: uint16;
}

table ResyncRequest { request_id: uint64; }
table WorldReset { request_id: uint64; }
table SnapshotAck { state_id: uint64; }

union Payload {
    HelloRequest,
    HelloResponse,
    Heartbeat,
    HeartbeatAck,
    WorldSnapshot,
    ChunkSnapshot,
    TileDelta,
    EntityState,
    EntityRemoved,
    VehicleState,
    FieldState,
    MoveRequest,
    InteractRequest,
    AttackRequest,
    CommandAck,
    TimeEvent,
    AcknowledgeThreatRequest,
    DecisionPrompt,
    DecisionResponse,
    ResyncRequest,
    WorldReset,
    SnapshotAck,
    EntitySpawned
    ,SimulationControlRequest
    ,MovementIntentRequest
    ,ContinuousIntentRequest
}

table CwmMessage {
    sequence_number: uint64;
    world_revision: uint64;
    timestamp_ms: uint64;
    payload: Payload;
    session_id: uint64;
    player_id: uint64;
    connection_id: uint64;
}

root_type CwmMessage;
