namespace CDDA.CWM;

enum EntityType : byte {
    PLAYER = 0,
    NPC = 1,
    MONSTER = 2,
    VEHICLE = 3,
    ITEM = 4,
    FIELD_EFFECT = 5
}

enum MoveDirection : byte {
    NONE = 0,
    NORTH = 1,
    NORTHEAST = 2,
    EAST = 3,
    SOUTHEAST = 4,
    SOUTH = 5,
    SOUTHWEST = 6,
    WEST = 7,
    NORTHWEST = 8,
    UP = 9,
    DOWN = 10
}

enum InteractAction : byte {
    EXAMINE = 0,
    OPEN = 1,
    CLOSE = 2,
    PICKUP = 3,
    DROP = 4,
    ATTACK = 5,
    SMASH = 6,
    USE = 7
}

struct Coord3i {
    x: int32;
    y: int32;
    z: int32;
}

struct Vec3f {
    x: float32;
    y: float32;
    z: float32;
}

table HelloRequest {
    protocol_version_major: uint16;
    protocol_version_minor: uint16;
    build_id: string;
    client_id: uint64;
}

table HelloResponse {
    protocol_version_major: uint16;
    protocol_version_minor: uint16;
    server_build_id: string;
    accepted: bool;
    reject_reason: string;
    next_command_id: uint64;
}

table Heartbeat {
    timestamp_ms: uint64;
}

table HeartbeatAck {
    timestamp_ms: uint64;
    server_time_ms: uint64;
}

struct CwmBlock {
    state_flags: uint32;
    material_id: uint16;
    light_level: uint8;
    orientation: uint8;
}

table ChunkSnapshot {
    chunk_x: int32;
    chunk_y: int32;
    chunk_z: int32;
    size_x: uint8;
    size_y: uint8;
    size_z: uint8;
    blocks: [CwmBlock];
}

table TileDelta {
    coord: Coord3i;
    block: CwmBlock;
}

table GroundItemState {
    stack_index: uint32;
    type_id: string;
    name: string;
    charges: int32;
    count_by_charges: bool;
    category: string;
    wielded: bool;
    rotten: bool;
    container: bool;
}

table GroundItemTileState {
    coord: Coord3i;
    items: [GroundItemState];
    storage: bool;
    storage_label: string;
}

table EntityState {
    id: uint64;
    type: EntityType;
    type_id: string;
    pos: Vec3f;
    rotation: float32;
    animation_hint: uint16;
    hp_percent: uint8;
    name: string;
    // CDDA sensory visibility, independent of the presentation camera.
    perceived: bool = true;
    // Native posture/environment cues; presentation offsets do not alter pos.
    state_flags: uint32 = 0;
    motion_seconds: float32 = 0.2;
}

table EntitySpawned {
    state: EntityState;
}

table EntityRemoved {
    id: uint64;
}

table VehicleComponentState {
    part_id: string;
    offset: Vec3f;
    broken: bool;
    open: bool;
}

table VehicleState {
    id: uint64;
    name: string;
    pivot: Vec3f;
    rotation: float32;
    velocity: Vec3f;
    components: [VehicleComponentState];
}

table FieldState {
    coord: Coord3i;
    field_type_id: uint16;
    density: uint8;
    age: uint32;
}

// Native player-facing descriptions. No raw hidden disease/vitamin values.
table StatusValue {
    id: string;
    label: string;
    text: string;
    color: string;
    // Ordinal perceived well-being: -1 unavailable, 0 worst, 10 best.
    // Native descriptor categories, not raw calories/pain or a Minecraft rule.
    perceived_level: int8 = -1;
}

table BodyPartStatus {
    id: string;
    label: string;
    health: StatusValue;
    temperature: StatusValue;
    // Known wound/treatment names from the native body UI, not all effects.
    conditions: [string];
}

table AvatarStatus {
    stamina: StatusValue;
    needs: [StatusValue];
    body_parts: [BodyPartStatus];
}

// Transient, perception-filtered presentation cues. Never gameplay commands.
enum PresentationKind : byte { ATTACK = 0, HURT = 1, DEATH = 2, SHOT = 3, SOUND = 4 }
table PresentationEvent {
    id: uint64;
    kind: PresentationKind;
    actor: uint64; // 0 for audio/unidentified source; never reveal hidden actors.
    description: string;
    sound_category: string;
    heard_volume: uint16;
}

table WorldSnapshot {
    world_revision: uint64;
    origin: Coord3i;
    simulation_time_seconds: uint64;
    chunks: [ChunkSnapshot];
    entities: [EntityState];
    vehicles: [VehicleState];
    fields: [FieldState];
    // End-of-action terrain/furniture changes, applied before entity positions.
    tiles: [TileDelta];
    // Native safety/laser-targeting stop; presentation must offer explicit acknowledgement.
    safety_stop: bool;
    // A full replaces all projected domains; a batch advances base_revision atomically.
    full: bool;
    base_revision: uint64;
    state_id: uint64;
    resync_id: uint64;
    completed_command_id: uint64;
    spawned: [EntitySpawned];
    removed: [EntityRemoved];
    clock: SimulationState;
    ground_item_tiles: [GroundItemTileState];
    // Complete read-only possession projection (worn, wielded and nested items).
    // Indices are presentation order, not inventory mutation handles.
    owned_items: [GroundItemState];
    // Complete native read-only status, replaced with each publication.
    avatar_status: AvatarStatus;
    consumption: ConsumptionState;
    first_aid: FirstAidState;
    crafting: CraftingState;
    ranged_weapon: RangedWeaponState;
    reload: ReloadState;
    item_transfer: ItemTransferState;
    // Native completion after activity, move debt and paced cost are paid.
    inventory_work: InventoryWorkState;
    quick_slots: [QuickSlot];
    presentation_events: [PresentationEvent];
    // Native illumination at the player, not a client visibility rule.
    low_light: bool;
    reading: ReadingState;
    disassembly: DisassemblyState;

}

table InventoryWorkState {
    command_id: uint64;
    settled: bool;
    total_time_ms: uint32; // Synchronous native debit paced by the coordinator.
    remaining_time_ms: uint32;
}

table SimulationState {
    realtime: bool;
    pause_reasons: uint32;
    time_scale: float32 = 1.0;
    continuous_motion: bool;
}

enum SimulationControl : byte { PAUSE = 0, RESUME = 1, SET_SPEED = 2, MENU_OPEN = 3, MENU_CLOSE = 4 }
table SimulationControlRequest {
    command_id: uint64;
    action: SimulationControl;
    time_scale: float32 = 1.0;
}
// An idempotent intent update; native actions are generated only while held.
table MovementIntentRequest {
    command_id: uint64;
    direction: MoveDirection;
}
// Normalized native XY direction, or (0,0) to release. Position is never
// supplied by the client. Length is checked and normalized by CDDA.
table ContinuousIntentRequest {
    command_id: uint64;
    x: float32;
    y: float32;
}

table MoveRequest {
    command_id: uint64;
    direction: MoveDirection;
}

table InteractRequest {
    command_id: uint64;
    target_coord: Coord3i;
    action: InteractAction;
    pickup_stack_index: uint32;
    pickup_type_id: string;
    pickup_charges: int32;
    pickup_count_by_charges: bool;
}

enum MovementMode : byte { WALK = 0, RUN = 1, CROUCH = 2, PRONE = 3 }

// Native mode selection, independent of held movement intent or camera pose.
table MovementModeRequest {
    command_id: uint64;
    mode: MovementMode;
}

// Progress is native ACT_CONSUME work, never a presentation timer. Token is
// ephemeral to this server activity, not an item or canonical save field.
table ConsumptionState { token: uint64; total_moves: int32; remaining_moves: int32; }
table CancelConsumptionRequest { command_id: uint64; activity_token: uint64; }
// Canonical ACT_FIRSTAID work. Neither progress nor token is saved by Luanti.
table FirstAidState { token: uint64; total_moves: int32; remaining_moves: int32; }
table CancelFirstAidRequest { command_id: uint64; activity_token: uint64; }
// ACT_CRAFT progress is the canonical craft item's counter (0..10,000,000).
table CraftingState { token: uint64; progress: int32; }
table CancelCraftingRequest { command_id: uint64; activity_token: uint64; }
// One native ACT_READ chapter, which may be followed by another chapter.
table ReadingState {
    token: uint64; total_moves: int32; remaining_moves: int32;
    book_name: string; progress: string; skimming: bool;
}
table CancelReadingRequest { command_id: uint64; activity_token: uint64; }
table BookInfo { identified: bool; chapter_moves: int32; summary: string; }
// ACT_DISASSEMBLE uses the canonical in-progress item's counter, not moves_left.
table DisassemblyState { token: uint64; progress: int32; name: string; }
table CancelDisassemblyRequest { command_id: uint64; activity_token: uint64; }
table DisassemblyInfo { estimated_moves: int64; progress: int32; resume: bool; }
enum CraftingFilter: uint8 { ALL = 0, FAVORITES = 1, RECENT = 2, UNFINISHED = 3, AUTO = 4 }
table CraftingQueryRequest { query_id: uint64; search: string; batch: uint32 = 1; filter: CraftingFilter = ALL; }
table CraftingEntry {
    id: uint32; recipe_id: string; result_type: string; name: string;
    requirements: string; reason: string; expected_moves: int64;
    resume: bool; progress: int32;
    favorite: bool; recent_rank: uint8; // 0 absent, 1 newest, at most 20.
}
table CraftingView {
    query_id: uint64; view_id: uint64; batch: uint32 = 1;
    entries: [CraftingEntry]; truncated: bool; error: string; filter: CraftingFilter = ALL;
}
table CraftingFavoriteRequest { command_id: uint64; view_id: uint64; entry_id: uint32; favorite: bool; expected_favorite: bool; }
table CraftingRequest { command_id: uint64; view_id: uint64; entry_id: uint32; }


// Read-only correlated query. Handles live only in this session/view and
// reference native item_locations; never interpret a display stack index.
table InventoryQueryRequest { query_id: uint64; external_coord: Coord3i; }
table InventoryEntry {
    id: uint32;
    parent_id: uint32;
    pocket_index: int32 = -1;
    type_id: string;
    name: string;
    category: string;
    charges: int32;
    count_by_charges: bool;
    worn: bool;
    wielded: bool;
    weight_grams: int64;
    volume_ml: int64;
    length_mm: int64;
    access_moves: int32;
    // Bits 0..6 correspond to EquipmentAction, validated by CDDA again.
    actions: uint8;
    reasons: [string];
    consume_moves: int32;
    consume_label: string;
    consume_warning: string;
    transfer_reason: string;
    container: bool;
    quick_slot: uint8;
    rotten: bool;
    ui_order: uint32;
    external: bool;
    book: BookInfo;
    disassembly: DisassemblyInfo;
}
table InventoryPocket {
    owner_id: uint32;
    index: uint32;
    name: string;
    capacity_ml: int64;
    remaining_ml: int64;
    capacity_grams: int64;
    remaining_grams: int64;
    max_length_mm: int64;
    access_moves: int32;
    sealed: bool;
    rigid: bool;
    watertight: bool;
}
table InventoryView {
    query_id: uint64;
    view_id: uint64;
    entries: [InventoryEntry];
    pockets: [InventoryPocket];
    truncated: bool;
    error: string;
    weight_grams: int64;
    weight_capacity_grams: int64;
    volume_ml: int64;
    volume_capacity_ml: int64;
    external_coord: Coord3i;
    external_label: string;
    external_capacity_ml: int64;
    external_remaining_ml: int64;
}
enum EquipmentAction : byte { WIELD = 0, STOW = 1, WEAR = 2, TAKEOFF = 3, CONSUME = 4, TREAT = 5, READ = 6, DISASSEMBLE = 7 }
// Stable native-owned UI bookmarks. Selection never wields an item.
table QuickSlot {
    slot: uint8;
    binding_id: string;
    type_id: string;
    name: string;
    category: string;
    charges: int32;
    count_by_charges: bool;
    worn: bool;
    wielded: bool;
    actions: uint8;
    rotten: bool;
}
// item_id=0 clears a slot; otherwise item identity comes from the current view.
table QuickbarBindRequest {
    command_id: uint64; slot: uint8; view_id: uint64; item_id: uint32;
    expected_binding_id: string;
}
table QuickbarSwapRequest {
    command_id: uint64; source_slot: uint8; target_slot: uint8;
    expected_source: string; expected_target: string;
}
table InventoryArrangeRequest {
    command_id: uint64; view_id: uint64; item_id: uint32; before_item_id: uint32;
}
table QuickbarUseRequest {
    command_id: uint64; slot: uint8; binding_id: string; action: EquipmentAction;
}
table EquipmentRequest {
    command_id: uint64;
    view_id: uint64;
    item_id: uint32;
    action: EquipmentAction;
}

// Ephemeral owned-item identities, native quantities and destination container.
enum ItemTransferAction : byte { DROP = 0, INSERT = 1, TAKE_EXTERNAL = 2, DEPOSIT_EXTERNAL = 3 }
table ItemTransferRequest { command_id: uint64; view_id: uint64; item_id: uint32; quantity: int32; destination_id: uint32; action: ItemTransferAction; }
table ItemTransferState { token: uint64; total_moves: int32; remaining_moves: int32; inserting: bool; }
table CancelItemTransferRequest { command_id: uint64; activity_token: uint64; }

enum RangedAction : byte { AIM = 0, FIRE = 1, RELOAD = 2 }
// Weapon generation and entity identity, never client ammunition/damage/coordinates.
table RangedRequest { command_id: uint64; weapon_token: uint64; target_entity_id: uint64; action: RangedAction; }
table RangedWeaponState { token: uint64; name: string; ammo: int32; range: int32; recoil: float64; reason: string; can_reload: bool; }
table ReloadState { token: uint64; total_moves: int32; remaining_moves: int32; }
table CancelReloadRequest { command_id: uint64; activity_token: uint64; }

table AttackRequest {
    command_id: uint64;
    target_entity_id: uint64;
}

table CommandAck {
    command_id: uint64;
    accepted: bool;
    error_message: string;
    result_revision: uint64;
}

table TimeEvent {
    world_revision: uint64;
    simulation_time: uint64;
    time_jump: bool;
    simulation_busy: bool;
}

table AcknowledgeThreatRequest {
    command_id: uint64;
}

table MedicalOption {
    choice: int32 = -1; // Current page choice index; -1 is read-only/unavailable.
    body_id: string;
    name: string;
    description: string; // Native benefits, limitations and known wound state.
    health_quarters: int32 = -1; // 0..20 native observable resolution; -1 unknown.
    health_text: string;
    hp_current: int32 = -1;
    hp_max: int32 = -1;
}

table DecisionPrompt {
    decision_id: uint64;
    text: string;
    choices: [string];
    cancel_choice: int32 = -1; // Native safe fallback; -1 disables client cancellation.
    medical: [MedicalOption];
    conversation: ConversationInfo;
}

// Already-generated native conversation. Refreshing it is presentation only.
table ConversationInfo {
    npc_id: uint64;
    speaker: string;
    topic: string;
    history: string;
    history_truncated: bool;
}

table TalkRequest { command_id: uint64; target_entity_id: uint64; }

table DecisionResponse {
    decision_id: uint64;
    choice: uint16;
}

// Presentation preference, independent of gameplay command IDs and saves.
table LanguageRequest { request_id: uint64; code: string; }
table LanguageState { request_id: uint64; code: string; accepted: bool; error: string; }

table ResyncRequest { request_id: uint64; }
table WorldReset { request_id: uint64; }
table SnapshotAck { state_id: uint64; }

union Payload {
    HelloRequest,
    HelloResponse,
    Heartbeat,
    HeartbeatAck,
    WorldSnapshot,
    ChunkSnapshot,
    TileDelta,
    EntityState,
    EntityRemoved,
    VehicleState,
    FieldState,
    MoveRequest,
    InteractRequest,
    AttackRequest,
    CommandAck,
    TimeEvent,
    AcknowledgeThreatRequest,
    DecisionPrompt,
    DecisionResponse,
    ResyncRequest,
    WorldReset,
    SnapshotAck,
    EntitySpawned
    ,SimulationControlRequest
    ,MovementIntentRequest
    ,ContinuousIntentRequest
    ,MovementModeRequest
    ,InventoryQueryRequest
    ,InventoryView
    ,EquipmentRequest
    ,CancelConsumptionRequest
    ,CancelFirstAidRequest
    ,CraftingQueryRequest
    ,CraftingView
    ,CraftingRequest
    ,CancelCraftingRequest
    ,RangedRequest
    ,CancelReloadRequest
    ,ItemTransferRequest
    ,CancelItemTransferRequest
    ,QuickbarBindRequest
    ,QuickbarUseRequest
    ,QuickbarSwapRequest
    ,InventoryArrangeRequest
    ,CraftingFavoriteRequest
    ,CancelReadingRequest
    ,LanguageRequest
    ,LanguageState
    ,CancelDisassemblyRequest
    ,TalkRequest
}

table CwmMessage {
    sequence_number: uint64;
    world_revision: uint64;
    timestamp_ms: uint64;
    payload: Payload;
    session_id: uint64;
    player_id: uint64;
    connection_id: uint64;
}

root_type CwmMessage;
