+TEST_CASE( "cwm_continuous_motion_pays_subtile_distance_and_native_crossings", "[cwm][continuous]" )
+{
+    prepare_runtime();
+    avatar &u = get_avatar();
+    map &m = get_map();
+    for( int y = 57; y < 65; ++y ) for( int x = 57; x < 65; ++x ) {
+        m.ter_set( tripoint( x, y, 0 ), ter_str_id( "t_floor" ) );
+        m.furn_set( tripoint( x, y, 0 ), furn_str_id( "f_null" ) );
+    }
+    u.remove_value( "cwm_motion_v1" );
+    u.remove_value( "cwm_stamina_fraction" );
+    const tripoint origin = m.getabs( u.pos() );
+    const int cost = u.run_cost( 100, false );
+    const int speed = u.get_speed();
+    u.moves = 1000;
+    SECTION( "short direction and stop retain paid offset inside the tile" ) {
+        auto step = cwm_motion::advance( u, m, .8, .6, .1 );
+        const auto state = cwm_motion::load( u, m );
+        CHECK( state.x == Approx( .08 * speed / cost ) );
+        CHECK( state.y == Approx( .06 * speed / cost ) );
+        CHECK( m.getabs( u.pos() ) == origin );
+        CHECK( 1000 - u.moves == static_cast<int>( std::ceil( step.distance * cost - 1e-9 ) ) );
+        const auto stopped = cwm_motion::advance( u, m, 0, 0, 1 );
+        CHECK( stopped.distance == 0 );
+        CHECK( cwm_motion::load( u, m ).x == state.x );
+        CHECK( cwm_motion::load( u, m ).y == state.y );
+    }
+    SECTION( "one physical tile charges native cost once, including the crossing" ) {
+        for( int i = 0; i < 10; ++i ) cwm_motion::advance( u, m, 1, 0, .1 * cost / speed );
+        auto state = cwm_motion::load( u, m );
+        CHECK( m.getabs( u.pos() ) == origin + tripoint_east );
+        CHECK( state.x == Approx( 0 ).margin( 1e-7 ) );
+        CHECK( 1000 - u.moves == cost );
+        CHECK_FALSE( cwm_motion::prepaid_crossing() );
+        CHECK_FALSE( cwm_motion::fractional_stamina() );
+    }
+    SECTION( "diagonal and axial physical speed are equal" ) {
+        const auto axial = cwm_motion::advance( u, m, 1, 0, .1 );
+        cwm_motion::recenter( u, m );
+        const auto diagonal = cwm_motion::advance( u, m, 1, 1, .1 );
+        CHECK( axial.distance == Approx( diagonal.distance ) );
+    }
+    SECTION( "walls and corners stop before visible tile geometry" ) {
+        m.ter_set( u.pos() + tripoint_east, ter_str_id( "t_wall" ) );
+        for( int i = 0; i < 10; ++i ) cwm_motion::advance( u, m, 1, 0, .1 );
+        CHECK( m.getabs( u.pos() ) == origin );
+        CHECK( cwm_motion::load( u, m ).x == Approx( .28 ).margin( 1e-5 ) );
+        const int paid = 1000 - u.moves;
+        for( int i = 0; i < 10; ++i ) cwm_motion::advance( u, m, 1, 0, .1 );
+        CHECK( 1000 - u.moves == paid );
+        m.ter_set( u.pos() + tripoint_south, ter_str_id( "t_wall" ) );
+        for( int i = 0; i < 10; ++i ) cwm_motion::advance( u, m, 1, 1, .1 );
+        CHECK( m.getabs( u.pos() ) == origin );
+        CHECK( cwm_motion::load( u, m ).x <= .28001 );
+        CHECK( cwm_motion::load( u, m ).y <= .28001 );
+    }
+    SECTION( "native auto-opening is paid separately from traveled distance" ) {
+        m.ter_set( u.pos() + tripoint_east, ter_str_id( "t_door_c" ) );
+        for( int i = 0; i < 10; ++i ) cwm_motion::advance( u, m, 1, 0, .1 * cost / speed );
+        CHECK( m.getabs( u.pos() ) == origin + tripoint_east );
+        const double traveled = m.getabs( u.pos() ).x - origin.x + cwm_motion::load( u, m ).x;
+        CHECK( 1000 - u.moves == static_cast<int>( std::ceil( traveled * cost - 1e-9 ) ) + 100 );
+        CHECK( m.ter( u.pos() ) == ter_str_id( "t_door_o" ) );
+    }
+    SECTION( "many short motions inside one cell retain native cost and stamina" ) {
+        const override_option burn_rate( "PLAYER_BASE_STAMINA_BURN_RATE", "100" );
+        const int stamina = u.get_stamina();
+        u.burn_move_stamina( cost );
+        const int expected_burn = stamina - u.get_stamina();
+        u.set_stamina( stamina );
+        for( const point d : { point_east, point_south, point_west, point_north } )
+            for( int i = 0; i < 25; ++i )
+                cwm_motion::advance( u, m, d.x, d.y, .01 * cost / speed );
+        CHECK( m.getabs( u.pos() ) == origin );
+        CHECK( cwm_motion::load( u, m ).x == Approx( 0 ).margin( 1e-7 ) );
+        CHECK( cwm_motion::load( u, m ).y == Approx( 0 ).margin( 1e-7 ) );
+        CHECK( 1000 - u.moves == cost );
+        CHECK( stamina - u.get_stamina() == expected_burn );
+    }
+    SECTION( "restraints do not grant within-tile movement or rapid escape rolls" ) {
+        u.add_effect( efftype_id( "beartrap" ), 1_hours );
+        const auto step = cwm_motion::advance( u, m, 1, 0, .1 );
+        CHECK( step.distance == 0 );
+        CHECK( step.extra_moves == 100 );
+        CHECK( cwm_motion::load( u, m ).x == 0 );
+    }
+    SECTION( "paid rounding credit survives reload and foreign anchor resets offsets" ) {
+        cwm_motion::advance( u, m, .8, .6, .001 );
+        const auto saved = cwm_motion::load( u, m );
+        CHECK( saved.credit > 0 );
+        const auto record = u.get_value( "cwm_motion_v1" );
+        u.remove_value( "cwm_motion_v1" );
+        u.set_value( "cwm_motion_v1", record );
+        CHECK( cwm_motion::load( u, m ).x == saved.x );
+        CHECK( cwm_motion::load( u, m ).credit == saved.credit );
+        u.setpos( u.pos() + tripoint_east );
+        CHECK( cwm_motion::load( u, m ).x == 0 );
+        CHECK( cwm_motion::load( u, m ).credit == saved.credit );
+    }
+}
