+    for (const char* name : {"t_door_c", "t_door_locked", "t_door_elocked",
+                            "t_door_metal_pickable", "t_door_bar_c", "t_door_glass_c",
+                            "t_door_metal_bulkhead_c", "t_fencegate_c"}) {
+        CAPTURE(name);
+        m.ter_set(p, ter_str_id(name));
+        const auto& native = m.ter(p).obj();
+        REQUIRE_FALSE(native.open.is_null());
+        const auto tile = cwm::CwmMapExporter::export_block(p, m, 15);
+        CHECK(tile.material_id() == DOOR_CLOSED);
+        CHECK(tile.state_flags() & DOOR);
+        CHECK(bool(tile.state_flags() & BLOCKS_MOVEMENT) == m.impassable_ter_furn(p));
+        // Locked and ordinary variants converge on the actual native open state.
+        m.ter_set(p, native.open);
+        CHECK(cwm::CwmMapExporter::export_block(p, m, 15).material_id() == DOOR_OPEN);
+        REQUIRE_FALSE(m.ter(p).obj().close.is_null());
+        m.ter_set(p, m.ter(p).obj().close);
+        CHECK(cwm::CwmMapExporter::export_block(p, m, 15).material_id() == DOOR_CLOSED);
+    }
+    for (const char* name : {"t_window_no_curtains", "t_window_domestic",
+                            "t_reinforced_double_pane_glass_with_curtain_open_window_closed",
+                            "t_reinforced_triple_pane_glass_with_curtain_open_window_closed"}) {
+        CAPTURE(name);
+        m.ter_set(p, ter_str_id(name));
+        CHECK(cwm::CwmMapExporter::export_block(p, m, 15).material_id() == WINDOW);
+        REQUIRE(m.open_door(u, p, true));
+        CHECK(cwm::CwmMapExporter::export_block(p, m, 15).material_id() == WINDOW_OPEN);
+        m.ter_set(p, m.ter(p).obj().close);
+        CHECK(cwm::CwmMapExporter::export_block(p, m, 15).material_id() == WINDOW);
+    }
+    m.ter_set(p, ter_str_id("t_window_empty_curtains_closed"));
+    CHECK(cwm::CwmMapExporter::export_block(p, m, 15).material_id() == WINDOW_BOARDED);
+    REQUIRE(m.open_door(u, p, true));
+    CHECK(cwm::CwmMapExporter::export_block(p, m, 15).material_id() == WINDOW_OPEN);
+    // The pinned trailer door is open but still impassable. Keep both facts;
+    // the renderer must show its native obstruction rather than infer passage.
+    m.ter_set(p, ter_str_id("t_bullettrailer_inner_door_o"));
+    const auto raised = cwm::CwmMapExporter::export_block(p, m, 15);
+    CHECK(raised.material_id() == DOOR_OPEN);
+    CHECK(raised.state_flags() & BLOCKS_MOVEMENT);
+}
