+static std::string journal_canonical_state( const avatar &u ) {
+    std::ostringstream stream;JsonOut out(stream);out.start_object();out.member("avatar");u.serialize(out);
+    out.member("missions");mission::serialize_all(out);out.end_object();return stream.str();
