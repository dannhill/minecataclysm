+        if (data_dir.back() != '/' && data_dir.back() != '\\') {
+            data_dir += "/";
+        }
+        PATH_INFO::set_datadir(data_dir);
+        std::cout << "[CDDA-Server] Data directory set to: " << data_dir << "\n";
+    }
+
+    assure_dir_exist(PATH_INFO::config_dir());
+    assure_dir_exist(PATH_INFO::savedir());
+    assure_dir_exist(PATH_INFO::templatedir());
+
+    setupDebug(DebugOutput::file);
+
+    get_options().init();
+    get_options().load();
+    // Override only this process's presentation preference. Never rewrite the
+    // player's existing options or infer language from the system locale.
+    get_options().get_option("USE_LANG").setValue(cwm::product_language(language)->native_locale);
+    set_language(cwm::product_language(language)->native_locale);
+    init_colors();
+
+    g = std::make_unique<game>();
+    g->new_game = true;
+    g->load_static_data();
+
+    world_generator->set_active_world(nullptr);
+    world_generator->init();
+
+    if (terrain_demo && (world_name != "terrain_comparison" || world_generator->has_world(world_name))) {
+        std::cerr << "--terrain-demo requires a new terrain_comparison world; use terrain-demo.sh.\n";
+        return 2;
+    }
+    if (terrain_demo) rng_set_engine_seed(42);
+
+    WORLD* world = nullptr;
+    if (world_generator->has_world(world_name)) {
+        std::cout << "[CDDA-Server] Loading existing world: " << world_name << "\n";
+        world = world_generator->get_world(world_name);
+    } else {
+        std::cout << "[CDDA-Server] Creating new canonical world: " << world_name << "\n";
+        try {
+            world = world_generator->make_new_world(world_name, recommended_mods());
+        } catch (const std::exception& error) {
+            std::cerr << "[CDDA-Server] ERROR: " << error.what() << "\n";
+            return 1;
+        }
+    }
+
+    if (!world) {
+        std::cerr << "[CDDA-Server] ERROR: Failed to initialize world: " << world_name << "\n";
+        return 1;
+    }
+    world_generator->set_active_world(world);
+    if (terrain_demo) {
+        world->WORLD_OPTIONS["SPAWN_DENSITY"].setValue("0");
+        world->save();
+    }
+
+    if (!new_character && !world->world_saves.empty()) {
+        const save_t* selected = nullptr;
+        for (const auto& save : world->world_saves) {
+            if ((!character.empty() && (save.decoded_name() == character || save.base_path() == character)) ||
+                (character.empty() && world->world_saves.size() == 1)) selected = &save;
+        }
+        if (!selected) {
+            std::cerr << "[CDDA-Server] Select an existing character with --character. Available save IDs:\n";
+            for (const auto& save : world->world_saves) std::cerr << "  " << save.decoded_name() << "\n";
+            return 2;
+        }
+        const save_t save = *selected;
+        g->setup();
+        if (!g->load(save)) {
+            std::cerr << "[CDDA-Server] ERROR: Canonical character load failed.\n";
+            return 1;
+        }
+        std::cout << "[CDDA-Server] Restored character: " << get_avatar().name << "\n";
+    } else {
+        if (!new_character && !character.empty()) {
+            std::cerr << "[CDDA-Server] No saved character matches --character; use --new-character to create one.\n";
+            return 2;
+        }
+        g->setup();
+        avatar& fresh = get_avatar();
+        fresh = avatar();
+        fresh.create(character_type::NOW);
+        fresh.name = character.empty() ? "Survivor" : character;
+        if (world->save_exists(save_t::from_save_id(fresh.get_save_id()))) {
+            std::cerr << "[CDDA-Server] ERROR: This character save already exists; choose another name.\n";
+            return 2;
+        }
+        if (!g->start_game()) {
+            std::cerr << "[CDDA-Server] ERROR: Failed to start canonical new game.\n";
+            return 1;
+        }
+    }
+    avatar& u = get_avatar();
+    map& here = get_map();
+    if (terrain_demo) create_terrain_comparison(u, here);
+
+    std::cout << "[CDDA-Server] World loaded. Player position: ("
+              << u.pos().x << ", " << u.pos().y << ", " << u.pos().z << ")\n";
+
+    cwm::CwmServer server(socket_path);
+    if (realtime) server.enable_realtime();
+    if (continuous) server.enable_continuous();
+    if (!server.start()) {
+        std::cerr << "[CDDA-Server] ERROR: Failed to bind local IPC endpoint at " << socket_path << "\n";
+        return 1;
+    }
+    std::cout << "[CDDA-Server] CWM IPC server listening on: " << socket_path << "\n";
+
+#ifdef _WIN32
+    if (!cwm_ready_event.empty()) {
+        const auto name = cdda::cwm::pipe_wide(cwm_ready_event);
+        const auto event = OpenEventW(EVENT_MODIFY_STATE, FALSE, name.c_str());
+        if (!event || !SetEvent(event)) { std::cerr << "Cannot signal launcher readiness\n"; return 2; }
+        CloseHandle(event);
+    }
+#endif
+    // Milestone 0.5 Automated acceptance mode
+    if (headless) {
+        std::cout << "[CDDA-Server] Running headless simulation for " << headless_ticks << " turns...\n";
+        for (int i = 0; i < headless_ticks && keep_running(); ++i) {
+            if (do_turn_with_action([&u]() { u.pause(); return true; },
+                [](const std::string& text, const std::vector<std::string>& choices) {
+                    std::cout << "[CDDA-Server] Headless decision declined/acknowledged: " << text << "\n";
+                    return static_cast<int>(choices.size()) - 1;
+                })) {
+                // Native death/quit cleanup has already handled persistence
+                // and cleared the map buffers. Never save them a second time.
+                return (g->uquit == QUIT_DIED || g->uquit == QUIT_SUICIDE ||
+                        g->uquit == QUIT_SAVED) ? 0 : 1;
+            }
+            std::cout << "  Turn " << (i + 1) << "/" << headless_ticks << " simulated.\n";
+        }
+        std::cout << "[CDDA-Server] Saving world state...\n";
+        bool saved = server.save_world(*g);
+        std::cout << "[CDDA-Server] World save " << (saved ? "SUCCESS" : "FAILED") << "\n";
+        if (saved) std::cout << "[CDDA-Server] Headless canonical-turn run completed.\n";
+        return saved ? 0 : 1;
+    }
+
+    std::cout << "[CDDA-Server] Entering main event loop. Waiting for Luanti 3D client...\n";
+    // Show the restored save before resuming any owed movement/turn debt.
+    // Bootstrap requires an admitted action; malformed/unsupported requests
+    // and handshakes cannot advance the inherited calendar.
+    while (keep_running() && !server.realtime_enabled() && !server.has_queued_action()) {
+        server.update(u, here, *g);
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    while (keep_running()) {
+        // Advance the same turn phases as the native outer loop. Input waits
+        // inside the provider; invalid requests cannot start additional turns.
+        if (server.advance_turn(u, here, *g, []() { return keep_running(); })) break;
+        server.update(u, here, *g);
+    }
+
+    if (g->uquit == QUIT_DIED || g->uquit == QUIT_SUICIDE) {
+        std::cout << "\n[CDDA-Server] Native character death lifecycle completed.\n";
+        server.stop();
+        return 0;
+    }
+    std::cout << "\n[CDDA-Server] Shutting down. Saving canonical game state...\n";
+    bool saved = server.saved_on_shutdown() || (g->uquit == QUIT_NO && server.save_world(*g));
+    std::cout << "[CDDA-Server] Final save: " << (saved ? "SUCCESS" : "FAILED") << "\n";
+    server.stop();
+
+    return saved ? 0 : 1;
+}
