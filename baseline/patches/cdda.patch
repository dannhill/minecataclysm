+TEST_CASE("cwm_presentation_is_bounded_perceived_and_observational", "[cwm][presentation]")
+{
+    clear_avatar(); clear_map(); clear_creatures();
+    avatar& u=get_avatar(); u.setpos(tripoint(60,60,0));
+    cwm::enable_presentation(false);
+    cwm::record_presentation(cwm::CueKind::Attack,u);
+    CHECK(cwm::drain_presentation().empty());
+    cwm::enable_presentation(true);
+    const auto rng=rng_get_engine(); const auto turn=calendar::turn; const int moves=u.moves;
+    for (int i=0;i<140;++i) cwm::record_presentation(cwm::CueKind::Attack,u);
+    const auto cues=cwm::drain_presentation();
+    REQUIRE(cues.size()==128);
+    CHECK(cues.front().actor==1); CHECK(cues.back().id>cues.front().id);
+    CHECK(cwm::drain_presentation().empty());
+    CHECK(rng_get_engine()==rng); CHECK(calendar::turn==turn); CHECK(u.moves==moves);
+    auto* mon=g->place_critter_at(mtype_id("mon_zombie"),tripoint(65,60,0)); REQUIRE(mon);
+    mon->set_value("cwm_monster_id","600");
+    u.add_effect(efftype_id("blind"),1_hours);
+    u.recalc_sight_limits();
+    // The native vision tests rebuild these caches after changing sight. Do
+    // not inherit a previous test's daytime seen-cache when probing blindness.
+    get_map().invalidate_map_cache(0); get_map().build_map_cache(0);
+    get_map().invalidate_visibility_cache(); get_map().update_visibility_cache(0);
+    REQUIRE_FALSE(u.sees(*mon)); // Native adjacent awareness is not invisibility.
+    cwm::record_presentation(cwm::CueKind::Attack,*mon);
+    CHECK(cwm::drain_presentation().empty());
+    u.remove_effect(efftype_id("blind"));
+    // Player damage is an explicit native result, not inferred from HP deltas.
+    u.deal_damage(mon,bodypart_id("torso"),damage_instance(damage_type_id("bash"),10));
+    auto hurt=cwm::drain_presentation();
+    CHECK(std::any_of(hurt.begin(),hurt.end(),[](const auto& cue){return cue.actor==1 && cue.kind==cwm::CueKind::Hurt;}));
+    cwm::record_presentation(cwm::CueKind::Attack,u);
+    auto full=cwm::CwmMapExporter::export_world_snapshot(1,1,u,get_map(),*g,true);
+    CHECK(CDDA::CWM::GetCwmMessage(full.data())->payload_as_WorldSnapshot()->presentation_events()->size()==0);
+    cwm::record_presentation(cwm::CueKind::Attack,u);
+    auto delta=cwm::CwmMapExporter::export_world_snapshot(2,2,u,get_map(),*g,false);
+    CHECK(CDDA::CWM::GetCwmMessage(delta.data())->payload_as_WorldSnapshot()->presentation_events()->size()==1);
+    auto next=cwm::CwmMapExporter::export_world_snapshot(3,3,u,get_map(),*g,false);
+    CHECK(CDDA::CWM::GetCwmMessage(next.data())->payload_as_WorldSnapshot()->presentation_events()->size()==0);
+    cwm::enable_presentation(false); clear_creatures();
+}
