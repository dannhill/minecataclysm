+flatbuffers::Offset<CDDA::CWM::AvatarStatus> CwmMapExporter::export_avatar_status(
+    flatbuffers::FlatBufferBuilder& fbb, const avatar& u)
+{
+    // Use the native UI's knowledge-filtered descriptions; do not publish
+    // hidden nutrition, diagnoses or raw pain/HP for a client to reinterpret.
+    const auto value = [&](const char* id, const char* label,
+                           const std::pair<std::string, nc_color>& display, int level = -1) {
+        return CDDA::CWM::CreateStatusValueDirect(fbb, id, label,
+            display.first.c_str(), get_all_colors().get_name(display.second).c_str(), level);
+    };
+    const auto stamina = value("stamina", "Stamina", get_stamina_bar(u.get_stamina(), u.get_stamina_max()));
+    std::vector<flatbuffers::Offset<CDDA::CWM::StatusValue>> needs;
+    needs.push_back(value("hunger", "Fame", display::hunger_text_color(u), hunger_perceived_level(u)));
+    needs.push_back(value("thirst", "Sete", display::thirst_text_color(u), thirst_perceived_level(u)));
+    needs.push_back(value("fatigue", "Sonno", display::fatigue_text_color(u), fatigue_perceived_level(u)));
+    needs.push_back(value("pain", "Dolore", display::pain_text_color(u), pain_perceived_level(u)));
+    needs.push_back(value("weariness", "Affaticamento", display::weariness_text_color(u)));
+    needs.push_back(value("temperature", "Temperatura", display::temp_text_color(u)));
+    needs.push_back(value("morale", "Morale", display::morale_face_color(u)));
+    std::vector<flatbuffers::Offset<CDDA::CWM::BodyPartStatus>> parts;
+    for (const bodypart_id& bp : u.get_all_body_parts(get_body_part_flags::only_main)) {
+        const auto health = value("health", "Salute",
+            get_hp_bar(u.get_part_hp_cur(bp), u.get_part_hp_max(bp), false));
+        const auto temperature = value("temperature", "Temperatura", display::temp_text_color(u, bp.id()));
+        std::vector<std::string> conditions;
+        // Same wound/treatment effects explicitly disclosed by body_window.
+        // Do not export arbitrary hidden diseases, effect IDs or exact timers.
+        for (const char* id : {"bandaged", "disinfected", "bleed", "bite", "infected", "mending"}) {
+            const efftype_id effect_id(id);
+            if (u.has_effect(effect_id, bp))
+                conditions.push_back(remove_color_tags(u.get_effect(effect_id, bp).get_speed_name()));
+        }
+        const auto known = fbb.CreateVectorOfStrings(conditions);
+        parts.push_back(CDDA::CWM::CreateBodyPartStatus(fbb, fbb.CreateString(bp.id().str()),
+            fbb.CreateString(body_part_name_as_heading(bp, 1)), health, temperature, known));
+    }
+    const auto needs_vec = fbb.CreateVector(needs);
+    const auto parts_vec = fbb.CreateVector(parts);
+    return CDDA::CWM::CreateAvatarStatus(fbb, stamina, needs_vec, parts_vec);
+}
