 // Returns true if game is over (death, saved, quit, etc)
+namespace
+{
+// The simulation and action provider share one thread. The scoped override
+// keeps the ordinary client on handle_action(), including after exceptions.
+const std::function<bool()> *external_action = nullptr;
+const external_choice_provider *external_choice = nullptr;
+const std::function<bool()> *external_world_gate = nullptr;
+bool external_phase_finished = false;
