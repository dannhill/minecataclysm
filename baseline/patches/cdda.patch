--- /dev/null
+++ b/src/cwm/cwm_map_exporter.h
@@ -0,0 +1,66 @@
+// CDDA CWM Map & Entity Exporter
+// Licensed under Apache-2.0
+#pragma once
+
+#include <vector>
+#include <cstdint>
+#include <set>
+#include <string>
+#include "cwm/cwm_protocol.hpp"
+#include "point.h"
+#include "cwm/cwm_generated.h"
+
+class map;
+class avatar;
+class game;
+class monster;
+
+namespace cwm {
+
+class CwmMapExporter {
+public:
+    struct ProjectionCache {
+        tripoint origin;
+        std::vector<uint64_t> tiles;
+        std::vector<std::string> ground_items;
+        std::set<uint64_t> actors;
+    };
+    struct ClockView { bool realtime{false}; uint32_t pause_reasons{0}; float scale{1.f}; float motion_seconds{.2f}; bool continuous{false}; };
+    // Read an already assigned canonical identity without allocating or using RNG.
+    static uint64_t monster_entity_id(const monster& critter);
+    static CDDA::CWM::CwmBlock export_block(const tripoint& p, map& m, uint8_t light);
+    static flatbuffers::Offset<CDDA::CWM::AvatarStatus> export_avatar_status(
+        flatbuffers::FlatBufferBuilder& fbb, const avatar& u);
+    static std::vector<uint8_t> export_world_snapshot(
+        uint64_t sequence_num,
+        uint64_t world_rev,
+        const avatar& u,
+        map& m,
+        game& g,
+        bool include_chunks = true,
+        ProjectionCache* cache = nullptr,
+        cdda::cwm::Identity identity = {},
+        uint64_t base_revision = 0, uint64_t state_id = 1,
+        uint64_t resync_id = 0, uint64_t completed_command_id = 0,
+        const ClockView* clock = nullptr, uint64_t activity_token = 0, uint64_t weapon_token = 0,
+        uint64_t inventory_work_command = 0, bool inventory_work_settled = false
+    );
+
+    static std::vector<uint8_t> export_tile_delta(
+        uint64_t sequence_num,
