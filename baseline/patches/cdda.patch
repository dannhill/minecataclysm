+#include "output.h"
+#include "cwm/cwm_map_exporter.h"
+#include "cwm/cwm_protocol.hpp"
+
+static void prepare_runtime()
+{
+    clear_avatar();
+    clear_map();
+    get_avatar().setpos( tripoint( 60, 60, 0 ) );
+    get_avatar().moves = 100;
+    calendar::turn = calendar::turn_zero + 36_hours + 7_seconds;
+    g->new_game = false;
+    g->uquit = QUIT_NO;
+    g->set_safe_mode( SAFE_MODE_OFF );
+    get_weather().update_weather();
+    get_avatar().recalc_sight_limits();
+    g->reset_light_level();
+    get_map().build_map_cache( 0 );
+    get_map().invalidate_visibility_cache();
+    get_map().update_visibility_cache( 0 );
+}
+
+TEST_CASE( "cwm_native_questions_use_scoped_external_choices", "[cwm][runtime]" )
+{
+    const override_option no_autosave( "AUTOSAVE", "false" );
+    prepare_runtime();
+    int questions = 0;
+    const auto choose = [&]( const std::string &text, const std::vector<std::string> &choices ) {
+        ++questions;
+        CHECK( text == "Confirm dangerous move?" );
+        REQUIRE( choices.size() == 2 );
+        return 1; // Explicit native No, never automatic confirmation.
+    };
+    REQUIRE_FALSE( external_ui_active() );
+    REQUIRE_FALSE( do_turn_with_action( [&]() {
+        CHECK( external_ui_active() );
+        CHECK_FALSE( query_yn( "Confirm dangerous move?" ) );
+        get_avatar().pause();
+        return true;
+    }, choose ) );
+    CHECK( questions == 1 );
+    CHECK_FALSE( external_ui_active() );
+    CHECK_THROWS_AS( do_turn_with_action( [&]() -> bool {
+        throw std::runtime_error( "fixture exception" );
+    }, choose ), std::runtime_error );
+    CHECK_FALSE( external_ui_active() );
+}
+
+TEST_CASE( "cwm_creature_identity_survives_other_creature_removal_and_visibility_changes", "[cwm][runtime]" )
+{
+    prepare_runtime();
+    monster *first = g->place_critter_at( mtype_id( "mon_zombie" ), get_avatar().pos() + tripoint( 4, 0, 0 ) );
+    monster *second = g->place_critter_at( mtype_id( "mon_zombie_brute" ), get_avatar().pos() + tripoint( 7, 0, 0 ) );
+    REQUIRE( first != nullptr );
+    REQUIRE( second != nullptr );
+    cwm::CwmMapExporter::ProjectionCache cache;
+    const auto projection = [&]() {
+        return cwm::CwmMapExporter::export_world_snapshot( 1, 1, get_avatar(), get_map(), *g, false, &cache );
+    };
+    const auto before = projection();
+    const auto *snapshot = cdda::cwm::MessageVerifier::parse( before.data(), before.size() )->payload_as_WorldSnapshot();
+    uint64_t second_id = 0;
+    for( const auto *ent : *snapshot->entities() ) {
+        if( ent->type_id()->str() == "mon_zombie_brute" ) {
+            second_id = ent->id();
+            CHECK( ent->perceived() );
+        }
+    }
+    REQUIRE( second_id != 0 );
+    first->set_hp( 0 );
+    g->cleanup_dead();
+    get_avatar().add_effect( efftype_id( "blind" ), 10_seconds );
+    get_avatar().recalc_sight_limits();
+    REQUIRE_FALSE( get_avatar().sees( *second ) );
+    const auto after = projection();
+    snapshot = cdda::cwm::MessageVerifier::parse( after.data(), after.size() )->payload_as_WorldSnapshot();
+    bool found = false;
+    for( const auto *ent : *snapshot->entities() ) {
+        if( ent->type_id()->str() == "mon_zombie_brute" ) {
+            found = true;
+            CHECK( ent->id() == second_id );
+            CHECK_FALSE( ent->perceived() );
+        }
+        CHECK( ent->type_id()->str() != "mon_zombie" );
+    }
+    CHECK( found );
+}
+
+TEST_CASE( "cwm_turn_runs_native_fields_ai_and_body", "[cwm][runtime]" )
+{
+    const override_option no_random_npc( "NPC_SPAWNTIME", "0" );
+    const override_option no_autosave( "AUTOSAVE", "false" );
+    const override_option no_autosafe( "AUTOSAFEMODE", "false" );
+    prepare_runtime();
+    avatar &u = get_avatar();
+    map &m = get_map();
+    const tripoint vent = u.pos() + tripoint( 12, 0, 0 );
+    m.add_field( vent, field_type_str_id( "fd_smoke_vent" ).id(), 3, 1_seconds );
+    REQUIRE( m.get_field( vent, field_type_str_id( "fd_smoke" ).id() ) == nullptr );
+    const tripoint start = u.pos() + tripoint( 7, 0, 0 );
+    monster *zombie = g->place_critter_at( mtype_id( "mon_zombie" ), start );
+    REQUIRE( zombie != nullptr );
+    zombie->anger = 100;
+    zombie->set_dest( m.getglobal( u.pos() ) );
+    zombie->set_moves( 200 );
+    u.add_effect( efftype_id( "blind" ), 10_seconds );
+    const time_point before = calendar::turn;
+    int calls = 0;
+    REQUIRE_FALSE( do_turn_with_action( [&]() {
+        ++calls;
+        u.pause();
+        return true;
+    } ) );
+    CHECK( calls == 1 );
+    CHECK( calendar::turn == before + 1_seconds );
+    CHECK( u.get_effect_dur( efftype_id( "blind" ) ) < 10_seconds );
+    CHECK( m.get_field( vent, field_type_str_id( "fd_smoke" ).id() ) != nullptr );
+    CHECK( zombie->pos() != start );
+    CHECK( u.moves > 0 );
+}
+
+TEST_CASE( "cwm_turn_pays_native_action_debt_before_accepting_input", "[cwm][runtime]" )
+{
+    const override_option no_random_npc( "NPC_SPAWNTIME", "0" );
+    const override_option no_autosave( "AUTOSAVE", "false" );
+    const override_option no_autosafe( "AUTOSAFEMODE", "false" );
+    prepare_runtime();
+    avatar &u = get_avatar();
+    u.moves = -250;
+    const time_point before = calendar::turn;
+    int calls = 0;
+    const auto pause = [&]() { ++calls; u.pause(); return true; };
+    for( int i = 0; i < 3; ++i ) REQUIRE_FALSE( do_turn_with_action( pause ) );
+    CHECK( calls == 0 );
+    CHECK( u.moves > 0 );
+    CHECK( calendar::turn == before + 3_seconds );
+    REQUIRE_FALSE( do_turn_with_action( pause ) );
+    CHECK( calls == 1 );
+}
+
+TEST_CASE( "cwm_threat_acknowledgement_preserves_native_safe_mode", "[cwm][runtime]" )
+{
+    prepare_runtime();
+    avatar &u = get_avatar();
+    monster *zombie = g->place_critter_at( mtype_id( "mon_zombie" ), u.pos() + tripoint( 5, 0, 0 ) );
+    REQUIRE( zombie != nullptr );
+    zombie->anger = 100;
+    REQUIRE( u.sees( *zombie ) );
+    g->set_safe_mode( SAFE_MODE_ON );
+    g->mostseen = 0;
+    g->mon_info_update();
+    REQUIRE( g->safe_mode == SAFE_MODE_STOP );
+    const int moves = u.moves;
+    const time_point before = calendar::turn;
+    CHECK( acknowledge_current_threat( u ) );
+    CHECK( g->safe_mode == SAFE_MODE_ON );
+    CHECK( zombie->ignoring > 0 );
+    CHECK( u.moves == moves );
+    CHECK( calendar::turn == before );
+    g->mon_info_update();
+    CHECK( g->safe_mode == SAFE_MODE_ON );
+    u.add_effect( efftype_id( "laserlocked" ), 10_seconds );
+    CHECK( acknowledge_current_threat( u ) );
+    CHECK_FALSE( u.has_effect( efftype_id( "laserlocked" ) ) );
+    CHECK( u.moves == moves );
+    CHECK( calendar::turn == before );
+}
+
+TEST_CASE( "cwm_native_activity_progresses_without_polling_for_actions", "[cwm][runtime]" )
+{
+    const override_option no_random_npc( "NPC_SPAWNTIME", "0" );
+    const override_option no_autosave( "AUTOSAVE", "false" );
+    const override_option no_autosafe( "AUTOSAFEMODE", "false" );
+    prepare_runtime();
+    avatar &u = get_avatar();
+    u.assign_activity( activity_id( "ACT_WAIT" ), 300 );
+    const time_point before = calendar::turn;
+    int calls = 0;
+    const auto pause = [&]() { ++calls; u.pause(); return true; };
+    REQUIRE_FALSE( do_turn_with_action( pause ) );
+    CHECK( calls == 0 );
+    CHECK( u.activity.moves_left < 300 );
+    for( int i = 0; i < 4 && u.activity; ++i ) REQUIRE_FALSE( do_turn_with_action( pause ) );
+    CHECK_FALSE( u.activity );
+    CHECK( calendar::turn > before );
+}
