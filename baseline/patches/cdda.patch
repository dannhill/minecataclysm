+#pragma once
+
+#include <cstdint>
+#include <string>
+
+// Native semantic presentation context, scoped to one already-generated choice.
+// Neither pagination nor a reconnect may re-run a topic's speaker effects.
+struct external_conversation_info {
+    uint64_t npc_id = 0;
+    std::string speaker;
+    std::string topic;
+    std::string history;
+    bool history_truncated = false;
+    bool companion_controls = false;
+};
+
+inline thread_local const external_conversation_info *external_conversation = nullptr;
+
+class external_conversation_scope
+{
+    const external_conversation_info *previous;
+    public:
+        explicit external_conversation_scope( const external_conversation_info *info ) :
+            previous( external_conversation ) { external_conversation = info; }
+        ~external_conversation_scope() { external_conversation = previous; }
+        external_conversation_scope( const external_conversation_scope & ) = delete;
+        external_conversation_scope &operator=( const external_conversation_scope & ) = delete;
+};
