+TEST_CASE("cwm_auto_open_and_furniture_export_without_full_resend", "[cwm]")
+{
+    using namespace cdda::cwm;
+    clear_avatar();
+    clear_map();
+    map& m = get_map();
+    avatar& u = get_avatar();
+    const tripoint p(60, 60, 0);
+    u.setpos(p);
+    u.moves = 1000;
+    const tripoint door = p + tripoint_east;
+    m.ter_set(p, ter_str_id("t_floor"));
+    m.ter_set(door, ter_str_id("t_door_c"));
+    cwm::CwmMapExporter::ProjectionCache cache;
+    auto full = cwm::CwmMapExporter::export_world_snapshot(1, 1, u, m, *g, true, &cache);
+    REQUIRE(CDDA::CWM::GetCwmMessage(full.data())->payload_as_WorldSnapshot()->chunks()->size() == 243);
+    REQUIRE(avatar_action::move(u, m, point_east));
+    REQUIRE(u.pos() == p); // Opening consumes an action, without a step.
+    REQUIRE(m.ter(door) == ter_str_id("t_door_o"));
+    m.furn_set(p + tripoint_south, furn_str_id("f_bookcase"));
+    auto partial = cwm::CwmMapExporter::export_world_snapshot(2, 2, u, m, *g, false, &cache);
+    const auto* result = CDDA::CWM::GetCwmMessage(partial.data())->payload_as_WorldSnapshot();
+    CHECK(result->chunks() == nullptr);
+    REQUIRE(result->tiles()->size() == 2);
+    bool found_door = false, found_furniture = false;
+    for (const auto* delta : *result->tiles()) {
+        if (delta->coord()->x() == door.x && delta->coord()->y() == door.y) {
+            found_door = true;
+            CHECK(delta->block()->material_id() == DOOR_OPEN);
+        } else {
+            found_furniture = true;
+            CHECK(bool(delta->block()->state_flags() & FURNITURE));
+        }
+    }
+    CHECK(found_door);
+    CHECK(found_furniture);
+    REQUIRE(avatar_action::move(u, m, point_east));
+    CHECK(u.pos() == door);
+    m.ter_set(door + tripoint_east, ter_str_id("t_wall"));
+    CHECK_FALSE(avatar_action::move(u, m, point_east));
+    CHECK(u.pos() == door);
+    auto unchanged = cwm::CwmMapExporter::export_world_snapshot(3, 3, u, m, *g, false, &cache);
+    CHECK(CDDA::CWM::GetCwmMessage(unchanged.data())->payload_as_WorldSnapshot()->tiles()->size() == 1);
+}
