+TEST_CASE("cwm_survival_levels_match_native_descriptor_boundaries", "[cwm][body]")
+{
+    clear_avatar();
+    avatar& u = get_avatar();
+    const auto exported = [&](int index) {
+        const auto moves = u.moves;
+        const auto turn = calendar::turn;
+        const auto rng = rng_get_engine();
+        flatbuffers::FlatBufferBuilder fbb;
+        fbb.Finish(cwm::CwmMapExporter::export_avatar_status(fbb, u));
+        const auto* status = flatbuffers::GetRoot<CDDA::CWM::AvatarStatus>(fbb.GetBufferPointer());
+        CHECK(u.moves == moves);
+        CHECK(calendar::turn == turn);
+        CHECK(rng_get_engine() == rng);
+        return int(status->needs()->Get(index)->perceived_level());
+    };
+    // One level for each native descriptive category, on both sides of every
+    // native threshold. Normal (blank description) is known, not unavailable.
+    for (const auto& entry : std::vector<std::pair<int, int>>{
+            {-61,10},{-60,9},{-21,9},{-20,8},{-1,8},{0,7},{40,7},
+            {41,5},{80,5},{81,3},{240,3},{241,1},{520,1},{521,0}}) {
+        u.set_thirst(entry.first);
+        REQUIRE(u.get_instant_thirst() == entry.first);
+        CHECK(exported(1) == entry.second);
+    }
+    for (const auto& entry : std::vector<std::pair<int, int>>{
+            {0,10},{int(fatigue_levels::TIRED)-1,10},{int(fatigue_levels::TIRED),6},
+            {int(fatigue_levels::DEAD_TIRED)-1,6},{int(fatigue_levels::DEAD_TIRED),3},
+            {int(fatigue_levels::EXHAUSTED)-1,3},{int(fatigue_levels::EXHAUSTED),0}}) {
+        u.set_fatigue(entry.first);
+        CHECK(exported(2) == entry.second);
+    }
+    for (const auto& entry : std::vector<std::pair<int, int>>{
+            {0,10},{1,9},{10,9},{11,8},{20,8},{21,7},{30,7},{31,6},
+            {40,6},{41,5},{50,5},{51,4},{60,4},{61,3},{70,3},{71,0},{100,0}}) {
+        u.set_pain(entry.first);
+        CHECK(exported(3) == entry.second);
+    }
+    const std::vector<std::pair<std::string,int>> hunger{
+        {"hunger_engorged",10},{"hunger_full",10},{"hunger_satisfied",10},
+        {"hunger_blank",8},{"hunger_hungry",6},{"hunger_very_hungry",4},
+        {"hunger_famished",2},{"hunger_near_starving",1},{"hunger_starving",0}};
+    for (const auto& entry : hunger) u.remove_effect(efftype_id(entry.first));
+    CHECK(exported(0) == -1); // No native hunger descriptor: never guess full.
+    for (const auto& entry : hunger) {
+        const efftype_id effect(entry.first);
+        u.add_effect(effect, 1_hours);
+        CHECK(exported(0) == entry.second);
+        CHECK(display::hunger_text_color(u).first != "ERROR!");
+        u.remove_effect(effect);
+    }
+}
