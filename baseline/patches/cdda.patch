+TEST_CASE("cwm_manual_capacity_pickup_is_explicit_and_auto_pickup_never_wields", "[cwm][pickup]") {
+    clear_avatar(); clear_map();
+    auto& u = get_avatar(); auto& m = get_map();
+    u.setpos(tripoint(60,60,0));
+    item bat(itype_id("bat")); bat.set_var("uid", "recover-capacity");
+    auto& ground = m.add_item(u.pos(), bat);
+    REQUIRE_FALSE(u.can_stash_partial(ground, false));
+    REQUIRE(u.can_wield(ground).success());
+    bool accept = false, automatic = false, loaded = false;
+    SECTION("cancel") {}
+    SECTION("explicit wield") { accept = true; }
+    SECTION("automatic pickup does not equip") { automatic = true; }
+    SECTION("loaded backpack wield keeps contents") { accept = true; loaded = true; }
+    SECTION("loaded backpack cancel keeps contents") { loaded = true; }
+    if (loaded) {
+        ground = item(itype_id("backpack_hiking")); ground.set_var("uid", "recover-capacity");
+        REQUIRE(ground.fill_with(item(itype_id("9mm"), calendar::turn, 1), 7) == 7);
+        REQUIRE_FALSE(u.can_stash_partial(ground, false));
+    }
+    int questions = 0;
+    u.moves = 1000; g->uquit = QUIT_NO; g->new_game = false;
+    g->set_safe_mode(SAFE_MODE_OFF);
+    do_turn_with_action([&]() {
