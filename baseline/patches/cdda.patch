diff --git a/src/cwm_motion.cpp b/src/cwm_motion.cpp
new file mode 100644
index 0000000..0106a99
--- /dev/null
+++ b/src/cwm_motion.cpp
@@ -0,0 +1,214 @@
+#include "cwm_motion.h"
+
+#include <algorithm>
+#include <cmath>
+#include <iomanip>
+#include <sstream>
+#include "avatar.h"
+#include "avatar_action.h"
+#include "creature_tracker.h"
+#include "game.h"
+#include "map.h"
+#include "npc.h"
+#include "move_mode.h"
+#include "flag.h"
+
+namespace cwm_motion {
+namespace {
+thread_local bool prepaid = false, fractional = false;
+thread_local double stamina_units = 0;
+struct Scope {
+    bool &flag;
+    bool previous;
+    explicit Scope( bool &value ) : flag( value ), previous( value ) { flag = true; }
+    ~Scope() { flag = previous; }
+};
+struct StaminaScope {
+    Scope scope{ fractional };
+    double previous{ stamina_units };
+    explicit StaminaScope( double moves ) { stamina_units = moves; }
+    ~StaminaScope() { stamina_units = previous; }
+};
+constexpr double radius = .22;
+bool solid( const avatar &u, const map &m, const tripoint &p )
+{
+    return !m.inbounds( p ) || m.impassable( p ) ||
+           ( p != u.pos() && get_creature_tracker().creature_at( p, true ) );
+}
+// Circle against native tile rectangles; prevents diagonal corner clipping.
+bool clear( const avatar &u, const map &m, double x, double y )
+{
+    for( int dy = -1; dy <= 1; ++dy ) for( int dx = -1; dx <= 1; ++dx ) {
+        if( !solid( u, m, u.pos() + tripoint( dx, dy, 0 ) ) ) continue;
+        const double near_x = std::clamp( x, dx - .5, dx + .5 );
+        const double near_y = std::clamp( y, dy - .5, dy + .5 );
+        if( std::hypot( x - near_x, y - near_y ) < radius - 1e-8 ) return false;
+    }
+    return true;
+}
+}
+bool prepaid_crossing() { return prepaid; }
+bool fractional_stamina() { return fractional; }
+double stamina_moves() { return stamina_units; }
+
+State load( const avatar &u, const map &m )
+{
+    State state;
+    state.anchor = m.getabs( u.pos() );
+    State saved;
+    std::istringstream in( u.get_value( "cwm_motion_v1" ) );
+    if( in >> saved.anchor.x >> saved.anchor.y >> saved.anchor.z >> saved.x >> saved.y >> saved.credit &&
+        std::isfinite( saved.x ) && std::isfinite( saved.y ) && std::isfinite( saved.credit ) &&
+        std::abs( saved.x ) < .50001 && std::abs( saved.y ) < .50001 &&
+        saved.credit >= 0 && saved.credit < 1.00001 ) {
+        // An external teleport/rebase must not attach a stale offset to a new
+        // tile. Monetary rounding credit remains paid across teleports.
+        state.credit = saved.credit;
+        if( saved.anchor == state.anchor ) { state.x = saved.x; state.y = saved.y; }
+    }
+    return state;
+}
+void store( avatar &u, const map &m, State state )
+{
+    state.anchor = m.getabs( u.pos() );
+    std::ostringstream out;
+    out << std::setprecision( 17 ) << state.anchor.x << ' ' << state.anchor.y << ' ' <<
+        state.anchor.z << ' ' << state.x << ' ' << state.y << ' ' << state.credit;
+    u.set_value( "cwm_motion_v1", out.str() );
+}
+void recenter( avatar &u, const map &m )
+{
+    auto state = load( u, m ); state.x = state.y = 0; store( u, m, state );
+}
+bool overlaps_tile( const avatar &u, const map &m, const tripoint &p )
+{
+    if( p.z != u.posz() ) return false;
+    const State state = load( u, m );
+    const auto delta = p - u.pos();
+    const double near_x = std::clamp( state.x, delta.x - .5, delta.x + .5 );
+    const double near_y = std::clamp( state.y, delta.y - .5, delta.y + .5 );
+    return std::hypot( state.x - near_x, state.y - near_y ) < radius - 1e-8;
+}
+Step advance( avatar &u, map &m, double x, double y, double seconds )
+{
+    Step result;
+    if( !std::isfinite( x ) || !std::isfinite( y ) || !std::isfinite( seconds ) ||
+        seconds <= 0 || u.moves <= 0 || u.in_vehicle || u.is_mounted() ||
+        u.get_grab_type() != object_type::NONE || !g->check_safe_mode_allowed( false ) ) return result;
+    const double length = std::hypot( x, y );
+    if( length < 1e-6 ) return result;
+    x /= length; y /= length;
+    // Restraints/status actions keep their native one-attempt cost and random
+    // rolls. Sampling must not grant free motion or 25 escape rolls/second.
+    bool native_status = u.has_flag( flag_id( "GRAB" ) ) ||
+                         u.has_effect_with_flag( flag_EFFECT_IMPEDING ) ||
+                         u.has_active_mutation( trait_id( "SHELL2" ) ) ||
+                         u.has_active_mutation( trait_id( "SHELL3" ) ) ||
+                         ( !u.enough_working_legs() && !u.is_prone() );
+    for( const char *id : { "downed", "webbed", "lightsnare", "heavysnare", "beartrap", "crushed", "in_pit", "stunned", "psi_stunned" } )
+        native_status = native_status || u.has_effect( efftype_id( id ) );
+    if( native_status ) {
+        const int before = u.moves;
+        const tripoint position = m.getabs( u.pos() );
+        const point direction( std::abs( x ) > .38 ? ( x > 0 ? 1 : -1 ) : 0,
+                               std::abs( y ) > .38 ? ( y > 0 ? 1 : -1 ) : 0 );
+        avatar_action::move( u, m, direction );
+        result.extra_moves = std::max( 0, before - u.moves );
+        result.crossed = m.getabs( u.pos() ) != position;
+        if( result.crossed ) recenter( u, m );
+        return result;
+    }
+    State state = load( u, m );
+    const tripoint start = state.anchor;
+    const int before_moves = u.moves;
+    const bool swimming = m.has_flag( ter_furn_flag::TFLAG_DEEP_WATER, u.pos() ) &&
+                          m.has_flag( ter_furn_flag::TFLAG_SWIMMABLE, u.pos() );
+    const int native_cost = swimming ? std::min( 200, u.swim_speed() ) :
+                            u.run_cost( std::max( 2, m.move_cost( u.pos() ) ) * 50, false );
+    const double cost = std::max( 1, native_cost );
+    const double distance = std::min( { std::max( 0, u.get_speed() ) * std::min( seconds, .20 ) / cost,
+                                       ( u.moves + state.credit ) / cost, .20 } );
+    const double old_x = state.x, old_y = state.y;
+    double next_x = state.x + x * distance, next_y = state.y + y * distance;
+    tripoint contacted;
+    bool contact = false;
+    // Sliding keeps the tangent component, without renormalizing its speed.
+    if( !clear( u, m, next_x, next_y ) ) {
+        const bool x_clear = std::abs( x * distance ) > 1e-9 && clear( u, m, next_x, state.y );
+        const bool y_clear = std::abs( y * distance ) > 1e-9 && clear( u, m, state.x, next_y );
+        contacted = tripoint( static_cast<int>( std::floor( next_x + .5 + x * radius ) ),
+                             static_cast<int>( std::floor( next_y + .5 + y * radius ) ), 0 );
+        contact = contacted != tripoint_zero;
+        if( x_clear ) next_y = state.y;
+        else if( y_clear ) next_x = state.x;
+        else {
+            // Approach the surface instead of stopping a whole quantum early.
+            double low = 0, high = 1;
+            for( int i = 0; i < 18; ++i ) {
+                const double t = ( low + high ) / 2;
+                if( clear( u, m, state.x + x * distance * t, state.y + y * distance * t ) ) low = t;
+                else high = t;
+            }
+            next_x = state.x + x * distance * low;
+            next_y = state.y + y * distance * low;
+        }
+    }
+    const tripoint delta( static_cast<int>( std::floor( next_x + .5 ) ),
+                          static_cast<int>( std::floor( next_y + .5 ) ), 0 );
+    bool entered = false;
+    if( delta != tripoint_zero || contact ) {
+        const tripoint attempt = delta != tripoint_zero ? delta : contacted;
+        const tripoint target = u.pos() + attempt;
+        const npc *person = get_creature_tracker().creature_at<npc>( target );
+        // Friendly bump does not start a conversation: explicit right-click owns it.
+        if( !person || person->is_enemy() ) {
+            // Do not invoke native movement toward an ordinary wall at 25Hz.
+            // Closed doors/windows and creatures retain their native action.
+            if( delta != tripoint_zero || get_creature_tracker().creature_at( target, true ) ||
+                m.open_door( u, target, !m.is_outside( u.pos() ), true ) ) {
+                const Scope scope( prepaid );
+                avatar_action::move( u, m, attempt );
+            }
+        }
+        const tripoint actual = m.getabs( u.pos() ) - start;
+        entered = actual != tripoint_zero;
+        if( delta != tripoint_zero && !entered ) {
+            // The native action can refuse a dangerous transition or open a
+            // door without entering. Stay on the authoritative side.
+            next_x = std::clamp( next_x, -.499999, .499999 );
+            next_y = std::clamp( next_y, -.499999, .499999 );
+        }
+        if( entered && actual != delta ) {
+            // Ramps, falls and native displacement keep their exact result.
+            next_x = actual.x; next_y = actual.y;
+        }
+    }
+    result.extra_moves = std::max( 0, before_moves - u.moves );
+    const tripoint actual = m.getabs( u.pos() ) - start;
+    result.distance = std::hypot( next_x - old_x, next_y - old_y );
+    const double debit = std::max( 0.0, cost * result.distance - state.credit );
+    const int paid = static_cast<int>( std::ceil( debit - 1e-9 ) );
+    state.credit = std::max( 0.0, state.credit + paid - cost * result.distance );
+    u.moves -= paid;
+    if( result.distance > 1e-8 ) {
+        const StaminaScope scope( result.distance * ( swimming ? u.swim_speed() : cost ) );
+        u.burn_move_stamina( 0 );
+        avatar_action::check_run_mode( u );
+        u.set_activity_level( u.current_movement_mode()->exertion_level() );
+        u.recoil = MAX_RECOIL;
+        u.last_target_pos = std::nullopt;
+        double steps = 0;
+        std::istringstream( u.get_value( "cwm_step_distance" ) ) >> steps;
+        if( !std::isfinite( steps ) || steps < 0 || steps >= 1 ) steps = 0;
+        steps += result.distance;
+        if( steps >= 1 ) { u.make_footstep_noise(); steps -= std::floor( steps ); }
+        std::ostringstream saved;
+        saved << std::setprecision( 17 ) << steps;
+        u.set_value( "cwm_step_distance", saved.str() );
+    }
+    state.x = next_x - actual.x; state.y = next_y - actual.y;
+    store( u, m, state );
+    result.crossed = entered;
+    return result;
+}
+}
diff --git a/src/cwm_motion.h b/src/cwm_motion.h
new file mode 100644
index 0000000..1672957
--- /dev/null
+++ b/src/cwm_motion.h
@@ -0,0 +1,28 @@
+// Native continuous avatar motion. No presentation-engine types or physics.
+#pragma once
+#include "point.h"
+
