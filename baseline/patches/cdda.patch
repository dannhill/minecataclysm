+#include "cata_catch.h"
+#include "avatar.h"
+#include "calendar.h"
+#include "do_turn.h"
+#include "field.h"
+#include "field_type.h"
+#include "game.h"
+#include "map.h"
+#include "map_helpers.h"
+#include "monster.h"
+#include "options_helpers.h"
+#include "player_helpers.h"
