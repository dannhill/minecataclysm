+            !u.is_deaf() && !u.is_mute() && !p.is_mute() &&
+            !p.has_effect(efftype_id("sleep")) && !p.has_effect(efftype_id("lying_down")) &&
+            !p.has_effect(efftype_id("narcosis")) && !p.has_effect(efftype_id("npc_suspend")) &&
+            p.posz()==u.posz() && rl_dist(u.pos(),p.pos())<=SEEX*2 &&
+            u.sees(p.pos()) && u.sees(p) && p.can_hear(u.pos(),u.get_shout_volume());
+    }
+    static std::string rule_state(const npc &p,const Rule &r) {
+        const auto flag=ally_rule_strs.at(r.id).rule;
+        std::string text=::cwm::text(r.label)+": "+::cwm::tr(p.rules.has_flag(flag,false)?"On":"Off");
+        if(p.rules.has_override_enable(flag))text+=" ("+::cwm::text("Override")+": "+::cwm::tr(p.rules.has_flag(flag)?"On":"Off")+")";
+        return text;
+    }
+    static bool base(avatar &u,npc &p,const Rule &r,bool enabled) {
+        if(!available(u,p))return false;
+        // Same semantic setters as native dialogue effects: preserve native
+        // range-cache invalidation and possible weapon reselection/costs.
+        auto actor=get_talker_for(p);
+        if(enabled)actor->set_ai_rule("ally_rule",r.id);else actor->clear_ai_rule("ally_rule",r.id);
+        return true;
+    }
+    static bool override_rule(avatar &u,npc &p,const Rule &r,int state) {
+        if(!available(u,p) || state < -1 || state>1)return false;
+        const auto flag=ally_rule_strs.at(r.id).rule;
+        if(state<0)p.rules.disable_override(flag);else p.rules.set_specific_override_state(flag,state!=0);
+        p.invalidate_range_cache();return true;
+    }
+    static bool local_guard(const npc &p) {
+        return p.mission==NPC_MISSION_GUARD_ALLY && !p.assigned_camp && !p.has_companion_mission();
+    }
+    static bool order(avatar &u,npc &p,bool guard) {
+        if(!available(u,p) || p.assigned_camp || p.has_companion_mission())return false;
+        if(guard && p.is_following())talk_function::assign_guard(p);
+        else if(!guard && local_guard(p))talk_function::stop_guard(p);
+        else return false;
+        return true;
+    }
+    // True means explicit Back; false is safe leave (also disconnect/Esc).
+    static bool run(avatar &u,npc &p,external_conversation_info info) {
+        enum Pane {HOME,COMBAT,BEHAVIOR,DETAIL,ENGAGEMENT,AIM,POWER,RESERVE,RECHARGE};
+        int pane=HOME,rule=0;bool done=false,back=false;
+        info.companion_controls=true;info.topic="CWM_COMPANION_CONTROLS";
+        while(!done && available(u,p)) {
+            using Entry=std::pair<std::string,std::function<void()>>;
+            std::vector<Entry> entries;
+            auto add=[&](std::string label,std::function<void()> action){entries.emplace_back(std::move(label),std::move(action));};
+            auto category=[&](const char *label,int next){add(::cwm::text(label),[&,next]{pane=next;});};
+            std::string body=::cwm::text("Companion orders and rules")+"\n"+p.disp_name()+"\n"+
+                ::cwm::tr(p.is_following()?"Following you":p.is_guarding()?"Guarding position":"Other native activity")+"\n\n";
+            if(pane==HOME) {
+                body+=::cwm::text("Rules and orders apply only to this ally. The native conversation pays its normal action cost when you leave.");
+                if(!p.assigned_camp && !p.has_companion_mission()) {
+                    if(p.is_following())add(::cwm::text("Guard this position"),[&]{order(u,p,true);});
+                    else if(local_guard(p))add(::cwm::text("Follow me"),[&]{order(u,p,false);});
+                }
+                category("Combat rules",COMBAT);category("Behavior rules",BEHAVIOR);
+                category("Engagement policy",ENGAGEMENT);category("Aiming policy",AIM);category("Bionic power policy",POWER);
+                add(::cwm::text("Clear all temporary overrides"),[&]{p.rules.clear_overrides();p.invalidate_range_cache();});
+            } else if(pane==COMBAT || pane==BEHAVIOR) {
+                body+=::cwm::text("On/Off shows the base rule. An Override is a temporary order that takes priority. Select a rule to inspect or change it.");
+                for(size_t n=0;n<rules().size();++n)if(rules()[n].combat==(pane==COMBAT))
+                    add(rule_state(p,rules()[n]),[&,n]{rule=n;pane=DETAIL;});
+            } else if(pane==DETAIL) {
+                const auto &r=rules()[rule];const auto flag=ally_rule_strs.at(r.id).rule;
+                body+=::cwm::text(r.label)+"\n\n"+::cwm::text("Base rule")+": "+::cwm::tr(p.rules.has_flag(flag,false)?"On":"Off")+
+                    "\n"+::cwm::text("Effective rule")+": "+::cwm::tr(p.rules.has_flag(flag)?"On":"Off")+
+                    "\n"+::cwm::text("Temporary override")+": "+(p.rules.has_override_enable(flag)?::cwm::text(p.rules.has_override(flag)?"On":"Off") : ::cwm::text("None"));
+                add(::cwm::text("Enable base rule"),[&]{base(u,p,r,true);});
+                add(::cwm::text("Disable base rule"),[&]{base(u,p,r,false);});
+                add(::cwm::text("Use base rule (remove override)"),[&]{override_rule(u,p,r,-1);});
+                add(::cwm::text("Temporarily enable"),[&]{override_rule(u,p,r,1);});
+                add(::cwm::text("Temporarily disable"),[&]{override_rule(u,p,r,0);});
+            } else if(pane==POWER) {
+                body+=::cwm::text("Native bionic power preferences. These do not install, activate or recharge a bionic for free.");
+                category("Power reserved for defense",RESERVE);category("Recharge threshold",RECHARGE);
+            } else {
+                const char *type=pane==ENGAGEMENT?"engagement_rule":pane==AIM?"aim_rule":pane==RESERVE?"cbm_reserve_rule":"cbm_recharge_rule";
+                std::vector<std::pair<const char*,const char*>> options;
+                if(pane==ENGAGEMENT)options={{"ENGAGE_NONE","Do not engage"},{"ENGAGE_CLOSE","Nearby enemies"},{"ENGAGE_WEAK","Weak enemies"},{"ENGAGE_HIT","Enemies I attack"},{"ENGAGE_ALL","All enemies"},{"ENGAGE_FREE_FIRE","Distant enemies without moving"},{"ENGAGE_NO_MOVE","Only within reach without moving"}};
+                else if(pane==AIM)options={{"AIM_WHEN_CONVENIENT","Aim when convenient"},{"AIM_SPRAY","Shoot without aiming"},{"AIM_PRECISE","Aim when possible"},{"AIM_STRICTLY_PRECISE","Shoot only when precisely aimed"}};
+                else if(pane==RESERVE)options={{"CBM_RESERVE_ALL","Reserve 100%"},{"CBM_RESERVE_MOST","Reserve 75%"},{"CBM_RESERVE_SOME","Reserve 50%"},{"CBM_RESERVE_LITTLE","Reserve 25%"},{"CBM_RESERVE_NONE","Reserve 0%"}};
+                else options={{"CBM_RECHARGE_ALL","Recharge below 90%"},{"CBM_RECHARGE_MOST","Recharge below 75%"},{"CBM_RECHARGE_SOME","Recharge below 50%"},{"CBM_RECHARGE_LITTLE","Recharge below 25%"},{"CBM_RECHARGE_NONE","Recharge below 10%"}};
+                body+=::cwm::text("The marked option is the current native policy. Selecting another uses the same setter as CDDA dialogue.");
+                for(const auto &o:options) {
+                    auto actor=get_talker_for(p);const bool current=actor->has_ai_rule(type,o.first);
+                    add(std::string(current?"* ":"")+::cwm::text(o.second),[&,type,id=o.first]{get_talker_for(p)->set_ai_rule(type,id);});
+                }
+            }
+            add(::cwm::text(pane==HOME?"Back to conversation":"Back"),[&]{
+                if(pane==HOME){back=true;done=true;}
+                else if(pane==DETAIL)pane=rules()[rule].combat?COMBAT:BEHAVIOR;
+                else if(pane==RESERVE || pane==RECHARGE)pane=POWER;
+                else pane=HOME;
+            });
+            add(::cwm::text("Leave conversation"),[&]{done=true;});
+            std::vector<std::string> labels;for(const auto &e:entries)labels.push_back(e.first);
+            int answer;
+            {external_conversation_scope scope(&info);answer=external_ui_choice(body,labels);}
+            if(answer<0 || size_t(answer)>=entries.size() || !available(u,p))return false;
+            entries[answer].second();
+        }
+        return back && available(u,p);
+    }
+};
+} // namespace cwm
diff --git a/src/cwm/cwm_conversation.h b/src/cwm/cwm_conversation.h
new file mode 100644
index 0000000..1296d17
--- /dev/null
+++ b/src/cwm/cwm_conversation.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include "avatar.h"
+#include "game.h"
+#include "npc.h"
+#include "talker.h"
+#include "cwm/product_language.hpp"
+
+namespace cwm {
+inline npc *conversation_target( uint64_t id, const avatar &u, game &game ) {
+    if( !( id & ( uint64_t( 1 ) << 63 ) ) ) return nullptr;
+    for( npc &person : game.all_npcs() ) {
+        if( ( ( uint64_t( 1 ) << 63 ) | uint64_t( person.getID().get_value() ) ) != id ) continue;
+        // Same eligibility as game::chat's local NPC selection, using native
+        // sensory visibility and distance, never the presentation camera.
+        return !person.is_dead() && person.posz() == u.posz() &&
+               rl_dist( u.pos(), person.pos() ) <= SEEX * 2 && u.sees( person.pos() ) && u.sees( person ) ? &person : nullptr;
+    }
+    return nullptr;
+}
+inline std::string conversation_error( uint64_t id, const avatar &u, game &game ) {
+    if( !conversation_target( id, u, game ) )
+        return ::cwm::tr( "NPC unavailable, unseen or too far away." );
+    if( u.has_trait( trait_id( "PROF_FOODP" ) ) &&
+        !( u.is_wearing( itype_id( "foodperson_mask" ) ) || u.is_wearing( itype_id( "foodperson_mask_on" ) ) ) )
+        return ::cwm::tr( "You can't speak without your face!" );
+    return {};
+}
+} // namespace cwm
diff --git a/src/cwm/cwm_crafting.h b/src/cwm/cwm_crafting.h
new file mode 100644
index 0000000..d94c308
--- /dev/null
+++ b/src/cwm/cwm_crafting.h
@@ -0,0 +1,220 @@
+#pragma once
+#include "cwm/product_language.hpp"
+#include "avatar.h"
+#include "avatar_action.h"
+#include "map.h"
+#include "map_iterator.h"
+#include "map_selector.h"
+#include "cwm_inventory.h"
+#include "activity_actor_definitions.h"
+#include "craft_command.h"
+#include "crafting.h"
+#include "item.h"
+#include "itype.h"
+#include "item_location.h"
+#include "inventory.h"
+#include "recipe_dictionary.h"
+#include "uistate.h"
+#include "output.h"
+#include "cwm/cwm_protocol.hpp"
+#include <algorithm>
+#include <cctype>
+
+namespace cwm {
+inline item_location active_craft(const avatar& u) {
+    if (u.activity.id() == activity_id("ACT_CRAFT") && !u.activity.targets.empty()) {
+        auto target = u.activity.targets.front();
+        if (target && target->is_craft()) return target;
+    }
+    return item_location{};
+}
+// Session/view handles, not canonical item IDs or client coordinates.
+class CraftingSelection {
+    struct Selection { const recipe* rec; item_location work; bool resume; };
+    uint64_t next_view_{1}, view_{0};
+    int batch_{1};
+    std::vector<Selection> entries_;
+    static std::string lower(std::string s) {
+        for (char& c : s) c = std::tolower(static_cast<unsigned char>(c));
+        return s;
+    }
+    static std::string availability(avatar& u, const recipe& rec, int batch, bool continuing = false) {
+        if (rec.is_nested()) return ::cwm::tr("Choose an actual recipe, not a recipe category.", "Scegli una ricetta effettiva, non una categoria.");
+        if (u.activity) return ::cwm::tr("Interrupt or finish the activity before crafting.", "Interrompi o concludi l'attivita prima di creare.");
+        if (u.is_mounted() || u.is_underwater()) return ::cwm::tr("Crafting is unavailable at this location.", "Crafting non disponibile in questa posizione.");
+        if (rec.category == "CC_BUILDING" || rec.is_practice()) return ::cwm::tr("This process requires a dedicated interface in a later update.", "Lavorazione dedicata prevista in seguito.");
+        if (rec.result()->phase != phase_id::SOLID)
+            return ::cwm::tr("Liquid or gas results require container handling in a later update.", "Risultati liquidi/gassosi: gestione contenitori prevista in seguito.");
+        // Sampling a byproduct group here would advance native RNG on a read-only query.
+        if (rec.has_byproducts()) return ::cwm::tr("Recipes with byproducts require a dedicated interface in a later update.", "Ricette con sottoprodotti: supporto dedicato previsto in seguito.");
+        if (u.morale_crafting_speed_multiplier(rec) <= 0) return ::cwm::tr("Morale is too low.", "Morale insufficiente.");
+        if (u.lighting_craft_speed_multiplier(rec) <= 0) return ::cwm::tr("Not enough light.", "Luce insufficiente.");
+        if (!u.has_recipe(&rec, u.crafting_inventory(), u.get_crafting_group())) return ::cwm::tr("Recipe unavailable.", "Ricetta non disponibile.");
+        if (!rec.character_has_required_proficiencies(u)) return ::cwm::tr("Required proficiencies are missing.", "Competenze obbligatorie mancanti.");
+        if (!continuing && !u.can_start_craft(&rec, recipe_filter_flags::no_favorite | recipe_filter_flags::no_equipped, batch))
+            return ::cwm::tr("Missing components or tools; favorites, equipped item types and full liquid containers are protected.", "Componenti o utensili insufficienti; preferiti, tipi equipaggiati e contenitori liquidi pieni sono protetti.");
+        return "";
+    }
+    static uint8_t recent_rank(const recipe& rec) {
+        uint8_t rank=0; for(auto it=uistate.recent_recipes.rbegin();it!=uistate.recent_recipes.rend() && rank<20;++it) {
+            ++rank;if(*it==rec.ident())return rank;
+        }return 0;
+    }
+public:
+    std::string set_favorite(avatar& u,uint64_t view,uint32_t entry,bool favorite,bool expected) {
+        if(!view || view!=view_ || !entry || entry>entries_.size())return ::cwm::tr("Catalog expired: reopen K.","Catalogo scaduto: riapri K.");
+        const auto* rec=entries_[entry-1].rec;
+        // Knowledge uses real books/readers, not freshly generated water or
+        // pseudo-tools. Keep native reachability, ownership and helper rules.
+        inventory sources;sources.form_from_map(u.pos(),PICKUP_RANGE,&u,false,true,false);
+        for(const auto& loc:u.all_items_loc())sources.add_item(*loc,false,false);
+        for(const auto* pseudo:u.get_pseudo_items())sources.add_item(*pseudo,false,false);
+        const auto helpers=u.get_crafting_group();
+        const auto available=u.get_available_recipes(sources,&helpers);
+        if(!*rec || rec->obsolete || rec->is_nested() || std::find(available.begin(),available.end(),rec)==available.end())
+            return ::cwm::tr("Recipe is no longer known or accessible.","Ricetta non piu nota o accessibile.");
+        const bool current=uistate.favorite_recipes.count(rec->ident());
+        if(current!=expected)return ::cwm::tr("Favorite changed: refresh the catalog.","Preferita cambiata: aggiorna il catalogo.");
+        if(favorite){uistate.favorite_recipes.insert(rec->ident());uistate.read_recipes.insert(rec->ident());}
+        else uistate.favorite_recipes.erase(rec->ident());
+        return {};
+    }
+    void clear() { view_ = 0; entries_.clear(); }
+    uint64_t view() const { return view_; }
+    std::vector<uint8_t> query(avatar& u, uint64_t query, const std::string& search, int batch,
+                              cdda::cwm::MessageBuilder& reply, const std::string& error = "",
+                              CDDA::CWM::CraftingFilter filter = CDDA::CWM::CraftingFilter::ALL) {
+        clear(); batch_ = batch;
+        auto& fbb = reply.builder();
+        std::vector<flatbuffers::Offset<CDDA::CWM::CraftingEntry>> rows;
+        bool truncated = false;
+        if (error.empty()) {
+            view_ = next_view_++;
+            u.invalidate_crafting_inventory();
+            const auto& inv = u.crafting_inventory();
+            const auto helpers = u.get_crafting_group();
+            auto available = u.get_available_recipes(inv, &helpers);
+            std::vector<Selection> candidates;
+            const auto include = [&](const recipe& rec,item_location work) {
+                // Native nested categories are navigation, never executable
+                // recipes. Their children are already in available_recipes.
+                if (!rec || rec.obsolete || (!work && rec.is_nested())) return;
+                if(filter==CDDA::CWM::CraftingFilter::UNFINISHED && !work)return;
+                if(filter==CDDA::CWM::CraftingFilter::FAVORITES && !uistate.favorite_recipes.count(rec.ident()))return;
+                if(filter==CDDA::CWM::CraftingFilter::RECENT && !recent_rank(rec))return;
+                candidates.push_back({&rec,work,bool(work)});
+            };
+            for (auto loc:u.all_items_loc())if(loc->is_craft())include(loc->get_making(),loc);
+            map& m=get_map();for(const auto& tile:m.points_in_radius(u.pos(),1)) {
+                if(!u.sees(tile) || !m.accessible_items(tile) || (tile!=u.pos() && !m.clear_path(u.pos(),tile,1,1,100)))continue;
+                for(auto& it:m.i_at(tile))if(it.is_craft())include(it.get_making(),item_location(map_cursor(tile),&it));
+            }
+            for(const auto* rec:available)include(*rec,{});
+            if(filter==CDDA::CWM::CraftingFilter::AUTO) {
+                const auto any=[&](auto predicate){return std::any_of(candidates.begin(),candidates.end(),predicate);};
+                filter=any([](const auto& e){return e.resume;}) ? CDDA::CWM::CraftingFilter::UNFINISHED :
+                    any([](const auto& e){return recent_rank(*e.rec)>0;}) ? CDDA::CWM::CraftingFilter::RECENT :
+                    any([](const auto& e){return uistate.favorite_recipes.count(e.rec->ident())>0;}) ? CDDA::CWM::CraftingFilter::FAVORITES : CDDA::CWM::CraftingFilter::ALL;
+                candidates.erase(std::remove_if(candidates.begin(),candidates.end(),[&](const auto& e) {
+                    return (filter==CDDA::CWM::CraftingFilter::UNFINISHED && !e.resume) ||
+                        (filter==CDDA::CWM::CraftingFilter::RECENT && !recent_rank(*e.rec)) ||
+                        (filter==CDDA::CWM::CraftingFilter::FAVORITES && !uistate.favorite_recipes.count(e.rec->ident()));
+                }),candidates.end());
+            }
+            std::stable_sort(candidates.begin(),candidates.end(),[&](const auto& a,const auto& b) {
+                if(filter==CDDA::CWM::CraftingFilter::RECENT && recent_rank(*a.rec)!=recent_rank(*b.rec))return recent_rank(*a.rec)<recent_rank(*b.rec);
+                if(a.resume!=b.resume)return a.resume;
+                return std::make_pair(a.rec->result_name(),a.rec->ident().str()) < std::make_pair(b.rec->result_name(),b.rec->ident().str());
+            });
+            const auto needle = lower(search);
+            auto add = [&](const recipe& rec, item_location work) {
+                const std::string name = work ? work->tname() : rec.result_name();
+                if (!needle.empty() && lower(name + " " + rec.ident().str()).find(needle) == std::string::npos) return;
+                if (rows.size() >= 256) { truncated = true; return; }
+                std::string reason = availability(u, rec, work ? work->get_making_batch_size() : batch, bool(work));
+                if (work) {
+                    const auto error = InventorySelection::access_error(work);
+                    if (!error.empty()) reason = error;
+                } // Native continuation validates only remaining requirements.
+                const int actual_batch = work ? work->get_making_batch_size() : batch;
+                const auto remaining = work ? work->get_continue_reqs() : rec.simple_requirements();
+                const auto filter = rec.get_component_filter(recipe_filter_flags::no_favorite | recipe_filter_flags::no_equipped);
+                if (work && !remaining.can_make_with_inventory(inv, filter, 1))
+                    reason = ::cwm::tr("Missing repair components needed to resume.", "Componenti di riparazione mancanti per riprendere.");
+                auto lines = remaining.get_folded_components_list(70, c_light_gray, inv, filter, work ? 1 : batch);
+                auto tools = rec.simple_requirements().get_folded_tools_list(70, c_light_gray, inv, actual_batch);
+                if (work) lines.insert(lines.begin(), ::cwm::tr("Original materials were already consumed; any replacements and batch tools are shown here.", "Materiali originali gia consumati; qui sono mostrati gli eventuali ricambi e gli utensili del lotto."));
+                lines.insert(lines.end(), tools.begin(), tools.end());
+                std::string requirements;
+                for (const auto& line : lines) requirements += remove_color_tags(line) + "\n";
+                if (!work && !rec.simple_requirements().can_make_with_inventory(inv,
+                    rec.get_component_filter(recipe_filter_flags::no_favorite | recipe_filter_flags::no_equipped), batch))
+                    requirements += ::cwm::tr("Missing: ", "Mancano: ") + remove_color_tags(rec.simple_requirements().list_missing()) + "\n";
+                requirements += remove_color_tags(rec.primary_skill_string(u) + "\n" + rec.required_skills_string(u)) + "\n";
+                requirements += remove_color_tags(rec.required_proficiencies_string(&u)) + "\n";
+                requirements += remove_color_tags(rec.missing_proficiencies_string(&u)) + "\n";
+                const auto books = u.get_books_for_recipe(inv, &rec);
+                for (const auto& book : books) requirements += "Book: " + item::nname(book) + "\n";
+                requirements += "Helpers: " + std::to_string(u.available_assistant_count(rec));
+                entries_.push_back({&rec, work, bool(work)});
+                const auto rid = fbb.CreateString(rec.ident().str()), type = fbb.CreateString(rec.result().is_null() ? "in_progress_craft" : rec.result().str());
+                const auto title = fbb.CreateString(name.substr(0, 16384)), req = fbb.CreateString(requirements.substr(0, 16384));
+                const auto why = fbb.CreateString(reason);
+                const int64_t time = u.crafting_speed_multiplier(rec) > 0 ? std::max<int64_t>(0, u.expected_time_to_craft(rec, actual_batch)) : 0;
+                rows.push_back(CDDA::CWM::CreateCraftingEntry(fbb, rows.size()+1, rid, type, title, req, why,
+                    time, bool(work), work ? std::clamp(work->item_counter, 0, 10000000) : 0,
+                    uistate.favorite_recipes.count(rec.ident()) != 0,recent_rank(rec)));
+            };
+            for(const auto& candidate:candidates)add(*candidate.rec,candidate.work);
+        }
+        if(filter==CDDA::CWM::CraftingFilter::AUTO)filter=CDDA::CWM::CraftingFilter::ALL;
+        const auto list = fbb.CreateVector(rows); const auto why = fbb.CreateString(error);
+        const auto view = CDDA::CWM::CreateCraftingView(fbb, query, view_, batch, list, truncated, why, filter);
+        return reply.finish_message(CDDA::CWM::Payload::CraftingView, view.Union());
+    }
+    std::string validate(avatar& u, uint64_t view, uint32_t entry) const {
+        if (!view || view != view_ || !entry || entry > entries_.size()) return ::cwm::tr("Catalog expired: reopen K.", "Catalogo scaduto: riapri K.");
+        u.invalidate_crafting_inventory();
+        const auto& choice = entries_[entry-1];
+        if (choice.resume) {
+            if (!choice.work || !choice.work->is_craft() || &choice.work->get_making() != choice.rec)
+                return ::cwm::tr("Unfinished craft is no longer available.", "Lavoro incompleto non piu disponibile.");
+            if (choice.work.held_by(u)) {
+                const auto error = InventorySelection::access_error(choice.work);
+                if (!error.empty()) return error;
+            } else {
+                map& m = get_map(); const auto tile = choice.work.pos_bub().raw();
+                if (choice.work.where() != item_location::type::map || square_dist(tile, u.pos()) > 1 ||
+                    !u.sees(tile) || !m.accessible_items(tile) ||
+                    (tile != u.pos() && !m.clear_path(u.pos(), tile, 1, 1, 100)))
+                    return ::cwm::tr("Unfinished craft is no longer reachable.", "Lavoro incompleto non piu raggiungibile.");
+            }
+            if (u.activity || u.is_underwater() || u.is_mounted()) return ::cwm::tr("Cannot resume this work.", "Ripresa non disponibile.");
+            const auto error = availability(u, *choice.rec, choice.work->get_making_batch_size(), true);
+            if (!error.empty()) return error;
+            const auto remaining = choice.work->get_continue_reqs();
+            if (!remaining.can_make_with_inventory(u.crafting_inventory(),
+                choice.rec->get_component_filter(recipe_filter_flags::no_favorite | recipe_filter_flags::no_equipped), 1))
+                return ::cwm::tr("Missing repair components needed to resume.", "Componenti di riparazione mancanti per riprendere.");
+            return "";
+        }
+        // A lost/deleted item_location is never converted into a new craft.
+        if (choice.work.where() != item_location::type::invalid) return ::cwm::tr("Unfinished craft is no longer available.", "Lavoro incompleto non piu disponibile.");
+        return availability(u, *choice.rec, batch_);
+    }
+    bool execute(avatar& u, uint64_t view, uint32_t entry) {
+        if (!validate(u, view, entry).empty()) return false;
+        auto choice = entries_[entry-1]; const int batch = batch_; clear();
+        if (choice.work) {
+            if (choice.work.held_by(u)) avatar_action::use_item(u, choice.work, "CRAFT");
+            else if (u.can_continue_craft(*choice.work))
+                u.assign_activity(craft_activity_actor(choice.work, false)); // Same native workbench path as iexamine.
+
+        } else if (crafting_allowed(u, *choice.rec)) {
+            *u.last_craft = craft_command(choice.rec, batch, false, &u, std::nullopt, true);
+            u.last_craft->execute();
+        }
+        return u.activity.id() == activity_id("ACT_CRAFT");
+    }
+};
+} // namespace cwm
diff --git a/src/cwm/cwm_disassembly.h b/src/cwm/cwm_disassembly.h
new file mode 100644
index 0000000..eecae77
--- /dev/null
+++ b/src/cwm/cwm_disassembly.h
@@ -0,0 +1,61 @@
+#pragma once
+#include "avatar.h"
+#include "activity_actor_definitions.h"
+#include "item.h"
+#include "itype.h"
+#include "inventory.h"
+#include "crafting.h"
+#include "recipe_dictionary.h"
+#include "output.h"
+#include "cwm/cwm_protocol.hpp"
+#include "cwm/product_language.hpp"
+#include <algorithm>
+#include <climits>
+
+namespace cwm {
+inline item_location active_disassembly(const avatar& u) {
+    if (u.activity.id() != activity_id("ACT_DISASSEMBLE")) return {};
+    const auto* actor = dynamic_cast<const disassemble_activity_actor*>(u.activity.get_actor());
+    return actor && actor->target ? actor->target : item_location{};
+}
+inline const recipe& disassembly_recipe(const item& it) {
+    return it.typeId() == itype_id("disassembly") ? it.get_making() : recipe_dictionary::get_uncraft(it.typeId());
+}
+inline inventory disassembly_sources(avatar& u) {
+    // Read-only concrete sources: native crafting_inventory() can generate
+    // randomized water/pseudo items and cache them during inspection.
+    inventory sources; sources.form_from_map(u.pos(), PICKUP_RANGE, &u, false, true, false);
+    for (const auto& loc : u.all_items_loc()) sources.add_item(*loc, false, false);
+    for (const auto* pseudo : u.get_pseudo_items()) sources.add_item(*pseudo, false, false);
+    return sources;
+}
+inline std::string disassembly_error(avatar& u, const item& it, const inventory* supplied = nullptr) {
+    if (!it.is_disassemblable()) return ::cwm::tr("You cannot disassemble this.");
+    const auto sources = supplied ? inventory{} : disassembly_sources(u);
+    const auto allowed = u.can_disassemble(it, supplied ? *supplied : sources);
+    if (!allowed.success()) return remove_color_tags(allowed.str());
+    const bool resume = it.typeId() == itype_id("disassembly");
+    if ((!resume && it.count_by_charges()) || (resume && it.get_making_batch_size() != 1))
+        return ::cwm::tr("Stack disassembly needs a quantity interface in a later update.");
+    const auto& recipe = disassembly_recipe(it);
+    const auto moves = recipe.time_to_craft_moves(u, recipe_time_flag::ignore_proficiencies);
+    if (moves < 0 || moves > INT_MAX)
+        return ::cwm::tr("Disassembly duration is outside this interface's supported range.");
+    const item& original = resume ? it.components.only_item() : it;
+    // Never create sample items here: constructors and yields can consume RNG.
+    for (const auto& component : original.get_uncraft_components())
+        if (component.type->phase != phase_id::SOLID)
+            return ::cwm::tr("Liquid or gas recovery needs a dedicated interface in a later update.");
+    if (!original.is_container_empty())
+        return ::cwm::tr("Empty the item before disassembling it here.");
+    return {};
+}
+inline flatbuffers::Offset<CDDA::CWM::DisassemblyInfo> export_disassembly_info(
+        flatbuffers::FlatBufferBuilder& wire, avatar& u, const item& it) {
+    if (!it.is_disassemblable()) return {};
+    const bool resume = it.typeId() == itype_id("disassembly");
+    return CDDA::CWM::CreateDisassemblyInfo(wire,
+        std::max<int64_t>(0, disassembly_recipe(it).time_to_craft_moves(u, recipe_time_flag::ignore_proficiencies)),
+        resume ? std::clamp(it.item_counter, 0, 10000000) : 0, resume);
+}
+} // namespace cwm
diff --git a/src/cwm/cwm_hotbar.h b/src/cwm/cwm_hotbar.h
new file mode 100644
index 0000000..0866007
--- /dev/null
+++ b/src/cwm/cwm_hotbar.h
@@ -0,0 +1,105 @@
+#pragma once
+#include "cwm_inventory.h"
+#include "cwm/cwm_session.hpp"
+#include <array>
+#include <iomanip>
+#include <sstream>
+
+namespace cwm {
+// Optional UI metadata in the canonical native values/item_vars extensions.
+// No inventory capacity, position, charge or gameplay RNG belongs to this class.
+// The reserved item key is ignored for stacking and removed from split portions.
+class Hotbar {
+public:
+    static constexpr const char* item_key = "cwm_quick_identity";
+    static std::string slot_key(unsigned slot) { return "cwm_quick_slot_" + std::to_string(slot); }
+    static bool valid_identity(const std::string& id) {
+        return id.size() == 32 && std::all_of(id.begin(), id.end(), [](char c) {
+            return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+        });
+    }
+    static std::map<std::string, std::vector<item_location>> owned(avatar& u) {
+        std::map<item*, item_location> parents;
+        std::map<std::string, std::vector<item_location>> found;
+        unsigned count = 0;
+        bool truncated = false;
+        u.visit_items([&](item* it, item* parent) {
+            if (++count > 8192) { truncated = true; return VisitResponse::ABORT; }
+            if (parent && !parents.count(parent)) return VisitResponse::SKIP;
+            auto location = parent ? item_location(parents.at(parent), it) : item_location(u, it);
+            parents.emplace(it, location);
+            const auto id = it->get_var(item_key);
+            if (valid_identity(id)) found[id].push_back(location);
+            return VisitResponse::NEXT;
+        });
+        // An incomplete scan cannot certify that an identity is unique.
+        if (truncated) found.clear();
+        return found;
+    }
+    static std::array<item_location, 9> refresh(avatar& u) {
+        std::array<item_location, 9> slots;
+        bool populated = false;
+        for (unsigned n = 1; n <= 9; ++n) populated |= !u.get_value(slot_key(n)).empty();
+        if (!populated) return slots;
+        const auto found = owned(u);
+        std::set<std::string> used;
+        for (unsigned n = 1; n <= 9; ++n) {
+            const auto id = u.get_value(slot_key(n));
+            const auto at = found.find(id);
+            if (valid_identity(id) && at != found.end() && at->second.size() == 1 && used.insert(id).second)
+                slots[n - 1] = at->second.front();
+            else if (!id.empty()) u.remove_value(slot_key(n));
+        }
+        return slots;
+    }
+    static unsigned slot(const avatar& u, const item& it) {
+        const auto id = it.get_var(item_key);
+        if (!valid_identity(id)) return 0;
+        for (unsigned n = 1; n <= 9; ++n) if (u.get_value(slot_key(n)) == id) return n;
+        return 0;
+    }
+    static item_location resolve(avatar& u, unsigned slot, const std::string& expected) {
+        if (slot < 1 || slot > 9 || !valid_identity(expected)) return {};
+        auto slots = refresh(u);
+        if (u.get_value(slot_key(slot)) != expected) return {};
+        return slots[slot - 1];
+    }
+    static std::string swap(avatar& u, unsigned source, unsigned target,
+            const std::string& expected_source, const std::string& expected_target) {
+        if (source < 1 || source > 9 || target < 1 || target > 9 || source == target)
+            return "Invalid quick slots.";
+        refresh(u);
+        if (!valid_identity(expected_source) || u.get_value(slot_key(source)) != expected_source ||
+            u.get_value(slot_key(target)) != expected_target)
+            return "Quick slots changed: refresh the inventory.";
+        if (expected_target.empty()) u.remove_value(slot_key(source));
+        else u.set_value(slot_key(source), expected_target);
+        u.set_value(slot_key(target), expected_source);
+        return {};
+    }
+    static std::string bind(avatar& u, unsigned slot, item_location location, const std::string& expected) {
+        if (slot < 1 || slot > 9) return "Invalid quick slot.";
+        refresh(u);
+        if (u.get_value(slot_key(slot)) != expected) return "Quick slot changed: refresh the inventory.";
+        if (!location) { u.remove_value(slot_key(slot)); return {}; }
+        if (!location.held_by(u) || !u.has_item(*location)) return "Item no longer owned.";
+        auto id = location->get_var(item_key);
+        const auto found = owned(u);
+        const auto at = found.find(id);
+        if (!valid_identity(id) || at == found.end() || at->second.size() != 1) {
+            do {
+                std::ostringstream token;
+                token << std::hex << std::setfill('0') << std::setw(16) << cdda::cwm::fresh_identity()
+                      << std::setw(16) << cdda::cwm::fresh_identity();
+                id = token.str();
+            } while (found.count(id));
+            location->set_var(item_key, id);
+        }
+        // Moving the shortcut does not copy its item or reserve another pocket.
+        for (unsigned n = 1; n <= 9; ++n)
+            if (u.get_value(slot_key(n)) == id) u.remove_value(slot_key(n));
+        u.set_value(slot_key(slot), id);
+        return {};
+    }
+};
+} // namespace cwm
diff --git a/src/cwm/cwm_inventory.h b/src/cwm/cwm_inventory.h
new file mode 100644
index 0000000..078e363
--- /dev/null
+++ b/src/cwm/cwm_inventory.h
@@ -0,0 +1,338 @@
+#pragma once
+#include "cwm/product_language.hpp"
+#include <algorithm>
+#include <array>
+#include <map>
+#include <vector>
+#include <string>
+#include <optional>
+#include "mapdata.h"
+#include "avatar.h"
+#include "calendar.h"
+#include "flag.h"
+#include "itype.h"
+#include "item.h"
+#include "item_category.h"
+#include "item_location.h"
+#include "item_pocket.h"
+#include "map.h"
+#include "output.h"
+#include "units.h"
+#include "visitable.h"
+#include "cwm/cwm_protocol.hpp"
+#include "cwm_reading.h"
+#include "cwm_disassembly.h"
+
+namespace cwm {
+// Bounded, ephemeral selection view. Native safe item_locations retain identity;
+// These handles remain ephemeral; separate optional hotbar metadata is canonical.
+class InventorySelection {
+    struct Binding {
+        item_location location;
+        std::vector<item*> parents;
+        std::string type;
+        int charges;
+        bool counted, worn, wielded, external;
+    };
+    uint64_t next_view_{1}, view_{0};
+    tripoint origin_{};
+    std::vector<Binding> bindings_;
+    std::optional<tripoint> external_;
+    std::string external_terrain_, external_furniture_;
+public:
+    void clear() { view_ = 0; bindings_.clear(); external_.reset(); }
+    uint64_t view_id() const { return view_; }
+    size_t size() const { return bindings_.size(); }
+    tripoint external_position() const { return get_map().getlocal(*external_); }
+    bool external_item(uint32_t id) const { return bindings_.at(id - 1).external; }
+    static std::vector<item*> external_parents(item_location loc) {
+        std::vector<item*> out;
+        while (loc.has_parent() && out.size() <= 32) { loc = loc.parent_item(); out.push_back(loc.get_item()); }
+        return out;
+    }
+    static std::string external_access(avatar& u, const tripoint& absolute) {
+        auto& m = get_map(); const auto origin = m.getabs(u.pos());
+        if (absolute.z != origin.z || std::abs(int64_t(absolute.x)-origin.x) > 1 ||
+            std::abs(int64_t(absolute.y)-origin.y) > 1) return ::cwm::tr("Storage is out of reach.", "Contenitore fuori portata.");
+        const auto pos = m.getlocal(absolute);
+        if (!m.inbounds(pos) || !u.sees(pos) || !m.accessible_items(pos) || !m.could_see_items(pos,u.pos()))
+            return ::cwm::tr("Storage contents are not accessible or perceived.", "Contenuto non accessibile o non percepito.");
+        return {};
+    }
+    std::string validate_external(avatar& u) const {
+        if (!external_ || get_map().getabs(u.pos()) != origin_) return ::cwm::tr("Position changed: reopen storage.", "Posizione cambiata: riapri il contenitore.");
+        auto error = external_access(u,*external_); if (!error.empty()) return error;
+        auto& m = get_map(); const auto pos = external_position();
+        if (m.ter(pos).id().str()!=external_terrain_ || m.furn(pos).id().str()!=external_furniture_)
+            return ::cwm::tr("Storage changed: reopen it.", "Contenitore cambiato: riaprilo.");
+        return {};
+    }
+    static std::string external_source_error(avatar& u, item_location loc) {
+        if (u.activity) return ::cwm::tr("Interrupt the current activity first.", "Interrompi prima l'attivita in corso.");
+        auto error = access_error(loc); if (!error.empty()) return error;
+        if (!loc->made_of_from_type(phase_id::SOLID) || loc->is_bucket_nonempty())
+            return ::cwm::tr("Liquids and full open containers need a dedicated interaction.", "Liquidi e contenitori aperti pieni richiedono un'interazione dedicata.");
+        return {};
+    }
+    static std::string access_error(item_location location) {
+        for (int depth = 0; location.has_parent(); ++depth) {
+            if (depth >= 32) return ::cwm::tr("Container nesting is too deep for this interface.", "Contenitore troppo annidato per questa interfaccia.");
+            const auto* pocket = location.parent_pocket();
+            if (!pocket || !pocket->is_type(pocket_type::CONTAINER))
+                return ::cwm::tr("Technical contents require their dedicated native interaction.", "Contenuto tecnico: serve l'interazione nativa dedicata.");
+            if (pocket->sealed()) return ::cwm::tr("Sealed pocket: opening it is not supported here yet.", "Tasca sigillata: apertura non ancora disponibile qui.");
+            location = location.parent_item();
+        }
+        return {};
+    }
+    static std::string action_error(avatar& u, item_location location, int action, const inventory* tools = nullptr) {
+        if (!location || !location.held_by(u) || !u.has_item(*location))
+            return ::cwm::tr("Item is no longer owned.", "Oggetto non piu posseduto.");
+        if (action < 0 || action > 7) return ::cwm::tr("Equipment action is unsupported.", "Azione equipaggiamento non supportata.");
+        if (u.activity) return ::cwm::tr("Wait for the native activity to finish.", "Attendi la conclusione dell'attivita nativa.");
+        const auto access = access_error(location);
+        if (!access.empty()) return access;
+        if (action == 6) return reading_error(u, *location);
+        if (action == 7) return disassembly_error(u, *location, tools);
+        const bool worn = u.is_worn(*location), wielded = u.is_wielding(*location);
+        if (action == 0) {
+            if (wielded) return ::cwm::tr("Item is already wielded.", "Oggetto gia impugnato.");
+            if (worn) { const auto result = u.can_takeoff(*location); if (!result.success()) return result.str(); }
+            const auto weapon = u.get_wielded_item();
+            if (weapon && weapon->has_item(*location)) return ::cwm::tr("Stow the wielded container first.", "Riponi prima il contenitore impugnato.");
+            const auto result = u.can_wield(*location);
+            if (!result.success()) return result.str();
+        } else if (action == 1) {
+            if (!wielded) return ::cwm::tr("Select the wielded item.", "Seleziona l'oggetto impugnato.");
+            const auto result = u.can_unwield(*location);
+            if (!result.success()) return result.str();
+        } else if (action == 2) {
+            if (worn) return ::cwm::tr("Item is already worn.", "Oggetto gia indossato.");
+            const auto result = u.can_wear(*location);
+            if (!result.success()) return result.str();
+        } else if (action == 3) {
+            const auto result = u.can_takeoff(*location);
+            if (!result.success()) return result.str();
+        }
+        if (action == 5) {
+            if (!location->is_medical_tool() || location->is_comestible())
+                return ::cwm::tr("Select a bandage or external treatment; drugs and liquids need their dedicated interface.", "Seleziona una benda o un trattamento esterno; farmaci e liquidi richiedono la loro interfaccia.");
+            if (u.is_underwater()) return ::cwm::tr("You cannot treat yourself underwater.", "Non puoi medicarti sott'acqua.");
+            if (u.is_mounted()) return ::cwm::tr("Dismount before treating yourself.", "Scendi dalla cavalcatura prima di medicarti.");
+            if (location->is_filthy()) return ::cwm::tr("Filthy item: cannot be used for treatment.", "Oggetto sporco: non utilizzabile per medicare.");
+            if (location->is_broken()) return ::cwm::tr("Item is broken.", "Oggetto rotto.");
+            if (!u.can_use_heal_item(*location)) return ::cwm::tr("Your biology is incompatible with this treatment.", "Biologia non compatibile con questo trattamento.");
+            if (!location->ammo_sufficient(&u, "heal")) return ::cwm::tr("Not enough charges for this treatment.", "Cariche insufficienti per questo trattamento.");
+        }
+        if (action == 4) {
+            if (!location->is_food()) return ::cwm::tr("Select food or a drink; medicine and tool use need another interface.", "Seleziona cibo o una bevanda; medicina e uso strumenti richiedono un'altra interfaccia.");
+            if (location->count_by_charges() && location->charges <= 0) return ::cwm::tr("No servings available.", "Nessuna porzione disponibile.");
+            if (location->type->has_use() && !location->type->can_use("PETFOOD"))
+                return ::cwm::tr("Food with a special use requires an interaction not available here yet.", "Alimento con uso speciale: interazione dedicata non ancora disponibile.");
+            const auto result = u.can_eat(*location);
+            if (!result.success()) return remove_color_tags(result.str());
+            if (location->will_spill() && !location->is_container_empty())
+                return ::cwm::tr("Full edible container: handle its contents first.", "Contenitore commestibile pieno: gestione dei contenuti richiesta.");
+        }
+        if ((action == 0 || action == 2) && location->will_spill() && !location->is_container_empty())
+            return ::cwm::tr("Full open container: handle its liquids first.", "Contenitore aperto pieno: gestione dei liquidi richiesta.");
+        return {};
+    }
+    std::string validate_binding(avatar& u, uint64_t view, uint32_t id) const {
+        if (!view || view != view_ || !id || id > bindings_.size()) return ::cwm::tr("Inventory selection expired: reopen the inventory.", "Selezione inventario scaduta: riapri l'inventario.");
+        const auto& selected = bindings_[id - 1];
+        const auto& location = selected.location;
+        if (selected.external) { auto error=validate_external(u); if (!error.empty()) return error; }
+        if (!location || (selected.external ? get_map().getabs(location.position()) != *external_ :
+            (!location.held_by(u) || !u.has_item(*location))) ||
+            (selected.external ? external_parents(location) : u.parents(*location)) != selected.parents || location->typeId().str() != selected.type ||
+            location->charges != selected.charges || location->count_by_charges() != selected.counted ||
+            u.is_worn(*location) != selected.worn || u.is_wielding(*location) != selected.wielded)
+            return ::cwm::tr("Item or pocket changed: reopen the inventory.", "Oggetto o tasca cambiati: riapri l'inventario.");
+        return {};
+    }
+    std::string validate(avatar& u, uint64_t view, uint32_t id, int action) const {
+        auto error = validate_binding(u, view, id);
+        return error.empty() ? action_error(u, target(id), action) : error;
+    }
+    static unsigned ui_order(const item& it) {
+        const double value = it.get_var("cwm_inventory_position", 0);
+        return value >= 1 && value <= 2048 && std::floor(value) == value ? unsigned(value) : 0;
+    }
+    std::string arrange(avatar& u, uint64_t view, uint32_t source, uint32_t before) {
+        if (external_) return "Arrange items in the ordinary owned inventory.";
+        auto error = validate_binding(u, view, source); if (!error.empty()) return error;
+        if (before) { error = validate_binding(u, view, before); if (!error.empty()) return error; }
+        if (source == before) return {};
+        std::vector<uint32_t> order;
+        for (unsigned n = 1; n <= bindings_.size(); ++n) {
+            error = validate_binding(u, view, n); if (!error.empty()) return error;
+            order.push_back(n);
+        }
+        std::stable_sort(order.begin(), order.end(), [&](unsigned a, unsigned b) {
+            const int x = ui_order(*target(a));
+            const int y = ui_order(*target(b));
+            return (x > 0 ? x : 4096 + int(a)) < (y > 0 ? y : 4096 + int(b));
+        });
+        order.erase(std::find(order.begin(), order.end(), source));
+        order.insert(before ? std::find(order.begin(), order.end(), before) : order.end(), source);
+        for (unsigned n = 0; n < order.size(); ++n) target(order[n])->set_var("cwm_inventory_position", int(n + 1));
+        return {}; // UI placement only, not native pocket movement.
+    }
+    static std::string transfer_source_error(avatar& u, item_location location) {
+        if (!location || !location.held_by(u) || !u.has_item(*location)) return ::cwm::tr("Item is no longer owned.", "Oggetto non piu posseduto.");
+        if (u.activity) return ::cwm::tr("Interrupt the current activity first.", "Interrompi prima l'attivita in corso.");
+        const auto access = access_error(location); if (!access.empty()) return access;
+        if (u.is_worn(*location)) return ::cwm::tr("Take off the worn item first.", "Togli prima l'oggetto indossato.");
+        if (!location->made_of_from_type(phase_id::SOLID) || location->is_bucket_nonempty())
+            return ::cwm::tr("Liquids and full open containers need a dedicated pouring interaction.", "Liquidi e contenitori aperti pieni richiedono il travaso dedicato.");
+        const auto drop = u.can_drop(*location); if (!drop.success()) return remove_color_tags(drop.str());
+        if (u.is_wielding(*location)) { const auto result = u.can_unwield(*location); if (!result.success()) return remove_color_tags(result.str()); }
+        return {};
+    }
+    std::string validate_transfer(avatar& u, uint64_t view, uint32_t id, int quantity,
+                                 uint32_t destination, int action) const {
+        auto error = validate_binding(u, view, id); if (!error.empty()) return error;
+        auto source = target(id);
+        error = external_item(id) ? external_source_error(u, source) : transfer_source_error(u, source); if (!error.empty()) return error;
+        const int available = source->count_by_charges() ? source->charges : 1;
+        if (quantity <= 0 || quantity > available) return ::cwm::tr("Quantity is invalid or no longer available.", "Quantita non valida o non piu disponibile.");
+        if (get_map().getabs(u.pos()) != origin_) return ::cwm::tr("Position changed: reopen the inventory.", "Posizione cambiata: riapri l'inventario.");
+        if (action == 2) {
+            if (destination || !external_item(id)) return "Select an external item to collect.";
+            return validate_external(u);
+        }
+        if (action == 3) {
+            if (destination || external_item(id)) return "Select an owned item to deposit.";
+            error = validate_external(u); if (!error.empty()) return error;
+            const auto pos = external_position(); auto& m = get_map();
+            if (!m.can_put_items_ter_furn(pos)) return "Items cannot be deposited here.";
+            item portion(*source); if (portion.count_by_charges()) portion.charges=quantity;
+            if (portion.volume() > m.free_volume(pos)) return "Not enough space in this storage.";
+            return {};
+        }
+        if (action == 0 && external_item(id)) {
+            error = validate_external(u); if (!error.empty()) return error;
+            if (!source->is_owned_by(u,true)) return "Collect this item with native pickup before dropping it.";
+        }
+        if (action == 0) {
+            if (destination) return ::cwm::tr("Dropping on the ground does not require a container.", "Il deposito a terra non richiede un contenitore.");
+            if (!get_map().can_put_items(u.pos())) return ::cwm::tr("You cannot drop items here.", "Non puoi depositare oggetti qui.");
+            return {};
+        }
+        if (action != 1) return ::cwm::tr("Transfer is unsupported.", "Trasferimento non supportato.");
+        error = validate_binding(u, view, destination); if (!error.empty()) return error;
+        auto container = target(destination);
+        if (external_item(id) || external_item(destination)) { error=validate_external(u); if (!error.empty()) return error; }
+        if (external_item(id) && !source->is_owned_by(u,true)) return "Collect this item with native pickup before inserting it.";
+        if (external_item(destination) && !container->is_owned_by(u,true)) return ::cwm::tr("This container is owned by someone else.", "Questo contenitore appartiene a qualcun altro.");
+        error = access_error(container); if (!error.empty()) return error;
+        if (source == container || source->has_item(*container)) return ::cwm::tr("A container cannot contain itself or an ancestor.", "Un contenitore non puo contenere se stesso o un suo antenato.");
+        if (source.has_parent() && source.parent_item() == container) return ::cwm::tr("Item is already in this container.", "Oggetto gia in questo contenitore.");
+        bool usable = false;
+        for (const auto* pocket : container->get_all_contained_pockets()) if (pocket->is_type(pocket_type::CONTAINER)) {
+            if (pocket->sealed()) return ::cwm::tr("Open the sealed pocket with its dedicated interaction first.", "Apri prima la tasca sigillata con l'interazione dedicata.");
+            usable = true;
+        }
+        if (!usable) return ::cwm::tr("Destination has no item pockets.", "La destinazione non ha tasche per oggetti.");
+        item portion(*source); if (portion.count_by_charges()) portion.charges = quantity;
+        const auto fit = container->can_contain_directly(portion);
+        if (!fit.success()) return remove_color_tags(fit.str());
+        const auto parents = container.parents_can_contain_recursive(&portion);
+        if (!parents.success()) return remove_color_tags(parents.str());
+        return {};
+    }
+    item_location target(uint32_t id) const { return bindings_.at(id - 1).location; }
+    std::vector<uint8_t> query(avatar& u, uint64_t query_id, cdda::cwm::MessageBuilder& wire,
+                              const std::string& supplied_error = {}, const std::optional<tripoint>& external = {}) {
+        std::string error=supplied_error;
+        if (external && error.empty()) error=external_access(u,*external);
+        auto& fbb = wire.builder();
+        std::vector<flatbuffers::Offset<CDDA::CWM::InventoryEntry>> entries;
+        std::vector<flatbuffers::Offset<CDDA::CWM::InventoryPocket>> pockets;
+        bool truncated = false;
+        if (!error.empty()) clear();
+        if (error.empty()) {
+            clear(); view_ = next_view_++; origin_ = get_map().getabs(u.pos());
+            if (external) {
+                external_=external; const auto pos=external_position(); auto& m=get_map();
+                external_terrain_=m.ter(pos).id().str();external_furniture_=m.furn(pos).id().str();
+            }
+            const auto disassembly_tools = disassembly_sources(u);
+            std::map<item*, uint32_t> ids;
+            bool exporting_external=false;
+            const auto append = [&](item* it, item* parent) {
+                if (entries.size() >= 2048) { truncated = true; return VisitResponse::ABORT; }
+                const auto ancestors = exporting_external ? std::vector<item*>{} : u.parents(*it);
+                if (ancestors.size() > 32 || (parent && !ids.count(parent))) {
+                    truncated = true; return VisitResponse::SKIP;
+                }
+                const uint32_t id = entries.size() + 1, parent_id = parent ? ids.at(parent) : 0;
+                item_location location = parent ? item_location(bindings_[parent_id - 1].location, it) : exporting_external ? item_location(map_cursor(external_position()),it) : item_location(u, it);
+                if (exporting_external && !access_error(location).empty()) return VisitResponse::SKIP;
+                const bool worn = u.is_worn(*it), wielded = u.is_wielding(*it);
+                int pocket_index = -1;
+                if (parent) {
+                    const auto parent_pockets = parent->get_all_contained_pockets();
+                    for (size_t i = 0; i < parent_pockets.size(); ++i)
+                        if (parent_pockets[i] == location.parent_pocket()) pocket_index = i;
+                }
+                uint8_t actions = 0;
+                std::vector<flatbuffers::Offset<flatbuffers::String>> reasons;
+                for (int action = 0; action < 8; ++action) {
+                    const auto reason = action_error(u, location, action, &disassembly_tools);
+                    if (reason.empty()) actions |= 1 << action;
+                    reasons.push_back(fbb.CreateString(reason));
+                }
+                const int access = access_error(location).empty() ? std::max(0, location.obtain_cost(u)) : 0;
+                const bool food = it->is_food();
+                const auto consume_label = !food ? "" :
+                    it->get_comestible()->comesttype == "FOOD" || it->has_flag(flag_USE_EAT_VERB) ? ::cwm::tr("Eat", "Mangia") : ::cwm::tr("Drink", "Bevi");
+                const int consume_moves = food ? std::max(0, to_moves<int>(u.get_consume_time(*it))) : 0;
+                const auto warning = food && u.can_eat(*it).success() ? u.will_eat(*it, false).str() : "";
+                const auto container_pockets = it->get_all_contained_pockets();
+                unsigned quick_slot = 0;
+                const auto quick_identity = it->get_var("cwm_quick_identity");
+                if (quick_identity.size() == 32) for (unsigned n = 1; n <= 9; ++n)
+                    if (u.get_value("cwm_quick_slot_" + std::to_string(n)) == quick_identity) quick_slot = n;
+                const auto book=export_book_info(fbb,u,*it);
+                entries.push_back(CDDA::CWM::CreateInventoryEntryDirect(fbb, id, parent_id, pocket_index,
+                    it->typeId().str().c_str(), remove_color_tags(it->tname()).c_str(), it->get_category_shallow().get_id().str().c_str(),
+                    it->charges, it->count_by_charges(), worn, wielded,
+                    units::to_gram<int64_t>(it->weight()), units::to_milliliter<int64_t>(it->volume()),
+                    units::to_millimeter<int64_t>(it->length()), access, actions, &reasons, consume_moves, consume_label, remove_color_tags(warning).c_str(), (exporting_external ? external_source_error(u,location) : transfer_source_error(u, location)).c_str(),
+                    std::any_of(container_pockets.begin(), container_pockets.end(),
+                        [](const auto* p) { return p->is_type(pocket_type::CONTAINER); }), exporting_external ? 0 : quick_slot, it->rotten(), exporting_external ? 0 : ui_order(*it), exporting_external, book, export_disassembly_info(fbb,u,*it)));
+                bindings_.push_back({location, exporting_external ? external_parents(location) : ancestors, it->typeId().str(), it->charges,
+                                     it->count_by_charges(), worn, wielded, exporting_external});
+                ids[it] = id;
+                const auto own_pockets = it->get_all_contained_pockets();
+                for (size_t i = 0; i < own_pockets.size(); ++i) {
+                    if (pockets.size() >= 8192) { truncated = true; return VisitResponse::SKIP; }
+                    const auto* p = own_pockets[i];
+                    pockets.push_back(CDDA::CWM::CreateInventoryPocketDirect(fbb, id, i,
+                        remove_color_tags(p->get_name().translated()).c_str(), units::to_milliliter<int64_t>(p->max_contains_volume()),
+                        units::to_milliliter<int64_t>(p->remaining_volume()),
+                        units::to_gram<int64_t>(p->get_pocket_data()->max_contains_weight),
+                        units::to_gram<int64_t>(p->remaining_weight()),
+                        units::to_millimeter<int64_t>(p->max_containable_length()),
+                        std::max(0, p->moves()), p->sealed(), p->rigid(), p->watertight()));
+                }
+                return VisitResponse::NEXT;
+            };
+            u.visit_items(append);
+            if (external_) { exporting_external=true; map_cursor(external_position()).visit_items(append); }
+        }
+        const CDDA::CWM::Coord3i coord(external ? external->x : 0, external ? external->y : 0, external ? external->z : 0);
+        const auto pos = external_ ? external_position() : u.pos(); auto& m=get_map();
+        const auto label = external_ ? m.name(pos) : "";
+        const auto capacity = external_ ? units::to_milliliter<int64_t>(m.max_volume(pos)) : 0;
+        const auto remaining = external_ ? std::max<int64_t>(0,units::to_milliliter<int64_t>(m.free_volume(pos))) : 0;
+        const auto result = CDDA::CWM::CreateInventoryViewDirect(fbb, query_id, error.empty() ? view_ : 0,
+            &entries, &pockets, truncated, error.c_str(), units::to_gram<int64_t>(u.weight_carried()),
+            units::to_gram<int64_t>(u.weight_capacity()), units::to_milliliter<int64_t>(u.volume_carried()),
+            units::to_milliliter<int64_t>(u.volume_capacity()), error.empty() && external ? &coord : nullptr, label.c_str(), capacity, remaining);
+        return wire.finish_message(CDDA::CWM::Payload::InventoryView, result.Union());
+    }
+};
+} // namespace cwm
