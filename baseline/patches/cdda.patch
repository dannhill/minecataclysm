+TEST_CASE( "cwm_pickup_deduplication_includes_the_item_selection", "[cwm][pickup]" )
+{
+    clear_avatar();
+    clear_map();
+    avatar &u = get_avatar();
+    u.setpos( tripoint( 60, 60, 0 ) );
+    const std::string socket = "/tmp/cwm-pickup-test-" + std::to_string( getpid() ) + ".sock";
+    cwm::CwmServer server( socket );
+    REQUIRE( server.start() );
+    auto peer = cdda::cwm::IpcClient::connect_unix( socket );
+    REQUIRE( peer );
+    REQUIRE( cwm::CwmServerTestAccess::accept_peer( server ) );
+    cwm::CwmServerTestAccess::ready( server );
+    item selected( itype_id( "9mm" ) );
+    cwm::CwmServerTestAccess::enqueue( server, u.pos(), 0, selected );
+    REQUIRE( server.has_active_client() );
+    SECTION( "identical pending command is ignored" ) {
+        cwm::CwmServerTestAccess::enqueue( server, u.pos(), 0, selected );
+        CHECK( server.has_active_client() );
+    }
+    SECTION( "different index under the same command ID closes the connection" ) {
+        cwm::CwmServerTestAccess::enqueue( server, u.pos(), 1, selected );
+        CHECK_FALSE( server.has_active_client() );
+    }
+    SECTION( "different charges under the same command ID closes the connection" ) {
+        ++selected.charges;
+        cwm::CwmServerTestAccess::enqueue( server, u.pos(), 0, selected );
+        CHECK_FALSE( server.has_active_client() );
+    }
+    SECTION( "different type under the same command ID closes the connection" ) {
+        cwm::CwmServerTestAccess::enqueue( server, u.pos(), 0, item( itype_id( "rock" ) ) );
+        CHECK_FALSE( server.has_active_client() );
+    }
+}
