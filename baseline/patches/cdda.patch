+void CwmServer::send_trade() {
+    if (!trade_context_ || !trade_context_->model || !ready_ || !has_active_client() || pending_decision_) return;
+    auto& t=*trade_context_;
+    if(t.cancel || t.connection!=identity_.connection)return;
+    auto& model=*t.model;auto& np=model.external_npc();
+    const auto validation=model.external_valid();
+    if(!validation.empty()) {t.cancel=true;t.error=validation;return;}
+    const auto& rows=model.external_entries();
+    if(rows.size()>2048) {t.cancel=true;t.error="Too many trade entries for this interface.";return;}
+    cdda::cwm::MessageBuilder wire(sequence_counter_,world_revision_,identity_);auto& f=wire.builder();
+    std::vector<flatbuffers::Offset<CDDA::CWM::TradeEntry>> entries;
+    std::unordered_map<const item*,uint32_t> ids;
+    for(size_t n=0;n<rows.size();++n)for(const auto& loc:rows[n].entry->locations)if(loc)ids[loc.get_item()]=n+1;
+    for(size_t n=0;n<rows.size();++n) {
+        const auto& row=rows[n];auto loc=row.entry->any_item();if(!loc) {t.cancel=true;t.error="Trade inventory changed.";return;}
+        uint32_t parent=0;if(loc.has_parent()) {auto p=loc.parent_item();if(p && ids.count(p.get_item()))parent=ids.at(p.get_item());}
+        auto reason=model.external_reason(row);
+        if(row.unit_price<0)reason="Unsupported native item value.";
+        entries.push_back(CDDA::CWM::CreateTradeEntry(f,n+1,row.trader,parent,
+            f.CreateString(loc->typeId().str()),f.CreateString(loc->tname().substr(0,16384)),
+            f.CreateString(loc->get_category_of_contents().get_id().str()),f.CreateString(loc.describe(&get_avatar()).substr(0,4096)),
+            int(std::min<size_t>(INT_MAX,row.entry->get_available_count())),int(row.entry->chosen_count),std::max(0,row.unit_price),
+            f.CreateString(reason.substr(0,4096)),row.trader ? np.is_worn(*loc) : get_avatar().is_worn(*loc),
+            row.trader ? np.is_wielding(*loc) : get_avatar().is_wielding(*loc),loc->rotten(),loc->is_container()));
+    }
+    const auto denial=model.external_denial();
+    emit(wire.finish_message(CDDA::CWM::Payload::TradeView,CDDA::CWM::CreateTradeView(f,t.id,t.quote,t.query,t.npc,
+        f.CreateString(np.get_name().substr(0,4096)),f.CreateString(model.external_title().substr(0,4096)),f.CreateVector(entries),
+        model.external_value(false),model.external_value(true),model.external_balance(),
+        npc_trading::calc_npc_owes_you(np,model.external_balance()),np.max_credit_extended(),model.external_service_cost(),
+        np.will_exchange_items_freely(),denial.empty(),f.CreateString((t.error.empty()?denial:t.error).substr(0,4096))).Union()));
+}
+
+bool CwmServer::ask_trade(trade_ui& model,avatar& u,map& m,game& g,const std::function<bool()>& keep_running) {
+    trade_context_=std::make_unique<TradeContext>();auto& t=*trade_context_;
+    t.model=&model;t.id=next_trade_++;t.quote=next_quote_++;t.connection=identity_.connection;
+    t.npc=(uint64_t(1)<<63)|uint64_t(model.external_npc().getID().get_value());
+    model.external_entries();
+    if(realtime_) {clock_.sample(cdda::cwm::SimulationClock::Wall::now(),false);drop_realtime_input(u,m,g);}
+    ++world_revision_;send_state(u,m,g);send_trade();
+    while(keep_running() && has_active_client() && identity_.connection==t.connection && !t.cancel) {
+        update(u,m,g);
+        if(!conversation_target(t.npc,u,g) || model.external_npc().is_enemy()) {t.error="The trader is no longer available.";break;}
+        if(t.commit_requested) {
+            t.commit_requested=false;
+            auto error=model.external_denial();
+            if(manual_pause_ || threat_pause_)error="Simulation is paused";
+            const bool accepted=error.empty() && model.external_confirm();
+            if(accepted) {t.model=nullptr;return true;}
+            if(error.empty())error="Trade not confirmed.";
+            send_result({t.commit,false,error},u,m,g);t.commit=0;t.error=error;
+            send_trade();
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    t.model=nullptr;
+    if(t.error.empty())t.error="Trade cancelled.";
+    return false;
+}
+
+void CwmServer::finish_trade(bool accepted,avatar& u,map& m,game& g) {
+    if(!trade_context_)return;
+    const auto id=trade_context_->id,command=trade_context_->commit;
+    const std::string error=accepted?"":trade_context_->error;
+    trade_context_.reset();++world_revision_;
+    if(command)send_result({command,accepted,error},u,m,g);
+    if(ready_ && has_active_client()) {
+        cdda::cwm::MessageBuilder wire(sequence_counter_,world_revision_,identity_);
+        emit(wire.finish_message(CDDA::CWM::Payload::TradeClosed,CDDA::CWM::CreateTradeClosed(wire.builder(),id,accepted,wire.builder().CreateString(error)).Union()));
+        send_state(u,m,g);
+    }
+}
+
+bool CwmServer::handle_trade_message(const CDDA::CWM::CwmMessage& msg,avatar& u,map& m,game& g) {
+    if(const auto* r=msg.payload_as_TradeCancelRequest()) {
+        if(trade_context_ && r->trade_id()==trade_context_->id && !pending_decision_)trade_context_->cancel=true;
+        return true;
+    }
+    if(const auto* r=msg.payload_as_TradeOfferRequest()) {
+        if(!trade_context_ || !trade_context_->model || pending_decision_ || trade_context_->commit_requested)return true;
+        auto& t=*trade_context_;t.query=r->request_id();
+        if(!r->request_id() || r->trade_id()!=t.id || r->quote_id()!=t.quote)t.error="Offer expired; use the current quote.";
+        else {
+            t.error=t.model->external_set(r->entry_id(),r->quantity());
+            if(t.error.empty())t.quote=next_quote_++;
+        }
+        send_trade();return true;
+    }
+    const auto* r=msg.payload_as_TradeCommitRequest();if(!r)return false;
+    const auto status=ledger_.begin(client_id_,r->command_id(),"trade:"+std::to_string(r->trade_id())+":"+std::to_string(r->quote_id()));
+    using S=cdda::cwm::CommandLedger::Status;
+    if(status==S::Pending)return true;
+    if(status==S::Complete) {const auto result=ledger_.find(r->command_id())->outcome;send_result({result.id,result.accepted,result.error},u,m,g);return true;}
+    if(status!=S::Fresh) {server_->client()->close();return true;}
+    std::string error;
+    if(!trade_context_ || !trade_context_->model || pending_decision_)error="No available trade quote.";
+    else if(trade_context_->commit || trade_context_->commit_requested)error="A trade confirmation is already pending.";
+    else if(r->trade_id()!=trade_context_->id || r->quote_id()!=trade_context_->quote)error="Offer expired; use the current quote.";
+    else if(manual_pause_ || threat_pause_)error="Simulation is paused";
+    else if(!conversation_target(trade_context_->npc,u,g) || trade_context_->model->external_npc().is_enemy())error="The trader is no longer available.";
+    else error=trade_context_->model->external_denial();
+    if(!error.empty()) {
+        send_result({r->command_id(),false,error},u,m,g);
+        if(trade_context_) {trade_context_->error=error;send_trade();}
+    } else {trade_context_->commit=r->command_id();trade_context_->commit_requested=true;}
+    return true;
+}
+
+} // namespace cwm
