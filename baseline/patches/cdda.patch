+        const auto bytes = wire.build_cancel_consumption( id, token );
+        server.handle_client_message( bytes.data(), bytes.size(), get_avatar(), get_map(), *g );
+    }
+    static void interrupt_medicine( CwmServer &server, uint64_t token, uint64_t id ) {
+        cdda::cwm::MessageBuilder wire( server.received_sequence_ + 1, 1, server.identity_ );
+        const auto bytes = wire.build_cancel_first_aid( id, token );
+        server.handle_client_message( bytes.data(), bytes.size(), get_avatar(), get_map(), *g );
+    }
+    static std::pair<uint64_t,uint32_t> crafting( CwmServer &server ) {
+        cdda::cwm::MessageBuilder wire(1,1,server.identity_);
+        const auto bytes=server.crafting_selection_.query(get_avatar(),1,"bandages_makeshift",1,wire);
+        const auto* view=CDDA::CWM::GetCwmMessage(bytes.data())->payload_as_CraftingView();
+        REQUIRE(view->entries()->size()>0);
+        return {view->view_id(),view->entries()->Get(0)->id()};
+    }
+    static void craft( CwmServer &server, uint64_t view, uint32_t entry, uint64_t id=1 ) {
+        cdda::cwm::MessageBuilder wire(server.received_sequence_+1,1,server.identity_);
+        const auto bytes=wire.build_crafting_request(id,view,entry);
+        server.handle_client_message(bytes.data(),bytes.size(),get_avatar(),get_map(),*g);
+    }
+    static void interrupt_crafting( CwmServer &server, uint64_t token, uint64_t id ) {
+        cdda::cwm::MessageBuilder wire(server.received_sequence_+1,1,server.identity_);
+        const auto bytes=wire.build_cancel_crafting(id,token);
+        server.handle_client_message(bytes.data(),bytes.size(),get_avatar(),get_map(),*g);
+    }
+    static void cancel( CwmServer &server ) { server.cancel_connection(); }
+    static void complete( CwmServer &server ) {
+        REQUIRE( server.result_ );
+        server.send_result( *server.result_, get_avatar(), get_map(), *g );
+        server.result_.reset();
+    }
+    static void pause( CwmServer &server ) { server.manual_pause_ = true; }
+    static bool execute( CwmServer &server ) {
+        REQUIRE( server.commands_.size() == 1 );
+        const auto command = server.commands_.front();
+        server.commands_.pop_front();
+        return server.execute( command, get_avatar(), get_map(), *g );
+    }
+    static void charge_work(CwmServer& server, int moves, int speed) {
+        server.clock_.charge_work(moves, speed);
+    }
+    static void sample_work(CwmServer& server, double seconds) {
+        const auto now = cdda::cwm::SimulationClock::Wall::time_point{} +
+            std::chrono::duration_cast<cdda::cwm::SimulationClock::Wall::duration>(std::chrono::duration<double>(seconds));
+        server.clock_.sample(now, true);
+    }
+    static bool settle(CwmServer& server) { return server.refresh_inventory_work(get_avatar()); }
+    static uint64_t work_id(const CwmServer& server) { return server.inventory_work_command_; }
+    static bool work_settled(const CwmServer& server) { return server.inventory_work_settled_; }
+    static bool accepted( const CwmServer &server ) {
+        REQUIRE( server.result_ );
+        return server.result_->accepted;
+    }
+    static bool completed_accepted( const CwmServer &server, uint64_t id ) {
+        const auto *entry = server.ledger_.find( id );
+        REQUIRE( entry ); REQUIRE( entry->complete );
+        return entry->outcome.accepted;
+    }
+    static int choice_without_peer( CwmServer &server, const std::string &text,
+                                    const std::vector<std::string> &choices ) {
+        return server.ask_decision( text, choices, get_avatar(), get_map(), *g, []() { return false; } );
+    }
+    static bool accept_peer( CwmServer &server ) { return server.server_->poll_accept(); }
+};
+}
