+
+namespace cwm {
+inline std::string reading_error(const avatar& u, const item& book) {
+    if (!book.is_book()) return ::cwm::tr("Select a paper book.", "Seleziona un libro cartaceo.");
+    if (book.type->has_use() || book.typeId() == itype_id("guidebook"))
+        return ::cwm::tr("Special-use books need a dedicated interaction.", "Libri con uso speciale: serve un'interazione dedicata.");
+    std::vector<std::string> reasons;
+    const auto* reader=u.get_book_reader(book,reasons);
+    if (!reader) {
+        std::string text;
+        for (const auto& reason : reasons) { if (!text.empty()) text += "\n"; text += remove_color_tags(reason); }
+        return text.empty() ? ::cwm::tr("Reading is unavailable.", "Lettura non disponibile.") : text.substr(0,2048);
+    }
+    const auto moves=to_moves<int64_t>(u.time_to_read(book,*reader));
+    if(moves<=0 || moves>INT_MAX)return ::cwm::tr("Reading duration is outside this interface's supported range.",
+        "Durata di lettura fuori dall'intervallo supportato.");
+    return {};
+}
+inline flatbuffers::Offset<CDDA::CWM::BookInfo> export_book_info(
+        flatbuffers::FlatBufferBuilder& wire, const avatar& u, const item& book) {
+    if (!book.is_book()) return {};
+    const bool identified=u.has_identified(book.typeId());
+    std::string summary;
+    if (!identified) summary=::cwm::tr("Skim first to discover the contents. No knowledge is granted by inspection.",
+        "Sfoglia prima per scoprire il contenuto. Consultare non assegna conoscenze.");
+    else if (const auto& skill=book.type->book->skill; !skill.is_null()) {
+        summary=skill.obj().name()+" — "+::cwm::tr("theory ","teoria ")+std::to_string(u.get_knowledge_level(skill))+" ("+
+            std::to_string(u.get_skill_level_object(skill).knowledgeExperience())+"%)"+
+            "; "+::cwm::tr("book levels ","livelli del libro ")+std::to_string(book.type->book->req)+
+            "–"+std::to_string(book.type->book->level)+"\n"+
+            ::cwm::tr("Read one chapter or study until a level; native conditions apply.",
+                "Leggi un capitolo o studia fino al prossimo livello; valgono i requisiti nativi.");
+    } else summary=::cwm::tr("Known leisure book. Chapter and morale effects remain native.",
+        "Libro di svago noto. Capitoli ed effetti sul morale restano nativi.");
+    std::vector<std::string> reasons;
+    const Character* reader=u.get_book_reader(book,reasons);
+    const int moves=reader ? int(std::clamp<int64_t>(to_moves<int64_t>(u.time_to_read(book,*reader)),0,INT_MAX)) : 0;
+    return CDDA::CWM::CreateBookInfoDirect(wire,identified,moves,summary.substr(0,2048).c_str());
+}
+} // namespace cwm
