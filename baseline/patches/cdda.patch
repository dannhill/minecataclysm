+
+static volatile std::sig_atomic_t g_running = 1;
+
+static void sig_handler(int) {
+    g_running = 0;
+}
+
+int main(int argc, const char* argv[]) {
+    std::string socket_path = "/tmp/cdda_cwm.sock";
+    std::string world_name = "cwm_world";
+    std::string user_dir = "./user";
+    std::string data_dir = "";
+    int headless_ticks = 0;
+    bool headless = false;
+    bool new_character = false;
+    std::string character;
+
+    for (int i = 1; i < argc; ++i) {
+        std::string arg = argv[i];
+        if (arg == "--socket" && i + 1 < argc) {
+            socket_path = argv[++i];
+        } else if (arg == "--world" && i + 1 < argc) {
+            world_name = argv[++i];
+        } else if (arg == "--userdir" && i + 1 < argc) {
+            user_dir = argv[++i];
+        } else if (arg == "--datadir" && i + 1 < argc) {
+            data_dir = argv[++i];
+        } else if (arg == "--headless-ticks" && i + 1 < argc) {
+            headless = true;
+            try {
+                size_t consumed = 0;
+                const std::string value = argv[++i];
+                headless_ticks = std::stoi(value, &consumed);
+                if (consumed != value.size() || headless_ticks < 0) throw std::invalid_argument("ticks");
+            } catch (const std::exception&) {
+                std::cerr << "--headless-ticks requires a nonnegative integer\n";
+                return 2;
+            }
+        } else if (arg == "--character" && i + 1 < argc) {
+            character = argv[++i];
+        } else if (arg == "--new-character") {
+            new_character = true;
+        } else if (arg == "--help" || arg == "-h") {
+            std::cout << "Usage: cdda-server [options]\n"
+                      << "  --socket <path>       Unix domain socket path (default: /tmp/cdda_cwm.sock)\n"
+                      << "  --world <name>        World name to load or create (default: cwm_world)\n"
+                      << "  --userdir <path>      User directory for savegames and config (default: ./user)\n"
+                      << "  --datadir <path>      Data directory (default: auto-detected)\n"
+                      << "  --character <id>      Select a decoded save ID (or a name with --new-character)\n"
+                      << "  --new-character       Explicitly create a character; existing saves are preserved\n"
+                      << "  --headless-ticks <n>  Advance n simulation turns headlessly and save (Milestone 0.5 verification)\n"
+                      << "  --help                Show this help message\n";
+            return 0;
+        } else {
+            std::cerr << "Unknown or incomplete option: " << arg << "\n";
+            return 2;
+        }
+    }
+
+    std::signal(SIGINT, sig_handler);
+    std::signal(SIGTERM, sig_handler);
+
+    std::cout << "========================================================\n"
+              << " Cataclysm: Dark Days Ahead - Headless CWM Server v1.0\n"
+              << " Simulation & Persistence Authority\n"
+              << "========================================================\n";
+
+    // Set test_mode = true to ensure NO curses windows or escape sequences are created
+    test_mode = true;
+
+    if (data_dir.empty()) {
+        std::vector<std::string> candidates = {
+            "data",
+            "cdda/data",
+            "../data",
+            "../../data",
+            "../cdda/data",
+            "/home/dannhill/Projects/cdda-mineclonia/cdda/data"
+        };
+        try {
+            fs::path exe_dir = fs::path(argv[0]).parent_path();
+            candidates.push_back((exe_dir / ".." / "data").string());
+            candidates.push_back((exe_dir / ".." / ".." / "data").string());
+            candidates.push_back((exe_dir / ".." / ".." / "cdda" / "data").string());
+        } catch (...) {}
+
+        for (const auto& c : candidates) {
+            if (dir_exist(c) && file_exist(c + "/raw/keybindings.json")) {
+                data_dir = c;
+                break;
+            }
+        }
+    }
+
+    assure_dir_exist(user_dir);
+    PATH_INFO::init_base_path("");
+    PATH_INFO::init_user_dir(user_dir);
+    PATH_INFO::set_standard_filenames();
+
+    if (!data_dir.empty()) {
+        if (data_dir.back() != '/' && data_dir.back() != '\\') {
+            data_dir += "/";
+        }
+        PATH_INFO::set_datadir(data_dir);
+        std::cout << "[CDDA-Server] Data directory set to: " << data_dir << "\n";
+    }
+
+    assure_dir_exist(PATH_INFO::config_dir());
+    assure_dir_exist(PATH_INFO::savedir());
+    assure_dir_exist(PATH_INFO::templatedir());
+
+    setupDebug(DebugOutput::file);
+
+    get_options().init();
+    get_options().load();
+    init_colors();
+
+    g = std::make_unique<game>();
+    g->new_game = true;
+    g->load_static_data();
+
+    world_generator->set_active_world(nullptr);
+    world_generator->init();
+
+    WORLD* world = nullptr;
+    if (world_generator->has_world(world_name)) {
+        std::cout << "[CDDA-Server] Loading existing world: " << world_name << "\n";
+        world = world_generator->get_world(world_name);
+    } else {
+        std::cout << "[CDDA-Server] Creating new canonical world: " << world_name << "\n";
+        const auto& mods = world_generator->get_mod_manager().get_default_mods();
+        world = world_generator->make_new_world(world_name, mods);
+    }
+
+    if (!world) {
+        std::cerr << "[CDDA-Server] ERROR: Failed to initialize world: " << world_name << "\n";
+        return 1;
+    }
+    world_generator->set_active_world(world);
+
+    if (!new_character && !world->world_saves.empty()) {
+        const save_t* selected = nullptr;
+        for (const auto& save : world->world_saves) {
+            if ((!character.empty() && (save.decoded_name() == character || save.base_path() == character)) ||
+                (character.empty() && world->world_saves.size() == 1)) selected = &save;
+        }
+        if (!selected) {
+            std::cerr << "[CDDA-Server] Select an existing character with --character. Available save IDs:\n";
+            for (const auto& save : world->world_saves) std::cerr << "  " << save.decoded_name() << "\n";
+            return 2;
+        }
+        const save_t save = *selected;
+        g->setup();
+        if (!g->load(save)) {
+            std::cerr << "[CDDA-Server] ERROR: Canonical character load failed.\n";
+            return 1;
+        }
+        std::cout << "[CDDA-Server] Restored character: " << get_avatar().name << "\n";
+    } else {
+        if (!new_character && !character.empty()) {
+            std::cerr << "[CDDA-Server] No saved character matches --character; use --new-character to create one.\n";
+            return 2;
+        }
+        g->setup();
+        avatar& fresh = get_avatar();
+        fresh = avatar();
+        fresh.create(character_type::NOW);
+        fresh.name = character.empty() ? "Survivor" : character;
+        if (world->save_exists(save_t::from_save_id(fresh.get_save_id()))) {
+            std::cerr << "[CDDA-Server] ERROR: This character save already exists; choose another name.\n";
+            return 2;
+        }
+        if (!g->start_game()) {
+            std::cerr << "[CDDA-Server] ERROR: Failed to start canonical new game.\n";
+            return 1;
+        }
+    }
+    avatar& u = get_avatar();
+    map& here = get_map();
+
+    std::cout << "[CDDA-Server] World loaded. Player position: ("
+              << u.pos().x << ", " << u.pos().y << ", " << u.pos().z << ")\n";
+
+    cwm::CwmServer server(socket_path);
+    if (!server.start()) {
+        std::cerr << "[CDDA-Server] ERROR: Failed to bind Unix socket at " << socket_path << "\n";
+        return 1;
+    }
+    std::cout << "[CDDA-Server] CWM IPC server listening on: " << socket_path << "\n";
+
+    // Milestone 0.5 Automated acceptance mode
+    if (headless) {
+        std::cout << "[CDDA-Server] Running headless simulation for " << headless_ticks << " turns...\n";
+        for (int i = 0; i < headless_ticks && g_running; ++i) {
+            if (do_turn_with_action([&u]() { u.pause(); return true; })) {
+                // Native death/quit cleanup has already handled persistence
+                // and cleared the map buffers. Never save them a second time.
+                return (g->uquit == QUIT_DIED || g->uquit == QUIT_SUICIDE ||
+                        g->uquit == QUIT_SAVED) ? 0 : 1;
+            }
+            std::cout << "  Turn " << (i + 1) << "/" << headless_ticks << " simulated.\n";
+        }
+        std::cout << "[CDDA-Server] Saving world state...\n";
+        bool saved = server.save_world(*g);
+        std::cout << "[CDDA-Server] World save " << (saved ? "SUCCESS" : "FAILED") << "\n";
+        if (saved) std::cout << "[CDDA-Server] Headless canonical-turn run completed.\n";
+        return saved ? 0 : 1;
+    }
+
+    std::cout << "[CDDA-Server] Entering main event loop. Waiting for Luanti 3D client...\n";
+    while (g_running) {
+        server.update(u, here, *g);
+        if (server.needs_turn(u)) {
+            if (server.advance_turn(u, here, *g, []() { return g_running != 0; })) break;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+
+    if (g->uquit == QUIT_DIED || g->uquit == QUIT_SUICIDE) {
+        std::cout << "\n[CDDA-Server] Native character death lifecycle completed.\n";
+        server.stop();
+        return 0;
+    }
+    std::cout << "\n[CDDA-Server] Shutting down. Saving canonical game state...\n";
+    bool saved = server.saved_on_shutdown() || (g->uquit == QUIT_NO && server.save_world(*g));
+    std::cout << "[CDDA-Server] Final save: " << (saved ? "SUCCESS" : "FAILED") << "\n";
+    server.stop();
+
+    return saved ? 0 : 1;
+}
