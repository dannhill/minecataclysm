+TEST_CASE("cwm_avatar_status_uses_native_visible_descriptions_without_mutation", "[cwm][body]")
+{
+    clear_avatar();
+    avatar& u = get_avatar();
+    u.set_thirst(300);
+    u.set_fatigue(400);
+    u.set_pain(50);
+    u.set_stamina(u.get_stamina_max() / 3);
+    const bodypart_id arm("arm_l");
+    u.set_part_hp_cur(arm, u.get_part_hp_max(arm) / 2);
+    const int moves = u.moves;
+    const auto time = calendar::turn;
+    const auto rng = rng_get_engine();
+    const int hp = u.get_part_hp_cur(arm);
+    flatbuffers::FlatBufferBuilder fbb;
+    fbb.Finish(cwm::CwmMapExporter::export_avatar_status(fbb, u));
+    const auto* state = flatbuffers::GetRoot<CDDA::CWM::AvatarStatus>(fbb.GetBufferPointer());
+    REQUIRE(state->stamina());
+    CHECK(state->stamina()->text()->str() == get_stamina_bar(u.get_stamina(), u.get_stamina_max()).first);
+    REQUIRE(state->needs()->size() == 7);
+    CHECK(state->needs()->Get(0)->text()->str() == display::hunger_text_color(u).first);
+    CHECK(state->needs()->Get(1)->text()->str() == display::thirst_text_color(u).first);
+    CHECK(state->needs()->Get(2)->text()->str() == display::fatigue_text_color(u).first);
+    CHECK(state->needs()->Get(3)->text()->str() == display::pain_text_color(u).first);
+    bool found = false;
+    for (const auto* part : *state->body_parts()) {
+        if (part->id()->str() == "arm_l") {
+            found = true;
+            CHECK(part->health()->text()->str() == get_hp_bar(hp, u.get_part_hp_max(arm), false).first);
+        }
+    }
+    CHECK(found);
+    CHECK(u.moves == moves);
+    CHECK(calendar::turn == time);
+    CHECK(rng_get_engine() == rng);
+    CHECK(u.get_part_hp_cur(arm) == hp);
+    CHECK(u.get_thirst() == 300);
+    // Analgesia changes the displayed perception without revealing raw pain.
+    u.set_painkiller(100);
+    flatbuffers::FlatBufferBuilder relieved;
+    relieved.Finish(cwm::CwmMapExporter::export_avatar_status(relieved, u));
+    const auto* after = flatbuffers::GetRoot<CDDA::CWM::AvatarStatus>(relieved.GetBufferPointer());
+    CHECK(after->needs()->Get(3)->text()->str() == display::pain_text_color(u).first);
+    CHECK(after->needs()->Get(3)->text()->str().empty());
+    CHECK(u.get_pain() == 50);
+    CHECK(after->needs()->Get(3)->perceived_level() == 10);
+    CHECK(state->needs()->Get(3)->perceived_level() == 5);
+}
