+TEST_CASE("cwm_native_trade_stale_context_and_container_overlap_are_rejected", "[cwm][trade]") {
+    prepare_runtime();const override_option autosave("AUTOSAVE","false");auto& u=get_avatar();
+    u.wear_item(item(itype_id("backpack"),calendar::turn),false);
