+static std::vector<mod_id> recommended_mods() {
+    std::vector<mod_id> result;
+    const bool loaded = read_from_file_json(PATH_INFO::mods_dev_default(), [&](const JsonValue& input) {
+        for (JsonObject entry : input.get_array()) {
+            entry.allow_omitted_members();
+            if (entry.get_string("id") == "dev:default") entry.read("dependencies", result);
+        }
+    });
+    if (!loaded || result.empty()) throw std::runtime_error("Native developer-default mod profile is missing");
+    // Same registry validation as native mod_manager::set_default_mods.
+    result.erase(std::remove_if(result.begin(), result.end(), [](const mod_id& id) {
+        return !id.is_valid();
+    }), result.end());
+    return result;
+}
