+void finish_external_action_phase()
+{
+    external_phase_finished = true;
+}
+
+bool external_ui_active()
+{
+    return external_choice && bool( *external_choice );
+}
+
+int external_ui_choice( const std::string &text, const std::vector<std::string> &choices )
+{
+    return ( *external_choice )( text, choices );
+}
+
+bool do_turn_with_action( const std::function<bool()> &action,
+                         const external_choice_provider &choice,
+                         const std::function<bool()> &world_gate )
+{
+    struct restore_input {
+        const std::function<bool()> *previous;
+        const external_choice_provider *previous_choice;
+        const std::function<bool()> *previous_gate;
+        bool previous_finished;
+        ~restore_input() {
+            external_action = previous;
+            external_choice = previous_choice;
+            external_world_gate = previous_gate;
+            external_phase_finished = previous_finished;
+        }
+    } restore{ external_action, external_choice, external_world_gate, external_phase_finished };
+    external_action = &action;
+    external_choice = &choice;
+    external_world_gate = &world_gate;
+    external_phase_finished = false;
+    return do_turn();
+}
