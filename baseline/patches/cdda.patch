@@ -0,0 +1,245 @@
+// CDDA CWM IPC Server Implementation
+// Licensed under Apache-2.0
+
+#include "cwm_server.h"
+#include "cwm_map_exporter.h"
+#include "cwm/ipc_transport.hpp"
+#include "cwm/cwm_protocol.hpp"
+
+#include "avatar.h"
+#include "avatar_action.h"
+#include "game.h"
+#include "map.h"
+#include "action.h"
+#include "debug.h"
+#include "monster.h"
+#include "mtype.h"
+#include "field_type.h"
+
+namespace cwm {
+
+CwmServer::CwmServer(const std::string& socket_path)
+    : socket_path_(socket_path),
+      server_(std::make_unique<cdda::cwm::IpcServer>(socket_path)) {}
+
+CwmServer::~CwmServer() {
+    stop();
+}
+
+bool CwmServer::start() {
+    return server_->start();
+}
+
+void CwmServer::stop() {
+    if (server_) {
+        server_->stop();
+    }
+}
+
+bool CwmServer::has_active_client() const {
+    return server_ && server_->has_client();
+}
+
+bool CwmServer::save_world(game& g) {
+    DebugLog(D_INFO, DC_ALL) << "[CWM] Saving authoritative world state...";
+    return g.save();
+}
+
+bool CwmServer::update(avatar& u, map& m, game& g) {
+    if (!server_) return false;
+
+    // Check for incoming client connection
+    if (server_->poll_accept(0)) {
+        DebugLog(D_INFO, DC_ALL) << "[CWM] Client connected via Unix socket.";
+        snapshot_sent_ = false;
+    }
+
+    if (!server_->has_client()) {
+        return true;
+    }
+
+    // Read incoming messages
+    std::vector<std::vector<uint8_t>> incoming_frames;
+    bool client_alive = server_->client()->poll_and_receive(incoming_frames, 0);
+    if (!client_alive) {
+        DebugLog(D_WARNING, DC_ALL) << "[CWM] Client disconnected.";
+        snapshot_sent_ = false;
+        return true;
+    }
+
+    for (const auto& frame : incoming_frames) {
+        handle_client_message(frame.data(), frame.size(), u, m, g);
+    }
+
+    // If client is connected and hasn't received snapshot yet, send it
+    if (!snapshot_sent_) {
+        auto snap = CwmMapExporter::export_world_snapshot(sequence_counter_++, world_revision_, u, m, g, true);
+        server_->client()->send_message(snap.data(), snap.size());
+        snapshot_sent_ = true;
+        DebugLog(D_INFO, DC_ALL) << "[CWM] Initial WorldSnapshot sent to client (revision: " << world_revision_ << ")";
+    }
+
+    return true;
+}
+
+void CwmServer::handle_client_message(
+    const uint8_t* data,
+    size_t size,
+    avatar& u,
+    map& m,
+    game& g
+) {
+    if (!cdda::cwm::MessageVerifier::verify(data, size)) {
+        DebugLog(D_WARNING, DC_ALL) << "[CWM] Malformed message rejected from client.";
+        return;
+    }
+
+    const auto* msg = cdda::cwm::MessageVerifier::parse(data, size);
+    if (!msg) return;
+
+    cdda::cwm::MessageBuilder reply_builder(sequence_counter_++, world_revision_);
+
+    switch (msg->payload_type()) {
+        case CDDA::CWM::Payload::HelloRequest: {
+            const auto* req = msg->payload_as_HelloRequest();
+            std::string build_id = req && req->build_id() ? req->build_id()->str() : "unknown";
+            DebugLog(D_INFO, DC_ALL) << "[CWM] Handshake received from client build: " << build_id;
+
+            auto resp = reply_builder.build_hello_response(true, "cdda-server-0.H");
+            server_->client()->send_message(resp.data(), resp.size());
+
+            // Ensure at least one living monster exists in reality bubble for visual synchronization
+            auto mons = g.all_monsters();
+            if (mons.begin() == mons.end()) {
+                g.place_critter_at(mtype_id("mon_zombie"), u.pos() + tripoint(4, 4, 0));
+            }
+
+            // Push fresh snapshot on handshake
+            auto snap = CwmMapExporter::export_world_snapshot(sequence_counter_++, world_revision_, u, m, g, true);
+            server_->client()->send_message(snap.data(), snap.size());
+            snapshot_sent_ = true;
+            break;
+        }
+
+        case CDDA::CWM::Payload::Heartbeat: {
+            auto ack = reply_builder.finish_message(
+                CDDA::CWM::Payload::HeartbeatAck,
+                CDDA::CWM::CreateHeartbeatAck(reply_builder.builder(), cdda::cwm::current_time_ms(), cdda::cwm::current_time_ms()).Union()
+            );
+            server_->client()->send_message(ack.data(), ack.size());
+            break;
+        }
+
+        case CDDA::CWM::Payload::MoveRequest: {
+            const auto* req = msg->payload_as_MoveRequest();
+            if (!req) break;
+
+            point delta = point_zero;
+            switch (req->direction()) {
+                case CDDA::CWM::MoveDirection::NORTH:     delta = point(0, -1); break;
+                case CDDA::CWM::MoveDirection::NORTHEAST: delta = point(1, -1); break;
+                case CDDA::CWM::MoveDirection::EAST:      delta = point(1, 0); break;
+                case CDDA::CWM::MoveDirection::SOUTHEAST: delta = point(1, 1); break;
+                case CDDA::CWM::MoveDirection::SOUTH:     delta = point(0, 1); break;
+                case CDDA::CWM::MoveDirection::SOUTHWEST: delta = point(-1, 1); break;
+                case CDDA::CWM::MoveDirection::WEST:      delta = point(-1, 0); break;
+                case CDDA::CWM::MoveDirection::NORTHWEST: delta = point(-1, -1); break;
+                default: break;
+            }
+
+            bool moved = false;
+            if (req->direction() == CDDA::CWM::MoveDirection::NONE) {
+                u.moves -= 100;
+                u.action_taken();
+                moved = true;
+                world_revision_++;
+            } else if (delta != point_zero) {
+                moved = avatar_action::move(u, m, delta);
+                if (moved) {
+                    u.action_taken();
+                    world_revision_++;
+                }
+            }
+
+            // Ack command
+            auto ack = reply_builder.build_command_ack(req->command_id(), moved);
+            server_->client()->send_message(ack.data(), ack.size());
+
+            // If player took an action and moves depleted, simulate world step
+            if (moved && u.moves <= 0) {
+                m.process_fields();
+                m.process_items();
+                u.process_turn();
+                u.moves += u.get_speed();
+
+                // Authoritative monster turn stepping & AI
+                for (monster& critter : g.all_monsters()) {
+                    if (!critter.is_dead()) {
+                        critter.process_turn();
+                        while (critter.moves > 0 && !critter.is_dead()) {
+                            critter.plan();
+                            critter.move();
+                            m.creature_in_field(critter);
+                        }
+                    }
+                }
+                g.cleanup_dead();
+                world_revision_++;
+            }
+
+            // Send updated snapshot reflecting movements
+            // CDDA shifts the reality bubble when the player nears its edge; local
+            // coordinates then jump by whole submaps. Resend terrain in that case.
+            const tripoint sub = m.get_abs_sub().raw();
+            const bool bubble_shifted = !last_sub_valid_ || sub.x != last_sub_x_ ||
+                                        sub.y != last_sub_y_ || sub.z != last_sub_z_;
+            last_sub_x_ = sub.x; last_sub_y_ = sub.y; last_sub_z_ = sub.z;
+            last_sub_valid_ = true;
+            auto snap = CwmMapExporter::export_world_snapshot(sequence_counter_++, world_revision_, u, m, g, bubble_shifted);
+            server_->client()->send_message(snap.data(), snap.size());
+            break;
+        }
+
+        case CDDA::CWM::Payload::InteractRequest: {
+            const auto* req = msg->payload_as_InteractRequest();
+            if (!req || !req->target_coord()) break;
+
+            tripoint target(req->target_coord()->x(), req->target_coord()->y(), req->target_coord()->z());
+            bool success = false;
+
+            if (req->action() == CDDA::CWM::InteractAction::OPEN) {
+                success = m.open_door(u, target, true, false);
+            } else if (req->action() == CDDA::CWM::InteractAction::CLOSE) {
+                success = m.close_door(target, true, false);
+            } else if (req->action() == CDDA::CWM::InteractAction::USE) {
+                m.add_field(target, fd_fire, 2);
+                success = true;
+            }
+
+            if (success) {
+                u.action_taken();
+                world_revision_++;
+            }
+
+            auto ack = reply_builder.build_command_ack(req->command_id(), success);
+            server_->client()->send_message(ack.data(), ack.size());
+
+            if (success) {
+                if (req->action() == CDDA::CWM::InteractAction::USE) {
+                    auto snap = CwmMapExporter::export_world_snapshot(sequence_counter_++, world_revision_, u, m, g, true);
+                    server_->client()->send_message(snap.data(), snap.size());
+                } else {
+                    auto tile_delta = CwmMapExporter::export_tile_delta(sequence_counter_++, world_revision_, target, m);
+                    server_->client()->send_message(tile_delta.data(), tile_delta.size());
+                }
+            }
+            break;
+        }
+
+        default:
+            DebugLog(D_INFO, DC_ALL) << "[CWM] Unhandled message payload type: " << static_cast<int>(msg->payload_type());
+            break;
+    }
+}
+
+} // namespace cwm
