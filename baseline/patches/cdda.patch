+namespace {
+constexpr uint64_t monster_namespace = uint64_t(1) << 62;
+constexpr const char* monster_identity_key = "cwm_monster_id";
+
+int stored_monster_id(const monster& critter) {
+    const std::string stored = critter.get_value(monster_identity_key);
+    int id = 0;
+    const auto parsed = std::from_chars(stored.data(), stored.data() + stored.size(), id);
+    return parsed.ec == std::errc() && parsed.ptr == stored.data() + stored.size() && id > 0 ? id : 0;
+}
+
+uint64_t persistent_monster_id(monster& critter, game& g, std::set<uint64_t>& used,
+                              const std::set<uint64_t>& reserved) {
+    // Creature::values is canonical native metadata, retained even by the
+    // pristine reader/writer. The world's native character allocator is shared
+    // by avatars and NPCs already; consume it without consuming gameplay RNG.
+    int native_id = stored_monster_id(critter);
+    if (!native_id || used.count(monster_namespace | uint64_t(native_id))) {
+        // Legacy saves need a first identity. A simultaneous native copy with
+        // copied metadata needs a new identity, rather than aliasing its owner.
+        do {
+            native_id = g.assign_npc_id().get_value();
+            if (native_id <= 0) throw std::runtime_error("Native actor identity allocator exhausted");
+        } while (used.count(monster_namespace | uint64_t(native_id)) ||
+                 reserved.count(monster_namespace | uint64_t(native_id)));
+        critter.set_value(monster_identity_key, std::to_string(native_id));
+    }
+    const uint64_t id = monster_namespace | uint64_t(native_id);
+    used.insert(id);
+    return id;
+}
+} // namespace
+
+uint64_t CwmMapExporter::monster_entity_id(const monster& critter) {
+    const int id = stored_monster_id(critter);
+    return id ? monster_namespace | uint64_t(id) : 0;
+}
+
+namespace {
+bool presentation_enabled = false;
+uint64_t cue_id = 0;
+std::vector<PresentationCue> pending_cues;
+void append_cue(CueKind kind, uint64_t actor, std::string text, std::string category = {}, int volume = 0) {
+    if (pending_cues.size() >= 128) return; // Drop presentation, never block gameplay.
+    pending_cues.push_back({++cue_id, kind, actor, std::move(text), std::move(category), std::clamp(volume, 0, 200)});
+}
+}
+void enable_presentation(bool enabled) {
+    presentation_enabled = enabled;
+    if (!enabled) pending_cues.clear();
+}
+void record_presentation(CueKind kind, const Creature& actor) {
+    if (!presentation_enabled) return;
+    const avatar& viewer = get_avatar();
+    if (!actor.is_avatar() && !viewer.sees(actor)) return;
+    uint64_t id = actor.is_avatar() ? 1 : 0;
+    if (const auto* mon = actor.as_monster()) {
+        if (mon->is_hallucination()) return;
+        id = CwmMapExporter::monster_entity_id(*mon);
+    } else if (const auto* person = actor.as_character()) {
+        if (!actor.is_avatar()) id = (uint64_t(1) << 63) | uint64_t(person->getID().get_value());
+    }
+    if (!id) return; // Newly spawned, unpublished identities are not invented here.
+    std::string text;
+    if (kind == CueKind::Death) text = actor.disp_name() + ::cwm::tr(" dies.", " muore.");
+    append_cue(kind, id, text);
+}
+void record_heard_sound(const std::string& description, const std::string& category, int volume) {
+    if (presentation_enabled) append_cue(CueKind::Sound, 0, description, category, volume);
+}
+std::vector<PresentationCue> drain_presentation() {
+    std::vector<PresentationCue> result;
+    result.swap(pending_cues);
+    return result;
+}
