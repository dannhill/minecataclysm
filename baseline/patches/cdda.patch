+// Explicit disposable comparison fixture. Uses native terrain/map/save APIs;
+// never runs on an existing world or as part of ordinary startup.
+static void create_terrain_comparison(avatar& u, map& m) {
+    g->clear_zombies();
+    std::vector<character_id> npcs;
+    for (const npc& person : g->all_npcs()) npcs.push_back(person.getID());
+    for (const auto& id : npcs) g->remove_npc(id);
+    const auto vehicles = m.get_vehicles();
+    for (const auto& vehicle : vehicles) m.destroy_vehicle(vehicle.v);
+    for (int y = 0; y < 132; ++y) for (int x = 0; x < 132; ++x) {
+        for (int z = -1; z <= 1; ++z) {
+            const tripoint p(x, y, z);
+            m.ter_set(p, ter_str_id(z < 0 ? "t_rock" : z == 0 ? "t_grass" : "t_open_air"));
+            m.furn_set(p, furn_str_id("f_null"));
+            m.i_clear(p);
+            m.clear_fields(p);
+            m.remove_trap(p);
+        }
+        const tripoint p(x, y, 0);
+        uint32_t patch = static_cast<uint32_t>(x / 5) * 0x9e3779b9u ^
+                         static_cast<uint32_t>(y / 5) * 0x85ebca6bu;
+        patch ^= patch >> 16;
+        uint32_t scatter = static_cast<uint32_t>(x) * 0x45d9f3bu ^
+                           static_cast<uint32_t>(y) * 0x119de1f3u;
+        scatter ^= scatter >> 16;
+        // Four compact areas around the starting plaza (60,60).
+        if (x < 57 && y < 57) {
+            if (x % 5 == static_cast<int>(patch % 3) + 1 &&
+                y % 5 == static_cast<int>((patch >> 4) % 3) + 1)
+                m.ter_set(p, ter_str_id("t_tree"));
+            else if (scatter % 17 == 0) m.ter_set(p, ter_str_id("t_shrub"));
+        } else if (x > 63 && y < 57) {
+            if (scatter % 5 == 0) m.ter_set(p, ter_str_id("t_grass_long"));
+            else if (scatter % 29 == 0) m.ter_set(p, ter_str_id("t_dirt"));
+        } else if (x > 63 && y > 63) {
+            m.ter_set(p, ter_str_id(x > 75 ? "t_water_sh" : "t_sand"));
+        } else if (x < 57 && y > 63) {
+            m.ter_set(p, ter_str_id("t_pavement"));
+            if (y < 67 || x > 53) m.ter_set(p, ter_str_id("t_sidewalk"));
+        }
+        if ((x >= 57 && x <= 63) || (y >= 57 && y <= 63))
+            m.ter_set(p, ter_str_id("t_sidewalk"));
+    }
+    // One recognizable house, with native windows, door, furniture and roof.
+    for (int y = 71; y <= 81; ++y) for (int x = 41; x <= 51; ++x) {
+        const bool edge = x == 41 || x == 51 || y == 71 || y == 81;
+        m.ter_set(tripoint(x,y,0), ter_str_id(edge ? "t_wall" : "t_floor"));
+        m.ter_set(tripoint(x,y,1), ter_str_id("t_wood_treated_roof"));
+    }
+    m.ter_set(tripoint(46,71,0), ter_str_id("t_door_c"));
+    m.ter_set(tripoint(43,71,0), ter_str_id("t_window"));
+    m.ter_set(tripoint(49,71,0), ter_str_id("t_window"));
+    m.furn_set(tripoint(44,75,0), furn_str_id("f_table"));
+    u.setpos(tripoint(60,60,0));
+    calendar::turn = calendar::turn_zero + 36_hours;
+    get_weather().weather_override = weather_type_id("clear");
+    get_weather().update_weather();
+    m.invalidate_map_cache(0);
+    m.build_map_cache(0);
+    if (!g->save()) throw std::runtime_error("Terrain comparison fixture could not be saved");
+    std::cout << "[CDDA-Server] Terrain comparison ready: plaza 60,60; NW forest, NE field, SW street, SE shore.\n";
+}
