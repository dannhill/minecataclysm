diff --git a/src/cwm/cwm_status_gauges.h b/src/cwm/cwm_status_gauges.h
new file mode 100644
index 0000000..527a652
--- /dev/null
+++ b/src/cwm/cwm_status_gauges.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <array>
+#include <utility>
+#include "character.h"
+#include "effect.h"
+
+namespace cwm {
+// Ordinal presentation levels of the *same categories* as display.cpp. No
+// raw nutrition, unperceived pain, diagnosis, or new gameplay thresholds.
+inline int hunger_perceived_level(const Character& u)
+{
+    if (!u.needs_food()) return 10;
+    static const std::array<std::pair<efftype_id, int>, 9> states{{
+        {efftype_id("hunger_engorged"), 10}, {efftype_id("hunger_full"), 10},
+        {efftype_id("hunger_satisfied"), 10}, {efftype_id("hunger_blank"), 8},
+        {efftype_id("hunger_hungry"), 6}, {efftype_id("hunger_very_hungry"), 4},
+        {efftype_id("hunger_near_starving"), 1}, {efftype_id("hunger_starving"), 0},
+        {efftype_id("hunger_famished"), 2}
+    }};
+    for (const auto& state : states)
+        if (u.has_effect(state.first)) return state.second;
+    return -1; // The native UI says ERROR, so do not invent a healthy value.
+}
+inline int thirst_perceived_level(const Character& u)
+{
+    const int thirst = u.get_instant_thirst(); // Includes immediate stomach water.
+    return thirst > 520 ? 0 : thirst > 240 ? 1 : thirst > 80 ? 3 :
+        thirst > 40 ? 5 : thirst < -60 ? 10 : thirst < -20 ? 9 : thirst < 0 ? 8 : 7;
+}
+inline int fatigue_perceived_level(const Character& u)
+{
+    const int fatigue = u.get_fatigue();
+    return fatigue >= fatigue_levels::EXHAUSTED ? 0 :
+        fatigue >= fatigue_levels::DEAD_TIRED ? 3 :
+        fatigue >= fatigue_levels::TIRED ? 6 : 10;
+}
+inline int pain_perceived_level(const Character& u)
+{
+    const int pain = u.get_perceived_pain(); // Analgesia, never get_pain().
+    return pain <= 0 ? 10 : pain > 70 ? 0 : 10 - (pain + 9) / 10;
+}
+} // namespace cwm
