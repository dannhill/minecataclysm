+TEST_CASE("cwm_xy_rebase_keeps_projection_incremental", "[cwm][projection][rebase]")
+{
+    using namespace cdda::cwm;
+
+    clear_avatar();
+    clear_map();
+    clear_creatures();
+
+    map& m = get_map();
+    avatar& u = get_avatar();
+    u.setpos(tripoint(60, 60, 0));
+
+    cwm::CwmMapExporter::ProjectionCache cache;
+
+    auto first = cwm::CwmMapExporter::export_world_snapshot(
+        1, 1, u, m, *g, true, &cache);
+    const auto* initial =
+        CDDA::CWM::GetCwmMessage(first.data())->payload_as_WorldSnapshot();
+
+    const tripoint before = m.get_abs_sub().raw();
+
+    m.shift(point_east);
+
+    const tripoint after = m.get_abs_sub().raw();
+    auto rebased = cwm::CwmMapExporter::export_world_snapshot(
+        2, 2, u, m, *g, false, &cache);
+
+    m.shift(point_west);
+
+    const auto* world =
+        CDDA::CWM::GetCwmMessage(rebased.data())->payload_as_WorldSnapshot();
+
+    REQUIRE(initial);
+    REQUIRE(initial->full());
+    REQUIRE(initial->chunks());
+    CHECK(initial->chunks()->size() == 363);
+
+    CHECK(after.x == before.x + 1);
+    CHECK(after.y == before.y);
+
+    REQUIRE(world);
+    CHECK_FALSE(world->full());
+    CHECK(world->chunks() == nullptr);
+    REQUIRE(world->tiles());
+
+    constexpr size_t entering_strip = 3 * 12 * 132;
+    size_t entering = 0;
+    size_t overlap = 0;
+    int min_x = 9999, max_x = -9999;
+    for (const auto* delta : *world->tiles()) {
+        const int x = delta->coord()->x();
+        min_x = std::min(min_x, x);
+        max_x = std::max(max_x, x);
+        if (x >= 120)
+            ++entering;
+        else
+            ++overlap;
+    }
+    INFO("tiles=" << world->tiles()->size()
+         << " entering=" << entering
+         << " overlap=" << overlap
+         << " min_x=" << min_x
+         << " max_x=" << max_x);
+    CHECK(world->tiles()->size() == entering_strip);
+}
