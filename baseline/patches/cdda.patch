@@ -0,0 +1,76 @@
+// CDDA CWM IPC Server
+// Licensed under Apache-2.0
+#pragma once
+
+#include <string>
+#include <memory>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <optional>
+#include "cwm_map_exporter.h"
+
+class avatar;
+class map;
+class game;
+
+namespace cdda::cwm {
+class IpcServer;
+}
+
+namespace cwm {
+
+class CwmServer {
+public:
+    explicit CwmServer(const std::string& socket_path);
+    ~CwmServer();
+
+    bool start();
+    void stop();
+
+    // Ticks server: handles connections, processes commands, advances turns
+    bool update(avatar& u, map& m, game& g);
+    bool needs_turn(const avatar& u) const;
+    bool advance_turn(avatar& u, map& m, game& g, const std::function<bool()>& keep_running);
+    bool saved_on_shutdown() const { return saved_on_shutdown_; }
+
+    bool save_world(game& g);
+
+    uint64_t world_revision() const { return world_revision_; }
+    bool has_active_client() const;
+
+private:
+    std::string socket_path_;
+    std::unique_ptr<cdda::cwm::IpcServer> server_;
+    uint64_t sequence_counter_{1};
+    uint64_t world_revision_{1};
+    bool snapshot_sent_{false};
+    struct Command {
+        uint64_t id;
+        bool move;
+        int action;
+        int x{0}, y{0}, z{0}; // absolute CDDA coordinates, captured on receipt
+    };
+    struct Result {
+        uint64_t id;
+        bool accepted;
+        std::string error;
+    };
+    std::deque<Command> commands_;
+    std::optional<Result> result_;
+    bool simulation_started_{false};
+    bool saved_on_shutdown_{false};
+    CwmMapExporter::ProjectionCache projection_cache_;
+    // Reality-bubble origin (absolute submap) last sent to the client.
+    // When CDDA shifts the bubble, local coordinates change and terrain must be resent.
+    int last_sub_x_{0}, last_sub_y_{0}, last_sub_z_{0};
+    bool last_sub_valid_{false};
+
+    void send_state(avatar& u, map& m, game& g, bool full = false);
+    void send_result(const Result& result, avatar& u, map& m, game& g);
+    bool execute(const Command& command, avatar& u, map& m, game& g);
+
+    void handle_client_message(const uint8_t* data, size_t size, avatar& u, map& m, game& g);
+};
+
+} // namespace cwm
diff --git a/src/safe_mode_actions.h b/src/safe_mode_actions.h
new file mode 100644
index 0000000..f5a7c0a
