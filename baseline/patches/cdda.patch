diff --git a/src/cwm/cwm_missions.h b/src/cwm/cwm_missions.h
new file mode 100644
index 0000000..e328e05
--- /dev/null
+++ b/src/cwm/cwm_missions.h
@@ -0,0 +1,107 @@
+#pragma once
+#include "avatar.h"
+#include "calendar.h"
+#include "game.h"
+#include "mission.h"
+#include "npc.h"
+#include "output.h"
+#include "cwm/cwm_protocol.hpp"
+#include "cwm/product_language.hpp"
+#include <set>
+
+namespace cwm {
+// A journal projects only the avatar's three native history lists. It never
+// calls process/is_complete/goal_condition or the general random tag parser.
+class MissionJournal {
+    uint64_t next_view_=1,view_=0;
+    int tracked_=-1;
+    std::set<int> active_;
+    static std::string bounded(std::string value,size_t bound,bool& limited) {
+        for(char& c:value)if(!c){c=' ';limited=true;}
+        if(value.size()>bound) {
+            size_t end=bound;
+            while(end && (static_cast<unsigned char>(value[end])&0xC0)==0x80)--end;
+            value.resize(end);limited=true;
+        }
+        return value;
+    }
+public:
+    static int tracked(const avatar& u) {return u.get_active_mission()?u.get_active_mission()->get_id():-1;}
+    void clear() {view_=0;active_.clear();tracked_=-1;}
+    uint64_t view() const {return view_;}
+    static std::string text(std::string source,const avatar& u,const std::string& giver,bool& limited,size_t bound=16384) {
+        source=remove_color_tags(source);
+        std::string result;
+        for(size_t at=0;at<source.size();) {
+            if(source[at]!='<') {result+=source[at++];continue;}
+            auto end=source.find('>',at);
+            if(end==std::string::npos) {result+=source.substr(at);break;}
+            const auto token=source.substr(at,end-at+1);
+            if(token=="<u_name>")result+=u.get_name();
+            else if(token=="<npc_name>")result+=giver.empty()?::cwm::tr("Quest giver"):giver;
+            else {result+=::cwm::tr("[dynamic detail: ask the quest giver]");limited=true;}
+            at=end+1;
+        }
+        return bounded(std::move(result),bound,limited);
+    }
+    static std::string objective(mission_goal goal) {
+        switch(goal) {
+            case MGOAL_GO_TO:case MGOAL_GO_TO_TYPE:return ::cwm::tr("Reach the mission destination.");
+            case MGOAL_FIND_ITEM:case MGOAL_FIND_ANY_ITEM:case MGOAL_FIND_ITEM_GROUP:return ::cwm::tr("Find the requested items.");
+            case MGOAL_FIND_MONSTER:return ::cwm::tr("Find and retrieve the mission creature.");
+            case MGOAL_FIND_NPC:return ::cwm::tr("Find the mission character.");
+            case MGOAL_TALK_TO_NPC:return ::cwm::tr("Speak with the mission character.");
+            case MGOAL_RECRUIT_NPC:case MGOAL_RECRUIT_NPC_CLASS:return ::cwm::tr("Recruit the requested companion.");
+            case MGOAL_ASSASSINATE:case MGOAL_KILL_MONSTER:case MGOAL_KILL_MONSTERS:case MGOAL_KILL_MONSTER_TYPE:case MGOAL_KILL_MONSTER_SPEC:case MGOAL_KILL_NEMESIS:return ::cwm::tr("Defeat the mission targets.");
+            case MGOAL_COMPUTER_TOGGLE:return ::cwm::tr("Activate the mission terminal.");
+            default:return ::cwm::tr("Follow the native mission instructions; discuss progress with the quest giver.");
+        }
+    }
+    std::vector<uint8_t> query(const avatar& u,game& g,uint64_t query,cdda::cwm::MessageBuilder& wire,const std::string& error={}) {
+        clear();auto& f=wire.builder();
+        std::vector<flatbuffers::Offset<CDDA::CWM::MissionEntry>> rows;
+        bool truncated=false;
+        if(error.empty()) {
+            view_=next_view_++;tracked_=tracked(u);std::set<int> ids;
+            const std::vector<std::vector<mission*>> lists{u.get_active_missions(),u.get_completed_missions(),u.get_failed_missions()};
+            for(unsigned state=0;state<lists.size();++state)for(const mission* m:lists[state]) {
+                if(!m || m->get_id()<0 || !ids.insert(m->get_id()).second)continue;
+                if(rows.size()==2048){truncated=true;continue;}
+                bool limited=false;
+                std::string giver;
+                if(m->get_npc_id().is_valid())if(const auto* person=g.find_npc(m->get_npc_id()))giver=person->disp_name();
+                giver=bounded(remove_color_tags(giver),4096,limited);
+                const auto title=text(m->name(),u,giver,limited,4096);
+                const auto description=text(m->get_description(),u,giver,limited);
+                std::string deadline,remaining,target_text;
+                if(m->has_deadline()) {
+                    deadline=to_string(m->get_deadline());
+                    if(state!=1) {
+                        const auto time=m->get_deadline()-calendar::turn;
+                        remaining=time<=0_turns ? ::cwm::tr("None!") : u.has_watch()?to_string(time):to_string_approx(time);
+                    }
+                }
+                std::optional<CDDA::CWM::Coord3i> target;
+                if(m->has_target()) {
+                    const auto p=m->get_target();target=CDDA::CWM::Coord3i(p.x(),p.y(),p.z());
+                    target_text=::cwm::tr("Target: ")+p.to_string()+"  "+::cwm::tr("You: ")+u.global_omt_location().to_string();
+                }
+                if(state==0)active_.insert(m->get_id());
+                rows.push_back(CDDA::CWM::CreateMissionEntry(f,m->get_id(),static_cast<CDDA::CWM::MissionState>(state),
+                    state==0 && m->get_id()==tracked_,f.CreateString(title.empty()?::cwm::tr("Unnamed mission"):title),
+                    f.CreateString(description),f.CreateString(objective(m->get_type().goal)),f.CreateString(giver),
+                    f.CreateString(deadline),f.CreateString(remaining),target?&*target:nullptr,f.CreateString(target_text),limited));
+            }
+        }
+        return wire.finish_message(CDDA::CWM::Payload::MissionView,CDDA::CWM::CreateMissionView(f,query,view_,tracked_,f.CreateVector(rows),truncated,f.CreateString(error)).Union());
+    }
+    std::string track(avatar& u,uint64_t view,int id,int expected) {
+        if(!view || view!=view_ || !active_.count(id))return ::cwm::tr("Journal expired: refresh the mission list.");
+        if(expected!=tracked_ || expected!=tracked(u))return ::cwm::tr("Tracked mission changed: refresh the journal.");
+        for(mission* m:u.get_active_missions())if(m && m->get_id()==id && m->in_progress() && m->get_assigned_player_id()==u.getID()) {
+            u.set_active_mission(*m);clear();return {};
+        }
+        return ::cwm::tr("Mission is no longer active or assigned to this character.");
+    }
+};
+}
