+    const tripoint start = u.pos();
+    const auto absolute_start = m.getglobal( start );
+    m.ter_set( start, ter_str_id( "t_floor" ) );
+    m.ter_set( start + tripoint_north, ter_str_id( "t_water_dp" ) );
+    item matches( itype_id( "matches" ), calendar::turn );
+    REQUIRE( u.wield( matches ) );
+    u.set_skill_level( skill_id( "swimming" ), 10 );
+    u.moves = 1000; // Wielding has already paid its native cost before the action under test.
+    int answer = 1;
+    SECTION( "decline preserves character and vulnerable item" ) { answer = 1; }
+    SECTION( "confirm executes native swimming and water damage" ) { answer = 0; }
+    int prompts = 0;
+    REQUIRE_FALSE( do_turn_with_action( [&]() {
+        const int before = u.moves;
+        REQUIRE( avatar_action::move( u, m, tripoint_north ) );
+        CHECK( m.getglobal( u.pos() ) ==
+               ( answer == 0 ? absolute_start + tripoint_north : absolute_start ) );
+        CHECK( u.get_wielded_item()->is_broken() == ( answer == 0 ) );
+        if( answer == 1 ) { CHECK( u.moves == before ); }
+        else { CHECK( u.moves < before ); }
+        u.pause();
+        return true;
+    }, [&]( const std::string &text, const std::vector<std::string> &choices ) {
+        ++prompts;
+        CHECK( text.find( "waterproof" ) != std::string::npos );
+        CHECK( text.find( "matchbook" ) != std::string::npos );
+        REQUIRE( choices.size() == 2 );
+        CHECK( choices.back() == "No" );
+        return answer;
+    } ) );
+    CHECK( prompts == 1 );
+    CHECK_FALSE( external_ui_active() );
