+++ b/src/cwm/cwm_reading.h
@@ -0,0 +1,52 @@
+#pragma once
+#include "avatar.h"
+#include "item.h"
+#include "itype.h"
+#include "skill.h"
+#include "output.h"
+#include "cwm/cwm_protocol.hpp"
