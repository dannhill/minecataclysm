+    cwm::CwmServerTestAccess::interrupt_crafting(server,token,2);
+    CHECK_FALSE(u.activity); REQUIRE(work); CHECK(work->item_counter==progress);
+    cwm::CwmServerTestAccess::interrupt_crafting(server,token,2); // Deduplication cannot remove/refund work.
+    REQUIRE(work); CHECK(work->item_counter==progress);
+    SECTION("resume the carried native work") {}
+    SECTION("resume the same native work on a nearby surface") {
+        REQUIRE(u.get_wielded_item()==work);
+        item moved=u.remove_weapon(); get_map().add_item(u.pos(),moved);
+        u.invalidate_crafting_inventory();
