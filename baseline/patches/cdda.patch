+// Reading has native participant and study-mode choices. Export just this
+// menu, without constructing curses windows or changing its return values.
+static void reading_menu_query( uilist &menu )
+{
+    if( !external_ui_active() ) { menu.query( true ); return; }
+    std::vector<std::string> labels;
+    std::vector<int> returns;
+    std::string text = menu.title + "\n" + menu.text;
+    for( size_t i = 0; i < menu.entries.size(); ++i ) {
+        const auto &entry = menu.entries[i];
+        if( entry.enabled ) {
+            labels.push_back( remove_color_tags( entry.txt + ( entry.desc.empty() ? "" : "\n" + entry.desc ) ) );
+            returns.push_back( entry.retval == -1 ? int( i ) : entry.retval );
+        } else if( !entry.txt.empty() ) {
+            text += "\n" + entry.txt;
+        }
+    }
+    labels.push_back( _( "Cancel" ) );
+    const int choice = external_ui_choice( remove_color_tags( text ), labels );
+    menu.ret = choice >= 0 && size_t( choice ) < returns.size() ? returns[choice] : UILIST_CANCEL;
+}
