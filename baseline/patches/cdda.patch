+namespace cwm {
+// Resolve only existing native hostile/perceived identities. The camera sends
+// neither coordinates nor a claimed distance/damage/line of sight.
+inline Creature* perceived_hostile(uint64_t id, avatar& u, game& g) {
+    Creature* result = nullptr;
+    if (id & (uint64_t(1)<<63)) {
+        for (npc& n : g.all_npcs()) if (((uint64_t(1)<<63)|uint64_t(n.getID().get_value())) == id && n.is_enemy()) result=&n;
+    } else if (id & (uint64_t(1)<<62)) {
+        for (monster& m : g.all_monsters()) if (CwmMapExporter::monster_entity_id(m)==id && !m.is_hallucination() &&
+            m.friendly==0 && !m.has_effect(efftype_id("pet")) && m.attitude_to(u)==Creature::Attitude::HOSTILE) result=&m;
+    }
+    return result && !result->is_dead_state() && get_map().inbounds(result->pos()) && u.sees(*result) ? result : nullptr;
+}
+inline std::string ranged_weapon_error(avatar& u, int action) {
+    const auto w=u.get_wielded_item();
+    if (!w || !w->is_gun()) return "Impugna prima un'arma da fuoco.";
+    if (u.activity) return "Interrompi o concludi l'attivita prima di agire.";
+    if (u.is_mounted() || u.in_vehicle) return "Armi montate/veicoli: interfaccia successiva.";
+    const auto mode=w->gun_current_mode();
+    if (!mode || mode.melee() || !mode->is_gun() || mode.qty <= 0) return "Modalita non balistica: interfaccia successiva.";
+    if (mode->has_flag(flag_RELOAD_AND_SHOOT)) return "Archi e armi carica-e-spara: interfaccia successiva.";
+    if (action==2) return w->is_reloadable() && u.rate_action_reload(*w)==hint_rating::good ? "" : "Arma non ricaricabile o gia piena.";
+    if (w->ammo_data() && !w->ammo_types().count(w->loaded_ammo().ammo_type())) return "Munizioni caricate incompatibili.";
+    std::vector<std::string> messages;
+    const bool common=gunmode_checks_common(u,get_map(),messages,mode);
+    const bool weapon=gunmode_checks_weapon(u,get_map(),messages,mode);
+    if (common && weapon) return "";
+    std::string why;
+    for (const auto& m:messages) why+=remove_color_tags(m)+"\n";
+    return why.empty() ? "Arma non pronta a sparare." : why;
+}
+class RangedSelection {
+    item_location weapon_;
+    std::string mode_;
+    uint64_t token_{0}, next_{1};
+    uint64_t aimed_target_{0};
+public:
+    void clear() { weapon_={};mode_.clear();token_=0;aimed_target_=0; }
+    void end_aim() { aimed_target_=0; }
+    uint64_t refresh(avatar& u) {
+        const auto w=u.get_wielded_item();
+        if (!w || !w->is_gun()) { clear();return 0; }
+        const auto mode=w->gun_current_mode();
+        const std::string id=mode ? w->gun_get_mode_id().str() : "";
+        if (!token_ || weapon_!=w || mode_!=id) { weapon_=w;mode_=id;token_=next_++;aimed_target_=0; }
+        return token_;
+    }
+    std::string validate(avatar& u, game& g, uint64_t weapon, uint64_t target, int action) {
+        if (action<0 || action>2 || !weapon || weapon!=refresh(u)) return "Arma o modalita cambiata; ripunta il bersaglio.";
+        auto why=ranged_weapon_error(u,action);if (!why.empty()) return why;
+        if (action==2) return target ? "La ricarica non richiede un bersaglio." : "";
+        const auto* t=perceived_hostile(target,u,g);
+        const auto gun=u.get_wielded_item()->gun_current_mode();
+        if (!t || rl_dist(u.pos(),t->pos())>gun->gun_range(&u)) return "Bersaglio non percepito, non ostile o fuori portata.";
+        return "";
+    }
+    bool maintaining_aim(avatar& u, game& g) {
+        if (!aimed_target_ || u.recoil >= MAX_RECOIL || !validate(u,g,token_,aimed_target_,0).empty()) {
+            end_aim();return false;
+        }
+        return true;
+    }
+    bool execute(avatar& u, game& g, uint64_t weapon, uint64_t target, int action) {
+        if (!validate(u,g,weapon,target,action).empty()) return false;
+        if (action==2) { end_aim();g.reload_wielded(true);return u.activity.id()==activity_id("ACT_RELOAD"); }
+        auto* t=perceived_hostile(target,u,g);const auto w=u.get_wielded_item();auto mode=w->gun_current_mode();
+        if (!t || !avatar_action::can_fire_weapon(u,get_map(),*w)) return false;
+        if (action==1 && t->is_npc() && !static_cast<npc*>(t)->guaranteed_hostile() &&
+            !query_yn("Really attack %s?", t->disp_name())) return false;
+        u.recoil=target_handler::aim_turning_recoil(u,t->pos());
+        if (!u.last_target_pos || *u.last_target_pos!=get_map().getabs(t->pos())) u.aim_cache_dirty=true;
+        u.last_target_pos=get_map().getabs(t->pos());u.last_target=g.shared_from(*t);
+        if (mode->has_flag(flag_id("ALWAYS_AIMED"))) u.recoil=0;
+        const int moves=u.moves;
+        if (action==0) { target_handler::aim_for_moves(u,*mode,t->pos(),100);u.aim_cache_dirty=true;aimed_target_=target;return u.moves<moves; }
+        const bool fired=u.fire_gun(t->pos(),mode.qty,*mode)>0; // Native cost/recoil/dispersion/projectile/damage/charges/skill.
+        u.aim_cache_dirty=true;return fired;
+    }
+};
+inline flatbuffers::Offset<CDDA::CWM::RangedWeaponState> export_ranged_weapon(flatbuffers::FlatBufferBuilder& f, avatar& u,uint64_t token) {
+    const auto w=u.get_wielded_item();
+    if (!token || !w || !w->is_gun()) return {};
+    const auto mode=w->gun_current_mode();
+    auto name=f.CreateString(w->tname().substr(0,16384));auto why=f.CreateString(ranged_weapon_error(u,1).substr(0,16384));
+    return CDDA::CWM::CreateRangedWeaponState(f,token,name,mode ? std::max(0,mode->ammo_remaining()) : 0,
+        mode ? std::max(0,mode->gun_range(&u)) : 0,std::clamp(u.recoil,0.0,double(MAX_RECOIL)),why,ranged_weapon_error(u,2).empty());
+}
+} // namespace cwm
