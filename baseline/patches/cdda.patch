+TEST_CASE("cwm_journal_queries_only_known_native_histories_without_effects", "[cwm][journal]") {
+    prepare_runtime();auto& u=get_avatar();u.setID(character_id(101),true);u.reset_all_missions();mission::clear_all();
+    const bool watch=GENERATE(false,true);
+    if(watch)REQUIRE(u.wear_item(item(itype_id("wristwatch")),false));
+    REQUIRE(u.has_watch()==watch);
+    int evaluated=0;
+    mission_type kind=*mission_type::get(mission_type_id("MISSION_GET_FLAG"));
+    kind.start=[](mission*){};kind.end=[](mission*){};kind.fail=[](mission*){};
+    kind.deadline_low=3_hours;kind.deadline_high=3_hours;
+    kind.goal=MGOAL_CONDITION;kind.goal_condition=[&](dialogue&){++evaluated;return true;};
+    auto make=[&](bool assigned) {
+        auto value=kind.create(character_id(999));mission::add_existing(value);auto* m=mission::find(value.get_id());
+        if(assigned) {m->assign(u);}
+        return m;
+    };
+    auto* first=make(true);auto* second=make(true);auto* success=make(true);success->wrap_up();
+    auto* failed=make(true);failed->fail();auto* hidden=make(false);
+    second->set_target(tripoint_abs_omt(123,456,-2));u.set_active_mission(*second);
+    const auto before=journal_canonical_state(u);const auto engine=rng_get_engine();const auto time=calendar::turn;const auto moves=u.moves;
+    cwm::MissionJournal journal;
+    for(unsigned n=1;n<4;++n) {
+        cdda::cwm::MessageBuilder wire(1,1);auto bytes=journal.query(u,*g,n,wire);
+        REQUIRE(cdda::cwm::MessageVerifier::verify(bytes.data(),bytes.size()));
+        auto* v=CDDA::CWM::GetCwmMessage(bytes.data())->payload_as_MissionView();REQUIRE(cdda::cwm::valid_missions(v));
+        REQUIRE(v->entries()->size()==4);CHECK(v->tracked_id()==second->get_id());
+        CHECK(v->entries()->Get(0)->remaining()->str()==(watch?to_string(first->get_deadline()-calendar::turn):to_string_approx(first->get_deadline()-calendar::turn)));
+        for(const auto* e:*v->entries())CHECK(e->id()!=hidden->get_id());
+        CHECK(v->entries()->Get(0)->id()==first->get_id());CHECK(v->entries()->Get(1)->target()->z()==-2);
+        CHECK(v->entries()->Get(2)->state()==CDDA::CWM::MissionState::COMPLETED);CHECK(v->entries()->Get(3)->state()==CDDA::CWM::MissionState::FAILED);
+        CHECK(journal_canonical_state(u)==before);CHECK(rng_get_engine()==engine);CHECK(calendar::turn==time);CHECK(u.moves==moves);CHECK(evaluated==0);
+    }
+    const auto view=journal.view();
+    CHECK_FALSE(journal.track(u,view,hidden->get_id(),second->get_id()).empty());
+    CHECK_FALSE(journal.track(u,view,success->get_id(),second->get_id()).empty());
+    CHECK_FALSE(journal.track(u,view,first->get_id(),-1).empty());
+    CHECK(journal.track(u,view,first->get_id(),second->get_id()).empty());CHECK(u.get_active_mission()==first);
+    CHECK_FALSE(journal.track(u,view,second->get_id(),first->get_id()).empty());
+    CHECK(calendar::turn==time);CHECK(u.moves==moves);CHECK(rng_get_engine()==engine);CHECK(evaluated==0);
+    u.reset_all_missions();mission::clear_all();
+}
