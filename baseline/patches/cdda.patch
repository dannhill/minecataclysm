+++ b/src/cwm_motion.h
@@ -0,0 +1,26 @@
+// Native continuous avatar motion. No presentation-engine types or physics.
+#pragma once
+#include "point.h"
+
+class avatar;
+class map;
+namespace cwm_motion {
+struct State {
+    tripoint anchor;
+    double x{0}, y{0}, credit{0};
+};
+State load( const avatar &u, const map &m );
+void store( avatar &u, const map &m, State state );
+void recenter( avatar &u, const map &m );
+// These scopes affect only ordinary walking/swimming debit, never attacks,
+// opening doors, restraints or vertical traversal.
+bool prepaid_crossing();
+bool fractional_stamina();
+double stamina_moves();
+struct Step {
+    double distance{0};
+    int extra_moves{0};
+    bool crossed{false};
+};
+Step advance( avatar &u, map &m, double x, double y, double seconds );
+}
