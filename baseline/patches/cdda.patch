+    static void quick_use(CwmServer& server, unsigned slot, const std::string& expected, int action, uint64_t id) {
+        cdda::cwm::MessageBuilder wire(server.received_sequence_+1,1,server.identity_);
+        const auto bytes=wire.build_quickbar_use(id,slot,expected,static_cast<CDDA::CWM::EquipmentAction>(action));
+        server.handle_client_message(bytes.data(),bytes.size(),get_avatar(),get_map(),*g);
