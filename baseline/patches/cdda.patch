+namespace {
+const move_mode_id mode_ids[] = {move_mode_id("walk"), move_mode_id("run"),
+    move_mode_id("crouch"), move_mode_id("prone")};
+bool valid_mode(int mode) { return mode >= 0 && mode < 4; }
+
+const point directions[] = {point_zero, point(0,-1), point(1,-1), point(1,0),
+    point(1,1), point(0,1), point(-1,1), point(-1,0), point(-1,-1)};
+
+Creature* attack_target(uint64_t id, avatar& u, map& m, game& g) {
+    Creature* target = nullptr;
+    if (id & (uint64_t(1) << 63)) {
+        for (npc& person : g.all_npcs())
+            if (((uint64_t(1) << 63) | uint64_t(person.getID().get_value())) == id && !person.is_dead() && person.is_enemy())
+                target = &person;
+    } else if (id & (uint64_t(1) << 62)) {
+        for (monster& critter : g.all_monsters())
+            if (CwmMapExporter::monster_entity_id(critter) == id && !critter.is_dead() && !critter.is_hallucination() &&
+                critter.friendly == 0 && !critter.has_effect(efftype_id("pet")) &&
+                critter.attitude_to(u) == Creature::Attitude::HOSTILE) target = &critter;
+    }
+    if (!target || target->is_dead_state() || !m.inbounds(target->pos()) || target->posz() != u.posz() ||
+        !u.is_adjacent(target, false) || !u.sees(*target) ||
+        !m.clear_path(u.pos(), target->pos(), 1, 1, 100)) return nullptr;
+    return target;
+}
+
+std::string vertical_error(const avatar& u, const map& m, int direction) {
+    // Contextual connections/swimming only. Free climbing requires a spatial
+    // choice UI; never fall through into the native terminal point selector.
+    if (u.in_vehicle) return "Vertical vehicle controls are not implemented yet";
+    if (u.is_mounted() && !u.mounted_creature->has_flag(mon_flag_RIDEABLE_MECH))
+        return "You cannot use stairs while riding this creature";
+    const bool up = direction == int(CDDA::CWM::MoveDirection::UP);
+    const int z = u.posz() + (up ? 1 : -1);
+    if (z < -OVERMAP_DEPTH || z > OVERMAP_HEIGHT) return "Vertical world boundary reached";
+    if (m.has_flag(up ? ter_furn_flag::TFLAG_GOES_UP : ter_furn_flag::TFLAG_GOES_DOWN, u.pos()) ||
+        u.is_underwater() || (!up && m.has_flag(ter_furn_flag::TFLAG_NO_FLOOR_WATER, u.pos())))
+        return {};
+    return "No native vertical connection here; free climbing is not available yet";
+}
+}
+
+CwmServer::CwmServer(const std::string& socket_path)
+    : socket_path_(socket_path), server_(std::make_unique<cdda::cwm::IpcServer>(socket_path)) {}
+CwmServer::~CwmServer() { stop(); }
+bool CwmServer::start() { return server_->start(); }
+void CwmServer::stop() { if (server_) server_->stop(); }
+bool CwmServer::has_active_client() const { return server_ && server_->has_client(); }
+bool CwmServer::save_world(game& g) { Hotbar::refresh(get_avatar()); return g.save(); }
+
+bool CwmServer::emit(const std::vector<uint8_t>& bytes) {
+    if (!has_active_client() || !server_->client()->send_message(bytes.data(), bytes.size())) return false;
+    ++sequence_counter_; // Count successfully queued wire messages, not attempted exports.
+    return true;
+}
+
+void CwmServer::cancel_connection() {
+    if (trade_context_) trade_context_->cancel=true;
+    // A replacement peer must not inherit an unanswered native choice. Keep
+    // a response already accepted from its valid connection, otherwise leave
+    // through the explicit safe final option before accepting more input.
+    if (pending_decision_ && decision_choices_ && !decision_answer_)
+        decision_answer_ = static_cast<int>(decision_choices_) - 1;
+    inventory_work_command_ = 0; inventory_work_settled_ = false;
+    inventory_selection_.clear();mission_journal_.clear();
+    held_direction_ = 0; intent_x_ = intent_y_ = 0; menu_pause_ = false;
+    motion_sample_ = clock_.elapsed();
+    for (const auto& command : commands_)
+        ledger_.complete({command.id, false, "Connection closed before execution", world_revision_});
+    commands_.clear();
+    crafting_selection_.clear(); ranged_selection_.clear();
+    if (result_) ledger_.complete({result_->id, result_->accepted, result_->error, world_revision_});
+    result_.reset();
+    snapshot_sent_ = negotiated_ = ready_ = rejecting_ = false;
+    awaiting_state_ = 0;
+}
+
+void CwmServer::refresh_activity(const avatar& u) {
+    if (auto work = u.activity.id() == activity_id("ACT_DISASSEMBLE") ? active_disassembly(u) : active_craft(u)) {
+        const int remaining = 10000000 - std::clamp(work->item_counter, 0, 10000000);
+        if (!activity_token_ || activity_kind_ != u.activity.id().str() || remaining > activity_remaining_)
+            activity_token_ = next_activity_token_++;
+        activity_kind_ = u.activity.id().str(); activity_total_ = 10000000; activity_remaining_ = remaining;
+        return;
+    }
+    if (u.activity.id() == activity_id("ACT_DROP") || u.activity.id() == activity_id("ACT_INSERT_ITEM") || u.activity.id() == activity_id("ACT_PICKUP")) {
+        if (!activity_token_ || activity_kind_ != u.activity.id().str()) activity_token_ = next_activity_token_++;
+        activity_kind_ = u.activity.id().str();
+        activity_total_ = std::max(0, u.activity.moves_total);
+        activity_remaining_ = std::clamp(u.activity.moves_left, 0, activity_total_);
+        return;
+    }
+    if ((u.activity.id() != activity_id("ACT_CONSUME") && u.activity.id() != activity_id("ACT_FIRSTAID") && u.activity.id() != activity_id("ACT_RELOAD") && u.activity.id() != activity_id("ACT_READ")) ||
+            u.activity.moves_total <= 0 || u.activity.moves_left <= 0) {
+        activity_token_ = 0; activity_total_ = activity_remaining_ = 0;
+        return;
+    }
+    if (!activity_token_ || activity_kind_ != u.activity.id().str() || activity_total_ != u.activity.moves_total ||
+        activity_remaining_ < u.activity.moves_left) activity_token_ = next_activity_token_++;
+    activity_kind_ = u.activity.id().str();
+    activity_total_ = u.activity.moves_total; activity_remaining_ = u.activity.moves_left;
+}
+
+bool CwmServer::refresh_inventory_work(const avatar& u) {
+    if (!inventory_work_command_ || inventory_work_settled_ || u.activity ||
+        u.moves <= 0 || u.is_dead_state() || (realtime_ && !clock_.action_due())) return false;
+    inventory_work_settled_ = true;
+    return true;
+}
+
+void CwmServer::send_state(avatar& u, map& m, game& g, bool full, uint64_t completed) {
+    if (!has_active_client() || !negotiated_ || rejecting_) return;
+    refresh_activity(u);
+    Hotbar::refresh(u);
+    if (refresh_inventory_work(u)) ++world_revision_;
+    const auto state_id = next_state_++;
+    const CwmMapExporter::ClockView clock{realtime_, pause_reasons(g),
+        static_cast<float>(clock_.scale()), motion_seconds_, continuous_};
+    auto snapshot = CwmMapExporter::export_world_snapshot(sequence_counter_, world_revision_,
+                    u, m, g, full, &projection_cache_, identity_, sent_revision_, state_id,
+                    resync_id_, completed, realtime_ ? &clock : nullptr, activity_token_, ranged_selection_.refresh(u),
+                    inventory_work_command_, inventory_work_settled_,
+                    uint32_t(std::min(4294967., inventory_work_total_)*1000),
+                    uint32_t(std::min({4294967., inventory_work_total_, clock_.remaining_work()})*1000));
+    const bool is_full = CDDA::CWM::GetCwmMessage(snapshot.data())->payload_as_WorldSnapshot()->full();
+    if (emit(snapshot)) {
+        snapshot_sent_ = true;
+        sent_revision_ = world_revision_;
+        if (is_full) {
+            ready_ = false; awaiting_state_ = state_id;
+            handshake_deadline_ = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+        }
+    }
+}
+
+void CwmServer::reset_world(avatar& u, map& m, game& g, uint64_t request_id) {
+    inventory_work_command_ = 0; inventory_work_settled_ = false;
+    inventory_selection_.clear(); ranged_selection_.clear();
+    if (realtime_) drop_realtime_input(u, m, g);
+    resync_id_ = request_id;
+    ready_ = false;
+    cdda::cwm::MessageBuilder builder(sequence_counter_, world_revision_, identity_);
+    auto message = builder.finish_message(CDDA::CWM::Payload::WorldReset,
+        CDDA::CWM::CreateWorldReset(builder.builder(), request_id).Union());
+    if (emit(message)) send_state(u, m, g, true);
+}
+
+void CwmServer::send_decision() {
+    if (!pending_decision_ || decision_answer_ || !ready_ || !has_active_client()) return;
+    cdda::cwm::MessageBuilder builder(sequence_counter_, world_revision_, identity_);
+    auto& fbb = builder.builder();
+    const auto text = fbb.CreateString(decision_text_);
+    const auto labels = fbb.CreateVectorOfStrings(decision_labels_);
+    std::vector<flatbuffers::Offset<CDDA::CWM::MedicalOption>> parts;
+    for (const auto& p : decision_medical_) parts.push_back(CDDA::CWM::CreateMedicalOption(
+        fbb, p.choice, fbb.CreateString(p.body_id), fbb.CreateString(p.name), fbb.CreateString(p.description),
+        p.health_quarters, fbb.CreateString(p.health_text), p.hp_current, p.hp_max));
+    const auto medical = parts.empty() ? flatbuffers::Offset<flatbuffers::Vector<flatbuffers::Offset<CDDA::CWM::MedicalOption>>>{} : fbb.CreateVector(parts);
+    flatbuffers::Offset<CDDA::CWM::ConversationInfo> conversation;
+    if (decision_conversation_) {
+        const auto& c = *decision_conversation_;
+        conversation = CDDA::CWM::CreateConversationInfo(fbb,c.npc_id,fbb.CreateString(c.speaker),
+            fbb.CreateString(c.topic),fbb.CreateString(c.history),c.history_truncated,c.companion_controls);
+    }
+    emit(builder.finish_message(CDDA::CWM::Payload::DecisionPrompt,
+        CDDA::CWM::CreateDecisionPrompt(fbb, pending_decision_, text, labels, static_cast<int>(decision_labels_.size()) - 1, medical, conversation).Union()));
+}
+
+void CwmServer::send_result(const Result& result, avatar& u, map& m, game& g) {
+    ledger_.complete({result.id, result.accepted, result.error, world_revision_});
+    if (!has_active_client() || !negotiated_) return;
+    const auto* entry = ledger_.find(result.id);
+    const auto revision = entry && entry->complete ? entry->outcome.revision : world_revision_;
+    cdda::cwm::MessageBuilder reply(sequence_counter_, world_revision_, identity_);
+    if (emit(reply.build_command_ack(result.id, result.accepted, result.error, revision)))
+        send_state(u, m, g, false, result.id);
+}
+
+bool CwmServer::update(avatar& u, map& m, game& g) {
+    if (!server_) return false;
+    if (server_->poll_accept(0)) {
+        cancel_connection();
+        sequence_counter_ = 1;
+        received_sequence_ = sent_revision_ = client_id_ = resync_id_ = 0;
+        identity_.player = static_cast<uint64_t>(u.getID().get_value());
+        ++identity_.connection;
+        handshake_deadline_ = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    }
+    if (!has_active_client()) { cancel_connection(); return true; }
+    std::vector<std::vector<uint8_t>> frames;
+    const bool alive = server_->client()->poll_and_receive(frames, 0);
+    for (const auto& frame : frames) {
+        if (!cdda::cwm::MessageVerifier::verify(frame.data(), frame.size())) {
+            server_->client()->close(cdda::cwm::IpcCloseReason::InvalidFrame);
+            break;
+        }
+        handle_client_message(frame.data(), frame.size(), u, m, g);
+        if (rejecting_ || (alive && !has_active_client())) break;
+    }
+    if (rejecting_ && (!server_->client()->queued_output_bytes() ||
+        std::chrono::steady_clock::now() > handshake_deadline_)) server_->client()->close();
+    if (!negotiated_ && std::chrono::steady_clock::now() > handshake_deadline_)
+        server_->client()->close();
+    if (negotiated_ && awaiting_state_ && std::chrono::steady_clock::now() > handshake_deadline_)
+        server_->client()->close();
+    if (!alive || !has_active_client()) {
+        std::cerr << "[CWM] Connection closed; transport reason " << int(server_->client()->close_reason()) << "\n";
+        cancel_connection();
+    }
+    return true;
+}
+
+uint32_t CwmServer::pause_reasons(const game& g) const {
+    if (!realtime_) return 0;
+    using namespace cdda::cwm;
+    return (manual_pause_ ? uint32_t(Manual) : 0u) | (menu_pause_ ? uint32_t(Menu) : 0u) |
+        ((g.uquit != QUIT_WATCH && (threat_pause_ || g.safe_mode == SAFE_MODE_STOP || get_avatar().has_effect(efftype_id("laserlocked")))) ? uint32_t(Threat) : 0u) |
+        ((!ready_ || !has_active_client()) ? uint32_t(Recovery) : 0u) | ((pending_decision_ || trade_context_) ? uint32_t(Decision) : 0u);
+}
+
+void CwmServer::service_clock(avatar& u, map& m, game& g) {
+    clock_.sample(cdda::cwm::SimulationClock::Wall::now(), pause_reasons(g) == 0);
+    update(u, m, g);
+    clock_.sample(cdda::cwm::SimulationClock::Wall::now(), pause_reasons(g) == 0);
+    if (refresh_inventory_work(u)) { ++world_revision_; send_state(u, m, g); }
+    if (continuous_ && (pause_reasons(g) || (!intent_x_ && !intent_y_) || !clock_.action_due()))
+        motion_sample_ = clock_.elapsed();
+}
+
+bool CwmServer::sample_motion(avatar& u, map& m, game& g, bool flush) {
+    if (!continuous_ || u.activity || pause_reasons(g) || !clock_.action_due() || (!intent_x_ && !intent_y_)) return false;
+    const double dt = clock_.elapsed() - motion_sample_;
+    // 25 wall samples/s. A delayed frame is capped, never caught up in bursts.
+    if (dt <= 1e-8 || (!flush && dt < .04 * clock_.scale())) return false;
+    motion_sample_ = clock_.elapsed();
+    cwm_motion::Step step;
+    double remaining = std::min(dt, .20);
+    while (remaining > 1e-8 && u.moves > 0 && !pause_reasons(g)) {
+        const double quantum = std::min(remaining, .04);
+        const auto part = cwm_motion::advance(u, m, intent_x_, intent_y_, quantum);
+        step.distance += part.distance; step.extra_moves += part.extra_moves;
+        step.crossed = step.crossed || part.crossed;
+        remaining -= quantum;
+        if (part.extra_moves) break;
+    }
+    motion_seconds_ = .04f;
+    if (step.extra_moves) clock_.charge_action(step.extra_moves, u.get_speed());
+    if (step.distance > 1e-8 || step.extra_moves) {
+        ++world_revision_; send_state(u, m, g);
+        detect_threats(u, m, g);
+    }
+    return step.crossed || step.extra_moves;
+}
+
+void CwmServer::drop_realtime_input(avatar& u, map& m, game& g) {
+    held_direction_ = 0; intent_x_ = intent_y_ = 0;
+    motion_sample_ = clock_.elapsed();
+    const auto cancelled = std::move(commands_);
+    commands_.clear();
+    crafting_selection_.clear();
+    for (const auto& command : cancelled)
+        send_result({command.id, false, "Paused or recovering before execution"}, u, m, g);
+}
+
+void CwmServer::detect_threats(avatar& u, map& m, game& g) {
+    if (!realtime_ || g.uquit == QUIT_WATCH) return;
+    std::set<std::string> current;
+    for (monster& creature : g.all_monsters()) {
+        if (creature.is_dead() || creature.is_hallucination() || !u.sees(creature)) continue;
+        const auto attitude = creature.attitude(&u);
+        if (attitude != MATT_ATTACK && attitude != MATT_FOLLOW) continue;
+        const auto id = creature.get_value("cwm_monster_id");
+        if (!id.empty()) current.insert("m:" + id);
+    }
+    for (npc& person : g.all_npcs())
+        if (!person.is_dead() && person.is_enemy() && u.sees(person))
+            current.insert("n:" + std::to_string(person.getID().get_value()));
+    bool unseen = false;
+    for (const auto& id : current) if (!perceived_threats_.count(id)) unseen = true;
+    perceived_threats_ = std::move(current);
+    if (unseen && !threat_pause_) {
+        threat_pause_ = true;
+        drop_realtime_input(u, m, g);
+        ++world_revision_;
+        send_state(u, m, g);
+    }
+}
+
+bool CwmServer::finish_shutdown(avatar& u, game& g) {
+    saved_on_shutdown_ = save_world(g);
+    g.uquit = saved_on_shutdown_ ? QUIT_SAVED : QUIT_NOSAVED;
+    u.moves = 0;
+    return false;
+}
+
+bool CwmServer::realtime_action(avatar& u, map& m, game& g,
+                              const std::function<bool()>& keep_running) {
+    while (keep_running()) {
+        service_clock(u, m, g);
+        if (pause_reasons(g)) { std::this_thread::sleep_for(std::chrono::milliseconds(1)); continue; }
+        if (clock_.tick_due()) {
+            if (held_direction_ || intent_x_ || intent_y_ || !commands_.empty()) {
+                // Held intent still owns unused native credit. A wall boundary
+                // is not an idle action and must not erase a fast actor's moves.
+                finish_external_action_phase();
+                return false;
+            }
+            // An explicitly aimed, still-valid firearm keeps its paid recoil
+            // between inputs. Native AIM waits by exhausting move credit;
+            // the generic WAIT action instead resets recoil to MAX_RECOIL.
+            // No aim improvement occurs here. World ticks still cost time.
+            if (ranged_selection_.maintaining_aim(u,g)) u.set_moves(0);
+            else u.pause();
+            return true;
+        }
+        if (continuous_ && commands_.empty() && (intent_x_ || intent_y_)) {
+            if (sample_motion(u, m, g)) return true;
+            // Fractional debit can exhaust native credit without crossing.
+            // do_turn must regain control to run the paced native world tick.
+            if (u.moves <= 0) return false;
+            std::this_thread::sleep_for(std::chrono::milliseconds(1)); continue;
+        }
+        if (clock_.action_due() && (!commands_.empty() || held_direction_)) {
+            Command command{};
+            if (!commands_.empty()) { command = commands_.front(); commands_.pop_front(); }
+            else command = Command{0, true, held_direction_};
+            const int before = u.moves;
+            const int speed = u.get_speed();
+            const bool acted = execute(command, u, m, g);
+            const double duration = command.equipment_action >= 0 || command.transfer_action >= 0 ?
+                clock_.charge_work(before-u.moves, speed) : clock_.charge_action(before-u.moves, speed);
+            if (acted && inventory_work_command_ == command.id && !u.activity)
+                inventory_work_total_ = clock_.remaining_work();
+            motion_seconds_ = static_cast<float>(std::clamp(duration, .05, 60.));
+            if (!acted && !command.id) held_direction_ = 0;
+            if (result_) {
+                if (command.id) send_result(*result_, u, m, g);
+                else send_state(u, m, g);
+                result_.reset();
+            }
+            detect_threats(u, m, g);
+            return acted;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    return finish_shutdown(u, g);
+}
+
+bool CwmServer::pace_world(avatar& u, map& m, game& g,
+                         const std::function<bool()>& keep_running) {
+    while (keep_running()) {
+        service_clock(u, m, g);
+        if (continuous_) motion_sample_ = clock_.elapsed();
+        if (!pause_reasons(g) && clock_.tick_due()) return true;
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    return finish_shutdown(u, g);
+}
+
+bool CwmServer::advance_turn(avatar& u, map& m, game& g,
+                           const std::function<bool()>& keep_running) {
+    const external_trade_provider trade_provider{
+        [&](trade_ui& model){return ask_trade(model,u,m,g,keep_running);},
+        [&](bool accepted){finish_trade(accepted,u,m,g);}
+    };
+    const external_trade_scope trade_scope(trade_provider);
+
+    if (realtime_) {
+        while (keep_running() && pause_reasons(g)) {
+            service_clock(u, m, g);
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        }
+        if (!keep_running()) { finish_shutdown(u, g); return true; }
+    }
+    bool prelude_sent = false;
+    const bool ended = do_turn_with_action([&]() {
+        if (g.uquit == QUIT_WATCH) {
+            const int choice = ask_decision("Deathcam: watch the next moment or finish?",
+                {"Advance one turn", "Finish deathcam"}, u, m, g, keep_running);
+            if (choice == 1) g.uquit = QUIT_DIED;
+            return false;
+        }
+        // Native timed events/perception run before requesting input. Publish
+        // them immediately, rather than attributing them to a later rejected
+        // request or withholding a safety warning until movement is attempted.
+        if (!prelude_sent) {
+            ++world_revision_;
+            send_state(u, m, g, !snapshot_sent_);
+            prelude_sent = true;
+        }
+        if (result_) {
+            send_result(*result_, u, m, g);
+            result_.reset();
+        }
+        if (realtime_) { detect_threats(u, m, g); return realtime_action(u, m, g, keep_running); }
+        while (keep_running()) {
+            update(u, m, g);
+            if (!commands_.empty()) {
+                const Command command = commands_.front();
+                commands_.pop_front();
+                return execute(command, u, m, g);
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        }
+        // Native cleanup clears map buffers: save first, as ACTION_SAVE does.
+        saved_on_shutdown_ = save_world(g);
+        g.uquit = saved_on_shutdown_ ? QUIT_SAVED : QUIT_NOSAVED;
+        u.moves = 0;
+        return false;
+    }, [&](const std::string& text, const std::vector<std::string>& choices) {
+        return ask_decision(text, choices, u, m, g, keep_running, external_medical_options());
+    }, realtime_ ? std::function<bool()>([&]() { return pace_world(u, m, g, keep_running); }) : std::function<bool()>{}, [&](int moves, int speed) {
+        if (realtime_) clock_.charge_work(moves, speed);
+    });
+    if (!ended) {
+        if (realtime_) clock_.complete_tick();
+        ++world_revision_;
+        if (result_) {
+            send_result(*result_, u, m, g);
+            result_.reset();
+        } else send_state(u, m, g);
+        detect_threats(u, m, g);
+    }
+    return ended;
+}
+
+int CwmServer::ask_decision(const std::string& text, const std::vector<std::string>& choices,
+                          avatar& u, map& m, game& g, const std::function<bool()>& keep_running, const std::vector<external_medical_option>& medical) {
+    if (choices.empty()) return -1;
+    if (choices.size() > 9) {
+        // The temporary numbered GUI pages long native lists. Preserve every
+        // available action and its original index; never hang on >9 choices.
+        size_t begin = 0;
+        while (keep_running() && has_active_client()) {
+            std::vector<std::string> page;
+            std::vector<int> indices;
+            const size_t end = std::min(begin + 6, choices.size() - 1);
+            for (size_t i = begin; i < end; ++i) { page.push_back(choices[i]); indices.push_back(i); }
+            if (begin) { page.push_back("Previous page"); indices.push_back(-1); }
+            if (end < choices.size() - 1) { page.push_back("Next page"); indices.push_back(-2); }
+            page.push_back(choices.back()); indices.push_back(choices.size() - 1);
+            std::vector<external_medical_option> page_medical;
+            for (auto option : medical) {
+                if (option.choice < 0) { if (begin == 0) page_medical.push_back(option); continue; }
+                const auto found = std::find(indices.begin(), indices.end(), option.choice);
+                if (found != indices.end()) { option.choice = found - indices.begin(); page_medical.push_back(option); }
+            }
+            const int answer = ask_decision(text, page, u, m, g, keep_running, page_medical);
+            if (indices[answer] == -1) begin -= 6;
+            else if (indices[answer] == -2) begin += 6;
+            else return indices[answer];
+        }
+        return choices.size() - 1;
+    }
+    if (realtime_) { clock_.sample(cdda::cwm::SimulationClock::Wall::now(), false); drop_realtime_input(u, m, g); }
+    pending_decision_ = next_decision_++;
+    decision_choices_ = choices.size();
+    decision_answer_.reset();
+    decision_text_ = text;
+    decision_labels_ = choices;
+    decision_medical_ = medical;
+    decision_conversation_ = external_conversation ? std::optional<external_conversation_info>(*external_conversation) : std::nullopt;
+    send_state(u, m, g, !snapshot_sent_);
+    send_decision();
+    const auto decision_connection = identity_.connection;
+    while (keep_running() && has_active_client() && identity_.connection == decision_connection && !decision_answer_) {
+        update(u, m, g);
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    // Yes/No, deathcam and world-end menus put the non-destructive option last.
+    const int selected = decision_answer_.value_or(static_cast<int>(choices.size()) - 1);
+    pending_decision_ = 0;
+    decision_medical_.clear();
+    decision_conversation_.reset();
+    decision_answer_.reset();
+    if (realtime_) { clock_.sample(cdda::cwm::SimulationClock::Wall::now(), false); ++world_revision_; send_state(u, m, g); }
+    return selected;
+}
+
+bool CwmServer::execute(const Command& command, avatar& u, map& m, game& g) {
+    const bool was_busy = bool(u.activity);
+    const bool acted = execute_native(command, u, m, g);
+    // A rejected request during someone else's work cannot replace its identity.
+    if (!was_busy && (command.equipment_action >= 0 || command.transfer_action >= 0)) {
+        inventory_work_command_ = command.id; inventory_work_settled_ = false; inventory_work_total_ = 0;
+    }
+    return acted;
+}
+
+bool CwmServer::execute_native(const Command& command, avatar& u, map& m, game& g) {
+    const int before_moves = u.moves;
+    bool accepted = false;
+    if (command.ranged_action < 0) ranged_selection_.end_aim();
+    // Revalidate busy state at execution as well as admission: multiple
+    // commands may arrive before the first starts its native activity.
+    if (u.activity) {
+        result_ = Result{command.id, false, ::cwm::tr("Interrupt or finish the activity before acting.", "Interrompi o concludi l'attivita prima di agire.")};
+        return false;
+    }
+    if (command.talk_target) {
+        auto error = conversation_error(command.talk_target,u,g);
+        if (realtime_ && pause_reasons(g)) error = "Simulation is paused";
+        if (!error.empty()) { result_ = Result{command.id,false,error}; return false; }
+        npc* person = conversation_target(command.talk_target,u,g);
+        inventory_selection_.clear(); crafting_selection_.clear(); ranged_selection_.clear();
+        u.talk_to(get_talker_for(*person));
+        // game::chat debits exactly one native action after the conversation.
+        u.mod_moves(-100);
+        refresh_activity(u); ++world_revision_;
+        result_ = Result{command.id,true,""};
+        return true;
+    } else if (command.ranged_action >= 0) {
+        auto error = ranged_selection_.validate(u,g,command.ranged_weapon,command.ranged_target,command.ranged_action);
+        if (realtime_ && pause_reasons(g)) error="Simulation is paused";
+        if (!error.empty()) { result_=Result{command.id,false,error};return false; }
+        inventory_selection_.clear();crafting_selection_.clear();
+        accepted=ranged_selection_.execute(u,g,command.ranged_weapon,command.ranged_target,command.ranged_action);
+        refresh_activity(u);++world_revision_;
+        result_=Result{command.id,accepted,accepted ? "" : ::cwm::tr("Native action was cancelled or failed.", "Azione nativa annullata o non riuscita.")};
+        return accepted || u.moves!=before_moves;
+    } else if (command.crafting_view) {
+        auto error = crafting_selection_.validate(u, command.crafting_view, command.crafting_entry);
+        if (realtime_ && pause_reasons(g)) error = "Simulation is paused";
+        if (!error.empty()) { result_ = Result{command.id, false, error}; return false; }
+        inventory_selection_.clear(); activity_token_ = 0;
+        accepted = crafting_selection_.execute(u, command.crafting_view, command.crafting_entry);
+        refresh_activity(u);
+        const bool acted = accepted || u.moves != before_moves;
+        // Native placement may store/drop an already-created craft without
+        // starting ACT_CRAFT. Publish that canonical mutation even with zero work.
+        ++world_revision_;
+        result_ = Result{command.id, accepted, accepted ? "" : ::cwm::tr("No work started; check for unfinished crafts in K.", "Nessun lavoro avviato; controlla gli eventuali incompleti in K.")};
+        return acted;
+    } else if (command.transfer_action >= 0) {
+        auto error = inventory_selection_.validate_transfer(u, command.inventory_view,
+            command.inventory_item, command.transfer_quantity, command.transfer_destination, command.transfer_action);
+        if (realtime_ && pause_reasons(g)) error = "Simulation is paused";
+        if (!error.empty()) { result_ = Result{command.id, false, error}; return false; }
+        auto source = inventory_selection_.target(command.inventory_item);
+        auto destination = command.transfer_destination ? inventory_selection_.target(command.transfer_destination) : item_location::nowhere;
+        const auto external_pos = command.transfer_action == 3 ? inventory_selection_.external_position() : u.pos();
+        inventory_selection_.clear(); ranged_selection_.clear(); activity_token_ = 0;
+        if (command.transfer_action == 2) {
+            u.pick_up({{source,command.transfer_quantity}});
+        } else if (command.transfer_action == 3) {
+            u.assign_activity(drop_activity_actor({drop_or_stash_item_info(source,command.transfer_quantity)}, external_pos-u.pos(),true));
+        } else if (command.transfer_action == 0) {
+            // The selected destination is explicitly ground at the avatar tile,
+            // never implicit vehicle cargo; same actor as native advanced inventory.
+            u.assign_activity(drop_activity_actor({drop_or_stash_item_info(source, command.transfer_quantity)}, tripoint_zero, true));
+        } else {
+            u.assign_activity(insert_item_activity_actor(destination, {{source, command.transfer_quantity}}, false));
+        }
+        const bool accepted = bool(u.activity);
+        result_ = Result{command.id, accepted, accepted ? "" : ::cwm::tr("Native transfer did not start.", "Trasferimento nativo non avviato.")};
+        if (accepted) ++world_revision_;
+        return accepted;
+    } else if (command.equipment_action >= 0) {
+        auto location = command.quick_slot ? Hotbar::resolve(u, command.quick_slot, command.quick_binding) :
+            (inventory_selection_.validate_binding(u, command.inventory_view, command.inventory_item).empty() ?
+             inventory_selection_.target(command.inventory_item) : item_location{});
+        auto error = command.quick_slot ? (location ? InventorySelection::action_error(u, location, command.equipment_action) : "Quick item lost or slot changed.") :
+            inventory_selection_.validate(u, command.inventory_view, command.inventory_item, command.equipment_action);
+        if (realtime_ && pause_reasons(g)) error = "Simulation is paused";
+        if (!error.empty()) { result_ = Result{command.id, false, error}; return false; }
+        inventory_selection_.clear(); // Invalidate every sibling handle before native mutation/choice.
+        switch (command.equipment_action) {
+            case 0: accepted = u.wield(location); break;
+            case 1: accepted = u.unwield(); break;
+            case 2: accepted = bool(u.wear(location)); break;
+            case 3: accepted = u.takeoff(location.obtain(u)); break;
+            case 4:
+                activity_token_ = 0;
+                // Same native eat path, without terminal-menu continuation.
+                avatar_action::eat(u, location, {}, {}, "", activity_id("ACT_CONSUME"));
+                accepted = u.activity.id() == activity_id("ACT_CONSUME") && u.activity.moves_left > 0;
+                // Native actor declined the warning and scheduled zero work.
+                if (!accepted && u.activity.id() == activity_id("ACT_CONSUME")) u.activity.set_to_null();
+                refresh_activity(u);
+                break;
+            case 5:
+                activity_token_ = 0;
+                avatar_action::use_item(u, location, "heal");
+                accepted = u.activity.id() == activity_id("ACT_FIRSTAID") && u.activity.moves_left > 0;
+                if (accepted && location) {
+                    // Retain the exact native obtained/nested location, as the
+                    // upstream consume actor does for first aid completion.
+                    u.activity.targets.clear(); u.activity.targets.push_back(location);
+                }
+                refresh_activity(u);
+                break;
+            case 7:
+                activity_token_ = 0;
+                // Native selection passes its item_location directly; do not
+                // obtain, delete or synthesize components in this adapter.
+                accepted = u.disassemble(location, true);
+                accepted = accepted && u.activity.id() == activity_id("ACT_DISASSEMBLE");
+                refresh_activity(u);
+                break;
+            case 6:
+                activity_token_ = 0;
+                // Native read key obtains the selected book from its pocket
+                // before avatar::read, paying the actual access cost.
+                location = location.obtain(u);
+                accepted = location && u.read(location);
+                accepted = accepted && u.activity.id() == activity_id("ACT_READ") && u.activity.moves_left > 0;
+                refresh_activity(u);
+                break;
+        }
+        const bool acted = accepted || u.moves != before_moves;
+        if (acted) ++world_revision_;
+        result_ = Result{command.id, accepted, accepted ? "" : ::cwm::tr("Native action was cancelled or failed.", "Azione nativa annullata o non riuscita.")};
+        return acted; // Native action debt/turns, never a Luanti inventory mutation.
+    } else if (command.movement_mode >= 0) {
+        if (!valid_mode(command.movement_mode) || (realtime_ && pause_reasons(g))) {
+            result_ = Result{command.id, false, "Movement mode unavailable"};
+            return false;
+        }
+        // Use the same native setter as keyboard mode selection: availability,
+        // hauling, recoil and perception invalidation belong to CDDA. No move
+        // cost is invented and the paid subtile offset is retained.
+        if (!u.can_switch_to(mode_ids[command.movement_mode])) {
+            result_ = Result{command.id, false, "Native movement mode unavailable"};
+            return false;
+        }
+        u.set_movement_mode(mode_ids[command.movement_mode]);
+        accepted = u.movement_mode_is(mode_ids[command.movement_mode]);
+    } else if (command.attack_target) {
+        Creature* target = attack_target(command.attack_target, u, m, g);
+        if (!target || (realtime_ && pause_reasons(g))) {
+            result_ = Result{command.id, false, "Melee target unavailable, not hostile or out of reach"};
+            return false;
+        }
+        accepted = avatar_action::attack(u, *target);
+    } else if (command.move) {
+        if (!g.check_safe_mode_allowed(false)) {
+            result_ = Result{command.id, false, "Safe mode: threat requires acknowledgement"};
+            return false;
+        } else if (command.action == 0) {
+            u.pause();
+            accepted = true;
+        } else if (command.action >= int(CDDA::CWM::MoveDirection::UP)) {
+            const auto error = vertical_error(u, m, command.action);
+            if (!error.empty()) {
+                result_ = Result{command.id, false, error};
+                return false;
+            }
+            const tripoint before = u.pos();
+            const bool underwater = u.is_underwater();
+            g.vertical_move(command.action == int(CDDA::CWM::MoveDirection::UP) ? 1 : -1, false);
+            accepted = before != u.pos() || underwater != u.is_underwater();
+            if (accepted && continuous_) cwm_motion::recenter(u, m);
+        } else {
+            const tripoint target = u.pos() + tripoint(directions[command.action], 0);
+            const npc* person = get_creature_tracker().creature_at<npc>(target);
+            if (person && !person->is_enemy()) {
+                result_ = Result{command.id, false, ::cwm::tr("Right-click the NPC to talk.")};
+                return false;
+            }
+            accepted = avatar_action::move(u, m, directions[command.action]);
+        }
+    } else {
+        const tripoint target = m.getlocal(tripoint(command.x, command.y, command.z));
+        if (target.z == u.posz() && rl_dist(target, u.pos()) <= 1 && m.inbounds(target)) {
+            if (command.action == int(CDDA::CWM::InteractAction::OPEN)) {
+                accepted = m.open_door(u, target, !m.is_outside(u.pos()), false);
+                if (accepted) u.moves -= 100; // native terrain-door OPEN cost
+            } else if (command.action == int(CDDA::CWM::InteractAction::CLOSE)) {
+                if (continuous_ && cwm_motion::overlaps_tile(u,m,target)) {
+                    result_ = Result{command.id, false, ::cwm::tr("Move away from the opening before closing it.", "Allontanati dal varco prima di chiuderlo.")};
+                    return false;
+                }
+                doors::close_door(m, u, target);
+                accepted = u.moves != before_moves;
+            } else if (command.action == int(CDDA::CWM::InteractAction::PICKUP)) {
+                map_stack stack = m.i_at(target);
+                if (command.pickup_stack_index >= stack.size()) {
+                    result_ = Result{command.id, false, "Pickup target stack changed"};
+                    return false;
+                }
+
+                auto it = stack.begin();
+                std::advance(it, command.pickup_stack_index);
+                item &candidate = *it;
+                if (candidate.typeId().str() != command.pickup_type_id ||
+                    candidate.charges != command.pickup_charges ||
+                    candidate.count_by_charges() != command.pickup_count_by_charges) {
+                    result_ = Result{command.id, false, "Pickup target item changed"};
+                    return false;
+                }
+
+                drop_locations selected;
+                selected.emplace_back(item_location(map_cursor(target), &candidate), 0);
+                u.pick_up(selected);
+                accepted = true;
+            }
+        }
+    }
+    // A failed native movement can still consume time, e.g. a movement effect.
+    const bool acted = accepted || u.moves != before_moves;
+    result_ = Result{command.id, acted, acted ? "" : "Native action blocked or target changed"};
+    if (acted) ++world_revision_;
+    return acted; // do_turn owns action_taken, activities and every world system
+}
+
+void CwmServer::handle_client_message(const uint8_t* data, size_t size,
+                                      avatar& u, map& m, game& g) {
+    const auto* msg = cdda::cwm::MessageVerifier::parse(data, size);
+    if (!msg) return;
+    using CDDA::CWM::Payload;
+    if (!negotiated_) {
+        const auto* hello = msg->payload_as_HelloRequest();
+        const bool accepted = hello && msg->sequence_number() == 1 && !msg->session_id() &&
+            !msg->player_id() && !msg->connection_id() && hello->client_id() &&
+            hello->protocol_version_major() == cdda::cwm::PROTOCOL_VERSION_MAJOR &&
+            hello->protocol_version_minor() == cdda::cwm::PROTOCOL_VERSION_MINOR;
+        cdda::cwm::MessageBuilder reply(sequence_counter_, world_revision_, identity_);
+        emit(reply.build_hello_response(accepted, "cdda-server-cwm-2",
+            accepted ? "" : "Current CWM Hello required before state or commands", ledger_.next_id()));
+        if (!accepted) { rejecting_ = true; return; }
+        client_id_ = hello->client_id(); received_sequence_ = 1; negotiated_ = true;
+        reset_world(u, m, g, 0);
+        return;
+    }
+    if (msg->session_id() != identity_.session || msg->player_id() != identity_.player ||
+        msg->connection_id() != identity_.connection || msg->sequence_number() != received_sequence_ + 1) {
+        server_->client()->close(cdda::cwm::IpcCloseReason::InvalidFrame); return;
+    }
+    received_sequence_ = msg->sequence_number();
+    if (msg->payload_type() == Payload::ResyncRequest) {
+        const auto* request = msg->payload_as_ResyncRequest();
+        if (!request || !request->request_id()) { server_->client()->close(); return; }
+        reset_world(u, m, g, request->request_id());
+        return;
+    }
+    if (msg->payload_type() == Payload::SnapshotAck) {
+        const auto* ack = msg->payload_as_SnapshotAck();
+        if (ack && awaiting_state_ && ack->state_id() == awaiting_state_) {
+            awaiting_state_ = 0; ready_ = true; send_decision(); send_trade();
+            if (realtime_) { ++world_revision_; send_state(u, m, g); detect_threats(u, m, g); }
+        }
+        return;
+    }
+    if (msg->payload_type() == Payload::Heartbeat) {
+        cdda::cwm::MessageBuilder reply(sequence_counter_, world_revision_, identity_);
+        emit(reply.finish_message(Payload::HeartbeatAck,
+            CDDA::CWM::CreateHeartbeatAck(reply.builder(), cdda::cwm::current_time_ms(),
+                                          cdda::cwm::current_time_ms()).Union()));
+        return;
+    }
+    if (!ready_ &&
+        msg->payload_type() != Payload::ContinuousIntentRequest)
+        return; // Spatial authority waits for installed full state.
+    if (const auto* request = msg->payload_as_LanguageRequest()) {
+        const std::string code = request->code() ? request->code()->str() : "";
+        const auto *language = ::cwm::product_language(code);
+        const bool valid = request->request_id() && language;
+        const bool accepted = valid && !pending_decision_ && !trade_context_;
+        // Never replay an open native question to obtain translated text:
+        // entry effects and choices must execute exactly once.
+        if (accepted && code != ::cwm::product_language_storage()) {
+            set_language(language->native_locale);
+            ::cwm::set_product_language(code);
+        }
+        cdda::cwm::MessageBuilder reply(sequence_counter_, world_revision_, identity_);
+        const auto bytes = reply.finish_message(Payload::LanguageState,
+            CDDA::CWM::CreateLanguageStateDirect(reply.builder(), request->request_id(),
+                ::cwm::product_language_storage().c_str(),
+                accepted, accepted ? "" : !valid ? "Unsupported language code." : ::cwm::tr(
+                    "Finish the open decision before changing language.",
+                    "Concludi la scelta aperta prima di cambiare lingua.")).Union());
+        emit(bytes);
+        // Refresh native item/status labels at the same world revision, with
+        // no turn, movement, activity restart or canonical option write.
+        if (accepted) send_state(u, m, g);
+        return;
+    }
+    if (msg->payload_type() == Payload::DecisionResponse) {
+        const auto* response = msg->payload_as_DecisionResponse();
+        if (response && pending_decision_ && !decision_answer_ &&
+            response->decision_id() == pending_decision_ && response->choice() < decision_choices_)
+            decision_answer_ = response->choice();
+        return;
+    }
+    if(const auto* request=msg->payload_as_MissionQueryRequest()) {
+        if(!request->query_id()){server_->client()->close();return;}
+        cdda::cwm::MessageBuilder reply(sequence_counter_,world_revision_,identity_);
+        emit(mission_journal_.query(u,g,request->query_id(),reply,
+            pending_decision_ || trade_context_ ? ::cwm::tr("Finish the open decision before opening the journal.") : ""));
+        return;
+    }
+    if (handle_trade_message(*msg,u,m,g)) return;
+    if ((pending_decision_ || trade_context_) && msg->payload_type() != Payload::SimulationControlRequest &&
+        msg->payload_type() != Payload::MovementIntentRequest &&
+        msg->payload_type() != Payload::ContinuousIntentRequest) return;
+    if (const auto* request = msg->payload_as_CraftingQueryRequest()) {
+        if (!request->query_id() || !request->search() || request->search()->size() > 256 ||
+            request->search()->str().find('\0') != std::string::npos || !request->batch() || request->batch() > 20 || int(request->filter()) > 4) {
+            server_->client()->close(); return;
+        }
+        const auto now = std::chrono::steady_clock::now();
+        cdda::cwm::MessageBuilder reply(sequence_counter_, world_revision_, identity_);
+        const bool throttled = now < next_crafting_query_;
+        if (!throttled) next_crafting_query_ = now + std::chrono::milliseconds(100);
+        emit(crafting_selection_.query(u, request->query_id(), request->search()->str(), request->batch(), reply,
+            throttled ? ::cwm::tr("Wait a moment before refreshing the catalog.", "Attendi un istante prima di aggiornare il catalogo.") : "", request->filter()));
+        return;
+    }
+    if (const auto* request = msg->payload_as_InventoryQueryRequest()) {
+        if (!request->query_id()) { server_->client()->close(); return; }
+        const auto now = std::chrono::steady_clock::now();
+        cdda::cwm::MessageBuilder reply(sequence_counter_, world_revision_, identity_);
+        Hotbar::refresh(u);
+        const bool throttled = now < next_inventory_query_;
+        if (!throttled) next_inventory_query_ = now + std::chrono::milliseconds(100);
+        std::optional<tripoint> external;
+        if (const auto* c=request->external_coord()) external=tripoint(c->x(),c->y(),c->z());
+        emit(inventory_selection_.query(u, request->query_id(), reply,
+            throttled ? ::cwm::tr("Wait a moment before refreshing the inventory.", "Attendi un istante prima di aggiornare l'inventario.") : "", external));
+        return; // No command ledger, move cost, calendar change or input action.
+    }
+    uint64_t id = 0;
+    std::string signature;
+    if(const auto* request=msg->payload_as_MissionTrackRequest()) {
+        id=request->command_id();signature="mission-track:"+std::to_string(request->view_id())+":"+std::to_string(request->mission_id())+":"+std::to_string(request->expected_tracked_id());
+    } else if (const auto* request = msg->payload_as_MoveRequest()) {
+        id = request->command_id(); signature = "move:" + std::to_string(int(request->direction()));
+    } else if (const auto* request = msg->payload_as_InteractRequest()) {
+        id = request->command_id(); signature = "interact:" + std::to_string(int(request->action()));
+        if (const auto* p = request->target_coord()) signature += ":" + std::to_string(p->x()) +
+            ":" + std::to_string(p->y()) + ":" + std::to_string(p->z());
+        if (request->action() == CDDA::CWM::InteractAction::PICKUP) {
+            const std::string type = request->pickup_type_id() ? request->pickup_type_id()->str() : "";
+            signature += ":" + std::to_string(request->pickup_stack_index()) +
+                ":" + std::to_string(type.size()) + ":" + type +
+                ":" + std::to_string(request->pickup_charges()) +
+                ":" + std::to_string(request->pickup_count_by_charges());
+        }
+    } else if (const auto* request = msg->payload_as_RangedRequest()) {
+        id=request->command_id();signature="ranged:"+std::to_string(request->weapon_token())+":"+std::to_string(request->target_entity_id())+":"+std::to_string(int(request->action()));
+    } else if (const auto* request = msg->payload_as_CancelReloadRequest()) {
+        id=request->command_id();signature="cancel-reload:"+std::to_string(request->activity_token());
+    } else if (const auto* request = msg->payload_as_CraftingFavoriteRequest()) {
+        id=request->command_id();signature="craft-favorite:"+std::to_string(request->view_id())+":"+std::to_string(request->entry_id())+":"+std::to_string(request->favorite())+":"+std::to_string(request->expected_favorite());
+    } else if (const auto* request = msg->payload_as_CraftingRequest()) {
+        id = request->command_id(); signature = "craft:" + std::to_string(request->view_id()) + ":" + std::to_string(request->entry_id());
+    } else if (const auto* request = msg->payload_as_CancelCraftingRequest()) {
+        id = request->command_id(); signature = "cancel-craft:" + std::to_string(request->activity_token());
+    } else if (const auto* request = msg->payload_as_CancelDisassemblyRequest()) {
+        id = request->command_id(); signature = "cancel-disassembly:" + std::to_string(request->activity_token());
+    } else if (const auto* request = msg->payload_as_CancelReadingRequest()) {
+        id = request->command_id(); signature = "cancel-reading:" + std::to_string(request->activity_token());
+    } else if (const auto* request = msg->payload_as_CancelFirstAidRequest()) {
+        id = request->command_id(); signature = "cancel-first-aid:" + std::to_string(request->activity_token());
+    } else if (const auto* request = msg->payload_as_CancelConsumptionRequest()) {
+        id = request->command_id(); signature = "cancel-consumption:" + std::to_string(request->activity_token());
+    } else if (const auto* request = msg->payload_as_ItemTransferRequest()) {
+        id = request->command_id(); signature = "item-transfer:" + std::to_string(request->view_id()) + ":" +
+            std::to_string(request->item_id()) + ":" + std::to_string(request->quantity()) + ":" +
+            std::to_string(request->destination_id()) + ":" + std::to_string(int(request->action()));
+    } else if (const auto* request = msg->payload_as_CancelItemTransferRequest()) {
+        id = request->command_id(); signature = "cancel-item-transfer:" + std::to_string(request->activity_token());
+    } else if (const auto* request = msg->payload_as_QuickbarSwapRequest()) {
+        if (!request->expected_source() || !request->expected_target() ||
+            request->expected_source()->size() != 32 || request->expected_target()->size() > 32 ||
+            !Hotbar::valid_identity(request->expected_source()->str()) ||
+            (request->expected_target()->size() && !Hotbar::valid_identity(request->expected_target()->str()))) {
+            server_->client()->close(); return;
+        }
+        id = request->command_id(); signature = "quick-swap:" + std::to_string(request->source_slot()) + ":" +
+            std::to_string(request->target_slot()) + ":" + request->expected_source()->str() + ":" + request->expected_target()->str();
+    } else if (const auto* request = msg->payload_as_InventoryArrangeRequest()) {
+        id = request->command_id(); signature = "inventory-arrange:" + std::to_string(request->view_id()) + ":" +
+            std::to_string(request->item_id()) + ":" + std::to_string(request->before_item_id());
+    } else if (const auto* request = msg->payload_as_QuickbarBindRequest()) {
+        if (!request->expected_binding_id() || request->expected_binding_id()->size() > 32 ||
+            (request->expected_binding_id()->size() && !Hotbar::valid_identity(request->expected_binding_id()->str()))) { server_->client()->close(); return; }
+        id = request->command_id(); signature = "quick-bind:" + std::to_string(request->slot()) + ":" +
+            std::to_string(request->view_id()) + ":" + std::to_string(request->item_id()) + ":" + request->expected_binding_id()->str();
+    } else if (const auto* request = msg->payload_as_QuickbarUseRequest()) {
+        if (!request->binding_id() || !Hotbar::valid_identity(request->binding_id()->str())) { server_->client()->close(); return; }
+        id = request->command_id(); signature = "quick-use:" + std::to_string(request->slot()) + ":" +
+            request->binding_id()->str() + ":" + std::to_string(int(request->action()));
+    } else if (const auto* request = msg->payload_as_EquipmentRequest()) {
+        id = request->command_id(); signature = "equipment:" + std::to_string(request->view_id()) +
+            ":" + std::to_string(request->item_id()) + ":" + std::to_string(int(request->action()));
+    } else if (const auto* request = msg->payload_as_MovementModeRequest()) {
+        id = request->command_id(); signature = "mode:" + std::to_string(int(request->mode()));
+    } else if (const auto* request = msg->payload_as_TalkRequest()) {
+        id = request->command_id(); signature = "talk:" + std::to_string(request->target_entity_id());
+    } else if (const auto* request = msg->payload_as_AttackRequest()) {
+        id = request->command_id(); signature = "attack:" + std::to_string(request->target_entity_id());
+    } else if (const auto* request = msg->payload_as_AcknowledgeThreatRequest()) {
+        id = request->command_id(); signature = "threat";
+    } else if (const auto* request = msg->payload_as_MovementIntentRequest()) {
+        id = request->command_id(); signature = "intent:" + std::to_string(int(request->direction()));
+    } else if (const auto* request = msg->payload_as_ContinuousIntentRequest()) {
+        uint32_t xb, yb; const float x = request->x(), y = request->y();
+        std::memcpy(&xb, &x, sizeof(xb)); std::memcpy(&yb, &y, sizeof(yb));
+        id = request->command_id(); signature = "continuous:" + std::to_string(xb) + ":" + std::to_string(yb);
+    } else if (const auto* request = msg->payload_as_SimulationControlRequest()) {
+        uint32_t scale_bits; const float scale = request->time_scale();
+        std::memcpy(&scale_bits, &scale, sizeof(scale_bits));
+        id = request->command_id(); signature = "clock:" + std::to_string(int(request->action())) + ":" + std::to_string(scale_bits);
+    } else { server_->client()->close(); return; }
+    const auto status = ledger_.begin(client_id_, id, signature);
+    using Status = cdda::cwm::CommandLedger::Status;
+    if (status == Status::Pending) return;
+    if (status == Status::Complete) {
+        const auto outcome = ledger_.find(id)->outcome;
+        cdda::cwm::MessageBuilder reply(sequence_counter_, world_revision_, identity_);
+        if (emit(reply.build_command_ack(id, outcome.accepted, outcome.error, outcome.revision)))
+            send_state(u, m, g, true, id);
+        return;
+    }
+    if (status == Status::Expired) { send_result({id, false, "Command identity expired"}, u, m, g); return; }
+    if (status != Status::Fresh) { server_->client()->close(); return; }
+    if(const auto* request=msg->payload_as_MissionTrackRequest()) {
+        const auto error=mission_journal_.track(u,request->view_id(),request->mission_id(),request->expected_tracked_id());
+        if(error.empty())++world_revision_;
+        send_result({id,error.empty(),error},u,m,g);return; // Native UI selection, no gameplay turn or move cost.
+    }
+    if(const auto* request=msg->payload_as_CraftingFavoriteRequest()) {
+        const auto error=crafting_selection_.set_favorite(u,request->view_id(),request->entry_id(),request->favorite(),request->expected_favorite());
+        if(error.empty())++world_revision_;
+        send_result({id,error.empty(),error},u,m,g);return; // Native UI metadata, no action/debit/queue.
+    }
+    if (const auto* request = msg->payload_as_QuickbarSwapRequest()) {
+        const auto error = Hotbar::swap(u, request->source_slot(), request->target_slot(),
+            request->expected_source()->str(), request->expected_target()->str());
+        if (error.empty()) ++world_revision_;
+        send_result({id, error.empty(), error}, u, m, g); return;
+    }
+    if (const auto* request = msg->payload_as_InventoryArrangeRequest()) {
+        const auto error = inventory_selection_.arrange(u, request->view_id(), request->item_id(), request->before_item_id());
+        if (error.empty()) ++world_revision_;
+        send_result({id, error.empty(), error}, u, m, g); return;
+    }
+    if (const auto* request = msg->payload_as_QuickbarBindRequest()) {
+        auto error = request->slot() < 1 || request->slot() > 9 ? std::string("Invalid quick slot.") : std::string{};
+        item_location location;
+        if (error.empty() && request->item_id()) {
+            error = inventory_selection_.validate_binding(u, request->view_id(), request->item_id());
+            if (error.empty()) location = inventory_selection_.target(request->item_id());
+        } else if (!request->item_id() && request->view_id()) error = "Clear does not take an inventory view.";
+        if (error.empty()) error = Hotbar::bind(u, request->slot(), location, request->expected_binding_id()->str());
+        if (error.empty()) ++world_revision_;
+        send_result({id, error.empty(), error}, u, m, g);
+        return; // UI assignment has no action, move debit or calendar advancement.
+    }
+    if (msg->payload_as_CancelConsumptionRequest() || msg->payload_as_CancelFirstAidRequest() || msg->payload_as_CancelCraftingRequest() || msg->payload_as_CancelReloadRequest() || msg->payload_as_CancelItemTransferRequest() || msg->payload_as_CancelReadingRequest() || msg->payload_as_CancelDisassemblyRequest()) {
+        const auto* meal = msg->payload_as_CancelConsumptionRequest();
+        const auto* aid = msg->payload_as_CancelFirstAidRequest();
+        const auto* craft = msg->payload_as_CancelCraftingRequest();
+        const auto* reload = msg->payload_as_CancelReloadRequest();
+        const auto* transfer = msg->payload_as_CancelItemTransferRequest();
+        const auto* reading = msg->payload_as_CancelReadingRequest();
+        const auto* disassembly = msg->payload_as_CancelDisassemblyRequest();
+        const auto token = disassembly ? disassembly->activity_token() : reading ? reading->activity_token() : transfer ? transfer->activity_token() : meal ? meal->activity_token() : aid ? aid->activity_token() : craft ? craft->activity_token() : reload->activity_token();
+        refresh_activity(u);
+        const bool valid = activity_token_ && token == activity_token_ &&
+            (transfer ? (u.activity.id() == activity_id("ACT_DROP") || u.activity.id() == activity_id("ACT_INSERT_ITEM") || u.activity.id() == activity_id("ACT_PICKUP")) :
+             u.activity.id() == activity_id(disassembly ? "ACT_DISASSEMBLE" : reading ? "ACT_READ" : meal ? "ACT_CONSUME" : aid ? "ACT_FIRSTAID" : craft ? "ACT_CRAFT" : "ACT_RELOAD")) &&
+            u.activity.is_interruptible() && (!realtime_ || !pause_reasons(g));
+        if (valid) {
+            u.cancel_activity(); // Native interruption/backlog rules, no refund.
+            inventory_work_command_ = id; inventory_work_settled_ = false;
+            activity_token_ = 0; inventory_selection_.clear(); crafting_selection_.clear(); ++world_revision_;
+        }
+        send_result({id, valid, valid ? "" : ::cwm::tr("Activity finished, changed or game paused.", "Attivita conclusa, cambiata o gioco in pausa.")}, u, m, g);
+        return; // Never enqueue cancellation behind the busy native activity.
+    }
+    if (const auto* request = msg->payload_as_ContinuousIntentRequest()) {
+        const float x = request->x(), y = request->y();
+        const double length = std::hypot(double(x), double(y));
+        const uint32_t reasons = pause_reasons(g);
+        const bool recovery_only =
+            !ready_ && awaiting_state_ &&
+            reasons == static_cast<uint32_t>(cdda::cwm::Recovery);
+        const bool input_available = reasons == 0 || recovery_only;
+        const bool valid =
+            continuous_ &&
+            std::isfinite(x) &&
+            std::isfinite(y) &&
+            length <= 1.415 &&
+            (length < 1e-6 ||
+             (input_available &&
+              !u.activity &&
+              !u.in_vehicle &&
+              !u.is_mounted() &&
+              u.get_grab_type() == object_type::NONE));
+        if (valid) {
+            // Account for the old direction up to admission, including a
+            // short tap. Frequent camera changes cannot postpone sampling.
+            sample_motion(u, m, g, true);
+            intent_x_ = length < 1e-6 || !input_available ? 0 : x / length;
+            intent_y_ = length < 1e-6 || !input_available ? 0 : y / length;
+            motion_sample_ = clock_.elapsed(); ++world_revision_;
+        }
+        send_result({id, valid, valid ? "" : "Continuous intent unavailable or invalid"}, u, m, g);
+        return;
+    }
+    if (const auto* request = msg->payload_as_MovementIntentRequest()) {
+        const int direction = int(request->direction());
+        const bool valid = realtime_ && !continuous_ && direction >= 0 && direction <= 8 &&
+            (direction == 0 || (!u.activity && !pause_reasons(g)));
+        if (valid) { held_direction_ = direction; ++world_revision_; }
+        send_result({id, valid, valid ? "" : "Movement intent unavailable or invalid"}, u, m, g);
+        return;
+    }
+    if (const auto* request = msg->payload_as_SimulationControlRequest()) {
+        bool valid = realtime_;
+        using CDDA::CWM::SimulationControl;
+        if (valid) switch (request->action()) {
+            case SimulationControl::PAUSE: manual_pause_ = true; drop_realtime_input(u, m, g); break;
+            case SimulationControl::RESUME: manual_pause_ = false; break;
+            case SimulationControl::SET_SPEED: {
+                const float previous = static_cast<float>(clock_.scale());
+                valid = clock_.set_scale(request->time_scale());
+                if (valid) motion_seconds_ = std::clamp(motion_seconds_ * previous / request->time_scale(), .05f, 60.f);
+                break;
+            }
+            case SimulationControl::MENU_OPEN: menu_pause_ = true; drop_realtime_input(u, m, g); break;
+            case SimulationControl::MENU_CLOSE: menu_pause_ = false; break;
+            default: valid = false; break;
+        }
+        if (valid) ++world_revision_;
+        send_result({id, valid, valid ? "" : "Clock control unavailable or invalid"}, u, m, g);
+        return;
+    }
+    if (msg->payload_type() == CDDA::CWM::Payload::AcknowledgeThreatRequest) {
+        const auto* request = msg->payload_as_AcknowledgeThreatRequest();
+        if (!request) return;
+        const bool acknowledged = acknowledge_current_threat(u);
+        if (acknowledged || threat_pause_) ++world_revision_;
+        if (realtime_) { threat_pause_ = false; held_direction_ = 0; intent_x_ = intent_y_ = 0; }
+        send_result(Result{request->command_id(), true, ""}, u, m, g);
+        return;
+    }
+    Command command{};
+    std::string error;
+    if (msg->payload_type() == CDDA::CWM::Payload::MoveRequest) {
+        const auto* request = msg->payload_as_MoveRequest();
+        if (!request) return;
+        command = Command{request->command_id(), true, int(request->direction())};
+        if (command.action < 0 || command.action > int(CDDA::CWM::MoveDirection::DOWN))
+            error = "Unsupported movement direction";
+        else if (continuous_ && command.action > 0 && command.action < int(CDDA::CWM::MoveDirection::UP))
+            error = "Continuous mode requires direction intent for horizontal movement";
+        else if (!g.check_safe_mode_allowed(false)) error = "Safe mode: threat requires acknowledgement";
+        else if (command.action >= int(CDDA::CWM::MoveDirection::UP))
+            error = vertical_error(u, m, command.action);
+        else if (command.action != 0) {
+            const tripoint target = u.pos() + tripoint(directions[command.action], 0);
+            if (!m.inbounds(target)) error = "Movement target outside reality bubble";
+            else if (m.impassable(target) && !get_creature_tracker().creature_at(target, true) &&
+                     !m.open_door(u, target, !m.is_outside(u.pos()), true)) error = "Movement blocked";
+        }
+    } else if (const auto* request = msg->payload_as_RangedRequest()) {
+        command.id=request->command_id();command.ranged_weapon=request->weapon_token();command.ranged_target=request->target_entity_id();command.ranged_action=int(request->action());
+        error=ranged_selection_.validate(u,g,command.ranged_weapon,command.ranged_target,command.ranged_action);
+        if (!g.check_safe_mode_allowed(false)) error="Safe mode: threat requires acknowledgement";
+    } else if (const auto* request = msg->payload_as_CraftingRequest()) {
+        command.id = request->command_id(); command.crafting_view = request->view_id();
+        command.crafting_entry = request->entry_id();
+        error = crafting_selection_.validate(u, command.crafting_view, command.crafting_entry);
+    } else if (const auto* request = msg->payload_as_ItemTransferRequest()) {
+        command.id = request->command_id(); command.inventory_view = request->view_id(); command.inventory_item = request->item_id();
+        command.transfer_quantity = request->quantity(); command.transfer_destination = request->destination_id(); command.transfer_action = int(request->action());
+        error = inventory_selection_.validate_transfer(u, command.inventory_view, command.inventory_item,
+            command.transfer_quantity, command.transfer_destination, command.transfer_action);
+    } else if (const auto* request = msg->payload_as_QuickbarUseRequest()) {
+        command.id = request->command_id(); command.quick_slot = request->slot();
+        command.quick_binding = request->binding_id()->str(); command.equipment_action = int(request->action());
+        auto location = Hotbar::resolve(u, command.quick_slot, command.quick_binding);
+        error = location ? InventorySelection::action_error(u, location, command.equipment_action) : "Quick item lost or slot changed.";
+    } else if (const auto* request = msg->payload_as_EquipmentRequest()) {
+        command.id = request->command_id();
+        command.inventory_view = request->view_id(); command.inventory_item = request->item_id();
+        command.equipment_action = int(request->action());
+        error = inventory_selection_.validate(u, command.inventory_view, command.inventory_item, command.equipment_action);
+    } else if (msg->payload_type() == CDDA::CWM::Payload::MovementModeRequest) {
+        const auto* request = msg->payload_as_MovementModeRequest();
+        command.id = request->command_id();
+        command.movement_mode = int(request->mode());
+        if (!valid_mode(command.movement_mode)) error = "Unsupported movement mode";
+        else if (!u.can_switch_to(mode_ids[command.movement_mode])) error = "Native movement mode unavailable";
+    } else if (const auto* request = msg->payload_as_TalkRequest()) {
+        command.id = request->command_id(); command.talk_target = request->target_entity_id();
+        error = conversation_error(command.talk_target,u,g);
+        if (error.empty() && !g.check_safe_mode_allowed(false)) error = "Safe mode: threat requires acknowledgement";
+    } else if (msg->payload_type() == CDDA::CWM::Payload::AttackRequest) {
+        const auto* request = msg->payload_as_AttackRequest();
+        command.id = request->command_id();
+        command.attack_target = request->target_entity_id();
+        if (!attack_target(command.attack_target, u, m, g))
+            error = "Melee target unavailable, not hostile or out of reach";
+        else if (!g.check_safe_mode_allowed(false)) error = "Safe mode: threat requires acknowledgement";
+    } else if (msg->payload_type() == CDDA::CWM::Payload::InteractRequest) {
+        const auto* request = msg->payload_as_InteractRequest();
+        if (!request) return;
+        command = Command{request->command_id(), false, int(request->action())};
+        if (!request->target_coord()) error = "Missing interaction target";
+        else {
+            const auto* p = request->target_coord();
+            // Check bounds before arithmetic on untrusted coordinates.
+            if (p->z() != u.posz() || p->x() < u.posx()-1 || p->x() > u.posx()+1 ||
+                p->y() < u.posy()-1 || p->y() > u.posy()+1) error = "Interaction target out of reach";
+            else {
+                const tripoint local(p->x(), p->y(), p->z());
+                const tripoint absolute = m.getabs(local);
+                command.x = absolute.x; command.y = absolute.y; command.z = absolute.z;
+                const bool inside = !m.is_outside(u.pos());
+                if (command.action == int(CDDA::CWM::InteractAction::OPEN)) {
+                    if (!m.open_door(u, local, inside, true)) error = "Target cannot be opened";
+                } else if (command.action == int(CDDA::CWM::InteractAction::CLOSE)) {
+                    if (!m.close_door(local, inside, true)) error = "Target cannot be closed";
+                    else if (continuous_ && cwm_motion::overlaps_tile(u,m,local))
+                        error = ::cwm::tr("Move away from the opening before closing it.", "Allontanati dal varco prima di chiuderlo.");
+                } else if (command.action == int(CDDA::CWM::InteractAction::PICKUP)) {
+                    if (!request->pickup_type_id() || request->pickup_type_id()->str().empty()) {
+                        error = "Missing pickup item guard";
+                    } else {
+                        command.pickup_stack_index = request->pickup_stack_index();
+                        command.pickup_type_id = request->pickup_type_id()->str();
+                        command.pickup_charges = request->pickup_charges();
+                        command.pickup_count_by_charges = request->pickup_count_by_charges();
+                    }
+                } else error = "Interaction not implemented";
+            }
+        }
+    } else return;
+    if (u.activity) error = ::cwm::tr("Interrupt or finish the activity before acting.", "Interrompi o concludi l'attivita prima di agire.");
+    if (commands_.size() >= 32) error = "Command queue full";
+    if (realtime_ && pause_reasons(g)) error = "Simulation is paused";
+    if (!error.empty()) send_result(Result{command.id, false, error}, u, m, g);
+    else commands_.push_back(command);
+}
