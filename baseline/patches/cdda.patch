index 0000000..75e5283
--- /dev/null
+++ b/src/cwm/cwm_map_exporter.cpp
@@ -0,0 +1,324 @@
+// CDDA CWM Map & Entity Exporter Implementation
+// Licensed under Apache-2.0
+
+#include "cwm_map_exporter.h"
+#include "cwm/tile_semantics.hpp"
+#include "mapdata.h"
+#include "cwm/cwm_protocol.hpp"
+
+#include "avatar.h"
+#include "game.h"
+#include "map.h"
+#include "monster.h"
+#include "calendar.h"
+#include "mtype.h"
+#include "vehicle.h"
+#include "field.h"
+#include "units.h"
+
+namespace cwm {
+
+CDDA::CWM::CwmBlock CwmMapExporter::export_block(const tripoint& p, map& m, uint8_t light) {
+    using namespace cdda::cwm;
+    if (!m.inbounds(p)) return CDDA::CWM::CwmBlock(0, AIR, light, 0);
+    const ter_t& t = m.ter(p).obj();
+    const furn_t& f = m.furn(p).obj();
+    const bool blocked = m.impassable_ter_furn(p);
+    uint32_t flags = 0;
+    if (blocked) flags |= BLOCKS_MOVEMENT;
+    uint16_t material = DIRT;
+    const std::string& id = t.id.str();
+    const bool door = t.has_flag(ter_furn_flag::TFLAG_DOOR) ||
+        (!t.close.is_null() && t.close.obj().has_flag(ter_furn_flag::TFLAG_DOOR));
+    if (id == "t_null" || t.has_flag(ter_furn_flag::TFLAG_NO_FLOOR)) material = AIR;
+    else if (t.has_flag(ter_furn_flag::TFLAG_WINDOW)) {
+        material = t.movecost > 0 ? WINDOW_OPEN :
+                   t.has_flag(ter_furn_flag::TFLAG_TRANSPARENT) ? WINDOW : WINDOW_BOARDED;
+    } else if (door) {
+        flags |= DOOR;
+        material = t.has_flag(ter_furn_flag::TFLAG_DOOR) ? DOOR_CLOSED : DOOR_OPEN;
+    } else if (t.has_flag(ter_furn_flag::TFLAG_WALL)) {
+        material = t.movecost > 0 ? LOW_OBSTACLE :
+                   t.has_flag(ter_furn_flag::TFLAG_TRANSPARENT) ? GLASS_WALL : WALL;
+    } else if (t.has_flag(ter_furn_flag::TFLAG_SWIMMABLE)) material = WATER;
+    else if (t.movecost == 0) material = OBSTACLE;
+    else if (id.find("grass") != std::string::npos) material = GRASS;
+    else if (id.find("pavement") != std::string::npos || id == "t_sidewalk" ||
+             id.find("asphalt") != std::string::npos) material = PAVEMENT;
+    else if (t.has_flag(ter_furn_flag::TFLAG_INDOORS) || id.find("floor") != std::string::npos ||
+             id.find("stairs") != std::string::npos || id.find("roof") != std::string::npos)
+        material = FLOOR;
+    if (!f.id.is_null()) {
+        flags |= FURNITURE;
+        if (blocked && !f.has_flag(ter_furn_flag::TFLAG_SHORT)) flags |= TALL_FURNITURE;
+    }
+    uint8_t orientation = 0;
+    if (door || t.has_flag(ter_furn_flag::TFLAG_WINDOW)) {
+        const auto connects = [&m](const tripoint& neighbor) {
+            if (!m.inbounds(neighbor)) return false;
+            const auto& terrain = m.ter(neighbor).obj();
+            return terrain.has_flag(ter_furn_flag::TFLAG_WALL) || terrain.has_flag(ter_furn_flag::TFLAG_CONNECT_WITH_WALL);
+        };
+        const int east_west = connects(p + tripoint_east) + connects(p + tripoint_west);
+        const int north_south = connects(p + tripoint_north) + connects(p + tripoint_south);
+        orientation = north_south > east_west ? 1 : 0;
+    }
+    return CDDA::CWM::CwmBlock(flags, material, light, orientation);
+}
+
+std::vector<uint8_t> CwmMapExporter::export_world_snapshot(
+    uint64_t sequence_num,
+    uint64_t world_rev,
+    const avatar& u,
+    map& m,
+    game& g,
+    bool include_chunks,
+    ProjectionCache* cache
+) {
+    cdda::cwm::MessageBuilder builder(sequence_num, world_rev);
+    auto& fbb = builder.builder();
+
+    tripoint u_pos = u.pos();
+
+    // 1. Origin
+    // Inform client of absolute submap origin where cx=0, cy=0 starts
+    tripoint sub = m.get_abs_sub().raw();
+    CDDA::CWM::Coord3i origin(sub.x * 12, sub.y * 12, u_pos.z - 1);
+
+    // 2. Chunks (Export 8x8 grid of 16x16 blocks across multi-Z levels: z-1, z, z+1)
+
+    std::vector<flatbuffers::Offset<CDDA::CWM::ChunkSnapshot>> chunk_offsets;
+
+    int z_min = u_pos.z - 1;
+    int z_max = u_pos.z + 1;
+
+    // Cache the complete semantic projection. Changes from auto-opening doors,
+    // furniture and monster actions share the same end-of-action export path.
+    const tripoint cache_origin(sub.x, sub.y, u_pos.z);
+    constexpr size_t tile_count = 3 * 9 * 9 * 16 * 16;
+    if (cache && (cache->origin != cache_origin || cache->tiles.size() != tile_count))
+        include_chunks = true;
+    if (cache && include_chunks) {
+        cache->origin = cache_origin;
+        cache->tiles.assign(tile_count, 0);
+    }
+    std::vector<flatbuffers::Offset<CDDA::CWM::TileDelta>> tile_offsets;
+    size_t cache_index = 0;
+    for (int z_level = z_min; z_level <= z_max; ++z_level) {
+        float nat_light = g.natural_light_level(z_level);
+        uint8_t ambient_light = static_cast<uint8_t>(std::clamp(static_cast<int>(nat_light / 6.0f), 1, 15));
+        for (int cy = 0; cy < 9; ++cy) {
+            for (int cx = 0; cx < 9; ++cx) {
+                std::vector<CDDA::CWM::CwmBlock> blocks;
+                if (include_chunks) blocks.reserve(256);
+                for (int by = 0; by < 16; ++by) {
+                    for (int bx = 0; bx < 16; ++bx, ++cache_index) {
+                        const tripoint p(cx * 16 + bx, cy * 16 + by, z_level);
+                        const auto block = export_block(p, m, ambient_light);
+                        const uint64_t packed = block.state_flags() |
+                            (static_cast<uint64_t>(block.material_id()) << 32) |
+                            (static_cast<uint64_t>(block.light_level()) << 48) |
+                            (static_cast<uint64_t>(block.orientation()) << 56);
+                        if (include_chunks) blocks.push_back(block);
+                        else if (cache && cache->tiles[cache_index] != packed) {
+                            const CDDA::CWM::Coord3i coord(p.x, p.y, p.z);
+                            tile_offsets.push_back(CDDA::CWM::CreateTileDelta(fbb, &coord, &block));
+                        }
+                        if (cache) cache->tiles[cache_index] = packed;
+                    }
+                }
+                if (include_chunks) {
+                    const auto vector = fbb.CreateVectorOfStructs(blocks);
+                    chunk_offsets.push_back(CDDA::CWM::CreateChunkSnapshot(
+                        fbb, cx, cy, z_level, 16, 16, 1, vector));
+                }
+            }
+        }
+    }
+    auto chunks_vec = include_chunks ? fbb.CreateVector(chunk_offsets) : 0;
+    const auto tiles_vec = fbb.CreateVector(tile_offsets);
+
+    // 3. Entities (Player + Monsters)
+    std::vector<flatbuffers::Offset<CDDA::CWM::EntityState>> entity_offsets;
+
+    // Player
+    {
+        auto player_name = fbb.CreateString(u.name.empty() ? "Player" : u.name);
+        auto player_type = fbb.CreateString("avatar");
+        CDDA::CWM::Vec3f pos(static_cast<float>(u_pos.x), static_cast<float>(u_pos.y), static_cast<float>(u_pos.z));
+
+        auto player_state = CDDA::CWM::CreateEntityState(
+            fbb,
+            1, // Player authoritative ID is 1
+            CDDA::CWM::EntityType::PLAYER,
+            player_type,
+            &pos,
+            0.0f,
+            0,
+            100,
+            player_name
+        );
+        entity_offsets.push_back(player_state);
+    }
+
+    // Monsters
+    uint64_t mon_counter = 1000;
+    for (monster& critter : g.all_monsters()) {
+        if (!critter.is_hallucination() && !critter.is_dead()) {
+            tripoint m_pos = critter.pos();
+            auto mon_name = fbb.CreateString(critter.name());
+            auto mon_type = fbb.CreateString(critter.type->id.str());
+            CDDA::CWM::Vec3f pos(static_cast<float>(m_pos.x), static_cast<float>(m_pos.y), static_cast<float>(m_pos.z));
+
+            uint8_t hp_pct = 100;
+            if (critter.get_hp_max() > 0) {
+                hp_pct = static_cast<uint8_t>((critter.get_hp() * 100) / critter.get_hp_max());
+            }
+
+            uint64_t entity_id = mon_counter++;
+            auto mon_state = CDDA::CWM::CreateEntityState(
+                fbb,
+                entity_id,
+                CDDA::CWM::EntityType::MONSTER,
+                mon_type,
+                &pos,
+                0.0f,
+                0,
+                hp_pct,
+                mon_name
+            );
+            entity_offsets.push_back(mon_state);
+        }
+    }
+
+    auto entities_vec = fbb.CreateVector(entity_offsets);
+
+    // 4. Vehicles
+    std::vector<flatbuffers::Offset<CDDA::CWM::VehicleState>> vehicle_offsets;
+    for (const wrapped_vehicle& wv : m.get_vehicles()) {
+        if (!wv.v) continue;
+        vehicle* veh = wv.v;
+        auto veh_name = fbb.CreateString(veh->name);
+        CDDA::CWM::Vec3f pivot(static_cast<float>(wv.pos.x), static_cast<float>(wv.pos.y), static_cast<float>(wv.pos.z));
+        CDDA::CWM::Vec3f vel(0.0f, 0.0f, 0.0f);
+        float rot = static_cast<float>(to_degrees(veh->face.dir()));
+
+        std::vector<flatbuffers::Offset<CDDA::CWM::VehicleComponentState>> comp_offsets;
+        int num_parts = veh->part_count();
+        for (int pi = 0; pi < num_parts; ++pi) {
+            const auto& part = veh->part(pi);
+            auto part_name = fbb.CreateString(part.name());
+            CDDA::CWM::Vec3f part_offset(static_cast<float>(part.mount.x), static_cast<float>(part.mount.y), 0.0f);
+            comp_offsets.push_back(CDDA::CWM::CreateVehicleComponentState(
+                fbb,
+                part_name,
+                &part_offset,
+                part.is_broken(),
+                part.open
+            ));
+        }
+
+        auto comps_vec = fbb.CreateVector(comp_offsets);
+        vehicle_offsets.push_back(CDDA::CWM::CreateVehicleState(
+            fbb,
+            reinterpret_cast<uint64_t>(veh),
+            veh_name,
+            &pivot,
+            rot,
+            &vel,
+            comps_vec
+        ));
+    }
+    auto vehicles_vec = fbb.CreateVector(vehicle_offsets);
+
+
+    // 5. Dynamic Fields (Fire, smoke, gas)
+    std::vector<flatbuffers::Offset<CDDA::CWM::FieldState>> field_offsets;
+    if (include_chunks) {
+        for (int z_level = z_min; z_level <= z_max; ++z_level) {
+            for (int y = 0; y < 128; ++y) {
+                for (int x = 0; x < 128; ++x) {
+                    tripoint p(x, y, z_level);
+                    if (m.has_field_at(p)) {
+                        const field& fld = m.field_at(p);
+                        for (const auto& pair : fld) {
+                            const field_type_id& ftype = pair.first;
+                            const field_entry& fentry = pair.second;
+                            uint16_t fid = 1;
+                            std::string fstr = ftype.id().str();
+                            if (fstr.find("smoke") != std::string::npos) fid = 2;
+                            else if (fstr.find("fire") != std::string::npos) fid = 1;
+                            else fid = 3;
+
+                            CDDA::CWM::Coord3i coord(p.x, p.y, p.z);
+                            uint8_t density = static_cast<uint8_t>(fentry.get_field_intensity());
+                            uint32_t age = static_cast<uint32_t>(to_turns<int>(fentry.get_field_age()));
+                            field_offsets.push_back(CDDA::CWM::CreateFieldState(fbb, &coord, fid, density, age));
+                        }
+                    }
+                }
+            }
+        }
+    }
+    auto fields_vec = fbb.CreateVector(field_offsets);
+
+    uint64_t sim_seconds = static_cast<uint64_t>(to_turn<int>(calendar::turn));
+
+    auto world_snap = CDDA::CWM::CreateWorldSnapshot(
+        fbb,
+        world_rev,
+        &origin,
+        sim_seconds,
+        chunks_vec,
+        entities_vec,
+        vehicles_vec,
+        fields_vec,
+        tiles_vec
+    );
+
+    return builder.finish_message(CDDA::CWM::Payload::WorldSnapshot, world_snap.Union());
+}
+
+std::vector<uint8_t> CwmMapExporter::export_tile_delta(
+    uint64_t sequence_num,
+    uint64_t world_rev,
+    const tripoint& p,
+    map& m
+) {
+    cdda::cwm::MessageBuilder builder(sequence_num, world_rev);
+
+    const auto block = export_block(p, m, 15);
+    return builder.build_tile_delta(p.x, p.y, p.z, block.material_id(),
+                                    block.state_flags(), block.light_level(), block.orientation());
+}
+
+std::vector<uint8_t> CwmMapExporter::export_entity_delta(
+    uint64_t sequence_num,
+    uint64_t world_rev,
+    uint64_t entity_id,
+    float x, float y, float z,
+    float rotation,
+    uint16_t anim_hint
+) {
+    cdda::cwm::MessageBuilder builder(sequence_num, world_rev);
+    auto& fbb = builder.builder();
+
+    CDDA::CWM::Vec3f pos(x, y, z);
+    auto empty_str = fbb.CreateString("");
+
+    auto state = CDDA::CWM::CreateEntityState(
+        fbb,
+        entity_id,
+        (entity_id == 1) ? CDDA::CWM::EntityType::PLAYER : CDDA::CWM::EntityType::MONSTER,
+        empty_str,
+        &pos,
+        rotation,
+        anim_hint,
+        100,
+        empty_str
+    );
+
+    return builder.finish_message(CDDA::CWM::Payload::EntityState, state.Union());
+}
+
+} // namespace cwm
