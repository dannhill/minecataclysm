+    avatar& u = get_avatar();
+    const tripoint p(60, 60, 0);
+    u.setpos(p);
+    for (const auto& id : {"t_stairs_up", "t_stairs_down", "t_ladder_up_down", "t_water_cube", "t_floor"}) {
+        CAPTURE(id);
+        m.ter_set(p, ter_str_id(id));
+        auto bytes = cwm::CwmMapExporter::export_world_snapshot(1, 1, u, m, *g, true);
+        const auto* player = CDDA::CWM::GetCwmMessage(bytes.data())->payload_as_WorldSnapshot()->entities()->Get(0);
+        const bool dry = !m.has_flag(ter_furn_flag::TFLAG_SWIMMABLE, p);
+        CHECK(bool(player->state_flags() & ON_UP_CONNECTION) ==
+              (dry && m.has_flag(ter_furn_flag::TFLAG_GOES_UP, p)));
+        CHECK(bool(player->state_flags() & ON_DOWN_CONNECTION) ==
+              (dry && m.has_flag(ter_furn_flag::TFLAG_GOES_DOWN, p)));
+    }
