+++ b/src/cwm/cwm_main.cpp
@@ -0,0 +1,221 @@
+// CDDA Headless CWM Server Entrypoint
+// Licensed under Apache-2.0
+
+#include <iostream>
+#include <string>
+#include <vector>
+#include <csignal>
+#include <thread>
+#include <chrono>
+
+#include "cwm_server.h"
+#include "cwm_map_exporter.h"
+
+#include "cached_options.h"
+#include "path_info.h"
+#include "filesystem.h"
+#include "options.h"
+#include "color.h"
+#include "game.h"
+#include "avatar.h"
+#include "map.h"
+#include "worldfactory.h"
+#include "loading_ui.h"
+#include "weather.h"
+#include "overmapbuffer.h"
+#include "overmap.h"
+#include "debug.h"
+#include "coordinate_conversions.h"
+#include <flatbuffers/util.h>
+
+#if defined(FLATBUFFERS_LOCALE_INDEPENDENT) && (FLATBUFFERS_LOCALE_INDEPENDENT > 0)
+namespace flatbuffers {
+ClassicLocale ClassicLocale::instance_;
+}
+#endif
+
+static volatile bool g_running = true;
+
+static void sig_handler(int) {
+    g_running = false;
+}
+
+static const mod_id MOD_DDA("dda");
+
+int main(int argc, const char* argv[]) {
+    std::string socket_path = "/tmp/cdda_cwm.sock";
+    std::string world_name = "cwm_world";
+    std::string user_dir = "./user";
+    std::string data_dir = "";
+    int headless_ticks = 0;
+
+    for (int i = 1; i < argc; ++i) {
+        std::string arg = argv[i];
+        if (arg == "--socket" && i + 1 < argc) {
+            socket_path = argv[++i];
+        } else if (arg == "--world" && i + 1 < argc) {
+            world_name = argv[++i];
+        } else if (arg == "--userdir" && i + 1 < argc) {
+            user_dir = argv[++i];
+        } else if (arg == "--datadir" && i + 1 < argc) {
+            data_dir = argv[++i];
+        } else if (arg == "--headless-ticks" && i + 1 < argc) {
+            headless_ticks = std::stoi(argv[++i]);
+        } else if (arg == "--help" || arg == "-h") {
+            std::cout << "Usage: cdda-server [options]\n"
+                      << "  --socket <path>       Unix domain socket path (default: /tmp/cdda_cwm.sock)\n"
+                      << "  --world <name>        World name to load or create (default: cwm_world)\n"
+                      << "  --userdir <path>      User directory for savegames and config (default: ./user)\n"
+                      << "  --datadir <path>      Data directory (default: auto-detected)\n"
+                      << "  --headless-ticks <n>  Advance n simulation turns headlessly and save (Milestone 0.5 verification)\n"
+                      << "  --help                Show this help message\n";
+            return 0;
+        }
+    }
+
+    std::signal(SIGINT, sig_handler);
+    std::signal(SIGTERM, sig_handler);
+
+    std::cout << "========================================================\n"
+              << " Cataclysm: Dark Days Ahead - Headless CWM Server v1.0\n"
+              << " Simulation & Persistence Authority\n"
+              << "========================================================\n";
+
+    // Set test_mode = true to ensure NO curses windows or escape sequences are created
+    test_mode = true;
+
+    if (data_dir.empty()) {
+        std::vector<std::string> candidates = {
+            "data",
+            "cdda/data",
+            "../data",
+            "../../data",
+            "../cdda/data",
+            "/home/dannhill/Projects/cdda-mineclonia/cdda/data"
+        };
+        try {
+            fs::path exe_dir = fs::path(argv[0]).parent_path();
+            candidates.push_back((exe_dir / ".." / "data").string());
+            candidates.push_back((exe_dir / ".." / ".." / "data").string());
+            candidates.push_back((exe_dir / ".." / ".." / "cdda" / "data").string());
+        } catch (...) {}
+
+        for (const auto& c : candidates) {
+            if (dir_exist(c) && file_exist(c + "/raw/keybindings.json")) {
+                data_dir = c;
+                break;
+            }
+        }
+    }
+
+    assure_dir_exist(user_dir);
+    PATH_INFO::init_base_path("");
+    PATH_INFO::init_user_dir(user_dir);
+    PATH_INFO::set_standard_filenames();
+
+    if (!data_dir.empty()) {
+        if (data_dir.back() != '/' && data_dir.back() != '\\') {
+            data_dir += "/";
+        }
+        PATH_INFO::set_datadir(data_dir);
+        std::cout << "[CDDA-Server] Data directory set to: " << data_dir << "\n";
+    }
+
+    assure_dir_exist(PATH_INFO::config_dir());
+    assure_dir_exist(PATH_INFO::savedir());
+    assure_dir_exist(PATH_INFO::templatedir());
+
+    setupDebug(DebugOutput::file);
+
+    get_options().init();
+    get_options().load();
+    init_colors();
+
+    g = std::make_unique<game>();
+    g->new_game = true;
+    g->load_static_data();
+
+    world_generator->set_active_world(nullptr);
+    world_generator->init();
+
+    WORLD* world = nullptr;
+    if (world_generator->has_world(world_name)) {
+        std::cout << "[CDDA-Server] Loading existing world: " << world_name << "\n";
+        world = world_generator->get_world(world_name);
+    } else {
+        std::cout << "[CDDA-Server] Creating new canonical world: " << world_name << "\n";
+        std::vector<mod_id> mods = { MOD_DDA };
+        world = world_generator->make_new_world(world_name, mods);
+    }
+
+    if (!world) {
+        std::cerr << "[CDDA-Server] ERROR: Failed to initialize world: " << world_name << "\n";
+        return 1;
+    }
+    world_generator->set_active_world(world);
+
+    loading_ui ui(false);
+    g->load_core_data(ui);
+    g->load_world_modfiles(ui);
+
+    // map caches depend on dynamic registries (notably trap::count()).
+    // Match upstream's headless test setup before start_game loads submaps.
+    get_map() = map();
+
+    avatar& u = get_avatar();
+    u = avatar();
+    u.create(character_type::NOW);
+    u.name = "Survivor";
+    // Milestone 6: Real World Generation
+    if (!g->start_game()) {
+        std::cerr << "[CDDA-Server] ERROR: Failed to start game (generate scenario).\n";
+        return 1;
+    }
+    map& here = get_map();
+    get_weather().update_weather();
+    
+    // Set time to midday on day 1 so tests have daylight
+    calendar::turn = calendar::turn_zero + 12_hours;
+
+    std::cout << "[CDDA-Server] World loaded. Player position: ("
+              << u.pos().x << ", " << u.pos().y << ", " << u.pos().z << ")\n";
+
+    cwm::CwmServer server(socket_path);
+    if (!server.start()) {
+        std::cerr << "[CDDA-Server] ERROR: Failed to bind Unix socket at " << socket_path << "\n";
+        return 1;
+    }
+    std::cout << "[CDDA-Server] CWM IPC server listening on: " << socket_path << "\n";
+
+    // Milestone 0.5 Automated acceptance mode
+    if (headless_ticks > 0) {
+        std::cout << "[CDDA-Server] Running headless simulation for " << headless_ticks << " turns...\n";
+        for (int i = 0; i < headless_ticks && g_running; ++i) {
+            u.action_taken();
+            here.process_fields();
+            here.process_items();
+            u.process_turn();
+            u.moves += u.get_speed();
+            calendar::turn += 1_turns;
+            std::cout << "  Turn " << (i + 1) << "/" << headless_ticks << " simulated.\n";
+        }
+        std::cout << "[CDDA-Server] Saving world state...\n";
+        bool saved = server.save_world(*g);
+        std::cout << "[CDDA-Server] World save " << (saved ? "SUCCESS" : "FAILED") << "\n";
+        std::cout << "[Milestone 0.5] Headless CDDA acceptance test PASSED.\n";
+        return saved ? 0 : 1;
+    }
+
+    std::cout << "[CDDA-Server] Entering main event loop. Waiting for Luanti 3D client...\n";
+    while (g_running) {
+        server.update(u, here, *g);
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+
+    std::cout << "\n[CDDA-Server] Shutting down. Saving canonical game state...\n";
+    bool saved = server.save_world(*g);
+    std::cout << "[CDDA-Server] Final save: " << (saved ? "SUCCESS" : "FAILED") << "\n";
+    server.stop();
+
+    return 0;
+}
diff --git a/src/cwm/cwm_map_exporter.cpp b/src/cwm/cwm_map_exporter.cpp
new file mode 100644
index 0000000..951fcf8
--- /dev/null
+++ b/src/cwm/cwm_map_exporter.cpp
@@ -0,0 +1,293 @@
+// CDDA CWM Map & Entity Exporter Implementation
+// Licensed under Apache-2.0
+
+#include "cwm_map_exporter.h"
+#include "cwm_types.h"
+#include "cwm/cwm_protocol.hpp"
+
+#include "avatar.h"
+#include "game.h"
+#include "map.h"
+#include "monster.h"
+#include "calendar.h"
+#include "mtype.h"
+#include "vehicle.h"
+#include "field.h"
+#include "units.h"
+
+namespace cwm {
+
+std::vector<uint8_t> CwmMapExporter::export_world_snapshot(
+    uint64_t sequence_num,
+    uint64_t world_rev,
+    const avatar& u,
+    map& m,
+    game& g,
+    bool include_chunks
+) {
+    cdda::cwm::MessageBuilder builder(sequence_num, world_rev);
+    auto& fbb = builder.builder();
+
+    tripoint u_pos = u.pos();
+
+    // 1. Origin
+    // Inform client of absolute submap origin where cx=0, cy=0 starts
+    tripoint sub = m.get_abs_sub().raw();
+    CDDA::CWM::Coord3i origin(sub.x * 12, sub.y * 12, u_pos.z - 1);
+
+    // 2. Chunks (Export 8x8 grid of 16x16 blocks across multi-Z levels: z-1, z, z+1)
+
+    std::vector<flatbuffers::Offset<CDDA::CWM::ChunkSnapshot>> chunk_offsets;
+
+    int z_min = u_pos.z - 1;
+    int z_max = u_pos.z + 1;
+
+    if (include_chunks) {
+        for (int z_level = z_min; z_level <= z_max; ++z_level) {
+
+        float nat_light = g.natural_light_level(z_level);
+        uint8_t ambient_light = static_cast<uint8_t>(std::clamp(static_cast<int>(nat_light / 6.0f), 1, 15));
+
+        for (int cy = 0; cy < 9; ++cy) {
+            for (int cx = 0; cx < 9; ++cx) {
+                std::vector<CDDA::CWM::CwmBlock> blocks;
+                blocks.reserve(16 * 16);
+
+                for (int by = 0; by < 16; ++by) {
+                    for (int bx = 0; bx < 16; ++bx) {
+                        int gx = cx * 16 + bx;
+                        int gy = cy * 16 + by;
+
+                        tripoint p(gx, gy, z_level);
+                        ter_id t = m.ter(p);
+                        furn_id f = m.furn(p);
+
+                        uint16_t mat_id = map_cdda_terrain_to_material(t.id().str());
+                        if (f.id().str() != "f_null") {
+                            // If furniture is present, prioritize furniture visual
+                            if (f.id().str().find("chair") != std::string::npos ||
+                                f.id().str().find("table") != std::string::npos ||
+                                f.id().str().find("bed") != std::string::npos) {
+                                mat_id = MAT_FURNITURE_WOOD;
+                            }
+                        }
+
+                        uint8_t light = ambient_light;
+                        if (m.has_field_at(p)) {
+                            light = 15; // Illuminated by field (e.g. fire)
+                        }
+
+                        uint32_t state_flags = 0;
+                        if (t.id().str().find("door") != std::string::npos) {
+                            state_flags |= 0x1;
+                        }
+
+                        blocks.emplace_back(state_flags, mat_id, light, 0);
+                    }
+                }
+
+                auto blocks_vec = fbb.CreateVectorOfStructs(blocks);
+
+                auto chunk_snap = CDDA::CWM::CreateChunkSnapshot(
+                    fbb,
+                    cx, cy, z_level,
+                    16, 16, 1,
+                    blocks_vec
+                );
+
+                chunk_offsets.push_back(chunk_snap);
+            }
+        }
+    }
+
+    }
+
+    auto chunks_vec = include_chunks ? fbb.CreateVector(chunk_offsets) : 0;
+
+
+    // 3. Entities (Player + Monsters)
+    std::vector<flatbuffers::Offset<CDDA::CWM::EntityState>> entity_offsets;
+
+    // Player
+    {
+        auto player_name = fbb.CreateString(u.name.empty() ? "Player" : u.name);
+        auto player_type = fbb.CreateString("avatar");
+        CDDA::CWM::Vec3f pos(static_cast<float>(u_pos.x), static_cast<float>(u_pos.y), static_cast<float>(u_pos.z));
+
+        auto player_state = CDDA::CWM::CreateEntityState(
+            fbb,
+            1, // Player authoritative ID is 1
+            CDDA::CWM::EntityType::PLAYER,
+            player_type,
+            &pos,
+            0.0f,
+            0,
+            100,
+            player_name
+        );
+        entity_offsets.push_back(player_state);
+    }
+
+    // Monsters
+    uint64_t mon_counter = 1000;
+    for (monster& critter : g.all_monsters()) {
+        if (!critter.is_hallucination() && !critter.is_dead()) {
+            tripoint m_pos = critter.pos();
+            auto mon_name = fbb.CreateString(critter.name());
+            auto mon_type = fbb.CreateString(critter.type->id.str());
+            CDDA::CWM::Vec3f pos(static_cast<float>(m_pos.x), static_cast<float>(m_pos.y), static_cast<float>(m_pos.z));
+
+            uint8_t hp_pct = 100;
+            if (critter.get_hp_max() > 0) {
+                hp_pct = static_cast<uint8_t>((critter.get_hp() * 100) / critter.get_hp_max());
+            }
+
+            uint64_t entity_id = mon_counter++;
+            auto mon_state = CDDA::CWM::CreateEntityState(
+                fbb,
+                entity_id,
+                CDDA::CWM::EntityType::MONSTER,
+                mon_type,
+                &pos,
+                0.0f,
+                0,
+                hp_pct,
+                mon_name
+            );
+            entity_offsets.push_back(mon_state);
+        }
+    }
+
+    auto entities_vec = fbb.CreateVector(entity_offsets);
+
+    // 4. Vehicles
+    std::vector<flatbuffers::Offset<CDDA::CWM::VehicleState>> vehicle_offsets;
+    for (const wrapped_vehicle& wv : m.get_vehicles()) {
+        if (!wv.v) continue;
+        vehicle* veh = wv.v;
+        auto veh_name = fbb.CreateString(veh->name);
+        CDDA::CWM::Vec3f pivot(static_cast<float>(wv.pos.x), static_cast<float>(wv.pos.y), static_cast<float>(wv.pos.z));
+        CDDA::CWM::Vec3f vel(0.0f, 0.0f, 0.0f);
+        float rot = static_cast<float>(to_degrees(veh->face.dir()));
+
+        std::vector<flatbuffers::Offset<CDDA::CWM::VehicleComponentState>> comp_offsets;
+        int num_parts = veh->part_count();
+        for (int pi = 0; pi < num_parts; ++pi) {
+            const auto& part = veh->part(pi);
+            auto part_name = fbb.CreateString(part.name());
+            CDDA::CWM::Vec3f part_offset(static_cast<float>(part.mount.x), static_cast<float>(part.mount.y), 0.0f);
+            comp_offsets.push_back(CDDA::CWM::CreateVehicleComponentState(
+                fbb,
+                part_name,
+                &part_offset,
+                part.is_broken(),
+                part.open
+            ));
+        }
+
+        auto comps_vec = fbb.CreateVector(comp_offsets);
+        vehicle_offsets.push_back(CDDA::CWM::CreateVehicleState(
+            fbb,
+            reinterpret_cast<uint64_t>(veh),
+            veh_name,
+            &pivot,
+            rot,
+            &vel,
+            comps_vec
+        ));
+    }
+    auto vehicles_vec = fbb.CreateVector(vehicle_offsets);
+
+
+    // 5. Dynamic Fields (Fire, smoke, gas)
+    std::vector<flatbuffers::Offset<CDDA::CWM::FieldState>> field_offsets;
+    if (include_chunks) {
+        for (int z_level = z_min; z_level <= z_max; ++z_level) {
+            for (int y = 0; y < 128; ++y) {
+                for (int x = 0; x < 128; ++x) {
+                    tripoint p(x, y, z_level);
+                    if (m.has_field_at(p)) {
+                        const field& fld = m.field_at(p);
+                        for (const auto& pair : fld) {
+                            const field_type_id& ftype = pair.first;
+                            const field_entry& fentry = pair.second;
+                            uint16_t fid = 1;
+                            std::string fstr = ftype.id().str();
+                            if (fstr.find("smoke") != std::string::npos) fid = 2;
+                            else if (fstr.find("fire") != std::string::npos) fid = 1;
+                            else fid = 3;
+
+                            CDDA::CWM::Coord3i coord(p.x, p.y, p.z);
+                            uint8_t density = static_cast<uint8_t>(fentry.get_field_intensity());
+                            uint32_t age = static_cast<uint32_t>(to_turns<int>(fentry.get_field_age()));
+                            field_offsets.push_back(CDDA::CWM::CreateFieldState(fbb, &coord, fid, density, age));
+                        }
+                    }
+                }
+            }
+        }
+    }
+    auto fields_vec = fbb.CreateVector(field_offsets);
+
+    uint64_t sim_seconds = static_cast<uint64_t>(to_turn<int>(calendar::turn));
+
+    auto world_snap = CDDA::CWM::CreateWorldSnapshot(
+        fbb,
+        world_rev,
+        &origin,
+        sim_seconds,
+        chunks_vec,
+        entities_vec,
+        vehicles_vec,
+        fields_vec
+    );
+
+    return builder.finish_message(CDDA::CWM::Payload::WorldSnapshot, world_snap.Union());
+}
+
+std::vector<uint8_t> CwmMapExporter::export_tile_delta(
+    uint64_t sequence_num,
+    uint64_t world_rev,
+    const tripoint& p,
+    map& m
+) {
+    cdda::cwm::MessageBuilder builder(sequence_num, world_rev);
+
+    ter_id t = m.ter(p);
+    uint16_t mat_id = map_cdda_terrain_to_material(t.id().str());
+    uint32_t state = 0;
+    if (t.id().str().find("door") != std::string::npos) state |= 0x1;
+
+    return builder.build_tile_delta(p.x, p.y, p.z, mat_id, state, 15, 0);
+}
+
+std::vector<uint8_t> CwmMapExporter::export_entity_delta(
+    uint64_t sequence_num,
+    uint64_t world_rev,
+    uint64_t entity_id,
+    float x, float y, float z,
+    float rotation,
+    uint16_t anim_hint
+) {
+    cdda::cwm::MessageBuilder builder(sequence_num, world_rev);
+    auto& fbb = builder.builder();
+
+    CDDA::CWM::Vec3f pos(x, y, z);
+    auto empty_str = fbb.CreateString("");
+
+    auto state = CDDA::CWM::CreateEntityState(
+        fbb,
+        entity_id,
+        (entity_id == 1) ? CDDA::CWM::EntityType::PLAYER : CDDA::CWM::EntityType::MONSTER,
+        empty_str,
+        &pos,
+        rotation,
+        anim_hint,
+        100,
+        empty_str
+    );
+
+    return builder.finish_message(CDDA::CWM::Payload::EntityState, state.Union());
+}
+
+} // namespace cwm
