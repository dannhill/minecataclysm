+namespace {
+std::string trade_signature( const item_location &loc ) {
+    if( !loc ) return {};
+    std::ostringstream stream;
+    JsonOut json( stream );
+    loc->serialize( json );
+    return stream.str();
+}
+}
+
+npc &trade_ui::external_npc() const { return *_parties[_trader]->as_npc(); }
+const std::vector<trade_ui::external_entry> &trade_ui::external_entries() {
+    if( _external_catalog ) return _external_entries;
+    _external_catalog = true;
+    _external_owed = external_npc().op_of_u.owed;
+    _external_credit = external_npc().max_credit_extended();
+    _external_free = external_npc().will_exchange_items_freely();
+    std::set<const item *> seen;
+    for( size_t side = 0; side < npanes; ++side ) {
+        for( const auto *column : _panes[side]->external_columns() ) {
+            for( inventory_entry *entry : column->get_entries( []( const inventory_entry &e ) { return e.is_item(); }, true ) ) {
+                if( !entry->get_available_count() || !seen.insert( entry->any_item().get_item() ).second ) continue;
+                external_entry record{ entry, side == _trader, {}, 0, {} };
+                for( const auto &loc : entry->locations ) record.signatures.push_back( trade_signature( loc ) );
+                record.unit_price = external_price( record, 1 );
+                record.denial = external_reason( record );
+                _external_entries.push_back( std::move( record ) );
+            }
+        }
+    }
+    return _external_entries;
+}
+int trade_ui::external_price( const external_entry &entry, int quantity ) const {
+    const size_t side = entry.trader ? _trader : _you;
+    return npc_trading::trading_price( *_parties[1-side], *_parties[side], { entry.entry->any_item(), quantity } );
+}
+std::string trade_ui::external_reason( const external_entry &entry ) const {
+    return ( entry.trader ? _tpreset : _upreset ).get_denial( entry.entry->any_item() );
+}
+std::string trade_ui::external_valid() {
+    const auto &rows = external_entries();
+    if( rows.size() > 2048 ) return _( "Too many trade entries for this interface.  No exchange was made." );
+    if( external_npc().op_of_u.owed != _external_owed || external_npc().max_credit_extended() != _external_credit ||
+        external_npc().will_exchange_items_freely() != _external_free )
+        return _( "The trade terms changed.  Close and reopen trading." );
+    for( const auto &row : rows ) {
+        for( size_t i = 0; i < row.entry->locations.size(); ++i ) {
+            const auto &loc = row.entry->locations[i];
+            if( !loc || trade_signature( loc ) != row.signatures[i] ||
+                !( row.trader ? _tpreset : _upreset ).is_shown( loc ) )
+                return _( "The trade inventory changed.  Close and reopen trading." );
+        }
+        if( external_price( row, 1 ) != row.unit_price || external_reason( row ) != row.denial )
+            return _( "The trade terms changed.  Close and reopen trading." );
+    }
+    for( size_t side = 0; side < npanes; ++side ) {
+        int64_t total = 0;
+        for( const auto &it : _panes[side]->to_trade() )
+            total += npc_trading::trading_price( *_parties[1-side], *_parties[side], it );
+        if( _valid_values && total != _trade_values[side] )
+            return _( "The trade price changed.  Close and reopen trading." );
+    }
+    return {};
+}
+std::string trade_ui::external_set( unsigned id, int quantity ) {
+    if( auto error = external_valid(); !error.empty() ) return error;
+    if( !id || id > _external_entries.size() || quantity < 0 ) return _( "Invalid trade selection." );
+    auto &row = _external_entries[id-1];
+    if( size_t( quantity ) > row.entry->get_available_count() ) return _( "That quantity is not available." );
+    if( quantity && !row.denial.empty() ) return row.denial;
+    if( quantity ) {
+        for( const auto &other : _external_entries ) {
+            if( &other == &row || !other.entry->chosen_count ) continue;
+            for( const auto &a : row.entry->locations ) for( const auto &b : other.entry->locations ) {
+                if( a == b || a.eventually_contains( b ) || b.eventually_contains( a ) )
+                    return _( "Select either a container or its contents, not both." );
+            }
+        }
+    }
+    _cpane = row.trader ? _trader : _you;
+    _panes[_cpane]->external_choose( *row.entry, quantity );
+    return {};
+}
+std::string trade_ui::external_denial() {
+    if( auto error = external_valid(); !error.empty() ) return error;
+    if( !_valid_values || !_valid_cost ) return _( "This offer's value is outside the supported range." );
+    const npc &np = external_npc();
+    if( !np.will_exchange_items_freely() && int64_t( np.op_of_u.sold ) + _trade_values[_you] > INT_MAX )
+        return _( "This offer's value is outside the supported range." );
+    if( !npc_trading::npc_will_accept_trade( np, _balance ) ) return _( "You need to offer more, within the trader's credit limit." );
+    if( !np.is_shopkeeper() && !npc_trading::npc_can_fit_items( np, _panes[_you]->to_trade() ) )
+        return _( "The trader does not have appropriate pockets for this offer." );
+    return {};
+}
+bool trade_ui::external_confirm() {
+    return external_denial().empty() && _confirm_trade();
+}
