+TEST_CASE( "cwm_creature_identity_survives_other_creature_removal_and_visibility_changes", "[cwm][runtime]" )
+{
+    prepare_runtime();
+    monster *first = g->place_critter_at( mtype_id( "mon_zombie" ), get_avatar().pos() + tripoint( 4, 0, 0 ) );
+    monster *second = g->place_critter_at( mtype_id( "mon_zombie_brute" ), get_avatar().pos() + tripoint( 7, 0, 0 ) );
+    REQUIRE( first != nullptr );
+    REQUIRE( second != nullptr );
+    cwm::CwmMapExporter::ProjectionCache cache;
+    const auto projection = [&]() {
+        return cwm::CwmMapExporter::export_world_snapshot( 1, 1, get_avatar(), get_map(), *g, false, &cache );
+    };
+    const auto before = projection();
+    const auto *snapshot = cdda::cwm::MessageVerifier::parse( before.data(), before.size() )->payload_as_WorldSnapshot();
+    uint64_t second_id = 0;
+    for( const auto *ent : *snapshot->entities() ) {
+        if( ent->type_id()->str() == "mon_zombie_brute" ) {
+            second_id = ent->id();
+            CHECK( ent->perceived() );
+        }
+    }
+    REQUIRE( second_id != 0 );
+    first->set_hp( 0 );
+    g->cleanup_dead();
+    get_avatar().add_effect( efftype_id( "blind" ), 10_seconds );
+    get_avatar().recalc_sight_limits();
+    REQUIRE_FALSE( get_avatar().sees( *second ) );
+    const auto after = projection();
+    snapshot = cdda::cwm::MessageVerifier::parse( after.data(), after.size() )->payload_as_WorldSnapshot();
+    bool found = false;
+    for( const auto *ent : *snapshot->entities() ) {
+        if( ent->type_id()->str() == "mon_zombie_brute" ) {
+            found = true;
+            CHECK( ent->id() == second_id );
+            CHECK_FALSE( ent->perceived() );
+        }
+        CHECK( ent->type_id()->str() != "mon_zombie" );
+    }
+    CHECK( found );
+}
