diff --git a/tests/cwm_projection_test.cpp b/tests/cwm_projection_test.cpp
new file mode 100644
index 0000000..609ac58
--- /dev/null
+++ b/tests/cwm_projection_test.cpp
@@ -0,0 +1,399 @@
+#include "cata_catch.h"
+#include "avatar.h"
+#include "avatar_action.h"
+#include "game.h"
+#include "map.h"
+#include "mapdata.h"
+#include "map_helpers.h"
+#include "player_helpers.h"
+#include "calendar.h"
+#include "creature_tracker.h"
+#include "json.h"
+#include "json_loader.h"
+#include "monster.h"
+#include "npc.h"
+#include "rng.h"
+#include <sstream>
+#include "cwm/cwm_map_exporter.h"
+#include "cwm/tile_semantics.hpp"
+
+TEST_CASE("cwm_actor_identity_survives_native_serialization_and_projection_lifecycle", "[cwm][actors]")
+{
+    clear_avatar();
+    clear_map();
+    clear_creatures();
+    map& m = get_map();
+    avatar& u = get_avatar();
+    u.setpos(tripoint(60, 60, 0));
+    auto* mon = g->place_critter_at(mtype_id("mon_zombie"), tripoint(63, 60, 0));
+    REQUIRE(mon);
+    const auto time_before = calendar::turn;
+    const int moves_before = mon->moves;
+    const int hp_before = mon->get_hp();
+    const auto rng_before = rng_get_engine();
+    cwm::CwmMapExporter::ProjectionCache cache;
+    const auto snapshot = [&](bool full = false) {
+        return cwm::CwmMapExporter::export_world_snapshot(1, 1, u, m, *g, full, &cache);
+    };
+    auto first = snapshot(true);
+    const auto* world = CDDA::CWM::GetCwmMessage(first.data())->payload_as_WorldSnapshot();
+    REQUIRE(world->entities()->size() == 2);
+    const uint64_t id = world->entities()->Get(1)->id();
+    CHECK((id >> 62) == 1);
+    CHECK_FALSE(mon->get_value("cwm_monster_id").empty());
+    CHECK(calendar::turn == time_before);
+    CHECK(mon->moves == moves_before);
+    CHECK(mon->get_hp() == hp_before);
+    CHECK(rng_get_engine() == rng_before);
+
+    mon->setpos(tripoint(64, 60, 0));
+    auto moved = snapshot();
+    world = CDDA::CWM::GetCwmMessage(moved.data())->payload_as_WorldSnapshot();
+    CHECK(world->entities()->Get(1)->id() == id);
+    CHECK(world->entities()->Get(1)->pos()->x() == 64);
+    CHECK(world->spawned()->size() == 0);
+    CHECK(world->removed()->size() == 0);
+    // A newly constructed projection/session cache cannot redefine identity.
+    cache = {};
+    auto recovered = snapshot(true);
+    CHECK(CDDA::CWM::GetCwmMessage(recovered.data())->payload_as_WorldSnapshot()->entities()->Get(1)->id() == id);
+
+    std::ostringstream saved;
+    JsonOut out(saved);
+    mon->serialize(out);
+    get_creature_tracker().remove(*mon);
+    auto removed = snapshot();
+    world = CDDA::CWM::GetCwmMessage(removed.data())->payload_as_WorldSnapshot();
+    REQUIRE(world->entities()->size() == 1);
+    REQUIRE(world->removed()->size() == 1);
+    CHECK(world->removed()->Get(0)->id() == id);
+    auto restored = make_shared_fast<monster>();
+    restored->deserialize(json_loader::from_string(saved.str()).get_object());
+    REQUIRE(g->place_critter_at(restored, tripoint(64, 60, 0)));
+    auto returned = snapshot();
+    world = CDDA::CWM::GetCwmMessage(returned.data())->payload_as_WorldSnapshot();
+    REQUIRE(world->spawned()->size() == 1);
+    CHECK(world->spawned()->Get(0)->state()->id() == id);
+
+    // A simultaneous copied creature is distinct; its copied metadata cannot
+    // cause duplicate wire IDs. An offloaded/reloaded sole owner above keeps ID.
+    auto copied = make_shared_fast<monster>(*restored);
+    REQUIRE(g->place_critter_at(copied, tripoint(65, 60, 0)));
+    auto cloned = snapshot();
+    world = CDDA::CWM::GetCwmMessage(cloned.data())->payload_as_WorldSnapshot();
+    REQUIRE(world->entities()->size() == 3);
