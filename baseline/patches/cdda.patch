+void avatar_action::check_run_mode( avatar &you )
+{
+    if( you.is_running() ) {
+        if( !you.can_run() ) {
+            you.toggle_run_mode();
+        }
+        if( you.get_stamina() <= 0 ) {
+            you.add_effect( effect_winded, 10_turns );
+        }
+    }
+}
+
+bool avatar_action::attack( avatar &you, Creature &target )
+{
+    if( !g->check_safe_mode_allowed( false ) ||
+        you.has_active_mutation( trait_SHELL2 ) || you.has_active_mutation( trait_SHELL3 ) ) {
+        return false;
+    }
+    if( !you.move_effects( true ) ) {
+        you.moves -= 100;
+        return false;
+    }
+    // Preserve the monster bump-attack pacification rule; NPC attacks use the
+    // native NPC branch, which does not perform this check.
+    if( target.is_monster() &&
+        !you.try_break_relax_gas( _( "Your willpower asserts itself, and so do you!" ),
+                                 _( "You're too pacified to strike anything…" ) ) ) {
+        return false;
+    }
+    const bool attacked = you.melee_attack( target, true );
+    if( npc *person = target.as_npc() ) {
+        person->make_angry();
+    }
+    return attacked;
+}
