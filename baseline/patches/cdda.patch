+    for (const auto& entry : std::vector<std::pair<int, int>>{
+            {0,10},{1,9},{10,9},{11,8},{20,8},{21,7},{30,7},{31,6},
+            {40,6},{41,5},{50,5},{51,4},{60,4},{61,3},{70,3},{71,0},{100,0}}) {
+        u.set_pain(entry.first);
+        CHECK(exported(3) == entry.second);
+    }
+    const std::vector<std::pair<std::string,int>> hunger{
+        {"hunger_engorged",10},{"hunger_full",10},{"hunger_satisfied",10},
+        {"hunger_blank",8},{"hunger_hungry",6},{"hunger_very_hungry",4},
+        {"hunger_famished",2},{"hunger_near_starving",1},{"hunger_starving",0}};
+    for (const auto& entry : hunger) u.remove_effect(efftype_id(entry.first));
+    CHECK(exported(0) == -1); // No native hunger descriptor: never guess full.
+    for (const auto& entry : hunger) {
