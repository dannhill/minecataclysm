+++ b/src/cwm/cwm_server.h
@@ -0,0 +1,51 @@
+// CDDA CWM IPC Server
+// Licensed under Apache-2.0
+#pragma once
+
+#include <string>
+#include <memory>
+#include <cstdint>
+#include "cwm_map_exporter.h"
+
+class avatar;
+class map;
+class game;
+
+namespace cdda::cwm {
+class IpcServer;
+}
+
+namespace cwm {
+
+class CwmServer {
+public:
+    explicit CwmServer(const std::string& socket_path);
+    ~CwmServer();
+
+    bool start();
+    void stop();
+
+    // Ticks server: handles connections, processes commands, advances turns
+    bool update(avatar& u, map& m, game& g);
+
+    bool save_world(game& g);
+
+    uint64_t world_revision() const { return world_revision_; }
+    bool has_active_client() const;
+
+private:
+    std::string socket_path_;
+    std::unique_ptr<cdda::cwm::IpcServer> server_;
+    uint64_t sequence_counter_{1};
+    uint64_t world_revision_{1};
+    bool snapshot_sent_{false};
+    CwmMapExporter::ProjectionCache projection_cache_;
+    // Reality-bubble origin (absolute submap) last sent to the client.
+    // When CDDA shifts the bubble, local coordinates change and terrain must be resent.
+    int last_sub_x_{0}, last_sub_y_{0}, last_sub_z_{0};
+    bool last_sub_valid_{false};
+
+    void handle_client_message(const uint8_t* data, size_t size, avatar& u, map& m, game& g);
+};
+
+} // namespace cwm
diff --git a/tests/cwm_projection_test.cpp b/tests/cwm_projection_test.cpp
new file mode 100644
index 0000000..ae4a2a3
--- /dev/null
+++ b/tests/cwm_projection_test.cpp
@@ -0,0 +1,115 @@
+#include "cata_catch.h"
+#include "avatar.h"
+#include "avatar_action.h"
+#include "game.h"
+#include "map.h"
+#include "mapdata.h"
+#include "map_helpers.h"
+#include "player_helpers.h"
+#include "cwm/cwm_map_exporter.h"
+#include "cwm/tile_semantics.hpp"
+
+TEST_CASE("cwm_terrain_catalog_has_visible_obstacles", "[cwm]")
+{
+    using namespace cdda::cwm;
+    clear_map();
+    map& m = get_map();
+    const tripoint p(60, 60, 0);
+    for (size_t i = 1; i < ter_t::count(); ++i) {
+        const ter_id id(static_cast<int>(i));
+        const auto& terrain = id.obj();
+        CAPTURE(terrain.id.str());
+        m.ter_set(p, id);
+        const auto tile = cwm::CwmMapExporter::export_block(p, m, 15);
+        CHECK(bool(tile.state_flags() & BLOCKS_MOVEMENT) == m.impassable_ter_furn(p));
+        if (terrain.movecost == 0 && !terrain.has_flag(ter_furn_flag::TFLAG_NO_FLOOR)) {
+            CHECK((tile.material_id() == WALL || tile.material_id() == WINDOW ||
+                   tile.material_id() == WINDOW_BOARDED || tile.material_id() == DOOR_CLOSED ||
+                   tile.material_id() == OBSTACLE || tile.material_id() == GLASS_WALL ||
+                   tile.material_id() == WATER));
+        }
+    }
+}
+
+TEST_CASE("cwm_windows_stairs_and_furniture_keep_semantics", "[cwm]")
+{
+    using namespace cdda::cwm;
+    clear_map();
+    map& m = get_map();
+    const tripoint p(60, 60, 0);
+    for (const auto& entry : {std::pair<const char*, uint16_t>{"t_window", WINDOW},
+                             {"t_window_open", WINDOW_OPEN}, {"t_window_empty", WINDOW_OPEN},
+                             {"t_window_boarded", WINDOW_BOARDED}, {"t_stairs_up", FLOOR},
+                             {"t_chainfence", OBSTACLE}, {"t_reinforced_glass", GLASS_WALL},
+                             {"t_wall_wood_widened", LOW_OBSTACLE}, {"t_bollard", LOW_OBSTACLE}}) {
+        CAPTURE(entry.first);
+        m.ter_set(p, ter_str_id(entry.first));
+        CHECK(cwm::CwmMapExporter::export_block(p, m, 15).material_id() == entry.second);
+    }
+    m.ter_set(p, ter_str_id("t_floor"));
+    for (size_t i = 1; i < furn_t::count(); ++i) {
+        const furn_id id(static_cast<int>(i));
+        CAPTURE(id.id().str());
+        m.furn_set(p, id);
+        const auto tile = cwm::CwmMapExporter::export_block(p, m, 15);
+        CHECK(tile.material_id() == FLOOR);
+        // f_clear is an editing sentinel: furn_set resolves it to f_null.
+        CHECK(bool(tile.state_flags() & FURNITURE) == !m.furn(p).id().is_null());
+        CHECK(bool(tile.state_flags() & BLOCKS_MOVEMENT) == m.impassable_ter_furn(p));
+    }
+    m.furn_set(p, furn_str_id("f_null"));
+    m.ter_set(p, ter_str_id("t_window"));
+    m.ter_set(p + tripoint_east, ter_str_id("t_wall"));
+    m.ter_set(p + tripoint_west, ter_str_id("t_wall"));
+    CHECK(cwm::CwmMapExporter::export_block(p, m, 15).orientation() == 0);
+    m.ter_set(p + tripoint_east, ter_str_id("t_floor"));
+    m.ter_set(p + tripoint_west, ter_str_id("t_floor"));
+    m.ter_set(p + tripoint_north, ter_str_id("t_wall"));
+    m.ter_set(p + tripoint_south, ter_str_id("t_wall"));
+    CHECK(cwm::CwmMapExporter::export_block(p, m, 15).orientation() == 1);
+}
+
+TEST_CASE("cwm_auto_open_and_furniture_export_without_full_resend", "[cwm]")
+{
+    using namespace cdda::cwm;
+    clear_avatar();
+    clear_map();
+    map& m = get_map();
+    avatar& u = get_avatar();
+    const tripoint p(60, 60, 0);
+    u.setpos(p);
+    u.moves = 1000;
+    const tripoint door = p + tripoint_east;
+    m.ter_set(p, ter_str_id("t_floor"));
+    m.ter_set(door, ter_str_id("t_door_c"));
+    cwm::CwmMapExporter::ProjectionCache cache;
+    auto full = cwm::CwmMapExporter::export_world_snapshot(1, 1, u, m, *g, true, &cache);
+    REQUIRE(CDDA::CWM::GetCwmMessage(full.data())->payload_as_WorldSnapshot()->chunks()->size() == 243);
+    REQUIRE(avatar_action::move(u, m, point_east));
+    REQUIRE(u.pos() == p); // Opening consumes an action, without a step.
+    REQUIRE(m.ter(door) == ter_str_id("t_door_o"));
+    m.furn_set(p + tripoint_south, furn_str_id("f_bookcase"));
+    auto partial = cwm::CwmMapExporter::export_world_snapshot(2, 2, u, m, *g, false, &cache);
+    const auto* result = CDDA::CWM::GetCwmMessage(partial.data())->payload_as_WorldSnapshot();
+    CHECK(result->chunks() == nullptr);
+    REQUIRE(result->tiles()->size() == 2);
+    bool found_door = false, found_furniture = false;
+    for (const auto* delta : *result->tiles()) {
+        if (delta->coord()->x() == door.x && delta->coord()->y() == door.y) {
+            found_door = true;
+            CHECK(delta->block()->material_id() == DOOR_OPEN);
+        } else {
+            found_furniture = true;
+            CHECK(bool(delta->block()->state_flags() & FURNITURE));
+        }
+    }
+    CHECK(found_door);
+    CHECK(found_furniture);
+    REQUIRE(avatar_action::move(u, m, point_east));
+    CHECK(u.pos() == door);
+    m.ter_set(door + tripoint_east, ter_str_id("t_wall"));
+    CHECK_FALSE(avatar_action::move(u, m, point_east));
+    CHECK(u.pos() == door);
+    auto unchanged = cwm::CwmMapExporter::export_world_snapshot(3, 3, u, m, *g, false, &cache);
+    CHECK(CDDA::CWM::GetCwmMessage(unchanged.data())->payload_as_WorldSnapshot()->tiles()->size() == 1);
+}
