+TEST_CASE("cwm_disassembly_type_filter_preserves_default_component_semantics_without_rng", "[cwm][disassembly]") {
+    const flag_id unrecoverable("UNRECOVERABLE");
+    std::set<itype_id> verified;
+    for(const auto* type:item_controller->all()) {
+        const auto& rec=recipe_dictionary::get_uncraft(type->get_id());
+        if(!rec || !rec.is_reversible()) continue;
+        auto expected=rec.simple_requirements().get_components();
+        for(auto& alternatives:expected) {
+            for(const auto& component:alternatives)if(verified.insert(component.type).second) {
+                INFO(component.type.str());
+                const item native_sample(component.type);
+                CHECK(native_sample.has_flag(unrecoverable)==component.type->has_flag(unrecoverable));
+            }
+            alternatives.erase(std::remove_if(alternatives.begin(),alternatives.end(),[&](const auto& c){
+                return !c.recoverable || c.type->has_flag(unrecoverable);
+            }),alternatives.end());
+        }
+        expected.erase(std::remove_if(expected.begin(),expected.end(),[](const auto& a){return a.empty();}),expected.end());
+        const auto rng=rng_get_engine();
+        CHECK(rec.disassembly_requirements().get_components()==expected);
+        CHECK(rng_get_engine()==rng);
+    }
+    CHECK(verified.size()>100);
+}
