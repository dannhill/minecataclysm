+class CwmServer {
+public:
+    explicit CwmServer(const std::string& socket_path);
+    ~CwmServer();
+
+    bool start();
+    void stop();
+
+    // Ticks server: handles connections, processes commands, advances turns
+    bool update(avatar& u, map& m, game& g);
+    bool advance_turn(avatar& u, map& m, game& g, const std::function<bool()>& keep_running);
+    bool has_queued_action() const { return !commands_.empty(); }
+    void enable_realtime() { realtime_ = true; }
+    void enable_continuous() { realtime_ = continuous_ = true; clock_.set_scale(4); }
+    bool realtime_enabled() const { return realtime_; }
+    bool saved_on_shutdown() const { return saved_on_shutdown_; }
+
+    bool save_world(game& g);
+
+    uint64_t world_revision() const { return world_revision_; }
+    bool has_active_client() const;
+
+private:
+    friend struct CwmServerTestAccess;
+    bool realtime_{false};
+    bool continuous_{false};
+    float intent_x_{0}, intent_y_{0};
+    double motion_sample_{0};
+    bool manual_pause_{false}, menu_pause_{false}, threat_pause_{false};
+    int held_direction_{0};
+    float motion_seconds_{1.f};
+    cdda::cwm::SimulationClock clock_;
+    std::set<std::string> perceived_threats_;
+    uint32_t pause_reasons(const game& g) const;
+    void service_clock(avatar& u, map& m, game& g);
+    bool sample_motion(avatar& u, map& m, game& g, bool flush = false);
+    void detect_threats(avatar& u, map& m, game& g);
+    void drop_realtime_input(avatar& u, map& m, game& g);
+    bool realtime_action(avatar& u, map& m, game& g, const std::function<bool()>& keep_running);
+    bool pace_world(avatar& u, map& m, game& g, const std::function<bool()>& keep_running);
+    bool finish_shutdown(avatar& u, game& g);
+    std::string socket_path_;
+    std::unique_ptr<cdda::cwm::CwmListener> server_;
+    uint64_t sequence_counter_{1};
+    uint64_t world_revision_{1};
+    bool snapshot_sent_{false};
+    cdda::cwm::Identity identity_{cdda::cwm::fresh_identity(), 0, 0};
+    cdda::cwm::CommandLedger ledger_;
+    uint64_t client_id_{0}, received_sequence_{0}, sent_revision_{0};
+    uint64_t next_state_{1}, awaiting_state_{0}, resync_id_{0};
+    bool negotiated_{false}, ready_{false}, rejecting_{false};
+    InventorySelection inventory_selection_;
+    uint64_t inventory_work_command_{0};
+    bool inventory_work_settled_{false};
+    bool refresh_inventory_work(const avatar& u);
+    uint64_t next_activity_token_{1}, activity_token_{0};
+    int activity_total_{0}, activity_remaining_{0};
+    std::string activity_kind_;
+    void refresh_activity(const avatar& u);
+
+    RangedSelection ranged_selection_;
+    CraftingSelection crafting_selection_;
+    std::chrono::steady_clock::time_point next_crafting_query_{};
+    std::chrono::steady_clock::time_point next_inventory_query_{};
+    std::chrono::steady_clock::time_point handshake_deadline_;
+    struct Command {
+        uint64_t id{0};
+        bool move{false};
+        uint64_t attack_target{0};
+        int ranged_action{-1};
+        uint64_t ranged_weapon{0}, ranged_target{0};
+        int movement_mode{-1};
+        uint64_t inventory_view{0};
+        uint32_t inventory_item{0};
+        int equipment_action{-1};
+        unsigned quick_slot{0};
+        std::string quick_binding;
+        int transfer_action{-1}, transfer_quantity{0};
+        uint32_t transfer_destination{0};
+        uint64_t crafting_view{0};
+        uint32_t crafting_entry{0};
+        int action{0};
+        int x{0}, y{0}, z{0}; // absolute CDDA coordinates, captured on receipt
+        uint32_t pickup_stack_index{0};
+        std::string pickup_type_id;
+        int32_t pickup_charges{0};
+        bool pickup_count_by_charges{false};
+
+        Command() = default;
+        Command(uint64_t command_id, bool is_move, int command_action)
+            : id(command_id), move(is_move), action(command_action) {}
+    };
+    struct Result {
+        uint64_t id;
+        bool accepted;
+        std::string error;
+    };
+    std::deque<Command> commands_;
+    std::optional<Result> result_;
+    bool saved_on_shutdown_{false};
+    uint64_t next_decision_{1};
+    uint64_t pending_decision_{0};
+    size_t decision_choices_{0};
+    std::optional<int> decision_answer_;
+    std::string decision_text_;
+    std::vector<std::string> decision_labels_;
+    CwmMapExporter::ProjectionCache projection_cache_;
+
+    void send_state(avatar& u, map& m, game& g, bool full = false, uint64_t completed = 0);
+    void send_result(const Result& result, avatar& u, map& m, game& g);
+    bool emit(const std::vector<uint8_t>& bytes);
+    void reset_world(avatar& u, map& m, game& g, uint64_t request_id);
+    void send_decision();
+    void cancel_connection();
+    bool execute(const Command& command, avatar& u, map& m, game& g);
+    bool execute_native(const Command& command, avatar& u, map& m, game& g);
+    int ask_decision(const std::string& text, const std::vector<std::string>& choices,
+                     avatar& u, map& m, game& g, const std::function<bool()>& keep_running);
+
+    void handle_client_message(const uint8_t* data, size_t size, avatar& u, map& m, game& g);
+};
+
+} // namespace cwm
