+    npc np;prepare_trade_npc(np);u.moves=1000;
+    do_turn_with_action([&](){
+        trade_ui model(u,np,0,"Validation");const auto& rows=model.external_entries();unsigned child=0,parent=0;
+        for(unsigned n=0;n<rows.size();++n)if(!rows[n].trader && rows[n].entry->any_item()->get_var("uid")=="trade-stale")child=n+1;
+        REQUIRE(child);auto loc=rows[child-1].entry->any_item();REQUIRE(loc.has_parent());const auto p=loc.parent_item();
+        for(unsigned n=0;n<rows.size();++n)if(rows[n].entry->any_item()==p)parent=n+1;
+        REQUIRE(parent);CHECK(model.external_set(parent,1).empty());CHECK_FALSE(model.external_set(child,1).empty());
+        CHECK(model.external_set(parent,0).empty());CHECK(model.external_set(child,3).empty());
+        loc->charges--;CHECK_FALSE(model.external_valid().empty());CHECK_FALSE(model.external_denial().empty());
+        finish_external_action_phase();return false;
+    },[](const std::string&,const std::vector<std::string>& labels){return int(labels.size())-1;});
+}
