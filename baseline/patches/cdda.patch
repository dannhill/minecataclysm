+TEST_CASE( "cwm_continuous_postures_keep_native_speed_stamina_and_noise", "[cwm][continuous][posture]" )
+{
+    double distances[4] = {};
+    int burns[4] = {}, sounds[4] = {};
+    const char *ids[] = { "walk", "run", "crouch", "prone" };
+    for( int mode = 0; mode < 4; ++mode ) {
+        CAPTURE( mode );
+        prepare_runtime();
+        avatar &u = get_avatar(); map &m = get_map();
+        m.ter_set( u.pos(), ter_str_id( "t_floor" ) );
+        u.set_movement_mode( move_mode_id( ids[mode] ) );
+        u.remove_value( "cwm_motion_v1" ); u.remove_value( "cwm_stamina_fraction" );
+        const int cost = u.run_cost( 100, false );
+        const int stamina = u.get_stamina();
+        // Compare sampling with native one-shot stamina for exactly one tile.
+        u.burn_move_stamina( cost );
+        burns[mode] = stamina - u.get_stamina();
+        u.set_stamina( stamina ); u.moves = 1000;
+        const auto step = cwm_motion::advance( u, m, 1, 0, .04 );
+        distances[mode] = step.distance;
+        CHECK( step.distance == Approx( .04 * u.get_speed() / cost ) );
+        sounds[mode] = u.footstep_sound();
+        cwm_motion::recenter( u, m ); u.remove_value( "cwm_motion_v1" );
+        u.remove_value( "cwm_stamina_fraction" ); u.set_stamina( stamina ); u.moves = 1000;
+        int sampled_burn = 0;
+        // Hold the native stamina level constant for this equivalence probe:
+        // real stamina depletion changes run_cost and burn modifiers. Keep
+        // the fractional remainder, so per-sample truncation is still tested.
+        for( const point d : { point_east, point_south, point_west, point_north } ) {
+            for( int i = 0; i < 25; ++i ) {
+                u.set_stamina( stamina );
+                cwm_motion::advance( u, m, d.x, d.y, .01 * cost / u.get_speed() );
+                sampled_burn += stamina - u.get_stamina();
+            }
+        }
+        CHECK( 1000 - u.moves == cost );
+        CHECK( sampled_burn == burns[mode] );
+    }
+    CHECK( distances[1] > distances[0] ); CHECK( distances[0] > distances[2] );
+    CHECK( distances[2] > distances[3] ); CHECK( burns[1] > burns[0] );
+    CHECK( sounds[1] > sounds[0] ); CHECK( sounds[0] > sounds[2] );
+    CHECK( sounds[2] > sounds[3] );
+}
