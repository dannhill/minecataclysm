+    size_t begin = history.size(), bytes = 0;
+    while( begin && bytes + history[begin - 1].text.size() + 1 <= 262144 ) {
+        --begin;
+        bytes += history[begin].text.size() + 1;
+    }
+    truncated = begin != 0;
+    std::string result;
+    for( size_t i = begin; i < history.size(); ++i ) {
+        result += history[i].text + "\n";
+    }
+    return result;
+}
