+    REQUIRE(resumed_view->entries()->Get(0)->resume());
+    REQUIRE(resumed_view->entries()->Get(0)->progress()==progress);
+    u.moves=100;
+    do_turn_with_action([&]() {
+        u.moves=100; CHECK(selection.execute(u,resumed_view->view_id(),1));
+        finish_external_action_phase();return false;
+    }, [](const auto&,const auto&){return 0;});
+    REQUIRE(u.activity.id()==activity_id("ACT_CRAFT"));
+    for(int turn=0; turn<100 && u.activity; ++turn) {u.moves=100;u.activity.do_turn(u);}
+    CHECK_FALSE(u.activity);
+    CHECK_FALSE(character_has_item_with_var_val(u,"uid","crafting-unit-sheet"));
+    int results=u.amount_of(itype_id("bandages_makeshift"));
+    for(const auto& it : get_map().i_at(u.pos())) if(it.typeId()==itype_id("bandages_makeshift")) results+=it.count();
+    CHECK(results==2);
+}
