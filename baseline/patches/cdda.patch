+    m.furn_set(p, furn_str_id("f_rope_up"));
+    // A grappling rope is CLIMBABLE, not GOES_UP. Its direction chooser
+    // remains a separate feature; the exporter must not invent a connection.
+    CHECK_FALSE(cwm::CwmMapExporter::export_block(p, m, 15).state_flags() & GOES_UP);
+    CHECK(cwm::CwmMapExporter::export_block(p, m, 15).state_flags() & DIFFICULT_Z);
+    CHECK(cwm::CwmMapExporter::export_block(p, m, 15).state_flags() & FURNITURE);
