+TEST_CASE("cwm_native_trade_quote_confirmation_and_read_only_browsing", "[cwm][trade]") {
+    prepare_runtime();const override_option autosave("AUTOSAVE","false");auto& u=get_avatar();
+    u.wear_item(item(itype_id("backpack"),calendar::turn),false);
+    npc np;prepare_trade_npc(np);
+    item bandage(itype_id("bandages"),calendar::turn);bandage.set_var("uid","native-trade-bandage");bandage.set_owner(np);np.i_add(bandage);
+    const bool accept=GENERATE(false,true);bool finished=false;int finishes=0;int expected=0;
+    const int owed=np.op_of_u.owed;
+    const external_trade_provider provider{
+        [&](trade_ui& model) {
+            const auto before=calendar::turn;const auto engine=rng_get_engine();
+            const auto& rows=model.external_entries();unsigned id=0;
+            for(unsigned n=0;n<rows.size();++n)if(rows[n].trader && rows[n].entry->any_item()->get_var("uid")=="native-trade-bandage")id=n+1;
+            REQUIRE(id);CHECK(model.external_valid().empty());CHECK(model.external_valid().empty());
+            CHECK(rng_get_engine()==engine);CHECK(calendar::turn==before);
+            REQUIRE(model.external_set(id,1).empty());CHECK(model.external_denial().empty());
+            CHECK(model.external_value(true)==npc_trading::trading_price(u,np,{rows[id-1].entry->any_item(),1}));
+            expected=npc_trading::calc_npc_owes_you(np,model.external_balance());
+            return model.external_confirm();
+        },[&](bool value){finished=value;++finishes;}
+    };
+    u.moves=1000;
+    do_turn_with_action([&](){const external_trade_scope scope(provider);CHECK(npc_trading::trade(np,0,"Native fixture")==accept);finish_external_action_phase();return false;},
+        [&](const std::string&,const std::vector<std::string>& labels){REQUIRE(labels.size()==2);return accept?0:1;});
+    CHECK(finishes==1);CHECK(finished==accept);CHECK(np.op_of_u.owed==(accept?expected:owed));
+    const auto carried=u.items_with([](const item& it){return it.get_var("uid")=="native-trade-bandage";});
+    const auto remaining=np.items_with([](const item& it){return it.get_var("uid")=="native-trade-bandage";});
+    CHECK(carried.size()==(accept?1:0));CHECK(remaining.size()==(accept?0:1));
+    if(accept)CHECK(carried.front()->is_owned_by(u));
+}
