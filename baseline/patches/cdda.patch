+        std::vector<int> quantities{0}; bool stash = true;
+        Pickup::pick_info info;
+        u.moves = 1000;
+        Pickup::do_pickup(targets, quantities, automatic, stash, info);
+        CHECK(stash == accept);
+        if (accept) {
+            REQUIRE(u.get_wielded_item());
+            CHECK(u.get_wielded_item()->get_var("uid") == "recover-capacity");
+            CHECK(m.i_at(u.pos()).empty());
+            CHECK(u.moves < 1000);
+        } else {
+            CHECK_FALSE(u.get_wielded_item());
+            REQUIRE(m.i_at(u.pos()).size() == 1);
+            CHECK(m.i_at(u.pos()).begin()->get_var("uid") == "recover-capacity");
+            CHECK(u.moves == 1000);
+        }
+        if (loaded) {
+            const item& bag = accept ? *u.get_wielded_item() : *m.i_at(u.pos()).begin();
+            int rounds = 0;
+            for (const auto* child : bag.all_items_top()) if (child->typeId() == itype_id("9mm")) rounds += child->charges;
+            CHECK(rounds == 7);
+        }
+        u.pause(); return true;
+    }, [&](const std::string& text, const std::vector<std::string>& choices) {
+        ++questions;
+        CHECK(text.find("Cannot store") != std::string::npos);
+        REQUIRE(choices.size() == 2);
+        CHECK(choices[0].find("Wield") != std::string::npos);
+        CHECK(choices.back() == "Cancel");
+        return accept ? 0 : 1;
+    });
+    CHECK(questions == (automatic ? 0 : 1));
+}
