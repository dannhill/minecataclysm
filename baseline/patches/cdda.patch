+TEST_CASE( "cwm_pickup_revalidates_the_queued_selection", "[cwm][pickup]" )
+{
+    clear_avatar();
+    clear_map();
+    avatar &u = get_avatar();
+    map &m = get_map();
+    u.setpos( tripoint( 60, 60, 0 ) );
+    REQUIRE( u.wear_item( item( itype_id( "backpack_hiking" ) ) ) );
+    u.moves = 1000;
+    const tripoint target = u.pos() + tripoint_east;
+    item &first = m.add_item( target, item( itype_id( "rock" ) ) );
+    item &selected = m.add_item( target, item( itype_id( "9mm" ) ) );
+    selected.set_var( "uid", "cwm-selected-pickup" );
+    const int charges = selected.charges;
+    const int before_moves = u.moves;
+    const auto before_time = calendar::turn;
+    const auto absolute_player = m.getabs( u.pos() );
+    cwm::CwmServer server( "/unused-cwm-pickup-fixture" );
+    cwm::CwmServerTestAccess::ready( server );
+    cwm::CwmServerTestAccess::enqueue( server, target, 1, selected );
+    REQUIRE( server.has_queued_action() );
+    CHECK_FALSE( u.activity );
+    CHECK( u.moves == before_moves );
+    CHECK( calendar::turn == before_time );
+
+    bool valid = false;
+    SECTION( "valid selection uses native activity and transfers the entire charge stack" ) {
+        valid = true;
+    }
+    SECTION( "bubble coordinates change before execution" ) {
+        m.shift( point( 1, 0 ) );
+        u.setpos( m.getlocal( absolute_player ) );
+        valid = true;
+    }
+    SECTION( "earlier item removal makes the queued index stale" ) {
+        m.i_rem( target, &first );
+    }
+    SECTION( "different item occupies the same index" ) {
+        m.i_rem( target, &selected );
+        m.add_item( target, item( itype_id( "stick" ) ) );
+    }
+    SECTION( "charge count changes after admission" ) {
+        selected.charges += 1;
+    }
+    SECTION( "player leaves the target's reach before execution" ) {
+        u.setpos( u.pos() + tripoint( 5, 0, 0 ) );
+    }
+
+    CHECK( cwm::CwmServerTestAccess::execute( server ) == valid );
+    CHECK( cwm::CwmServerTestAccess::accepted( server ) == valid );
+    CHECK( u.moves == before_moves ); // Assignment is not a free inventory transfer.
+    CHECK( calendar::turn == before_time );
+    CHECK_FALSE( character_has_item_with_var_val( u, "uid", "cwm-selected-pickup" ) );
+    if( valid ) {
+        REQUIRE( u.activity );
+        process_activity( u );
+        CHECK( character_has_item_with_var_val( u, "uid", "cwm-selected-pickup" ) );
+        CHECK( u.charges_of( itype_id( "9mm" ) ) == charges );
+        CHECK( m.i_at( m.getlocal( m.getabs( u.pos() ) + tripoint_east ) ).size() == 1 );
+    } else {
+        CHECK_FALSE( u.activity );
+        CHECK( server.world_revision() == 1 );
+    }
+}
