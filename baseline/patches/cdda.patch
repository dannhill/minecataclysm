+// CDDA CWM Types & Manifest Mapping
+// Licensed under Apache-2.0
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <unordered_map>
+
+namespace cwm {
+
+// Material IDs aligned with assets-manifest.json
+enum MaterialId : uint16_t {
+    MAT_AIR = 0,
+    MAT_DIRT = 1,
+    MAT_GRASS = 2,
+    MAT_WALL_BRICK = 3,
+    MAT_FLOOR_WOOD = 4,
+    MAT_DOOR_WOOD_CLOSED = 5,
+    MAT_DOOR_WOOD_OPEN = 6,
+    MAT_WINDOW_GLASS = 7,
+    MAT_PAVEMENT_STONE = 8,
+    MAT_FURNITURE_WOOD = 9
+};
+
+inline uint16_t map_cdda_terrain_to_material(const std::string& ter_id) {
+    static const std::unordered_map<std::string, uint16_t> mapping = {
+        {"t_open_air", MAT_AIR},
+        {"t_null", MAT_AIR},
+        {"t_dirt", MAT_DIRT},
+        {"t_dirtmound", MAT_DIRT},
+        {"t_grass", MAT_GRASS},
+        {"t_grass_tall", MAT_GRASS},
+        {"t_grass_dead", MAT_GRASS},
+        {"t_wall", MAT_WALL_BRICK},
+        {"t_wall_brick", MAT_WALL_BRICK},
+        {"t_wall_metal", MAT_WALL_BRICK},
+        {"t_concrete_wall", MAT_WALL_BRICK},
+        {"t_floor", MAT_FLOOR_WOOD},
+        {"t_floor_wood", MAT_FLOOR_WOOD},
+        {"t_carpet_red", MAT_FLOOR_WOOD},
+        {"t_carpet_green", MAT_FLOOR_WOOD},
+        {"t_carpet_yellow", MAT_FLOOR_WOOD},
+        {"t_carpet_purple", MAT_FLOOR_WOOD},
+        {"t_door_c", MAT_DOOR_WOOD_CLOSED},
+        {"t_door_locked", MAT_DOOR_WOOD_CLOSED},
+        {"t_door_locked_peep", MAT_DOOR_WOOD_CLOSED},
+        {"t_door_o", MAT_DOOR_WOOD_OPEN},
+        {"t_window", MAT_WINDOW_GLASS},
+        {"t_window_curtains", MAT_WINDOW_GLASS},
+        {"t_window_open", MAT_WINDOW_GLASS},
+        {"t_pavement", MAT_PAVEMENT_STONE},
+        {"t_pavement_y", MAT_PAVEMENT_STONE},
+        {"t_sidewalk", MAT_PAVEMENT_STONE},
+        {"t_asphalt", MAT_PAVEMENT_STONE}
+    };
+
+    auto it = mapping.find(ter_id);
+    if (it != mapping.end()) {
+        return it->second;
+    }
+    if (ter_id.find("air") != std::string::npos || ter_id.find("null") != std::string::npos) return MAT_AIR;
+    // Default fallback based on substring
+    if (ter_id.find("wall") != std::string::npos) return MAT_WALL_BRICK;
+    if (ter_id.find("door") != std::string::npos) {
+        return (ter_id.find("_o") != std::string::npos) ? MAT_DOOR_WOOD_OPEN : MAT_DOOR_WOOD_CLOSED;
+    }
+    if (ter_id.find("floor") != std::string::npos) return MAT_FLOOR_WOOD;
+    return MAT_DIRT;
+}
+
+} // namespace cwm
