+TEST_CASE( "cwm_external_tick_boundary_retains_native_speed_credit", "[cwm][realtime]" )
+{
+    const override_option no_autosave( "AUTOSAVE", "false" );
+    prepare_runtime();
+    avatar &u = get_avatar();
+    u.moves = 125;
+    const int speed = u.get_speed();
+    const auto before = calendar::turn;
+    int gates = 0, actions = 0;
+    REQUIRE_FALSE( do_turn_with_action( [&]() {
+        ++actions;
+        finish_external_action_phase();
+        return false;
+    }, {}, [&]() {
+        ++gates;
+        CHECK( u.moves == 125 );
+        CHECK( calendar::turn == before + 1_turns );
+        return true;
+    } ) );
+    CHECK( gates == 1 );
+    CHECK( actions == 1 );
+    CHECK( u.moves == 125 + speed );
+    // The scoped boundary signal cannot leak to a later ordinary native turn.
+    actions = 0;
+    REQUIRE_FALSE( do_turn_with_action( [&]() { ++actions; u.pause(); return true; } ) );
+    CHECK( actions == 1 );
+    CHECK( u.moves == speed );
+}
