+
+bool CddaBridge::pointGroundItems(const irr::core::line3d<float>& ray) {
+    if (!pimpl_) return false;
+    auto& impl = *pimpl_;
+    impl.pointed_ground_.reset(); impl.hover_hint_.clear();
+    if (!impl.session_.ready() || !impl.entities_.count(1) || impl.metrics_.pending_decision)
+        return false;
+    const auto player = impl.entities_.at(1).target_pos;
+    float closest = std::numeric_limits<float>::max();
+    for (const auto& [pos, items] : impl.ground_items_.tiles()) {
+        if (pos.Y != std::round(player.Y) ||
+            std::abs(pos.X - std::round(player.X)) > 1 ||
+            std::abs(pos.Z - std::round(player.Z)) > 1) continue;
+        const v3f center(pos.X * 10.f, (pos.Y + .8f) * 10.f, pos.Z * 10.f);
+        const irr::core::aabbox3df box(center - v3f(4.5f, 3.f, 4.5f),
+                                     center + v3f(4.5f, 3.f, 4.5f));
+        const float distance = center.getDistanceFromSQ(ray.start);
+        if (distance < closest && box.intersectsWithLine(ray)) {
+            closest = distance; impl.pointed_ground_ = pos;
+            impl.hover_hint_ = utf8_to_wide(items.size() == 1 ? items.front().name :
+                "Pila a terra (" + std::to_string(items.size()) + " oggetti)") +
+                L" — tasto destro";
+        }
+    }
+    return impl.pointed_ground_.has_value();
+}
+
+std::string CddaBridge::activateGroundItems() {
+    if (!pimpl_ || !pimpl_->pointed_ground_ || pimpl_->pending_move_ || pimpl_->queued_pickup_)
+        return {};
+    auto& impl = *pimpl_;
+    const auto* items = impl.ground_items_.get(*impl.pointed_ground_);
+    if (!items || items->empty()) return {};
+    impl.last_ground_target_ = *impl.pointed_ground_;
+    if (items->size() == 1) {
+        impl.queue_pickup(*impl.pointed_ground_, items->front());
+        return {};
+    }
+    impl.ground_container_pos_ = *impl.pointed_ground_;
+    impl.ground_selection_ = *items;
+    impl.ground_page_ = impl.owned_page_ = 0;
+    impl.populate_mirror(impl.ground_mirror_, impl.ground_selection_, 27);
+    impl.populate_mirror(impl.owned_mirror_, impl.owned_items_, 36);
+    impl.ground_close_requested_ = impl.ground_form_dirty_ = false;
+    impl.ground_container_open_ = true;
+    infostream << "CWM ground container opened: " << items->size() << " ground items, "
+               << impl.owned_items_.size() << " owned items" << std::endl;
+    setMenuPause(true);
+    return impl.container_form();
+}
