+    UASSERTEQ(int, input.sample({false,false,false},false,false,true,3), 3);
+    UASSERTEQ(int, input.sample({true,false,false},false,false,false,3), -1);
+    UASSERTEQ(int, input.sample({true,false,false},false,false,true,3), 3);
+    input.sample({false,false,false},false,false,true,3);
+    UASSERTEQ(int, input.sample({true,false,false},false,false,true,3), 1);
