+    }
+    if (pimpl_->vertical_text_) {
+        const auto player = pimpl_->entities_.find(1);
+        const uint32_t flags = player == pimpl_->entities_.end() ? 0 : player->second.state_flags;
+        using namespace cdda::cwm;
+        std::wstring hint;
+        if (flags & UNDERWATER)
+            hint = ::cwm::wide("Swim: Jump to rise/surface | Sneak + Jump to dive/descend", "Nuota: Salto per emergere | Accovacciati + Salto per immergerti");
+        else if (flags & SWIMMING)
+            hint = ::cwm::wide("Swim: Sneak + Jump to dive", "Nuota: Accovacciati + Salto per immergerti");
+        else {
+            if (flags & ON_UP_CONNECTION) hint = ::cwm::wide("Jump: ascend", "Salto: sali");
+            if (flags & ON_DOWN_CONNECTION) {
+                if (!hint.empty()) hint += L" | ";
+                hint += ::cwm::wide("Sneak + Jump: descend", "Accovacciati + Salto: scendi");
+            }
+        }
+        pimpl_->vertical_text_->setText(hint.c_str());
+        pimpl_->vertical_text_->setVisible(pimpl_->player_ready_ &&
+            !pimpl_->metrics_.pending_decision && !pimpl_->metrics_.safety_stop && !hint.empty());
+    }
+
+    if (!pimpl_->safety_text_) {
+        pimpl_->safety_text_ = guienv->addStaticText(
+            ::cwm::wide("CDDA: threat detected. Release movement, press Aux1 (default E) to resume.",
+                "CDDA: minaccia rilevata. Rilascia il movimento e premi Aux1 (predefinito E) per riprendere.").c_str(),
+            irr::core::rect<irr::s32>(10, 165, 650, 205), false, true);
+        if (pimpl_->safety_text_)
+            pimpl_->safety_text_->setOverrideColor(irr::video::SColor(255, 255, 210, 80));
+    }
+    if (pimpl_->safety_text_)
+        pimpl_->safety_text_->setVisible(pimpl_->metrics_.connected && pimpl_->metrics_.safety_stop && !pimpl_->metrics_.pending_decision);
+
+    if (!pimpl_->debug_text_) {
+        // Create static text at top left
+        irr::core::rect<irr::s32> rect(10, 10, 400, 150);
+        pimpl_->debug_text_ = guienv->addStaticText(L"F3 Overlay Initializing...", rect, false, true, nullptr, -1, true);
+        if (pimpl_->debug_text_) {
+            pimpl_->debug_text_->setOverrideColor(irr::video::SColor(255, 255, 255, 255));
+        }
+    }
+
+    if (pimpl_->debug_text_) {
+        wchar_t text[512];
+        swprintf(text, 512, L"[CDDA-Mineclonia F3 Overlay]\n"
+                             L"CWM IPC Connected: %ls\n"
+                             L"FPS: %u\n"
+                             L"Action result: %.2f ms; projection: %.2f ms\n"
+                             L"Revision: %llu\n"
+                             L"Chunks: %u\n"
+                             L"Entities: %u\n"
+                             L"Vehicles: %u",
+                 pimpl_->metrics_.connected ? L"YES" : L"NO",
+                 pimpl_->metrics_.fps,
+                 pimpl_->metrics_.ipc_latency_ms,
+                 pimpl_->metrics_.projection_ms,
+                 (unsigned long long)pimpl_->metrics_.current_revision,
+                 pimpl_->metrics_.chunks_loaded,
+                 pimpl_->metrics_.entities_count,
+                 pimpl_->metrics_.vehicles_count);
+
+        pimpl_->debug_text_->setText(text);
+        pimpl_->debug_text_->setVisible(pimpl_->diagnostics_ && !pimpl_->ground_container_open_ && !pimpl_->body_form_open_ && !pimpl_->equipment_open_ && !pimpl_->crafting_open_ && !pimpl_->metrics_.pending_decision);
+    }
+}
+
+} // namespace cdda_client
diff --git a/src/cdda/cdda_bridge.h b/src/cdda/cdda_bridge.h
new file mode 100644
index 0000000..551cb62
--- /dev/null
+++ b/src/cdda/cdda_bridge.h
@@ -0,0 +1,183 @@
+// Luanti C++ CWM Presentation Bridge
+// Licensed under Apache-2.0
+#pragma once
+
+#include <string>
+#include <memory>
+#include <optional>
+#include <vector>
+#include <unordered_map>
+#include <cstdint>
+#include <mutex>
+#include "irrlichttypes.h"
+#include "irr_v3d.h"
+#include <line3d.h>
+
+namespace irr { namespace gui { class IGUIEnvironment; class IGUIStaticText; } }
+
+class Client;
+class MapBlock;
+class Inventory;
+struct InventoryLocation;
+struct InventoryAction;
+
+namespace cdda_client {
+
+
+struct VisualVehicleComponent {
+    std::string name;
+    v3f mount_offset;
+    bool is_broken;
+    bool is_open;
+    void* scene_node{nullptr}; // Pointer to Irrlicht scene node
+};
+
+struct VisualVehicle {
+    uint64_t id{0};
+    std::string name;
+    v3f current_pos;
+    v3f target_pos;
+    float rotation{0.0f};
+    v3f velocity;
+    std::vector<VisualVehicleComponent> components;
+};
+
+struct VisualEntity {
+    uint64_t id{0};
+    std::string type_id;
+    v3f current_pos;
+    v3f target_pos;
+    v3f start_pos;
+    float interpolation_time{0.2f};
+    float motion_seconds{0.2f};
+    float rotation{0.0f};
+    uint8_t hp_percent{100};
+    uint32_t state_flags{0};
+    std::string name;
+    bool perceived{true};
+    bool humanoid{false};
+    void* scene_node{nullptr};
+    uint64_t node_generation{0};
+    float model_y_offset{0.0f};
+    float avatar_model_scale{0.f};
+    float presentation_yaw{0.f};
+    double animation_seconds{0.};
+    bool walking{false};
+    float attack_seconds{0.f}, hurt_seconds{0.f};
+};
+
+class CddaBridge {
+public:
+    static CddaBridge& getInstance();
+    // Share one lock between projection/cache writers and mesh data capture.
+    // Workers release it before generating geometry from their private copy.
+    static std::recursive_mutex& projectionMutex();
+
+    bool initialize(Client* client, const std::string& socket_path);
+    void shutdown();
+    void update(float dtime);
+
+    // The local Luanti server supplies empty cache blocks, not gameplay terrain.
+    bool restoreProjectedBlock(Client* client, MapBlock* block);
+    // Once initialized, native physics/teleports cannot own this player,
+    // including while IPC is reconnecting.
+    bool ownsPlayer(const Client* client) const;
+    void traceCamera(const v3f& position, const v3f& direction);
+    void updateScenePositions();
+    std::string wieldedTexture() const;
+    bool firearmWielded() const;
+    bool aiming() const;
+    float shotKick() const;
+    void toggleDiagnostics();
+    bool terrainComparisonEnabled() const;
+    void toggleTerrainStyle();
+    void toggleTerrainFog();
+    float terrainFogDistance() const;
+
+    // Input hooks
+    bool handleMoveInput(int dir);
+    void handlePostureInput(bool run, bool crouch, bool prone);
+    double visualAnimationTime() const;
+    float visualAnimationDelta() const;
+    bool handleInteract(int x, int y, int z, int action);
+    bool handlePointedOpening(const v3s16& node, bool close);
+    bool pointCombatTarget(const irr::core::line3d<float>& ray);
+    float pointingRange() const;
+    bool attackPointedTarget();
+    bool hasPointedRangedTarget() const;
+    bool isPointedOpening(const v3s16& node) const;
+    std::optional<v3s16> pointOpening(const irr::core::line3d<float>& ray);
+    bool handleAimInput(bool right, bool pressed, bool fallback, bool context,
+                        bool focused, bool fire, bool reload);
+    bool reloadWeapon();
+    bool pointStorageNode(const v3s16& node);
+    bool pointGroundItems(const irr::core::line3d<float>& ray);
+    std::string activateGroundItems();
+    Inventory* getInventoryMirror(const InventoryLocation& location);
+    void handleInventoryAction(const InventoryAction& action);
+    void groundContainerFields(const std::unordered_map<std::string, std::string>& fields);
+    bool takeGroundContainerClose();
+    std::string takeGroundContainerUpdate();
+    bool acknowledgeThreat();
+    bool answerDecision(uint16_t choice);
+    uint64_t decisionDialogConnection() const;
+    std::string takeDecisionDialogUpdate();
+    void decisionDialogFields(uint64_t id,uint64_t connection,const std::unordered_map<std::string,std::string>& fields);
+    void handleMovementIntent(int direction);
+    void handleContinuousIntent(float x, float y);
+    void setMenuPause(bool paused);
+    void toggleSimulationPause();
+    void cycleSimulationSpeed();
+    std::string openCrafting();
+    void craftingFields(const std::unordered_map<std::string, std::string>& fields);
+    bool takeCraftingClose();
+    std::string takeCraftingUpdate();
+    // Esc abandons the return intent, not the native activity/cost.
+    bool dismissInventoryWork();
+    std::string openEquipmentInventory();
+    void equipmentInventoryFields(const std::unordered_map<std::string, std::string>& fields);
+    bool takeEquipmentInventoryClose();
+    std::string takeEquipmentInventoryUpdate();
+    std::string openBodyStatus();
+    void closeBodyStatus();
+    bool takeBodyStatusClose();
+
+    // Coordinate conversion
+    static v3s16 cddaToLuantiCoord(int x, int y, int z);
+    static v3s16 luantiToCddaCoord(v3s16 pos);
+
+    // Metrics for F3 Debug Overlay
+    struct Metrics {
+        bool realtime{false};
+        bool continuous_motion{false};
+        uint32_t pause_reasons{0};
+        float time_scale{1.f};
+        uint64_t simulation_time{0};
+        uint64_t current_revision{0};
+        uint32_t fps{60};
+        float ipc_latency_ms{0.0f};
+        float projection_ms{0.0f};
+        uint32_t chunks_loaded{0};
+        uint32_t entities_count{0};
+        uint32_t vehicles_count{0};
+        bool connected{false};
+        bool safety_stop{false};
+        uint64_t pending_decision{0};
+        uint16_t decision_choices{0};
+    };
+    Metrics getMetrics() const;
+    unsigned quickSlot() const;
+    void selectQuickSlot(unsigned slot);
+    void useQuickSlot();
+
+    // F3 Debug Overlay
+    void renderDebugOverlay(irr::gui::IGUIEnvironment* guienv);
+
+
+private:
+    CddaBridge() = default;
+    class Impl;
+    std::unique_ptr<Impl> pimpl_;
+};
+
+} // namespace cdda_client
diff --git a/src/cdda/crafting_inventory.h b/src/cdda/crafting_inventory.h
new file mode 100644
index 0000000..4584bd7
--- /dev/null
+++ b/src/cdda/crafting_inventory.h
@@ -0,0 +1,80 @@
+#pragma once
+#include "cwm/product_language.hpp"
+#include "equipment_inventory.h"
+namespace cdda_client {
+struct CraftingEntry {
+    uint32_t id{}; std::string recipe, type, name, requirements, reason;
+    int64_t expected{}; bool resume{}; int progress{}; bool favorite{}; unsigned recent_rank{};
+};
+struct CraftingView {
+    uint64_t query{}, view{}; unsigned batch{1}; bool truncated{};
+    CDDA::CWM::CraftingFilter filter{CDDA::CWM::CraftingFilter::ALL};
+    std::string error; std::vector<CraftingEntry> entries;
+    void read(const CDDA::CWM::CraftingView& source) {
+        *this = {}; query = source.query_id(); view = source.view_id(); batch = source.batch();
+        truncated = source.truncated(); error = source.error()->str(); filter=source.filter();
+        for (const auto* e : *source.entries()) entries.push_back({e->id(), e->recipe_id()->str(),
+            e->result_type()->str(), e->name()->str(), e->requirements()->str(), e->reason()->str(),
+            e->expected_moves(), e->resume(), e->progress(),e->favorite(),e->recent_rank()});
+    }
+    const CraftingEntry* entry(uint32_t id) const { return id && id <= entries.size() ? &entries[id-1] : nullptr; }
+};
+inline std::string craftingForm(const CraftingView& view, size_t page, uint32_t selected,
+        const std::string& search, unsigned batch, const std::string& notice,
+        const std::function<std::string(const std::string&)>& icon, bool busy, CDDA::CWM::CraftingFilter filter=CDDA::CWM::CraftingFilter::ALL, bool updating=false) {
+    std::string f = "formspec_version[4]size[16,11]no_prepend[]bgcolor[#00000000]"
+        "background9[0,0;16,11;mcl_base_textures_background9.png;false;7]"
+        "style_type[label;textcolor=#323232]"
+        "style_type[textarea;textcolor=#323232]"
+        "style_type[button;border=false;bgimg=mcl_inventory_button9.png;bgimg_pressed=mcl_inventory_button9_pressed.png;bgimg_middle=2,2]" +
+        ("label[0.4,0.4;" + ::cwm::text("Crafting - known recipes and unfinished work", "Crafting - ricette note e lavori incompleti") + "]") +
+        "field[0.4,1;5.6,0.65;search;;" + statusEscape(search) + "]field_close_on_enter[search;false]" +
+        ("button[6.1,1;1.6,0.65;find;" + ::cwm::text("Search", "Cerca") + "]label[8,0.7;" + ::cwm::text("Batch", "Lotto") + "]dropdown[8,1;3.3,0.65;batch;");
+    for (unsigned n=1; n<=20; ++n) f += (n>1 ? "," : "") + std::to_string(n);
+    f += ";" + std::to_string(batch) + ("]button[11.6,1;1.8,0.65;refresh;" + ::cwm::text("Refresh", "Aggiorna") + "]button_exit[13.7,1;1.8,0.65;close;" + ::cwm::text("Close", "Chiudi") + "]");
+    const char* ids[]={"all_recipes","favorite_recipes","recent_recipes","unfinished_recipes"};
+    const std::string labels[]={::cwm::text("All","Tutte"),::cwm::text("Favorites","Preferite"),::cwm::text("Recent","Recenti"),::cwm::text("Unfinished","Incompleti")};
+    for(int n=0;n<4;++n) {
+        if(n==int(filter))f+="style["+std::string(ids[n])+";bgcolor=#E8CF57FF]";
+        f+="button["+std::to_string(.5+n*1.85)+",1.9;1.72,0.6;"+ids[n]+";"+labels[n]+"]";
+    }
+    if(updating)f+="label[8,2.6;"+::cwm::text("Updating native catalog...","Aggiornamento catalogo nativo...")+"]";
+    if (busy) f += ("button[8,1.9;7.5,0.6;cancel_craft;" + ::cwm::text("Interrupt current work", "Interrompi lavoro corrente") + "]");
+    if (!view.view) return f + "label[0.5,3.1;" + statusEscape(view.error.empty() ? (::cwm::text("Reading native recipes...", "Lettura ricette native...")) : view.error) + "]";
+    if(view.entries.empty())f+="label[0.5,3;"+::cwm::text("No matching recipes. Try another tab or clear the search.","Nessuna ricetta. Cambia scheda o svuota la ricerca.")+"]";
+    const size_t pages=std::max<size_t>(1,(view.entries.size()+35)/36); page=std::min(page,pages-1);
+    for (size_t i=page*36; i<std::min(view.entries.size(),(page+1)*36); ++i) {
+        const auto& e=view.entries[i]; const size_t n=i%36;
+        const auto x=std::to_string(.5+(n%6)*1.18), y=std::to_string(2.7+(n/6)*1.12);
+        f += "image["+x+","+y+";1.05,1.05;mcl_formspec_itemslot.png]";
+        if (e.id==selected) f += "box["+x+","+y+";1.05,1.05;#E8CF5790]";
+        f += "item_image_button["+x+","+y+";1.05,1.05;"+statusEscape(icon(e.type))+";recipe_"+std::to_string(e.id)+";]";
+        f += "tooltip[recipe_"+std::to_string(e.id)+";"+statusEscape(e.name+"\n"+(e.reason.empty() ? ::cwm::text("Available", "Disponibile") : e.reason))+"]";
+        if(e.favorite) {
+            const auto badge="recipe_"+std::to_string(e.id);
+            f+="style["+badge+";textcolor=#8B6100;border=false;bgimg=;bgimg_pressed=;bgcolor=#00000000]button["+
+                std::to_string(.5+(n%6)*1.18+.05)+","+std::to_string(2.7+(n/6)*1.12+.05)+";0.35,0.35;"+badge+";*]";
+            f+="tooltip["+badge+";"+statusEscape(e.name+"\n"+::cwm::text("Favorite recipe","Ricetta preferita"))+"]";
+        }
+        if (e.resume) {
+            const auto bx = std::to_string(.5+(n%6)*1.18+.65);
+            const auto by = std::to_string(2.7+(n/6)*1.12+.05);
+            const auto badge = "recipe_" + std::to_string(e.id);
+            f += "style["+badge+";textcolor=#FFFFFF;border=false;bgimg=;bgimg_pressed=;bgcolor=#276040]";
+            f += "button["+bx+","+by+";0.35,0.35;"+badge+";R]";
+            f += "tooltip["+badge+(";" + ::cwm::text("Unfinished work: resume the selected recipe.", "Lavoro incompleto: riprendi dalla ricetta selezionata.") + "]");
+        }
+    }
+    f += "button[0.5,9.7;1.5,0.65;prev;<]button[6,9.7;1.5,0.65;next;>]label[2.2,10;"+std::to_string(page+1)+" / "+std::to_string(pages)+"]";
+    if (const auto* e=view.entry(selected)) {
+        f += "textarea[8,2.8;7.5,6.1;;;"+statusEscape(e->name+"\n"+
+            (e->resume ? (::cwm::text("Resume: ", "Riprendi: "))+std::to_string(e->progress/100000)+"%\n" : (::cwm::text("Estimated duration: ", "Durata stimata: "))+std::to_string(e->expected/100)+(::cwm::text(" CDDA seconds", " secondi CDDA") + "\n"))+
+            e->requirements+"\n"+(e->reason.empty() ? ::cwm::text("Available", "Disponibile") : e->reason))+"]";
+        if (e->reason.empty() && !busy && !updating) f += "button[8,9;7.5,0.65;start;"+std::string(e->resume ? (::cwm::text("Resume work", "Riprendi lavoro")) : (::cwm::text("Choose components and craft", "Scegli componenti e crea")))+"]";
+        if(!updating)f+="button[8,9.8;7.5,0.65;favorite_recipe;"+std::string(e->favorite?::cwm::text("Remove recipe favorite","Rimuovi ricetta preferita"): ::cwm::text("Add recipe favorite","Aggiungi ricetta preferita"))+"]";
+    }
+    f += "label[0.5,10.75;"+statusEscape(notice.substr(0,160))+"]";
+    if (view.truncated && notice.empty()) f += ("label[0.5,10.75;" + ::cwm::text("Too many results: narrow the search.", "Troppi risultati: restringi la ricerca.") + "]");
+    return f;
+}
+} // namespace cdda_client
diff --git a/src/cdda/creature_visual.h b/src/cdda/creature_visual.h
new file mode 100644
index 0000000..d02b91f
