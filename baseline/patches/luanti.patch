+    v3s16 project_tile(int x, int y, int z) const {
+        return CddaBridge::cddaToLuantiCoord(x + projection_origin_.X - scene_origin_.X,
+            y + projection_origin_.Y - scene_origin_.Y, z);
+    }
+
+    void render_entity(VisualEntity& ent) {
+        if (!client_ || ent.id == 1) return;
+        if (!smgr_) smgr_ = client_->getSceneManager();
+        if (!smgr_) return;
+        if (!ent.scene_node && ent.perceived) {
+            const bool zombie = ent.type_id.find("mon_zombie") == 0;
+            irr::scene::ISceneNode* node = nullptr;
+            if (zombie || ent.humanoid) {
+                auto* mesh = client_->getMesh(zombie ? "zombie.b3d" : "character.b3d");
+                if (mesh) {
+                    auto* body = smgr_->addAnimatedMeshSceneNode(mesh);
+                    if (body) {
+                        const auto box = mesh->getBoundingBox();
+                        const float height = box.MaxEdge.Y - box.MinEdge.Y;
+                        const float scale = height > 0.001f ? 18.0f / height : 1.0f;
+                        body->setScale(v3f(scale, scale, scale));
+                        body->setFrameLoop(0, 0);
+                        body->setAnimationSpeed(0);
+                        ent.model_y_offset = -box.MinEdge.Y * scale;
+                        setMeshColor(mesh, irr::video::SColor(255, 255, 255, 255));
+                        node = body;
+                        node->forEachMaterial([&](auto& material) {
+                            material.setTexture(0, client_->getTextureSource()->getTextureForMesh(
+                                zombie ? "zombie.png" : "character.png"));
+                            material.MaterialType = irr::video::EMT_TRANSPARENT_ALPHA_CHANNEL_REF;
+                        });
+                    }
+                    mesh->drop();
+                }
+            }
+            if (!node) {
+                auto* cube = createCubeMesh(v3f(7.0f, 10.0f, 7.0f));
+                auto* marker = smgr_->addMeshSceneNode(cube);
+                cube->drop();
+                if (marker) {
+                    setMeshColor(marker->getMesh(), irr::video::SColor(255, 220, 65, 180));
+                    ent.model_y_offset = 5.0f;
+                    node = marker;
+                }
+            }
+            if (node) {
+                node->setID(actor_scene_tag);
+                node->forEachMaterial([](auto& material) { material.FogEnable = true; });
+                ent.scene_node = node;
+                ent.node_generation = ++next_actor_node_;
+                infostream << "[Luanti-CDDA] Visual creature " << ent.id << ": " << ent.type_id << std::endl;
+            }
+        }
+        if (ent.scene_node) {
+            auto* node = static_cast<irr::scene::ISceneNode*>(ent.scene_node);
+            const v3s16 offset = client_->getEnv().getCameraOffset();
+            node->setVisible(session_.ready() && ent.perceived);
+            node->setPosition((ent.current_pos + v3f(0, .5f, 0) - v3f(offset.X, offset.Y, offset.Z)) * 10.0f +
+                              v3f(0, ent.model_y_offset, 0));
+            node->setRotation(v3f(0, -ent.rotation, 0));
+        }
+    }
+
+    static void apply_nodes(MapBlock& block, const std::vector<MapNode>* nodes) {
+        for (s16 z = 0; z < MAP_BLOCKSIZE; ++z)
+            for (s16 y = 0; y < MAP_BLOCKSIZE; ++y)
+                for (s16 x = 0; x < MAP_BLOCKSIZE; ++x) {
+                    const size_t index = z * MapBlock::zstride + y * MapBlock::ystride + x;
+                    block.setNodeNoCheck(x, y, z, nodes ? (*nodes)[index] : MapNode(CONTENT_AIR, 0xff));
+                }
+        // Network deserialization can cache an empty block as isAir=true.
+        block.expireIsAirCache();
+        block.resetUsageTimer();
+    }
+
+    bool restore_projected_block(MapBlock* block) {
+        std::lock_guard<std::recursive_mutex> lock(CddaBridge::projectionMutex());
+        if (!block) return false;
+        const auto it = projected_blocks_.find(block->getPos());
+        if (it == projected_blocks_.end()) return false;
+        apply_nodes(*block, &it->second);
+        return true;
+    }
+
+    void commit_projection(const std::set<v3s16>& modified_blocks) {
+        if (!client_) return;
+        std::lock_guard<std::recursive_mutex> lock(CddaBridge::projectionMutex());
+        Map& map = client_->getEnv().getMap();
+        for (const auto& bp : modified_blocks) {
+            MapSector* sector = map.emergeSector(v2s16(bp.X, bp.Z));
+            if (!sector) continue;
+            MapBlock* block = sector->getBlockNoCreateNoEx(bp.Y);
+            if (!block) block = sector->createBlankBlock(bp.Y);
+            const auto it = projected_blocks_.find(bp);
+            apply_nodes(*block, it == projected_blocks_.end() ? nullptr : &it->second);
+            client_->addUpdateMeshTaskWithEdge(bp, false, true);
+        }
+    }
+
+    content_t get_node_for_material(uint16_t mat_id) {
+        if (mat_id == 0) return CONTENT_AIR;
+        auto it = material_map_.find(mat_id);
+        if (it != material_map_.end()) return it->second;
+
+        if (!client_) return CONTENT_AIR;
+        const NodeDefManager* ndef = client_->getNodeDefManager();
+        if (!ndef) return CONTENT_AIR;
+
+        content_t cid = CONTENT_AIR;
+        switch (mat_id) {
+            case 1: cid = ndef->getId("cdda_nodes:dirt"); break;
+            case 2: cid = ndef->getId("cdda_nodes:grass_block"); break;
+            case 3: cid = ndef->getId("cdda_nodes:brick_wall"); break;
+            case 4: cid = ndef->getId("cdda_nodes:wood_planks"); break;
+            case 5: cid = ndef->getId("cdda_nodes:door_wood_closed"); break;
+            case 6: cid = ndef->getId("cdda_nodes:door_wood_open"); break;
+            case 7: cid = ndef->getId("cdda_nodes:glass"); break;
+            case 8: cid = ndef->getId("cdda_nodes:stone"); break;
+            case 9: cid = ndef->getId("cdda_nodes:furniture_wood"); break;
+            case 10: cid = CONTENT_AIR; break;
+            case 11: cid = ndef->getId("cdda_nodes:wood_planks"); break;
+            case 12: cid = ndef->getId("cdda_nodes:stone"); break;
+            case 13: cid = ndef->getId("cdda_nodes:glass"); break;
+            case 14: cid = ndef->getId("cdda_nodes:water"); break;
+            case 15: cid = ndef->getId("cdda_nodes:stone"); break;
+            default: cid = ndef->getId("cdda_nodes:stone"); break;
+        }
+        if (cid == CONTENT_IGNORE) cid = CONTENT_AIR;
+        material_map_[mat_id] = cid;
+        return cid;
+    }
+
+    void set_voxel(const v3s16& lpos, content_t cid, uint8_t light, uint8_t param2, std::set<v3s16>& modified_blocks) {
+        v3s16 bp, offset;
+        getNodeBlockPosWithOffset(lpos, bp, offset);
+        auto& nodes = projected_blocks_.try_emplace(bp, size_t(MapBlock::nodecount),
+                                                    MapNode(CONTENT_AIR, 0xff)).first->second;
+        // Same light in day and night banks: CDDA, not Luanti's clock, decides brightness.
+        const uint8_t l = light & 0x0F;
+        const size_t index = offset.Z * MapBlock::zstride + offset.Y * MapBlock::ystride + offset.X;
+        nodes[index] = MapNode(cid, (uint8_t)(l | (l << 4)), param2);
+        modified_blocks.insert(bp);
+    }
+
+    void place_cdda_tile(const v3s16& base, uint16_t material, uint32_t flags,
+                         uint8_t light, uint8_t orientation, std::set<v3s16>& modified) {
+        using namespace cdda::cwm;
+        if (terrain_demo_) {
+            if (material == AIR) terrain_tiles_.erase(base);
+            else terrain_tiles_.insert_or_assign(base, CDDA::CWM::CwmBlock(flags, material, light, orientation));
+        }
+        // The baseline retains the previous renderer's material mapping.
+        if (!terrain_enriched_) {
+            if (material == SAND || material == SHRUB) material = DIRT;
+            else if (material == TALL_GRASS) material = GRASS;
+            else if (material == TREE) material = OBSTACLE;
+            else if (material == SIDEWALK) material = PAVEMENT;
+        }
+        // Each nodebox stays inside its own cell; split doors avoid cross-cell
+        // occlusion, and ordinary cubes retain faces visible from either side.
+        const uint8_t facedir = orientation == 1 ? 1 : 0;
+        content_t floor = material == AIR ? CONTENT_AIR : get_node_for_material(FLOOR);
+        content_t lower = CONTENT_AIR, upper = CONTENT_AIR;
+        switch (material) {
+            case AIR: break;
+            case WALL: case OBSTACLE: case GLASS_WALL:
+                floor = lower = upper = get_node_for_material(material); break;
+            case DOOR_CLOSED: case DOOR_OPEN:
+                lower = get_node_for_material(material);
+                if (material == DOOR_OPEN && (flags & BLOCKS_MOVEMENT))
+                    lower = get_node_for_material(LOW_OBSTACLE);
+                upper = get_node_for_material(WALL); break;
+            case WINDOW: case WINDOW_OPEN: case WINDOW_BOARDED:
+                // The sill belongs to the wall; opening removes only the pane.
+                floor = lower = get_node_for_material(WALL);
+                upper = get_node_for_material(material); break;
+            case LEGACY_FURNITURE:
+                lower = get_node_for_material(LEGACY_FURNITURE); break;
+            case LOW_OBSTACLE:
+                lower = get_node_for_material(LOW_OBSTACLE); break;
+            case SAND: floor = terrain_node("cdda_nodes:demo_sand"); break;
+            case SIDEWALK: floor = terrain_node("cdda_nodes:demo_sidewalk"); break;
+            case TREE:
+                floor = get_node_for_material(DIRT);
+                lower = terrain_node("cdda_nodes:demo_tree");
+                upper = terrain_node("cdda_nodes:demo_leaves"); break;
+            case SHRUB:
+                floor = get_node_for_material(GRASS);
+                lower = terrain_node("cdda_nodes:demo_shrub"); break;
+            case TALL_GRASS:
+                floor = get_node_for_material(GRASS);
+                lower = terrain_node("cdda_nodes:demo_tall_grass"); break;
+            default: floor = get_node_for_material(material); break;
+        }
+        if (terrain_enriched_) {
+            if (material == GRASS || material == TALL_GRASS || material == SHRUB) {
+                const std::string name = "cdda_nodes:demo_grass_" + std::to_string(terrain_variant(base));
+                floor = terrain_node(name.c_str());
+            } else if (material == DIRT) {
+                const std::string name = "cdda_nodes:demo_dirt_" + std::to_string(terrain_variant(base));
+                floor = terrain_node(name.c_str());
+            } else if (material == PAVEMENT) floor = terrain_node("cdda_nodes:demo_asphalt");
+            else if (material == WATER) floor = terrain_node("cdda_nodes:demo_water");
+        }
+        if (flags & FURNITURE) {
+            lower = get_node_for_material(LEGACY_FURNITURE);
+            if (flags & TALL_FURNITURE) upper = lower;
+        }
+        // Recognizable entry geometry for native connections. These are
+        // contextual transitions, not Luanti stairs with their own physics.
+        // Water can have GOES_UP too: keep its native water presentation.
+        if (material != WATER && (flags & (GOES_UP | GOES_DOWN))) {
+            if (flags & GOES_DOWN) floor = terrain_node("cdda_nodes:stairwell");
+            if (flags & GOES_UP) {
+                lower = terrain_node(flags & DIFFICULT_Z ?
+                    "cdda_nodes:ladder_lower" : "cdda_nodes:stairs_entry");
+                upper = flags & DIFFICULT_Z ? terrain_node("cdda_nodes:ladder_upper") : CONTENT_AIR;
+            }
+        }
+        set_voxel(base, floor, light, 0, modified);
+        set_voxel(base + v3s16(0, 1, 0), lower, light, facedir, modified);
+        // Door covers both headroom cells using two independent nodeboxes.
+        if (material == DOOR_CLOSED || material == DOOR_OPEN)
+            upper = client_->getNodeDefManager()->getId(material == DOOR_CLOSED ?
+                "cdda_nodes:door_wood_closed_top" : "cdda_nodes:door_wood_open_top");
+        set_voxel(base + v3s16(0, 2, 0), upper, light, facedir, modified);
+    }
+
+    void apply_tile(const CDDA::CWM::TileDelta* delta, std::set<v3s16>& modified) {
+        if (!delta || !delta->coord() || !delta->block()) return;
+        const auto* p = delta->coord();
+        const auto* block = delta->block();
+        place_cdda_tile(project_tile(p->x(), p->y(), p->z()),
+                       block->material_id(), block->state_flags(), block->light_level(),
+                       block->orientation(), modified);
+    }
+
+    void clear_world() {
+        std::lock_guard<std::recursive_mutex> lock(CddaBridge::projectionMutex());
+        for (auto& [id, ent] : entities_) if (ent.scene_node)
+            static_cast<irr::scene::ISceneNode*>(ent.scene_node)->remove();
+        entities_.clear();
+        for (auto& [id, vehicle] : vehicles_) for (auto& part : vehicle.components)
+            if (part.scene_node) static_cast<irr::scene::ISceneNode*>(part.scene_node)->remove();
+        vehicles_.clear();
+        std::set<v3s16> old_blocks;
+        for (const auto& [pos, nodes] : projected_blocks_) old_blocks.insert(pos);
+        projected_blocks_.clear(); terrain_tiles_.clear(); terrain_bounds_.clear();
+        clear_ground_item_visuals();
+        ground_items_.clear();
+        owned_items_.clear(); last_ground_target_.reset(); cancel_pickup_selection(); cancel_equipment();
+        avatar_status_ = {}; body_close_requested_ = true;
+        commit_projection(old_blocks);
+        origin_valid_ = false;
+        pending_move_ = 0; metrics_.pending_decision = 0;
+        player_feet_offset_ = player_eye_offset_ = 0.f;
+        posture_input_ = {}; posture_command_ = 0; deferred_opening_.reset();
+    }
+
+    bool send_clock_control(CDDA::CWM::SimulationControl action, float scale = 1.f) {
+        if (!metrics_.realtime || !player_ready_ || !session_.ready()) return false;
+        auto builder = session_.builder();
+        auto request = CDDA::CWM::CreateSimulationControlRequest(builder.builder(), session_.next_command++, action, scale);
+        const auto bytes = builder.finish_message(CDDA::CWM::Payload::SimulationControlRequest, request.Union());
+        return connection_->send_message(bytes.data(), bytes.size());
+    }
+
+    void movement_intent(int direction) {
+        if (metrics_.continuous_motion) { continuous_intent(0, 0); return; }
+        if (!metrics_.realtime) return;
+        if (!player_ready_ || !session_.ready() || metrics_.pause_reasons || metrics_.pending_decision) {
+            sent_intent_ = 0; intent_needs_release_ = direction != 0; return;
+        }
+        if (!direction) intent_needs_release_ = false;
+        if (direction && intent_needs_release_) return;
+        if (sent_intent_ == direction) return;
+        auto builder = session_.builder();
+        auto request = CDDA::CWM::CreateMovementIntentRequest(builder.builder(), session_.next_command++,
+            static_cast<CDDA::CWM::MoveDirection>(direction));
+        const auto bytes = builder.finish_message(CDDA::CWM::Payload::MovementIntentRequest, request.Union());
+        if (connection_->send_message(bytes.data(), bytes.size())) sent_intent_ = direction;
+    }
+
+    void continuous_intent(float x, float y) {
+        if (!metrics_.continuous_motion) return;
+        const bool pressed = std::hypot(x, y) > 1e-5f;
+        // Pause bit 3 is Recovery.  The native server deliberately accepts
+        // ContinuousIntent while Recovery is the sole pause reason: simulation
+        // remains frozen, but current held/released direction must not become
+        // stale across the full-state acknowledgement window.
+        constexpr uint32_t recovery_pause = 1u << 3;
+        const bool recovery_only = metrics_.pause_reasons == recovery_pause;
+        if (!player_ready_ || !session_.ready() ||
+                (metrics_.pause_reasons && !recovery_only) || metrics_.pending_decision) {
+            sent_intent_x_ = sent_intent_y_ = 0; intent_needs_release_ = pressed; return;
+        }
+        if (!pressed) intent_needs_release_ = false;
+        if (pressed && intent_needs_release_) return;
+        if (std::hypot(x-sent_intent_x_, y-sent_intent_y_) < .005f) return;
+
+        // Press/release stay immediate.  While held, coalesce camera-heading
+        // changes to CDDA's 25 Hz authoritative continuous-motion cadence.
+        static auto next_heading_update = std::chrono::steady_clock::time_point{};
+        const auto now = std::chrono::steady_clock::now();
+        const bool starting = std::hypot(sent_intent_x_, sent_intent_y_) <= 1e-5f;
+        if (pressed && !starting && now < next_heading_update) return;
+
+        auto builder = session_.builder();
+        auto request = CDDA::CWM::CreateContinuousIntentRequest(builder.builder(), session_.next_command++, x, y);
+        const auto bytes = builder.finish_message(CDDA::CWM::Payload::ContinuousIntentRequest, request.Union());
+        if (connection_->send_message(bytes.data(), bytes.size())) {
+            sent_intent_x_ = x; sent_intent_y_ = y;
+            next_heading_update = pressed ?
+                now + std::chrono::milliseconds(40) :
+                std::chrono::steady_clock::time_point{};
+        }
+    }
+
+    bool connect() {
+        connection_ = cdda::cwm::IpcClient::connect_unix(socket_path_, 0);
+        metrics_.connected = false; player_ready_ = false; pending_move_ = 0;
+        deferred_opening_.reset();
+        sync_timer_ = 0.f;
+        sent_intent_ = 0; sent_intent_x_ = sent_intent_y_ = 0; intent_needs_release_ = true; sent_menu_pause_ = -1;
+        if (connection_ && connection_->is_valid() && session_.begin(*connection_)) return true;
+        return false;
+    }
+
+    void disconnected() {
+        session_.disconnected();
+        body_close_requested_ = true;
+        cancel_pickup_selection(); cancel_equipment();
+        metrics_.connected = false; player_ready_ = false; pending_move_ = 0;
+        deferred_opening_.reset();
+        connection_.reset(); metrics_.pending_decision = 0;
+        for (auto& [id, ent] : entities_) if (ent.scene_node)
+            static_cast<irr::scene::ISceneNode*>(ent.scene_node)->setVisible(false);
+        for (auto& [id, vehicle] : vehicles_) for (auto& part : vehicle.components)
+            if (part.scene_node) static_cast<irr::scene::ISceneNode*>(part.scene_node)->setVisible(false);
+        for (auto& [pos, visual] : ground_item_visuals_)
+            for (auto* node : visual.nodes) if (node) node->setVisible(false);
+    }
+
+    void update(float dtime) {
+        visual_animation_delta_ = 0.f;
+        ipc_work_ = {};
+        if (!connection_ || !connection_->is_valid()) {
+            disconnected();
+            reconnect_timer_ += dtime;
+            if (reconnect_timer_ > 2.0f) {
+                reconnect_timer_ = 0.0f;
+                connect();
+            }
+            return;
+        }
+
+        std::vector<std::vector<uint8_t>> incoming;
+        const bool ok = connection_->poll_and_receive(incoming, 0);
+        ipc_work_ = connection_->last_work();
+        for (const auto& frame : incoming) {
+            if (!cdda::cwm::MessageVerifier::verify(frame.data(), frame.size())) {
+                connection_->close(cdda::cwm::IpcCloseReason::InvalidFrame);
+                break;
+            }
+            process_message(frame.data(), frame.size());
+            if (ok && !connection_->is_valid()) break;
+        }
+        if (!ok || !connection_->is_valid()) {
+            disconnected();
+            return;
+        }
+
+        player_ready_ = session_.ready() && entities_.count(1);
+        if (deferred_opening_) {
+            if (!session_.ready() || !player_ready_ || metrics_.pause_reasons || metrics_.pending_decision ||
+                sent_menu_pause_ == 1 || body_form_open_ || ground_container_open_ || equipment_open_ ||
+                std::chrono::steady_clock::now() >= deferred_opening_->expires) deferred_opening_.reset();
+            else if (!pending_move_) {
+                const auto opening = *deferred_opening_;
+                deferred_opening_.reset();
+                send_interact_request(opening.x, opening.y, opening.z, opening.action);
+            }
+        }
+        flush_pickup();
+        flush_equipment();
+        if (player_ready_) sync_timer_ = 0.f;
+        else {
+            sync_timer_ += dtime;
+            if (sync_timer_ > 5.f) { connection_->close(); disconnected(); return; }
+        }
+
+        const bool frozen = !player_ready_ || !session_.ready() || metrics_.pause_reasons ||
+            metrics_.pending_decision || sent_menu_pause_ == 1 || body_form_open_ || ground_container_open_ || equipment_open_;
+        visual_animation_delta_ = frozen ? 0.f : dtime * (metrics_.realtime ? metrics_.time_scale : 1.f);
+        visual_animation_time_ += visual_animation_delta_;
+
+        // Interpolate visual entities
+        for (auto& [id, ent] : entities_) {
+            const float elapsed = frozen ? 0.f : dtime;
+            ent.interpolation_time = std::min(ent.motion_seconds, ent.interpolation_time + elapsed);
+            ent.current_pos = ent.start_pos + (ent.target_pos - ent.start_pos) *
+                              (ent.interpolation_time / ent.motion_seconds);
+            render_entity(ent);
+            
+            // Sync Luanti camera to CDDA player (id == 1)
+            if (id == 1 && client_) {
+                auto* local_player = client_->getEnv().getLocalPlayer();
+                if (local_player) {
+                    using namespace cdda::cwm;
+                    float feet = 0.f, eye = 0.f;
+                    if (ent.state_flags & PRONE) eye = -1.3f;
+                    else if (ent.state_flags & CROUCHING) eye = -.7f;
+                    if (ent.state_flags & WINDOW_PASSAGE) {
+                        feet = 1.f; eye = -.85f; // crouched passage over the sill
+                    } else if (ent.state_flags & UNDERWATER) { feet = -1.8f; eye = 0.f; }
+                    else if (ent.state_flags & SWIMMING) { feet = -1.2f; eye = 0.f; }
+                    else if (ent.state_flags & WADING) {
+                        feet = -.3f;
+                        // Keep a prone eye above the shallow-water/floor surface.
+                        // Compensate most of the wading offset, retaining a small 0.08-node dip.
+                        if (ent.state_flags & PRONE) eye += .22f;
+                    }
+                    const float blend = 1.f - std::exp(-20.f * (frozen ? 0.f : dtime));
+                    player_feet_offset_ += (feet - player_feet_offset_) * blend;
+                    player_eye_offset_ += (eye - player_eye_offset_) * blend;
+                    local_player->eye_offset_first.Y = player_eye_offset_ * 10.f;
+                    local_player->setPosition((ent.current_pos +
+                        v3f(0, 0.5f + player_feet_offset_, 0)) * 10.0f);
+                }
+            }
+        }
+
+        // Interpolate visual vehicles and manage scene nodes
+        if (client_ && !smgr_) {
+            smgr_ = client_->getSceneManager();
+        }
+
+        update_ground_item_visuals(visual_animation_delta_);
+
+        for (auto& [id, veh] : vehicles_) {
+            v3f diff = veh.target_pos - veh.current_pos;
+            veh.current_pos += diff * std::min(1.0f, (frozen ? 0.f : dtime) * 12.0f);
+
+            if (smgr_) {
+                for (auto& comp : veh.components) {
+                    if (!comp.scene_node) {
+                        // Create a simple cube node for the vehicle component
+                        // BS (Block Size) is 10.0f
+                        irr::scene::ISceneNode* node = smgr_->addEmptySceneNode();
+                        if (node) {
+                            // node->getMaterial(0).setFlag(irr::video::EMF_LIGHTING, false);
+                            if (comp.is_broken) {
+                                // Maybe darker color, just handle node creation
+                            }
+                            comp.scene_node = node;
+                        }
+                    }
+                    if (comp.scene_node) {
+                        irr::scene::ISceneNode* node = static_cast<irr::scene::ISceneNode*>(comp.scene_node);
+                        
+                        // Calculate world position based on pivot and rotation
+                        // CDDA rotations: 0 is East, 90 is South, etc.
+                        float rad = veh.rotation * irr::core::DEGTORAD;
+                        float cos_r = std::cos(rad);
+                        float sin_r = std::sin(rad);
+                        
+                        // Apply rotation to mount offset
+                        // Mount offset X is forward/back, Y is left/right in CDDA
+                        float ox = comp.mount_offset.X;
+                        float oz = comp.mount_offset.Z;
+                        
+                        float rx = ox * cos_r - oz * sin_r;
+                        float rz = ox * sin_r + oz * cos_r;
+                        
+                        v3f world_pos(
+                            (veh.current_pos.X + rx) * 10.0f, // Luanti uses BS=10.0f
+                            (veh.current_pos.Y) * 10.0f,
+                            (veh.current_pos.Z + rz) * 10.0f
+                        );
+                        
+                        node->setVisible(session_.ready());
+                        node->setPosition(world_pos);
+                        node->setRotation(v3f(0.0f, -veh.rotation, 0.0f));
+                    }
+                }
+            }
+        }
+    }
+
+    void process_message(const uint8_t* data, size_t size) {
+        const auto* msg = cdda::cwm::MessageVerifier::parse(data, size);
+        if (!msg) return;
+
+        const auto previous_state = session_.state;
+        if (!session_.accept(*msg, *connection_)) {
+            if (!session_.ready()) {
+                cancel_pickup_selection(); cancel_equipment();
+                body_close_requested_ = true;
+            }
+            player_ready_ = false;
+            if (previous_state != session_.state) sync_timer_ = 0.f;
+            return;
+        }
+        if (previous_state != session_.state) sync_timer_ = 0.f;
+        metrics_.connected = true;
+        if (session_.clear_world) { clear_world(); session_.clear_world = false; }
+        if (msg->payload_type() == CDDA::CWM::Payload::WorldReset) {
+            cancel_pickup_selection(); cancel_equipment();
+            body_close_requested_ = true;
+            player_ready_ = false;
+            metrics_.pending_decision = 0;
+            pending_move_ = 0;
+        }
+
+        switch (msg->payload_type()) {
+            case CDDA::CWM::Payload::InventoryView: {
+                const auto* view = msg->payload_as_InventoryView();
+                if (equipment_open_ && view->query_id() == inventory_query_) {
+                    equipment_view_.read(*view); equipment_dirty_ = true;
+                }
+                break;
+            }
+            case CDDA::CWM::Payload::HelloResponse: {
+                const auto* resp = msg->payload_as_HelloResponse();
+                if (resp && resp->accepted()) {
+                    std::cout << "[Luanti-CDDA] Handshake accepted by server: "
+                              << (resp->server_build_id() ? resp->server_build_id()->str() : "") << std::endl;
+                }
+                break;
+            }
+
+            case CDDA::CWM::Payload::WorldSnapshot: {
+                std::lock_guard<std::recursive_mutex> lock(CddaBridge::projectionMutex());
+                const auto* snap = msg->payload_as_WorldSnapshot();
+                if (!snap || !snap->origin()) {
+                    warningstream << "[Luanti-CDDA] Ignoring snapshot without origin" << std::endl;
+                    break;
+                }
+                metrics_.safety_stop = snap->safety_stop();
+                const auto projection_started = std::chrono::steady_clock::now();
+                const v3s32 origin(snap->origin()->x(), snap->origin()->y(), snap->origin()->z());
+                const bool had_origin = origin_valid_;
+                const v3s32 previous_projection_origin = projection_origin_;
+                const bool rebased = !had_origin || origin.X != projection_origin_.X ||
+                                     origin.Y != projection_origin_.Y;
+                if (!origin_valid_) scene_origin_ = origin;
+                projection_origin_ = origin;
+                origin_valid_ = true;
+
+                if (snap->chunks() && snap->chunks()->size() > 0)
+                    metrics_.chunks_loaded = snap->chunks()->size();
+                metrics_.entities_count = snap->entities() ? snap->entities()->size() : 0;
+
+                // Ingest chunk voxels into Luanti ClientMap
+                if (client_ && snap->chunks() && snap->chunks()->size() > 0) {
+                    std::set<v3s16> modified_blocks;
+                    // Compare full snapshots in the stable scene coordinates.
+                    // Retain overlapping meshes; replace/remove changed blocks
+                    // only. A CDDA rebase must not remesh the world under the camera.
+                    auto previous_blocks = std::move(projected_blocks_);
+                    projected_blocks_.clear();
+                    terrain_tiles_.clear();
+
+                    for (size_t ci = 0; ci < snap->chunks()->size(); ++ci) {
+                        const auto* chunk = snap->chunks()->Get(ci);
+                        if (!chunk || !chunk->blocks()) continue;
+
+                        int cx = chunk->chunk_x();
+                        int cy = chunk->chunk_y();
+                        int cz = chunk->chunk_z();
+                        uint8_t sx = chunk->size_x();
+                        uint8_t sy = chunk->size_y();
+                        uint8_t sz = chunk->size_z();
+
+                        size_t block_idx = 0;
+                        for (uint8_t bz = 0; bz < sz; ++bz) {
+                            for (uint8_t by = 0; by < sy; ++by) {
+                                for (uint8_t bx = 0; bx < sx; ++bx) {
+                                    if (block_idx >= chunk->blocks()->size()) break;
+                                    const auto* b = chunk->blocks()->Get(block_idx++);
+
+                                    uint16_t mat_id = b->material_id();
+                                    int gx = cx * sx + bx;
+                                    int gy = cy * sy + by;
+                                    int gz = cz + bz;
+
+                                    v3s16 lpos = project_tile(gx, gy, gz);
+                                    uint8_t light = b->light_level();
+                                    uint8_t param2 = b->orientation();
+
+                                    place_cdda_tile(lpos, mat_id, b->state_flags(), light, param2, modified_blocks);
+                                }
+                            }
+                        }
+                    }
+
+                    for (auto it = modified_blocks.begin(); it != modified_blocks.end();) {
+                        const auto previous = previous_blocks.find(*it);
+                        if (previous != previous_blocks.end() &&
+                            previous->second == projected_blocks_.at(*it))
+                            it = modified_blocks.erase(it);
+                        else ++it;
+                    }
+                    for (const auto& previous : previous_blocks)
+                        if (!projected_blocks_.count(previous.first)) modified_blocks.insert(previous.first);
+
+                    commit_projection(modified_blocks);
+                    update_terrain_bounds();
+                    infostream << "[Luanti-CDDA] Installed terrain projection in "
+                               << projected_blocks_.size() << " local map blocks" << std::endl;
+                }
+
+                const bool incremental_rebase = had_origin && rebased &&
+                    (!snap->chunks() || snap->chunks()->size() == 0);
+
+                if (client_ && (incremental_rebase ||
+                    (snap->tiles() && snap->tiles()->size() > 0))) {
+                    std::set<v3s16> modified_blocks;
+
+                    if (incremental_rebase) {
+                        constexpr int projection_width = 132;
+                        for (int z = previous_projection_origin.Z;
+                             z < previous_projection_origin.Z + 3; ++z) {
+                            for (int y = 0; y < projection_width; ++y) {
+                                for (int x = 0; x < projection_width; ++x) {
+                                    const int abs_x = previous_projection_origin.X + x;
+                                    const int abs_y = previous_projection_origin.Y + y;
+                                    const int nx = abs_x - origin.X;
+                                    const int ny = abs_y - origin.Y;
+                                    if (nx >= 0 && nx < projection_width &&
+                                        ny >= 0 && ny < projection_width)
+                                        continue;
+                                    const v3s16 lpos = CddaBridge::cddaToLuantiCoord(
+                                        abs_x - scene_origin_.X,
+                                        abs_y - scene_origin_.Y, z);
+                                    place_cdda_tile(lpos, cdda::cwm::AIR, 0, 0, 0,
+                                                    modified_blocks);
+                                }
+                            }
+                        }
+                    }
+
+                    if (snap->tiles())
+                        for (const auto* delta : *snap->tiles())
+                            apply_tile(delta, modified_blocks);
+
+                    commit_projection(modified_blocks);
+                    update_terrain_bounds();
+                }
+
+                if (snap->full())
+                    ground_items_.clear();
+                else if (incremental_rebase)
+                    ground_items_.pruneWindow(origin, scene_origin_);
+
+                if (snap->ground_item_tiles()) {
+                    for (const auto* tile : *snap->ground_item_tiles()) {
+                        if (!tile || !tile->coord()) continue;
+
+                        std::vector<GroundItemView> items;
+                        if (tile->items()) {
+                            items.reserve(tile->items()->size());
+                            for (const auto* state : *tile->items()) {
+                                if (!state) continue;
+                                items.push_back({
+                                    state->stack_index(),
+                                    state->type_id() ? state->type_id()->str() : "",
+                                    state->name() ? state->name()->str() : "",
+                                    state->charges(),
+                                    state->count_by_charges()
+                                });
+                            }
+                        }
+
+                        const auto* p = tile->coord();
+                        ground_items_.apply(project_tile(p->x(), p->y(), p->z()),
+                                            std::move(items));
+                    }
+                }
+
+                if (snap->full()) owned_items_.clear();
+                if (snap->full()) avatar_status_ = {};
+                if (const auto* status = snap->avatar_status()) {
+                    const auto view = [](const auto* value) {
+                        return StatusView{value->id()->str(), value->label()->str(),
+                            value->text()->str(), value->color()->str(), value->perceived_level()};
+                    };
+                    avatar_status_ = {};
+                    avatar_status_.available = true;
+                    avatar_status_.stamina = view(status->stamina());
+                    for (const auto* need : *status->needs()) avatar_status_.needs.push_back(view(need));
+                    for (const auto* part : *status->body_parts())
+                        avatar_status_.parts.push_back({part->id()->str(), part->label()->str(),
+                            view(part->health()), view(part->temperature())});
+                }
+                if (snap->owned_items()) {
+                    owned_items_.clear();
+                    for (const auto* item : *snap->owned_items())
+                        owned_items_.push_back({item->stack_index(), item->type_id()->str(),
+                            item->name()->str(), item->charges(), item->count_by_charges()});
+                    if (ground_container_open_)
+                        populate_mirror(owned_mirror_, owned_items_, 36);
+                }
+
+                // Each atomic state carries the full vehicle roster.
+                std::set<uint64_t> vehicle_ids;
+                metrics_.vehicles_count = snap->vehicles()->size();
+                for (const auto* state : *snap->vehicles()) {
+                    const auto id = state->id(); vehicle_ids.insert(id);
+                    auto& vehicle = vehicles_[id];
+                    const auto target = project_position(state->pivot()->x(), state->pivot()->y(), state->pivot()->z());
+                    if (!vehicle.id) vehicle.current_pos = target;
+                    vehicle.id = id; vehicle.target_pos = target; vehicle.rotation = state->rotation();
+                    vehicle.name = state->name() ? state->name()->str() : "";
+                    for (auto& part : vehicle.components) if (part.scene_node)
+                        static_cast<irr::scene::ISceneNode*>(part.scene_node)->remove();
+                    vehicle.components.clear();
+                    if (state->components()) for (const auto* part : *state->components())
+                        vehicle.components.push_back({part->part_id() ? part->part_id()->str() : "",
+                            v3f(part->offset()->x(), 0.f, -part->offset()->y()), part->broken(), part->open(), nullptr});
+                }
+                for (auto it = vehicles_.begin(); it != vehicles_.end();) {
+                    if (vehicle_ids.count(it->first)) { ++it; continue; }
+                    for (auto& part : it->second.components) if (part.scene_node)
+                        static_cast<irr::scene::ISceneNode*>(part.scene_node)->remove();
+                    it = vehicles_.erase(it);
+                }
+
+                metrics_.simulation_time = snap->simulation_time_seconds();
+                metrics_.realtime = snap->clock() && snap->clock()->realtime();
+                metrics_.continuous_motion = snap->clock() && snap->clock()->continuous_motion();
+                metrics_.pause_reasons = snap->clock() ? snap->clock()->pause_reasons() : 0;
+                metrics_.time_scale = snap->clock() ? snap->clock()->time_scale() : 1.f;
+                // Recovery-only is a transport/full-state pause, not an
+                // authoritative input cancellation.  Preserve the last
+                // actually-sent continuous vector so camera changes and the
+                // eventual physical release can still reach CDDA.  Other
+                // pauses deliberately drop held input and require a fresh press.
+                constexpr uint32_t recovery_pause = 1u << 3;
+                const bool recovery_only = metrics_.pause_reasons == recovery_pause;
+                if (metrics_.realtime && metrics_.pause_reasons &&
+                        (!metrics_.continuous_motion || !recovery_only)) {
+                    sent_intent_ = 0; sent_intent_x_ = sent_intent_y_ = 0; intent_needs_release_ = true;
+                }
+                // Sync entities
+                if (snap->entities()) {
+                    std::set<uint64_t> present;
+                    for (size_t i = 0; i < snap->entities()->size(); ++i) {
+                        const auto* ent_state = snap->entities()->Get(i);
+                        if (!ent_state || !ent_state->pos()) continue;
+                        uint64_t eid = ent_state->id();
+                        present.insert(eid);
+                        v3f target = project_position(ent_state->pos()->x(),
+                            ent_state->pos()->y(), ent_state->pos()->z());
+                        if (eid == 1 && rebased)
+                            infostream << "[Luanti-CDDA] Player projected at local ("
+                                       << target.X << ", " << target.Y << ", " << target.Z
+                                       << ")" << std::endl;
+
+                        auto it = entities_.find(eid);
+                        if (it == entities_.end()) {
+                            VisualEntity ve;
+                            ve.id = eid;
+                            ve.motion_seconds = ent_state->motion_seconds();
+                            ve.interpolation_time = ve.motion_seconds;
+                            ve.type_id = ent_state->type_id() ? ent_state->type_id()->str() : "";
+                            ve.name = ent_state->name() ? ent_state->name()->str() : "";
+                            ve.current_pos = target;
+                            ve.target_pos = target;
+                            ve.start_pos = target;
+                            ve.rotation = ent_state->rotation();
+                            ve.hp_percent = ent_state->hp_percent();
+                            ve.state_flags = ent_state->state_flags();
+                            ve.perceived = ent_state->perceived();
+                            ve.humanoid = ent_state->type() == CDDA::CWM::EntityType::NPC;
+                            entities_[eid] = ve;
+                        } else {
+                            const float fraction = it->second.interpolation_time / it->second.motion_seconds;
+                            it->second.motion_seconds = ent_state->motion_seconds();
+                            it->second.interpolation_time = fraction * it->second.motion_seconds;
+                            const std::string type_id = ent_state->type_id() ? ent_state->type_id()->str() : "";
+                            if (it->second.type_id != type_id) {
+                                if (it->second.scene_node)
+                                    static_cast<irr::scene::ISceneNode*>(it->second.scene_node)->remove();
+                                it->second.scene_node = nullptr;
+                                it->second.node_generation = 0;
+                                it->second.type_id = type_id;
+                            }
+                            it->second.name = ent_state->name() ? ent_state->name()->str() : "";
+                            it->second.humanoid = ent_state->type() == CDDA::CWM::EntityType::NPC;
+                            // A full recovery state or newly perceived actor
+                            // establishes its position now. Never animate a
+                            // path through the unseen interval or reconnect gap.
+                            if (previous_state != cdda::cwm::SessionState::Running ||
+                                !it->second.perceived || !ent_state->perceived()) {
+                                it->second.current_pos = target;
+                                it->second.start_pos = target;
+                                it->second.interpolation_time = it->second.motion_seconds;
+                            } else if (target != it->second.target_pos) {
+                                it->second.start_pos = it->second.current_pos;
+                                it->second.interpolation_time = 0.0f;
+                            }
+                            it->second.target_pos = target;
+                            it->second.rotation = ent_state->rotation();
+                            it->second.hp_percent = ent_state->hp_percent();
+                            it->second.state_flags = ent_state->state_flags();
+                            it->second.perceived = ent_state->perceived();
+                        }
+                    }
+                    for (auto it = entities_.begin(); it != entities_.end();) {
+                        if (!present.count(it->first)) {
+                            if (it->second.scene_node)
+                                static_cast<irr::scene::ISceneNode*>(it->second.scene_node)->remove();
+                            it = entities_.erase(it);
+                        } else ++it;
+                    }
+                }
+                if (!session_.commit(*snap, *connection_)) { connection_->close(); return; }
+                metrics_.current_revision = session_.revision;
+                player_ready_ = session_.ready() && entities_.count(1) != 0;
+                metrics_.projection_ms = std::chrono::duration<float, std::milli>(
+                    std::chrono::steady_clock::now() - projection_started).count();
+                // ACK can arrive before simulation ends. Unlock only when its
+                // authoritative result has also arrived; never queue held keys.
+                if (pending_move_ && move_acked_ && snap->completed_command_id() == pending_move_ &&
+                    snap->world_revision() >= ack_revision_) {
+                    metrics_.ipc_latency_ms = std::chrono::duration<float, std::milli>(
+                        std::chrono::steady_clock::now() - sent_move_).count();
+                    pending_move_ = 0;
+                }
+                break;
+            }
+
+            case CDDA::CWM::Payload::TileDelta: {
+                const auto* delta = msg->payload_as_TileDelta();
+                if (client_) {
+                    std::set<v3s16> modified_blocks;
+                    apply_tile(delta, modified_blocks);
+                    commit_projection(modified_blocks);
+                }
+                break;
+            }
+
+            case CDDA::CWM::Payload::CommandAck: {
+                const auto* ack = msg->payload_as_CommandAck();
+                if (ack) {
+                    if (ack->command_id() == last_attack_command_) last_attack_result_ = ack->accepted() ? 1 : 0;
+                    if (ack->command_id() == posture_command_ && !ack->accepted())
+                        posture_input_.reject(requested_posture_);
+                    if (!ack->accepted() && ack->error_message()) {
+                        const auto error = ack->error_message()->str();
+                        item_hint_ = error == "Native movement mode unavailable" && requested_posture_ == 1 &&
+                            ack->command_id() == posture_command_ ?
+                            L"Corsa non disponibile: riprendi fiato o controlla le condizioni delle gambe." :
+                            utf8_to_wide(error);
+                        item_hint_until_ = std::chrono::steady_clock::now() + std::chrono::seconds(3);
+                    }
+                    if (ack->command_id() == pending_move_) { move_acked_ = true; ack_revision_ = ack->result_revision(); }
+                }
+                break;
+            }
+
+            case CDDA::CWM::Payload::DecisionPrompt: {
+                const auto* prompt = msg->payload_as_DecisionPrompt();
+                if (!prompt || !prompt->text() || !prompt->choices() || prompt->choices()->size() == 0 ||
+                    prompt->choices()->size() > 9) break;
+                metrics_.pending_decision = prompt->decision_id();
+                metrics_.decision_choices = prompt->choices()->size();
+                decision_body_ = utf8_to_wide(prompt->text()->str()) + L"\n\n";
+                for (size_t i = 0; i < prompt->choices()->size(); ++i)
+                    decision_body_ += std::to_wstring(i + 1) + L". " +
+                        utf8_to_wide(prompt->choices()->Get(i)->str()) + L"\n";
+                decision_body_ += L"\nPress the corresponding number to choose.";
+                break;
+            }
+
+            default:
+                break;
+        }
+    }
+
+    bool send_move_request(int dir) {
+        const auto now = std::chrono::steady_clock::now();
+        if (!connection_ || !connection_->is_valid() || !session_.ready() || !player_ready_ ||
+            pending_move_ || now < next_move_) return false;
+        const uint64_t command = session_.next_command++;
+        auto builder = session_.builder();
+        auto req = builder.build_move_request(command, static_cast<CDDA::CWM::MoveDirection>(dir));
+        if (!connection_->send_message(req.data(), req.size())) return false;
+        pending_move_ = command;
+        move_acked_ = false;
+        sent_move_ = now;
+        next_move_ = now + std::chrono::milliseconds(200);
+        return true;
+    }
+
+    bool send_interact_request(int x, int y, int z, int action) {
+        const auto now = std::chrono::steady_clock::now();
+        if (!connection_ || !connection_->is_valid() || !session_.ready() || !player_ready_ ||
+            metrics_.pending_decision || metrics_.pause_reasons || sent_menu_pause_ == 1 ||
+            body_form_open_ || ground_container_open_ || equipment_open_ || now < next_move_) return false;
+        if (pending_move_) {
+            // A modifier's free posture roundtrip must not eat its OPEN/CLOSE
+            // click. Keep at most one, with native range/state revalidation;
+            // menus, recovery and timeout cancel it. Never defer other actions.
+            if (pending_move_ != posture_command_ || deferred_opening_ ||
+                (action != int(CDDA::CWM::InteractAction::OPEN) && action != int(CDDA::CWM::InteractAction::CLOSE))) return false;
+            deferred_opening_ = DeferredOpening{x,y,z,action,now + std::chrono::seconds(1)};
+            return true;
+        }
+        const uint64_t command = session_.next_command++;
+        auto builder = session_.builder();
+        auto req = builder.build_interact_request(
+            command,
+            x - projection_origin_.X + scene_origin_.X,
+            y - projection_origin_.Y + scene_origin_.Y, z,
+            static_cast<CDDA::CWM::InteractAction>(action)
+        );
+        infostream << "CWM opening request " << command << " action " << action
+                   << " target " << (x - projection_origin_.X + scene_origin_.X)
+                   << ',' << (y - projection_origin_.Y + scene_origin_.Y) << ',' << z
+                   << std::endl;
+        if (!connection_->send_message(req.data(), req.size())) return false;
+        pending_move_ = command;
+        move_acked_ = false;
+        sent_move_ = now;
+        next_move_ = now + std::chrono::milliseconds(200);
+        return true;
+    }
+
+    bool send_attack_request() {
+        const auto now = std::chrono::steady_clock::now();
+        if (!connection_ || !connection_->is_valid() || !session_.ready() || !player_ready_ ||
+            pending_move_ || metrics_.pending_decision || metrics_.pause_reasons ||
+            ground_container_open_ || body_form_open_ || now < next_move_) return false;
+        const auto it = entities_.find(pointed_actor_);
+        if (it == entities_.end() || !it->second.perceived || !it->second.scene_node ||
+            !(it->second.state_flags & cdda::cwm::HOSTILE_TO_PLAYER)) return false;
+        const uint64_t command = session_.next_command++;
+        auto builder = session_.builder();
+        const auto req = builder.build_attack_request(command, pointed_actor_);
+        if (!connection_->send_message(req.data(), req.size())) return false;
+        pending_move_ = command; move_acked_ = false; sent_move_ = now;
+        next_move_ = now + std::chrono::milliseconds(200);
+        last_attack_target_ = pointed_actor_; ++attacks_sent_;
+        last_attack_command_ = command; last_attack_result_ = -1;
+        return true;
+    }
+
+    bool acknowledge_threat() {
+        if (!connection_ || !connection_->is_valid() || !session_.ready() || !player_ready_ || pending_move_)
+            return false;
+        const uint64_t command = session_.next_command++;
+        auto builder = session_.builder();
+        const auto request = builder.finish_message(CDDA::CWM::Payload::AcknowledgeThreatRequest,
+            CDDA::CWM::CreateAcknowledgeThreatRequest(builder.builder(), command).Union());
+        if (!connection_->send_message(request.data(), request.size())) return false;
+        pending_move_ = command;
+        move_acked_ = false;
+        sent_move_ = std::chrono::steady_clock::now();
+        return true;
+    }
+
+    bool answer_decision(uint16_t choice) {
+        if (!connection_ || !connection_->is_valid() || !session_.ready() || !metrics_.pending_decision ||
+            choice >= metrics_.decision_choices) return false;
+        auto builder = session_.builder();
+        const auto request = builder.finish_message(CDDA::CWM::Payload::DecisionResponse,
+            CDDA::CWM::CreateDecisionResponse(builder.builder(), metrics_.pending_decision, choice).Union());
+        if (!connection_->send_message(request.data(), request.size())) return false;
+        metrics_.pending_decision = 0;
+        return true;
+    }
+};
