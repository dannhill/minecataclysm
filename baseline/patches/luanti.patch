+bool CddaBridge::handlePointedOpening(const v3s16& node, bool close) {
+    if (!pimpl_) return false;
+    const auto tile = luantiToCddaCoord(node);
+    const auto opening = pimpl_->opening_tiles_.find(cddaToLuantiCoord(tile.X, tile.Y, tile.Z));
+    if (opening == pimpl_->opening_tiles_.end()) return false;
+    close = close || opening->second; // Explicit close, otherwise authoritative toggle.
+    return handleInteract(tile.X, tile.Y, tile.Z, static_cast<int>(close ?
+        CDDA::CWM::InteractAction::CLOSE : CDDA::CWM::InteractAction::OPEN));
+}
+
+float CddaBridge::pointingRange() const {
+    // Extend the presentation ray beyond the disposable Luanti hand's reach.
+    // Native range/perception still authorize the shot; cap traversal to the
+    // reality-bubble extent even for a malformed/unreasonably large range.
+    return pimpl_ && pimpl_->weapon_token_ ?
+        std::max(4.f, float(std::clamp(pimpl_->weapon_range_, 0, 132)) + 1.f) : 4.f;
+}
+
+bool CddaBridge::pointCombatTarget(const irr::core::line3d<float>& ray) {
+    if (!pimpl_) return false;
+    auto& impl = *pimpl_;
+    impl.pointed_actor_ = 0;
+    if (!impl.session_.ready() || !impl.player_ready_ || impl.metrics_.pending_decision) return false;
+    // The pointing ray uses absolute world coordinates; Irrlicht actors use
+    // camera-relative coordinates. Keep both endpoints in the same space.
+    const auto offset = impl.client_->getEnv().getCameraOffset();
+    const v3f shift = v3f(offset.X, offset.Y, offset.Z) * 10.f;
+    const irr::core::line3d<float> local_ray(ray.start - shift, ray.end - shift);
+    float closest = std::numeric_limits<float>::max();
+    for (auto& [id, ent] : impl.entities_) {
+        if (id == 1 || !ent.perceived || !ent.scene_node) continue;
+        auto* node = static_cast<irr::scene::ISceneNode*>(ent.scene_node);
+        if (!node->isVisible()) continue;
+        node->updateAbsolutePosition();
+        const auto box = node->getTransformedBoundingBox();
+        // Slab intersection gives the first surface, rather than choosing the
+        // nearest center when visual bounds overlap.
+        float begin = 0.f, end = 1.f;
+        const auto delta = local_ray.getVector();
+        const float start[] = {local_ray.start.X, local_ray.start.Y, local_ray.start.Z};
+        const float direction[] = {delta.X, delta.Y, delta.Z};
+        const float lo[] = {box.MinEdge.X, box.MinEdge.Y, box.MinEdge.Z};
+        const float hi[] = {box.MaxEdge.X, box.MaxEdge.Y, box.MaxEdge.Z};
+        bool hit = true;
+        for (int axis = 0; axis < 3 && hit; ++axis) {
+            if (std::abs(direction[axis]) < 1e-6f) {
+                hit = start[axis] >= lo[axis] && start[axis] <= hi[axis];
+            } else {
+                float a = (lo[axis] - start[axis]) / direction[axis];
+                float b = (hi[axis] - start[axis]) / direction[axis];
+                if (a > b) std::swap(a, b);
+                begin = std::max(begin, a); end = std::min(end, b);
+                hit = begin <= end;
+            }
+        }
+        if (hit && begin < closest) { closest = begin; impl.pointed_actor_ = id; }
+    }
+    if (impl.pointed_actor_) {
+        const auto& ent = impl.entities_.at(impl.pointed_actor_);
+        impl.hover_hint_ = (impl.weapon_token_ ? utf8_to_wide(impl.weapon_name_) + L" [" + std::to_wstring(impl.weapon_ammo_) + L"] — " : L"") + utf8_to_wide(ent.name) +
+            ((ent.state_flags & cdda::cwm::HOSTILE_TO_PLAYER) ?
+             (impl.metrics_.pause_reasons ? (::cwm::wide(" — resume to attack", " — riprendi per attaccare")) : impl.weapon_token_ ? (::cwm::wide(" — hold right mouse/F: aim; left click: fire; R: reload", " — destro/F mantenuto: mira; clic sinistro: spara; R: ricarica")) : (::cwm::wide(" — left click: melee attack", " — clic sinistro: attacco ravvicinato"))) :
+             (::cwm::wide(" — non-hostile creature", " — creatura non ostile")));
+        if (impl.weapon_token_ && (ent.state_flags & cdda::cwm::HOSTILE_TO_PLAYER)) {
+            if (impl.aim_input_.aiming()) impl.hover_hint_ += ::cwm::wide(" — Aiming", " — In mira");
+            // Actual native recoil, not a locally predicted hit probability.
+            impl.hover_hint_ += (::cwm::wide(" — recoil ", " — rinculo ")) + std::to_wstring(int(impl.weapon_recoil_));
+            if (!impl.weapon_reason_.empty()) impl.hover_hint_ += L" — " + utf8_to_wide(impl.weapon_reason_);
+        }
+    }
+    return impl.pointed_actor_ != 0;
+}
+
+void CddaBridge::handlePostureInput(bool run, bool crouch, bool prone) {
+    if (!pimpl_) return;
+    auto& impl = *pimpl_;
+    const auto player = impl.entities_.find(1);
+    const auto flags = player == impl.entities_.end() ? 0 : player->second.state_flags;
+    const int confirmed = flags & cdda::cwm::PRONE ? 3 :
+        flags & cdda::cwm::CROUCHING ? 2 : flags & cdda::cwm::RUNNING ? 1 : 0;
+    const bool allowed = impl.connection_ && impl.connection_->is_valid() && impl.session_.ready() &&
+        impl.player_ready_ && !impl.activity_token_ && !impl.metrics_.pending_decision && !impl.metrics_.pause_reasons &&
+        impl.sent_menu_pause_ != 1 && !impl.body_form_open_ && !impl.ground_container_open_ && !impl.equipment_open_;
+    const int desired = impl.posture_input_.sample({run, crouch, prone},
+        g_settings->getBool("cwm_run_toggle"), g_settings->getBool("cwm_crouch_toggle"), allowed, confirmed);
+    if (desired < 0 || desired == confirmed || impl.pending_move_) return;
+    const uint64_t command = impl.session_.next_command++;
+    auto builder = impl.session_.builder();
+    const auto bytes = builder.build_movement_mode_request(command,
+        static_cast<CDDA::CWM::MovementMode>(desired));
+    if (!impl.connection_->send_message(bytes.data(), bytes.size())) return;
+    impl.posture_command_ = impl.pending_move_ = command;
+    impl.requested_posture_ = desired;
+    impl.move_acked_ = false;
+    impl.sent_move_ = std::chrono::steady_clock::now();
+}
