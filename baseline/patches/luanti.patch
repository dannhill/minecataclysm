+++ b/src/cdda/creature_visual.h
@@ -0,0 +1,26 @@
+#pragma once
+#include "humanoid_animation.h"
+#include <string>
+namespace cdda_client {
+struct CreatureVisual {
+    const char* mesh; const char* skin; float height; int skin_layer;
+    HumanoidCycle idle, walk;
+};
+// Bounded, explicit proxies for pinned native archetypes. Exotic/mutated
+// anatomy keeps the honest fallback. No inference from translated names.
+inline CreatureVisual creatureVisual(const std::string& id, bool humanoid) {
+    if (id.rfind("mon_zombie",0)==0) return {"zombie.b3d","zombie.png",18,1,{40,49,2},{0,39,25}};
+    if (humanoid || id=="avatar") return {"character.b3d","mcl_skins_character_1.png",18,0,{0,79,30},{168,187,30}};
+    if (id=="mon_dog" || id=="mon_wolf" || id=="mon_coyote")
+        return {"cwm_wolf.b3d","mobs_mc_wolf.png",8.4f,0,{0,0,1},{0,40,30}};
+    if (id=="mon_spider_web" || id=="mon_spider_widow_giant" || id=="mon_spider_jumping_giant")
+        return {"cwm_spider.b3d","mobs_mc_spider.png",7,0,{20,40,10},{0,20,25}};
+    if (id=="mon_spider_web_small" || id=="mon_spider_widow_small" || id=="mon_spider_jumping_small")
+        return {"cwm_spider.b3d","mobs_mc_spider.png",3,0,{20,40,10},{0,20,25}};
+    if (id=="mon_chicken" || id=="mon_grouse")
+        return {"cwm_chicken.b3d","mobs_mc_chicken.png",5,0,{0,0,1},{0,20,40}};
+    if (id=="mon_chicken_chick" || id=="mon_grouse_chick")
+        return {"cwm_chicken.b3d","mobs_mc_chicken.png",2.5f,0,{0,0,1},{0,20,40}};
+    return {nullptr,nullptr,10,0,{0,0,1},{0,0,1}};
+}
+}
diff --git a/src/cdda/decision_dialog.h b/src/cdda/decision_dialog.h
new file mode 100644
index 0000000..74ce5f0
--- /dev/null
+++ b/src/cdda/decision_dialog.h
@@ -0,0 +1,76 @@
+#pragma once
+#include "avatar_status.h"
+#include "decision_text.h"
+#include "cwm/cwm_generated.h"
+#include "cwm/product_language.hpp"
+#include <vector>
+namespace cdda_client {
+struct MedicalOptionView {
+    int choice{-1}, quarters{-1}, current{-1}, maximum{-1};
+    std::string id, name, description, health_text;
+};
+struct DecisionDialog {
+    uint64_t id{},connection{};int cancel{-1};bool submitted{};
+    std::string body;std::vector<std::string> choices;
+    std::vector<MedicalOptionView> medical;
+    void read(const CDDA::CWM::DecisionPrompt& prompt,uint64_t generation) {
+        id=prompt.decision_id();connection=generation;cancel=prompt.cancel_choice();submitted=false;
+        body=prompt.text()->str();choices.clear();for(const auto* label:*prompt.choices())choices.push_back(label->str());
+        medical.clear(); if(prompt.medical())for(const auto* p:*prompt.medical())medical.push_back({
+            p->choice(),p->health_quarters(),p->hp_current(),p->hp_max(),p->body_id()->str(),p->name()->str(),p->description()->str(),p->health_text()->str()});
+    }
+    bool permits(uint64_t expected,uint64_t generation,int choice) const {
+        return id && expected==id && generation==connection && !submitted && choice>=0 && size_t(choice)<choices.size();
+    }
+    std::string medicalForm(std::string f) const {
+        f += "hypertext[0.55,1.85;14.9,1.0;prompt;" + statusEscape("<global color=#323232 size=18>"+decisionRichText(body)) + "]";
+        const double height = medical.size()*2.8 + choices.size()*.85;
+        f += "scrollbaroptions[min=0;max="+std::to_string(int(std::max(1.,(height-6.7)*10)))+";smallstep=5;largestep=24;thumbsize=67]scrollbar[15.05,3.1;0.4,6.7;vertical;medical_scroll;0]scroll_container[0.55,3.1;14.3,6.7;medical_scroll;vertical;0.1]";
+        double y=0;std::vector<bool> shown(choices.size(),false);
+        for(const auto& p:medical) {
+            const auto ys=std::to_string(y);
+            f+="image[0,"+ys+";0.7,0.7;"+bodyPartIcon(p.id)+"]";
+            if(p.choice>=0) { shown[p.choice]=true; f+="button[0.85,"+ys+";4.7,0.7;choice_"+std::to_string(p.choice)+";"+std::to_string(p.choice+1)+". "+statusEscape(p.name)+"]"; }
+            else f+="label[0.85,"+std::to_string(y+.35)+";"+statusEscape(p.name)+"]";
+            if(p.quarters>=0)for(int n=0;n<10;++n) {
+                const auto x=std::to_string(5.8+n*.42);
+                f+="image["+x+","+std::to_string(y+.1)+";0.36,0.36;heart.png^[opacity:45]";
+                const int half=std::clamp(p.quarters-2*n,0,2);
+                if(half)f+="image["+x+","+std::to_string(y+.1)+";0.36,0.36;heart.png^[opacity:0^[lowpart:"+std::to_string(half*50)+":heart.png]";
+            } else f+="label[5.8,"+std::to_string(y+.35)+";"+statusEscape(p.health_text.empty()?::cwm::text("Health unknown","Salute sconosciuta"):p.health_text)+"]";
+            if(p.current>=0)f+="label[10.5,"+std::to_string(y+.35)+";"+std::to_string(p.current)+" / "+std::to_string(p.maximum)+"]";
+            f+="hypertext[0.85,"+std::to_string(y+.8)+";13.2,1.8;medical_info_"+std::to_string(int(y*10))+";"+statusEscape("<global color=#323232 size=16>"+decisionRichText(p.description))+ "]";
+            y+=2.8;
+        }
+        for(size_t n=0;n<choices.size();++n)if(!shown[n]) {
+            f+="button[0,"+std::to_string(y)+";14.25,0.72;choice_"+std::to_string(n)+";"+std::to_string(n+1)+". "+statusEscape(decisionPlainText(choices[n]))+"]";y+=.85;
+        }
+        f+="scroll_container_end[]label[0.55,10.05;"+::cwm::text("Choose a body part. Effects shown are expectations, not guaranteed healing.","Scegli una parte. Gli effetti indicati non garantiscono la guarigione.")+"]";
+        if(cancel>=0 && size_t(cancel)<choices.size())f+="button[0.55,10.65;14.9,0.75;cancel;Esc: "+statusEscape(decisionPlainText(choices[cancel]))+"]";
+        return f;
+    }
+    std::string form() const {
+        std::string f="formspec_version[4]size[16,12]no_prepend[]bgcolor[#00000000]"
+            "background9[0,0;16,12;mcl_base_textures_background9.png;false;7]"
+            "style_type[label;textcolor=#323232]style_type[button;border=false;bgimg=mcl_inventory_button9.png;bgimg_pressed=mcl_inventory_button9_pressed.png;bgimg_middle=2,2]";
+        f+="cwm_decision["+std::string(submitted?"1":"0")+"]image[0.55,0.4;0.65,0.65;cdda_status_unknown.png]";
+        f+="label[1.45,0.75;"+::cwm::text("Choose an action","Scegli un'azione")+"]";
+        f+="label[0.55,1.35;"+std::string(submitted?::cwm::text("Response sent · waiting for the game","Risposta inviata · in attesa del gioco"): ::cwm::text("Time is paused while you choose","Il tempo e fermo mentre scegli"))+"]";
+        if(!medical.empty() && !submitted)return medicalForm(f);
+        f+="hypertext[0.55,1.85;14.9,3.9;prompt;"+statusEscape("<global color=#323232 size=18>"+decisionRichText(body))+"]set_focus[prompt;true]";
+        if(submitted)return f+"label[0.55,6.3;"+::cwm::text("Waiting for the game...","In attesa del gioco...")+"]";
+        const int maximum=std::max(0,int(choices.size()*8.5)-36);
+        f+="scrollbaroptions[min=0;max="+std::to_string(std::max(1,maximum))+";smallstep=4;largestep=12;thumbsize=36]scrollbar[15.05,6;0.4,3.65;vertical;choices_scroll;0]scroll_container[0.55,6;14.3,3.65;choices_scroll;vertical;0.1]";
+        for(size_t n=0;n<choices.size();++n) {
+            const auto name="choice_"+std::to_string(n);auto label=decisionPlainText(choices[n]);
+            std::string single_line;for(char c:label) {if(c=='\n')single_line+=" · ";else if(c!='\r')single_line+=c;}label=std::move(single_line);
+            // Full text remains in the tooltip; do not cut in the middle of UTF-8.
+            if(label.size()>95) {size_t end=95;while(end && (static_cast<unsigned char>(label[end])&0xC0)==0x80)--end;label=label.substr(0,end)+"...";}
+            f+="button[0,"+std::to_string(n*.85)+";14.25,0.72;"+name+";"+std::to_string(n+1)+". "+statusEscape(label)+"]tooltip["+name+";"+statusEscape(decisionPlainText(choices[n]))+"]";
+        }
+        f+="scroll_container_end[]label[0.55,10.05;"+::cwm::text("Click a choice or press 1–9. Enter never approves automatically.","Clic su una scelta o 1–9. Invio non approva automaticamente.")+"]";
+        if(cancel>=0 && size_t(cancel)<choices.size())f+="button[0.55,10.65;14.9,0.75;cancel;Esc: "+statusEscape(decisionPlainText(choices[cancel]))+"]";
+        return f;
+    }
+};
+} // namespace cdda_client
diff --git a/src/cdda/decision_input.h b/src/cdda/decision_input.h
new file mode 100644
index 0000000..38421b3
--- /dev/null
+++ b/src/cdda/decision_input.h
@@ -0,0 +1,15 @@
+#pragma once
+#include <array>
+namespace cdda_client {
+class DecisionInput {
+    std::array<bool,512> down_{};
+    unsigned event_key_{512}; bool fresh_{};
+public:
+    void observe(unsigned key,bool down) {
+        event_key_=key;fresh_=key<down_.size() && down && !down_[key];
+        if(key<down_.size())down_[key]=down;
+    }
+    bool fresh(unsigned key) const {return event_key_==key && fresh_;}
+};
+inline DecisionInput& decisionInput() {static DecisionInput input;return input;}
+} // namespace cdda_client
diff --git a/src/cdda/decision_text.h b/src/cdda/decision_text.h
new file mode 100644
index 0000000..15c7818
--- /dev/null
+++ b/src/cdda/decision_text.h
@@ -0,0 +1,53 @@
+#pragma once
+#include <string>
+#include <string_view>
+namespace cdda_client {
+// CDDA terminal colour tags have no meaning to Irrlicht static text.
+// Preserve symbols, UTF-8 and literal angle brackets; remove only tag syntax.
+inline std::string decisionPlainText(std::string_view source) {
+    std::string text;
+    for (size_t i = 0; i < source.size();) {
+        if (source.substr(i, 8) == "</color>") { i += 8; continue; }
+        if (source.substr(i, 7) == "<color_") {
+            const auto end = source.find('>', i + 7);
+            bool tag = end != source.npos && end > i + 7;
+            if (tag) for (size_t n = i + 7; n < end; ++n) {
+                const char c = source[n];
+                if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                      (c >= '0' && c <= '9') || c == '_')) { tag = false; break; }
+            }
+            if (tag) { i = end + 1; continue; }
+        }
+        text += source[i++];
+    }
+    return text;
+}
+inline std::string decisionMarkup(std::string_view source) {
+    std::string out;
+    for(char c:source) {if(c=='<' || c=='>' || c=='\\')out+='\\';out+=c;}
+    return out;
+}
+inline std::string decisionRichText(std::string_view source) {
+    std::string out;unsigned opened=0;
+    for(size_t i=0;i<source.size();) {
+        if(source.substr(i,8)=="</color>") {if(opened){out+="</style>";--opened;}i+=8;continue;}
+        if(source.substr(i,7)=="<color_") {
+            const auto end=source.find('>',i+7);
+            if(end!=source.npos) {
+                const auto tag=source.substr(i+7,end-i-7);std::string color;
+                if(tag=="c_red" || tag=="c_light_red" || tag=="red")color="#A53C2C";
+                else if(tag=="c_green" || tag=="c_light_green" || tag=="green")color="#32723C";
+                else if(tag=="c_yellow" || tag=="yellow")color="#936812";
+                else if(tag=="c_cyan" || tag=="c_light_blue" || tag=="c_blue")color="#236B91";
+                else if(tag=="c_white" || tag=="c_light_gray" || tag=="c_dark_gray")color="#484848";
+                if(!color.empty()){out+="<style color="+color+">";++opened;i=end+1;continue;}
+                bool valid=!tag.empty();for(char c:tag)if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'))valid=false;
+                if(valid){out+="<style>";++opened;i=end+1;continue;}
+            }
+        }
+        out+=decisionMarkup(source.substr(i++,1));
+    }
+    while(opened){out+="</style>";--opened;}
+    return out;
+}
+} // namespace cdda_client
diff --git a/src/cdda/equipment_inventory.h b/src/cdda/equipment_inventory.h
new file mode 100644
