+float CddaBridge::terrainFogDistance() const {
+    if (!terrainComparisonEnabled() || !pimpl_->terrain_fog_ || !pimpl_->player_ready_)
+        return 0;
+    const auto player = pimpl_->entities_.find(1);
+    if (player == pimpl_->entities_.end() || pimpl_->terrain_tiles_.empty()) return 0;
+    // End before the nearest edge of the projected surface, not at a guessed
+    // world radius. Bound distance keeps nearby threats/doors fully readable.
+    const auto it = pimpl_->terrain_bounds_.find(static_cast<s16>(player->second.target_pos.Y));
+    if (it == pimpl_->terrain_bounds_.end()) return 0;
+    const auto& b = it->second;
+    const auto& p = player->second.current_pos;
+    const float edge = std::min({p.X - b[0], b[1] - p.X, p.Z - b[2], b[3] - p.Z});
+    return std::max(8.f, std::min(40.f, edge - 3.f));
+}
