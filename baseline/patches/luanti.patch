+std::string CddaBridge::wieldedTexture() const {
+    if (!pimpl_ || !pimpl_->session_.ready()) return {};
+    for (const auto& item : pimpl_->owned_items_) if (item.wielded) {
+        const auto name = pimpl_->ground_item_visual_name(item.type_id);
+        const auto& def = pimpl_->client_->getItemDefManager()->get(name);
+        EquipmentEntry e; e.category=item.category;
+        auto texture = name == "cdda_items:fallback_generic" || def.inventory_image.empty() ? equipmentCategoryIcon(e) : def.inventory_image;
+        return texture + (item.rotten ? "^[colorize:#667322:110" : "");
