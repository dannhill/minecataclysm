+    if (!pimpl_ || !pimpl_->session_.ready() || !pimpl_->player_ready_ || pimpl_->pending_move_ ||
+        pimpl_->body_form_open_ || pimpl_->ground_container_open_ || pimpl_->metrics_.pending_decision) return {};
+    auto& i = *pimpl_;
+    i.equipment_open_ = true; i.equipment_close_ = false;
