+std::string CddaBridge::openCrafting() {
+    if (!pimpl_ || !pimpl_->session_.ready() || !pimpl_->player_ready_ || pimpl_->pending_move_ ||
+        pimpl_->body_form_open_ || pimpl_->ground_container_open_ || pimpl_->equipment_open_ || pimpl_->metrics_.pending_decision) return {};
+    auto& i = *pimpl_;
+    i.crafting_open_ = true; i.crafting_close_ = false;
+    i.crafting_search_.clear(); i.crafting_batch_ = 1; i.crafting_filter_=CDDA::CWM::CraftingFilter::AUTO;
+    i.crafting_search_due_.reset();
+    setMenuPause(true);
+    if (!i.query_crafting()) i.crafting_view_.error = (::cwm::text("Catalog unavailable: try again.", "Catalogo non disponibile: riprova."));
+    return i.crafting_form();
+}
+void CddaBridge::craftingFields(const std::unordered_map<std::string, std::string>& fields) {
+    if (!pimpl_ || !pimpl_->crafting_open_) return;
+    auto& i = *pimpl_;
+    if (fields.count("quit")) {
+        i.crafting_open_ = i.crafting_close_ = i.crafting_dirty_ = false;
+        i.crafting_view_ = {}; i.crafting_query_ = 0; i.crafting_query_pending_=false;i.crafting_search_due_.reset();i.queued_crafting_.reset(); return;
+    }
+    if (fields.count("search_changed")) {
+        const auto found=fields.find("search");
+        if(found!=fields.end() && found->second.substr(0,256)!=i.crafting_search_) {
+            i.crafting_search_=found->second.substr(0,256);i.crafting_page_=0;
+            i.crafting_search_due_=std::chrono::steady_clock::now()+std::chrono::milliseconds(120);
+        }
+        return;
+    }
+    bool batch_change=false;
+    if (const auto found=fields.find("batch");found!=fields.end())
+        for(unsigned n=1;n<=20;++n)if(found->second==std::to_string(n) && i.crafting_batch_!=n){i.crafting_batch_=n;batch_change=true;break;}
+    if(i.crafting_query_pending_ || i.crafting_favorite_command_){
+        if(batch_change)i.crafting_search_due_=std::chrono::steady_clock::now();
+        return;
+    }
+    if(fields.count("favorite_recipe")) {
+        const auto* e=i.crafting_view_.entry(i.crafting_selected_);
+        if(!e || !i.session_.ready() || i.pending_move_ || i.metrics_.pending_decision)return;
+        auto wire=i.session_.builder();const auto id=i.session_.next_command++;
+        const auto bytes=wire.build_crafting_favorite(id,i.crafting_view_.view,e->id,!e->favorite,e->favorite);
+        if(i.connection_->send_message(bytes.data(),bytes.size())){
+            i.crafting_favorite_command_=i.pending_move_=id;i.move_acked_=false;
+            i.sent_move_=std::chrono::steady_clock::now();i.crafting_dirty_=true;
+        }return;
+    }
+    bool tab_change=false;
+    const char* tabs[]={"all_recipes","favorite_recipes","recent_recipes","unfinished_recipes"};
+    for(int n=0;n<4;++n)if(fields.count(tabs[n]) && int(i.crafting_filter_)!=n){i.crafting_filter_=static_cast<CDDA::CWM::CraftingFilter>(n);tab_change=true;}
+    if (fields.count("cancel_craft") && i.crafting_ && i.activity_token_) {
+        if (i.metrics_.pause_reasons & ~uint32_t(2)) i.crafting_notice_ = (::cwm::text("Resume the game before interrupting.", "Riprendi il gioco prima di interrompere."));
+        else if (!i.session_.ready() || i.pending_move_) i.crafting_notice_ = (::cwm::text("Wait for the updated state.", "Attendi lo stato aggiornato."));
+        else { i.queued_cancel_activity_ = i.activity_token_; i.crafting_close_ = true; return; }
+        i.crafting_dirty_ = true; return;
+    }
+    bool refresh = batch_change || tab_change || fields.count("refresh") || fields.count("find") || fields.count("key_enter_field");
+    if (refresh) {
+        if (const auto found = fields.find("search"); found != fields.end()) i.crafting_search_ = found->second.substr(0, 256);
+        i.crafting_search_due_.reset();
+        if(tab_change){i.crafting_selected_=0;i.crafting_page_=0;}
+        i.query_crafting(true); return;
+    }
+    if (fields.count("prev") && i.crafting_page_) --i.crafting_page_;
+    if (fields.count("next") && (i.crafting_page_+1)*36 < i.crafting_view_.entries.size()) ++i.crafting_page_;
+    for (const auto& e : i.crafting_view_.entries)
+        if (fields.count("recipe_"+std::to_string(e.id))) i.crafting_selected_ = e.id;
+    if (fields.count("start")) if (const auto* e = i.crafting_view_.entry(i.crafting_selected_)) {
+        if (!e->reason.empty()) i.crafting_notice_ = e->reason;
+        else if (i.crafting_search_due_) return;
+        else if (i.activity_token_) i.crafting_notice_ = (::cwm::text("Interrupt the activity before acting.", "Interrompi l'attivita prima di agire."));
+        else if (i.metrics_.pause_reasons & ~uint32_t(2)) i.crafting_notice_ = (::cwm::text("Resume the game before crafting.", "Riprendi il gioco prima di creare."));
+        else if (!i.session_.ready() || i.pending_move_) i.crafting_notice_ = (::cwm::text("Wait for the updated state.", "Attendi lo stato aggiornato."));
+        else {
+            i.queued_crafting_ = Impl::QueuedCrafting{i.crafting_view_.view, e->id};
+            i.crafting_close_ = true; return;
+        }
+    }
+    i.crafting_dirty_ = true;
+}
+bool CddaBridge::takeCraftingClose() {
+    if (!pimpl_ || !pimpl_->crafting_open_ || !pimpl_->crafting_close_) return false;
+    pimpl_->crafting_open_ = pimpl_->crafting_close_ = pimpl_->crafting_dirty_ = false; return true;
+}
+std::string CddaBridge::takeCraftingUpdate() {
+    if (!pimpl_ || !pimpl_->crafting_open_ || !pimpl_->crafting_dirty_) return {};
+    pimpl_->crafting_dirty_ = false; return pimpl_->crafting_form();
+}
+
+bool CddaBridge::dismissInventoryWork() {
+    if (!pimpl_ || (!pimpl_->inventory_work_command_ && !pimpl_->inventory_return_armed_ &&
+        !(pimpl_->reading_ && !pimpl_->reading_panel_hidden_))) return false;
+    if(pimpl_->reading_)pimpl_->reading_panel_hidden_=true;
+    if (pimpl_->inventory_return_armed_) {
+        pimpl_->queued_equipment_.reset(); pimpl_->queued_transfer_.reset(); pimpl_->queued_cancel_activity_.reset();
+    }
+    pimpl_->dismiss_inventory_work();
+    return true;
+}
+
+unsigned CddaBridge::quickSlot() const { return pimpl_ ? pimpl_->quick_slot_ : 1; }
+void CddaBridge::selectQuickSlot(unsigned slot) { if (pimpl_ && slot >= 1 && slot <= 9) pimpl_->quick_slot_ = slot; }
+
+void CddaBridge::useQuickSlot() {
+    if (!pimpl_ || !pimpl_->session_.ready() || !pimpl_->player_ready_) return;
+    auto& i = *pimpl_;
+    const auto& slot = i.quick_slots_[i.quick_slot_ - 1];
+    const auto action = quickDefaultAction(slot.item);
+    if (!slot || action < 0 || i.pending_move_ || i.activity_token_ || (i.inventory_work_command_ && !i.inventory_work_settled_) || i.metrics_.pause_reasons ||
+        i.metrics_.pending_decision || i.equipment_open_ || i.body_form_open_ || i.crafting_open_ || i.ground_container_open_) {
+        i.item_hint_ = !slot ? (::cwm::wide("Empty quick slot. Drag an item into it in I.", "Slot rapido vuoto. Assegna un oggetto con I.")) : (::cwm::wide("Action unavailable: resume or finish the current work.", "Azione non disponibile: riprendi o concludi il lavoro in corso."));
+        i.item_hint_until_ = std::chrono::steady_clock::now() + std::chrono::seconds(4);
+        return; // Never retain a paused/busy key for later execution.
+    }
+    auto wire = i.session_.builder(); const auto id = i.session_.next_command++;
+    const auto bytes = wire.build_quickbar_use(id, i.quick_slot_, slot.binding, static_cast<CDDA::CWM::EquipmentAction>(action));
+    if (!i.connection_->send_message(bytes.data(), bytes.size())) return;
+    i.dismiss_inventory_work();
+    i.inventory_work_command_ = id;
+    const std::array<std::wstring,7> names{{(::cwm::wide("Wield", "Impugna")),(::cwm::wide("Stow", "Riponi")),(::cwm::wide("Wear", "Indossa")),(::cwm::wide("Take off", "Togli")),(::cwm::wide("Consume", "Consuma")),(::cwm::wide("Treat", "Medica")), (::cwm::wide("Read", "Leggi"))}};
+    i.inventory_work_label_ = names[action] + L": " + utf8_to_wide(slot.item.name);
+    i.pending_move_ = id; i.move_acked_ = false; i.sent_move_ = std::chrono::steady_clock::now();
+    ++i.quick_use_sent_;
+}
+
+std::string CddaBridge::openEquipmentInventory() {
+    if (!pimpl_ || !pimpl_->session_.ready() || !pimpl_->player_ready_ ||
+        (pimpl_->pending_move_ && pimpl_->pending_move_ != pimpl_->inventory_work_command_) ||
+        pimpl_->body_form_open_ || pimpl_->crafting_open_ || pimpl_->ground_container_open_ || pimpl_->metrics_.pending_decision) return {};
+    auto& i = *pimpl_;
+    // Inspecting is neither cancellation nor opting out of work feedback.
+    // Suppress automatic return, but preserve the native debit and its panel.
+    i.inventory_return_requested_ = i.inventory_return_armed_ = false;
+    i.external_anchor_.reset();
+    i.equipment_open_ = true; i.equipment_close_ = false; i.transfer_form_ = false;
+    i.equipment_search_open_ = true; i.equipment_focus_search_ = false;
+    setMenuPause(true);
+    i.inventory_inspection_pending_ = i.pending_move_ != 0;
+    if (i.inventory_inspection_pending_) {
+        i.equipment_view_ = {}; i.equipment_selected_ = 0; i.inventory_query_ = 0;
+    } else if (!i.query_inventory()) i.equipment_view_.error = (::cwm::text("Inventory unavailable: try again.", "Inventario non disponibile: riprova."));
+    if (i.inventory_work_command_ && i.inventory_work_rejected_) i.equipment_notice_ = i.inventory_work_error_;
+    return i.equipment_form();
+}
+
+void CddaBridge::equipmentInventoryFields(const std::unordered_map<std::string, std::string>& submitted) {
+    auto fields = submitted;
+    if (!pimpl_ || !pimpl_->equipment_open_) return;
+    auto& i = *pimpl_;
+    if (fields.count("quit")) {
+        i.inventory_inspection_pending_ = false;
+        i.inventory_return_requested_ = i.inventory_return_armed_ = false;
+        i.equipment_open_ = i.equipment_close_ = i.equipment_dirty_ = false;
+        i.inventory_query_ = 0; i.equipment_view_ = {};
+        return;
+    }
+    if (fields.count("quick_transfer")) {
+        const auto key = fields.at("quick_transfer");
+        const EquipmentEntry* source = nullptr;
+        for (const auto& e : i.equipment_view_.entries)
+            if (key == "item_" + std::to_string(e.id)) source = &e;
+        if (!source || (!i.external_anchor_ && (!i.transfer_form_ || !i.transfer_destination_))) {
+            i.equipment_notice_ = ::cwm::text("Select a destination container first.", "Seleziona prima un contenitore di destinazione.");
+            i.equipment_dirty_ = true; return;
+        }
+        fields["drag_from"] = key;
+        fields["drag_to"] = i.external_anchor_ ? (source->external ? "drag_owned" : "drag_external") :
+            "destination_" + std::to_string(i.transfer_destination_);
+    }
+    if (fields.count("drag_from") && fields.count("drag_to")) {
+        i.equipment_dirty_ = true;
+        const auto from = fields.at("drag_from"), to = fields.at("drag_to");
+        const auto number = [](const std::string &key, const std::string &prefix) -> unsigned {
+            if (key.rfind(prefix, 0) != 0) return 0;
+            const auto tail = key.substr(prefix.size());
+            if (tail.empty() || tail.size() > 4 || !std::all_of(tail.begin(), tail.end(), [](unsigned char c) { return std::isdigit(c); })) return 0;
+            return std::stoul(tail);
+        };
+        const auto entry_for = [&](const std::string &key) -> const EquipmentEntry* {
+            if (key.rfind("quickslot_", 0) == 0) {
+                const auto slot = number(key, "quickslot_");
+                for (const auto &e : i.equipment_view_.entries) if (slot && e.quick_slot == slot) return &e;
+                return nullptr;
+            }
+            for (const auto *prefix : {"item_", "hand_", "worn_", "destination_"})
+                if (key.rfind(prefix, 0) == 0) return i.equipment_view_.entry(number(key, prefix));
+            return nullptr;
+        };
+        const auto *source = entry_for(from), *destination = entry_for(to);
+        if (!fields.count("drag_view") || fields.at("drag_view") != std::to_string(i.equipment_view_.view) ||
+            !i.session_.ready() || i.pending_move_ || i.metrics_.pending_decision || !source) {
+            i.equipment_notice_ = (::cwm::text("View changed: try dragging again.", "Vista cambiata: riprova il trascinamento.")); return;
+        }
+        i.equipment_selected_ = source->id;
+        if (i.external_anchor_) {
+            if (i.activity_token_ || (i.metrics_.pause_reasons & ~uint32_t(2))) { i.equipment_notice_ = ::cwm::text("Resume or interrupt the work first.","Riprendi o interrompi prima il lavoro."); return; }
+            int quantity=source->counted?source->charges:1;
+            if (fields.count("quantity")) { const auto& value=fields.at("quantity"); quantity=0;
+                if (!value.empty() && value.size()<=9 && std::all_of(value.begin(),value.end(),[](unsigned char c){return std::isdigit(c);}))
+                    for(char c:value) quantity=quantity*10+c-'0'; }
+            if (quantity<=0 || quantity>(source->counted?source->charges:1)) {i.equipment_notice_=::cwm::text("Invalid quantity.","Quantita non valida.");return;}
+            if (!source->transfer_reason.empty()) {i.equipment_notice_=source->transfer_reason;return;}
+            const int action=to == "drag_ground" ? 0 : destination && destination->container ? 1 :
+                to.rfind("drag_owned",0)==0 && source->external ? 2 : to.rfind("drag_external",0)==0 && !source->external ? 3 : -1;
+            if(action<0) {i.equipment_notice_=::cwm::text("Drag onto a container or the receiving area.","Trascina su un contenitore o sulla zona di destinazione.");return;}
+            i.queued_transfer_=Impl::QueuedTransfer{i.equipment_view_.view,source->id,destination?destination->id:0,quantity,action};
+            i.inventory_return_armed_=true;i.equipment_close_=true;return;
+        }
+        const unsigned from_slot = number(from, "quickslot_"), to_slot = number(to, "quickslot_");
+        const bool grid = to.rfind("grid_", 0) == 0 || (to.rfind("item_", 0) == 0 && destination && !destination->container);
+        if (to_slot || (from_slot && grid) || (grid && from.rfind("item_", 0) == 0)) {
+            auto wire = i.session_.builder(); const auto id = i.session_.next_command++;
+            std::vector<uint8_t> bytes;
+            if (to_slot > 9 || from_slot > 9) return;
+            if (to_slot) {
+                i.quick_slot_ = to_slot;
+                bytes = from_slot ? wire.build_quickbar_swap(id, from_slot, to_slot,
+                    i.quick_slots_[from_slot-1].binding, i.quick_slots_[to_slot-1].binding) :
+                    wire.build_quickbar_bind(id, to_slot, i.equipment_view_.view, source->id, i.quick_slots_[to_slot-1].binding);
+            } else if (from_slot) {
+                bytes = wire.build_quickbar_bind(id, from_slot, 0, 0, i.quick_slots_[from_slot-1].binding);
+            } else {
+                bytes = wire.build_inventory_arrange(id, i.equipment_view_.view, source->id, destination ? destination->id : 0);
+            }
+            if (i.connection_->send_message(bytes.data(), bytes.size())) {
+                i.quick_bind_command_ = i.pending_move_ = id; i.move_acked_ = false;
+                i.sent_move_ = std::chrono::steady_clock::now();
+            }
+            return;
+        }
+        if (i.activity_token_ || (i.metrics_.pause_reasons & ~uint32_t(2))) {
+            i.equipment_notice_ = (::cwm::text("Resume or interrupt the work before moving items.", "Riprendi o interrompi il lavoro prima di spostare oggetti.")); return;
+        }
+        int action = -1;
+        if (to.rfind("hand_", 0) == 0) action = 0;
+        else if (to.rfind("worn_", 0) == 0 || to.rfind("wear_empty_", 0) == 0) action = 2;
+        else if (grid && from.rfind("hand_", 0) == 0) action = 1;
+        else if (grid && from.rfind("worn_", 0) == 0) action = 3;
+        if (action >= 0) {
+            if (!(source->actions & (1 << action))) { i.equipment_notice_ = source->reasons[action]; return; }
+            i.queued_equipment_ = Impl::QueuedEquipment{i.equipment_view_.view, source->id, action};
+        } else if (to == "drag_ground" || (destination && destination->container)) {
+            int quantity = source->counted ? source->charges : 1;
+            if (fields.count("quantity")) {
+                const auto &text = fields.at("quantity");
+                if (text.empty() || text.size() > 9 || !std::all_of(text.begin(), text.end(), [](unsigned char c) { return std::isdigit(c); })) quantity = 0;
+                else { quantity = 0; for (const char c : text) quantity = quantity * 10 + c - '0'; }
+            }
+            if (!source->transfer_reason.empty()) { i.equipment_notice_ = source->transfer_reason; return; }
+            if (quantity <= 0 || quantity > (source->counted ? source->charges : 1)) {
+                i.equipment_notice_ = (::cwm::text("Invalid quantity.", "Quantita non valida.")); return;
+            }
+            i.queued_transfer_ = Impl::QueuedTransfer{i.equipment_view_.view, source->id,
+                to == "drag_ground" ? 0 : destination->id, quantity, to == "drag_ground" ? 0 : 1};
+        } else { i.equipment_notice_ = (::cwm::text("Destination unavailable.", "Destinazione non disponibile.")); return; }
+        i.inventory_return_armed_ = true; i.equipment_close_ = true;
+        return;
+    }
+    if (fields.count("cancel_consume") && i.activity_token_) {
+        if (i.metrics_.pause_reasons & ~uint32_t(2)) i.equipment_notice_ = (::cwm::text("Resume the game before interrupting.", "Riprendi il gioco prima di interrompere."));
+        else if (!i.session_.ready() || i.pending_move_) i.equipment_notice_ = (::cwm::text("Wait for the updated state.", "Attendi lo stato aggiornato."));
+        else { i.queued_cancel_activity_ = i.activity_token_; i.inventory_return_armed_ = true; i.equipment_close_ = true; return; }
+        i.equipment_dirty_ = true; return;
+    }
+    if (i.external_anchor_) {
+        if(fields.count("refresh")){i.query_inventory();return;}
+        for(const auto& e:i.equipment_view_.entries) if(fields.count("item_"+std::to_string(e.id))) {i.equipment_selected_=e.id;i.transfer_quantity_=1;}
+        if(fields.count("all")) {const auto* e=i.equipment_view_.entry(i.equipment_selected_);if(e)i.transfer_quantity_=e->counted?e->charges:1;}
+        if(fields.count("ext_prev") && i.equipment_page_) --i.equipment_page_;
+        if(fields.count("own_prev") && i.destination_page_) --i.destination_page_;
+        const auto ext=std::count_if(i.equipment_view_.entries.begin(),i.equipment_view_.entries.end(),[](const auto& e){return e.external;});
+        if(fields.count("ext_next") && (i.equipment_page_+1)*27<size_t(ext))++i.equipment_page_;
+        if(fields.count("own_next") && (i.destination_page_+1)*27<i.equipment_view_.entries.size()-ext)++i.destination_page_;
+        i.equipment_dirty_=true;return;
+    }
+    if (fields.count("transfers") || fields.count("back")) {
+        if (fields.count("transfers")) {
+            i.equipment_saved_page_ = i.equipment_page_; i.equipment_page_ = 0;
+        } else i.equipment_page_ = i.equipment_saved_page_;
+        i.transfer_form_ = fields.count("transfers");
+        i.transfer_destination_ = 0; i.destination_page_ = 0; i.transfer_quantity_ = 1;
+        i.equipment_dirty_ = true; return;
+    }
+    if (fields.count("refresh")) { i.query_inventory(); return; }
+    if (i.transfer_form_) {
+        const auto quantity = fields.find("quantity");
+        if (quantity != fields.end()) {
+            const auto& value = quantity->second;
+            if (!value.empty() && value.size() <= 9 && std::all_of(value.begin(), value.end(), [](unsigned char c) { return std::isdigit(c); }))
+                { i.transfer_quantity_ = 0; for (const char c : value) i.transfer_quantity_ = i.transfer_quantity_ * 10 + c - '0'; }
+            else i.transfer_quantity_ = 0;
+        }
+        for (const auto& e : i.equipment_view_.entries) {
+            if (fields.count("item_" + std::to_string(e.id))) { i.equipment_selected_ = e.id; i.transfer_quantity_ = 1; }
+            if (e.container && fields.count("destination_" + std::to_string(e.id))) i.transfer_destination_ = e.id;
+        }
+        if (fields.count("prev") && i.equipment_page_) --i.equipment_page_;
+        if (fields.count("next") && (i.equipment_page_ + 1) * 36 < i.equipment_view_.entries.size()) ++i.equipment_page_;
+        const auto containers = std::count_if(i.equipment_view_.entries.begin(), i.equipment_view_.entries.end(), [](const auto& e) { return e.container; });
+        if (fields.count("dest_prev") && i.destination_page_) --i.destination_page_;
+        if (fields.count("dest_next") && (i.destination_page_ + 1) * 6 < size_t(containers)) ++i.destination_page_;
+        if (fields.count("drop") || fields.count("insert")) {
+            const auto* selected = i.equipment_view_.entry(i.equipment_selected_);
+            const bool insert = fields.count("insert");
+            const int available = selected ? (selected->counted ? selected->charges : 1) : 0;
+            if (!selected) i.equipment_notice_ = (::cwm::text("Select an item.", "Seleziona un oggetto."));
+            else if (!selected->transfer_reason.empty()) i.equipment_notice_ = selected->transfer_reason;
+            else if (i.transfer_quantity_ <= 0 || i.transfer_quantity_ > available) i.equipment_notice_ = (::cwm::text("Invalid quantity.", "Quantita non valida."));
+            else if (insert && !i.transfer_destination_) i.equipment_notice_ = (::cwm::text("Select a container.", "Seleziona un contenitore."));
+            else if (i.activity_token_) i.equipment_notice_ = (::cwm::text("Interrupt the activity first.", "Interrompi prima l'attivita."));
+            else if (i.metrics_.pause_reasons & ~uint32_t(2)) i.equipment_notice_ = (::cwm::text("Resume the game before transferring.", "Riprendi il gioco prima di trasferire."));
+            else if (!i.session_.ready() || i.pending_move_) i.equipment_notice_ = (::cwm::text("Wait for the updated state.", "Attendi lo stato aggiornato."));
+            else {
+                i.queued_transfer_ = Impl::QueuedTransfer{i.equipment_view_.view, selected->id,
+                    insert ? i.transfer_destination_ : 0, i.transfer_quantity_, insert ? 1 : 0};
+                i.inventory_return_armed_ = true; i.equipment_close_ = true; return;
+            }
+        }
+        i.equipment_dirty_ = true; return;
+    }
+    if (fields.count("search_open")) {
+        i.equipment_search_open_ = i.equipment_focus_search_ = true;
+        i.equipment_dirty_ = true; return;
+    }
+    if (fields.count("search_back")) {
+        i.equipment_search_open_ = i.equipment_focus_search_ = false;
+        i.equipment_dirty_ = true; return;
+    }
+    if (fields.count("search_clear")) { i.equipment_search_.clear(); i.equipment_page_ = 0; }
+    if (fields.count("details")) i.equipment_details_open_ = !i.equipment_details_open_;
+    if (fields.count("worn_prev") && i.equipment_worn_page_) --i.equipment_worn_page_;
+    const auto worn_count = std::count_if(i.equipment_view_.entries.begin(), i.equipment_view_.entries.end(), [](const auto& e) { return e.worn; });
+    if (fields.count("worn_next") && (i.equipment_worn_page_ + 1) * 10 < size_t(worn_count)) ++i.equipment_worn_page_;
+    if (fields.count("find") || fields.count("key_enter_field") || fields.count("search_changed")) {
+        const auto search = fields.find("search");
+        if (search != fields.end()) i.equipment_search_ = search->second.substr(0, 256);
+        i.equipment_page_ = 0;
+    }
+    const auto filter = fields.find("filter");
+    if (filter != fields.end()) {
+        const std::array<std::string,3> names{{(::cwm::text("All", "Tutti")), (::cwm::text("Equipped", "Equipaggiati")), (::cwm::text("Containers", "Contenitori"))}};
+        const auto found = std::find(names.begin(), names.end(), filter->second);
+        if (found != names.end()) {
+            const int value = found - names.begin();
+            if (value != i.equipment_filter_) i.equipment_page_ = 0;
+            i.equipment_filter_ = value;
+        }
+    }
+    const auto ids = equipmentGridIds(i.equipment_view_, i.equipment_search_, i.equipment_filter_);
+    if (fields.count("prev") && i.equipment_page_) --i.equipment_page_;
+    if (fields.count("next") && (i.equipment_page_ + 1) * equipmentPageSize < ids.size()) ++i.equipment_page_;
+    for (const auto id : ids) if (fields.count("item_" + std::to_string(id))) i.equipment_selected_ = id;
+    for (const auto& e : i.equipment_view_.entries)
+        if ((e.wielded && fields.count("hand_" + std::to_string(e.id))) ||
+            (e.worn && fields.count("worn_" + std::to_string(e.id))) ||
+            fields.count("quick_" + std::to_string(e.id))) i.equipment_selected_ = e.id;
+    for (unsigned n = 1; n <= 9; ++n) if (fields.count("quickslot_" + std::to_string(n))) {
+        i.quick_slot_ = n;
+        for (const auto &e : i.equipment_view_.entries) if (e.quick_slot == n) i.equipment_selected_ = e.id;
+    }
+    if (fields.count("quick_bind") || fields.count("quick_clear")) {
+        const bool clear = fields.count("quick_clear");
+        const auto* selected = i.equipment_view_.entry(i.equipment_selected_);
+        if (!i.session_.ready() || i.pending_move_ || i.metrics_.pending_decision) i.equipment_notice_ = (::cwm::text("Wait for the updated state.", "Attendi lo stato aggiornato."));
+        else if (!clear && !selected) i.equipment_notice_ = (::cwm::text("Select an item in the grid first.", "Seleziona prima un oggetto nella griglia."));
+        else {
+            auto wire = i.session_.builder(); const auto id = i.session_.next_command++;
+            const auto bytes = wire.build_quickbar_bind(id, i.quick_slot_, clear ? 0 : i.equipment_view_.view,
+                clear ? 0 : selected->id, i.quick_slots_[i.quick_slot_ - 1].binding);
+            if (i.connection_->send_message(bytes.data(), bytes.size())) {
+                i.quick_bind_command_ = id; i.pending_move_ = id; i.move_acked_ = false;
+                i.sent_move_ = std::chrono::steady_clock::now();
+            }
+        }
+        i.equipment_dirty_ = true; return;
+    }
+    if (const auto* selected = i.equipment_view_.entry(i.equipment_selected_)) {
+        for (int action = 0; action < 7; ++action) if (fields.count("action_" + std::to_string(action))) {
+            if (!(selected->actions & (1 << action))) i.equipment_notice_ = selected->reasons[action];
+            else if (i.metrics_.pause_reasons & ~uint32_t(2)) i.equipment_notice_ = (::cwm::text("Resume the game before equipping.", "Riprendi il gioco prima di equipaggiare."));
+            else if (!i.session_.ready() || i.pending_move_) i.equipment_notice_ = (::cwm::text("Wait for the updated state and reopen the inventory.", "Attendi lo stato aggiornato e riapri l'inventario."));
+            else {
+                i.queued_equipment_ = Impl::QueuedEquipment{i.equipment_view_.view, selected->id, action};
+                i.inventory_return_armed_ = true; i.equipment_close_ = true;
+                return;
+            }
+        }
+    }
+    i.equipment_dirty_ = true;
+}
+bool CddaBridge::takeEquipmentInventoryClose() {
+    if (!pimpl_ || !pimpl_->equipment_open_ || !pimpl_->equipment_close_) return false;
+    pimpl_->equipment_open_ = pimpl_->equipment_close_ = pimpl_->equipment_dirty_ = false;
+    return true;
+}
+std::string CddaBridge::takeEquipmentInventoryUpdate() {
+    if (!pimpl_ || !pimpl_->equipment_open_ || !pimpl_->equipment_dirty_) return {};
+    pimpl_->equipment_dirty_ = false;
+    const auto form = pimpl_->equipment_form();
+    pimpl_->equipment_focus_search_ = false;
+    return form;
+}
+
+std::string CddaBridge::openBodyStatus() {
+    if (!pimpl_ || !pimpl_->session_.ready() || !pimpl_->player_ready_ ||
+        !pimpl_->avatar_status_.available || pimpl_->ground_container_open_ || pimpl_->equipment_open_ || pimpl_->crafting_open_ ||
+        pimpl_->metrics_.pending_decision) return {};
+    pimpl_->body_form_open_ = true;
+    pimpl_->body_close_requested_ = false;
+    setMenuPause(true);
+    return avatarStatusForm(pimpl_->avatar_status_);
+}
+
+void CddaBridge::closeBodyStatus() {
+    if (pimpl_) pimpl_->body_form_open_ = false;
+}
+
+bool CddaBridge::takeBodyStatusClose() {
+    if (!pimpl_ || !pimpl_->body_form_open_ ||
+        (!pimpl_->body_close_requested_ && pimpl_->session_.ready())) return false;
+    pimpl_->body_form_open_ = pimpl_->body_close_requested_ = false;
+    return true;
+}
+
+CddaBridge::Metrics CddaBridge::getMetrics() const {
+    if (pimpl_) return pimpl_->metrics_;
+    return Metrics{};
+}
