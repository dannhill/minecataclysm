+    std::string ground_item_visual_name(const std::string& type_id) const {
+        if (!client_) return {};
+        auto* idef = client_->getItemDefManager();
+        if (!idef) return {};
+        const std::string mapped = groundItemRegistration(type_id);
+        if (idef->isKnown(mapped)) return mapped;
+        const std::string fallback = "cdda_items:fallback_generic";
+        return idef->isKnown(fallback) ? fallback : std::string{};
+    }
+
+    static void remove_ground_item_visual(GroundItemVisual& visual) {
+        for (auto* node : visual.nodes) {
+            if (!node) continue;
+            node->remove();
+            node->drop();
+        }
+        visual.nodes.clear();
+        visual.item_names.clear();
+    }
+
+    void clear_ground_item_visuals() {
+        for (auto& [pos, visual] : ground_item_visuals_)
+            remove_ground_item_visual(visual);
+        ground_item_visuals_.clear();
+    }
+
+    void reconcile_ground_item_visuals() {
+        if (!client_) return;
+        if (!smgr_) smgr_ = client_->getSceneManager();
+        if (!smgr_) return;
+
+        for (auto it = ground_item_visuals_.begin(); it != ground_item_visuals_.end();) {
+            if (ground_items_.get(it->first) && !ground_items_.storage(it->first)) {
+                ++it;
+                continue;
+            }
+            remove_ground_item_visual(it->second);
+            it = ground_item_visuals_.erase(it);
+        }
+
+        auto* idef = client_->getItemDefManager();
+        if (!idef) return;
+
+        static const v3f pile_offsets[3] = {
+            v3f(-0.18f, 0.f, -0.08f),
+            v3f( 0.18f, 0.f, -0.06f),
+            v3f( 0.00f, 0.f,  0.18f),
+        };
+
+        for (const auto& [pos, items] : ground_items_.tiles()) {
+            if (ground_items_.storage(pos)) continue;
+            const size_t count = std::min<size_t>(3, items.size());
+            std::vector<std::string> names;
+            names.reserve(count);
+            for (size_t i = 0; i < count; ++i) {
+                auto name = ground_item_visual_name(items[i].type_id);
+                if (!name.empty()) names.push_back(std::move(name));
+            }
+
+            auto& visual = ground_item_visuals_[pos];
+            if (visual.item_names != names) {
+                remove_ground_item_visual(visual);
+                visual.item_names = names;
+                for (const auto& name : names) {
+                    auto* node = new WieldMeshSceneNode(smgr_, -1);
+                    ItemStack stack(name, 1, 0, idef);
+                    node->setItem(stack, client_, true);
+                    node->setScale(v3f(0.2f, 0.2f, 0.2f));
+                    visual.nodes.push_back(node);
+                }
+            }
+
+            const bool pile = visual.nodes.size() > 1;
+            for (size_t i = 0; i < visual.nodes.size(); ++i) {
+                const v3f off = pile ? pile_offsets[i] : v3f(0.f, 0.f, 0.f);
+                visual.nodes[i]->setPosition(
+                    (v3f(pos.X + off.X, pos.Y + 0.62f + 0.03f * i, pos.Z + off.Z) -
+                    v3f(client_->getEnv().getCameraOffset().X,
+                        client_->getEnv().getCameraOffset().Y,
+                        client_->getEnv().getCameraOffset().Z)) * 10.f);
+            }
+        }
+    }
+
+    void update_ground_item_visuals(float dtime) {
+        reconcile_ground_item_visuals();
+        ground_item_rotation_ = std::fmod(ground_item_rotation_ + dtime * 90.f, 360.f);
+        for (auto& [pos, visual] : ground_item_visuals_) {
+            for (size_t i = 0; i < visual.nodes.size(); ++i) {
+                visual.nodes[i]->setVisible(session_.ready());
+                visual.nodes[i]->setRotation(
+                    v3f(0.f, ground_item_rotation_ + static_cast<float>(i) * 120.f, 0.f));
+            }
+        }
+    }
+
+    void update_terrain_bounds() {
+        if (!terrain_demo_) return;
+        terrain_bounds_.clear();
+        for (const auto& [pos, tile] : terrain_tiles_) {
+            auto [it, added] = terrain_bounds_.try_emplace(pos.Y,
+                std::array<float, 4>{32767.f, -32767.f, 32767.f, -32767.f});
+            auto& bounds = it->second;
+            bounds[0] = std::min(bounds[0], static_cast<float>(pos.X));
+            bounds[1] = std::max(bounds[1], static_cast<float>(pos.X));
+            bounds[2] = std::min(bounds[2], static_cast<float>(pos.Z));
+            bounds[3] = std::max(bounds[3], static_cast<float>(pos.Z));
+        }
+    }
