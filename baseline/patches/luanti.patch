+    uint32_t terrain_variant(const v3s16& base) const {
+        // Absolute CDDA XY: appearance survives bubble rebases and reloads.
+        uint32_t x = static_cast<uint32_t>(base.X + scene_origin_.X);
+        uint32_t y = static_cast<uint32_t>(-base.Z + scene_origin_.Y);
+        uint32_t value = x * 0x9e3779b9u ^ y * 0x85ebca6bu;
+        value ^= value >> 16;
+        return value % 3;
+    }
