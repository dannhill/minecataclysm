+std::optional<size_t> GUIFormSpecMenu::cwmDragZoneAt(v2s32 point)
+{
+    for (size_t n = 0; n < m_cwm_drag_zones.size(); ++n)
+        for (const auto &field : m_fields) if (field.fname == m_cwm_drag_zones[n].name) {
+            auto *e = getElementFromId(field.fid, true);
+            if (e && e->getAbsoluteClippingRect().isPointInside(point)) return n;
+        }
+    return {};
+}
+
+bool GUIFormSpecMenu::cwmDragEvent(const SEvent &event)
+{
+    if (!m_text_dst || m_text_dst->m_formname != "CWM_EQUIPMENT") return false;
+    if (event.EventType == EET_KEY_INPUT_EVENT && event.KeyInput.PressedDown &&
+            (event.KeyInput.Key == KEY_ESCAPE ||
+             (m_client && KeyPress(event.KeyInput) == getKeySetting("keymap_inventory"))) && m_cwm_drag_source) {
+        m_cwm_drag_source.reset(); m_cwm_drag_active = false; m_cwm_drag_cancelled = true;
+        return true;
+    }
+    if (event.EventType != EET_MOUSE_INPUT_EVENT) return false;
+    const v2s32 point(event.MouseInput.X, event.MouseInput.Y);
+    if (event.MouseInput.Event == EMIE_LMOUSE_PRESSED_DOWN) {
+        m_cwm_drag_cancelled = false;
+        const auto at = cwmDragZoneAt(point);
+        if (at && m_cwm_drag_zones[*at].item) {
+            m_cwm_drag_source = at; m_cwm_drag_start = point;
+            m_cwm_drag_shift = event.MouseInput.Shift;
+            m_cwm_drag_active = false; Environment->setFocus(this); return true;
+        }
+    }
+    if (event.MouseInput.Event == EMIE_MOUSE_MOVED && m_cwm_drag_source) {
+        m_pointer = point;
+        m_cwm_drag_active |= (point - m_cwm_drag_start).getLengthSQ() >= 36;
+        return true;
+    }
+    if (event.MouseInput.Event == EMIE_LMOUSE_LEFT_UP) {
+        if (m_cwm_drag_cancelled) { m_cwm_drag_cancelled = false; return true; }
+        if (!m_cwm_drag_source) return false;
+        const auto source = m_cwm_drag_zones[*m_cwm_drag_source];
+        const auto at = cwmDragZoneAt(point);
+        const bool dragging = m_cwm_drag_active;
+        m_cwm_drag_source.reset(); m_cwm_drag_active = false;
+        StringMap fields;
+        if (!dragging) {
+            if (at && m_cwm_drag_zones[*at].name == source.name) {
+                if (m_cwm_quick_transfer && m_cwm_drag_shift && source.name.rfind("item_", 0) == 0)
+                    fields = {{"quick_transfer", source.name}, {"drag_view", std::to_string(m_cwm_drag_view)}};
+                else fields = {{source.name, "true"}};
+            }
+        } else if (!AbsoluteRect.isPointInside(point) || (at && m_cwm_drag_zones[*at].name != source.name)) {
+            fields = {{"drag_from", source.name},
+                {"drag_to", !AbsoluteRect.isPointInside(point) ? "drag_ground" : m_cwm_drag_zones[*at].name},
+                {"drag_view", std::to_string(m_cwm_drag_view)}};
+        }
+        if (!fields.empty()) {
+            if (source.item == m_cwm_drag_selected)
+                for (const auto &f : m_fields) if (f.fname == "quantity") {
+                    auto *e = getElementFromId(f.fid, true);
+                    if (e) fields["quantity"] = wide_to_utf8(e->getText());
+                }
+            m_text_dst->gotText(fields);
+        }
+        return true;
+    }
+    return false;
+}
+
+bool GUIFormSpecMenu::cwmDragAllowed(const CwmDragZone &source, const CwmDragZone &target) const
+{
+    if (source.name == target.name) return true;
+    if (target.name.rfind("quickslot_", 0) == 0) return true;
+    if (target.name.rfind("hand_", 0) == 0) return source.actions & 1;
+    if (target.name.rfind("worn_", 0) == 0 || target.name.rfind("wear_empty_", 0) == 0) return source.actions & 4;
+    if (target.name == "drag_ground" || target.name.rfind("drag_owned",0)==0 || target.name.rfind("drag_external",0)==0 || (target.flags & 1)) return (source.flags & 2) && source.item != target.item;
+    if (source.name.rfind("hand_", 0) == 0) return source.actions & 2;
+    if (source.name.rfind("worn_", 0) == 0) return source.actions & 8;
+    return true; // Grid placement or bookmark removal only.
+}
+
+void GUIFormSpecMenu::drawCwmDrag()
+{
+    if (!m_cwm_drag_source || !m_cwm_drag_active || !m_client) return;
+    auto *driver = Environment->getVideoDriver();
+    const auto at = cwmDragZoneAt(m_pointer);
+    if (at) for (const auto &f : m_fields) if (f.fname == m_cwm_drag_zones[*at].name) {
+        if (auto *e = getElementFromId(f.fid, true))
+            driver->draw2DRectangle(cwmDragAllowed(m_cwm_drag_zones[*m_cwm_drag_source], m_cwm_drag_zones[*at]) ?
+                video::SColor(100, 60, 190, 110) : video::SColor(100, 210, 65, 50), e->getAbsoluteClippingRect());
+    }
+    if (at && !cwmDragAllowed(m_cwm_drag_zones[*m_cwm_drag_source], m_cwm_drag_zones[*at]))
+        m_font->draw(::cwm::wide("Destination unavailable", "Destinazione non disponibile").c_str(), core::rect<s32>(m_pointer.X + 28, m_pointer.Y + 24,
+            m_pointer.X + 330, m_pointer.Y + 50), video::SColor(255, 240, 100, 80));
+    const auto &source = m_cwm_drag_zones[*m_cwm_drag_source];
+    const core::rect<s32> rect(m_pointer.X - 24, m_pointer.Y - 24, m_pointer.X + 24, m_pointer.Y + 24);
+    if (!source.texture) {
+        drawItemStack(driver, m_font, ItemStack(source.visual, 1, 0, m_client->getItemDefManager()),
+            rect, nullptr, m_client, IT_ROT_DRAGGED);
+    } else if (auto *texture = m_tsrc->getTexture(source.visual)) {
+        const auto size = texture->getOriginalSize();
+        driver->draw2DImage(texture, rect, core::rect<s32>(0, 0, size.Width, size.Height), nullptr, nullptr, true);
+    }
+}
