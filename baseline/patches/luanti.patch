+
+bool CddaBridge::pointGroundItems(const irr::core::line3d<float>& ray) {
+    if (!pimpl_) return false;
+    auto& impl = *pimpl_;
+    impl.pointed_ground_.reset(); impl.hover_hint_.clear();
+    if (!impl.session_.ready() || !impl.entities_.count(1) || impl.metrics_.pending_decision)
+        return false;
+    const auto player = impl.entities_.at(1).target_pos;
+    float closest = std::numeric_limits<float>::max();
+    for (const auto& [pos, items] : impl.ground_items_.tiles()) {
+        if (pos.Y != std::round(player.Y) ||
+            std::abs(pos.X - std::round(player.X)) > 1 ||
+            std::abs(pos.Z - std::round(player.Z)) > 1) continue;
+        const v3f center(pos.X * 10.f, (pos.Y + .8f) * 10.f, pos.Z * 10.f);
+        const irr::core::aabbox3df box(center - v3f(4.5f, 3.f, 4.5f),
+                                     center + v3f(4.5f, 3.f, 4.5f));
+        const float distance = center.getDistanceFromSQ(ray.start);
+        if (distance < closest && box.intersectsWithLine(ray)) {
+            closest = distance; impl.pointed_ground_ = pos;
+            impl.hover_hint_ = utf8_to_wide(items.size() == 1 ? items.front().name :
+                (::cwm::text("Ground stack (", "Pila a terra (")) + std::to_string(items.size()) + (::cwm::text(" items)", " oggetti)"))) +
+                (::cwm::wide(" — right click", " — tasto destro"));
+        }
+    }
+    return impl.pointed_ground_.has_value();
+}
+
+bool CddaBridge::pointStorageNode(const v3s16& node) {
+    if(!pimpl_ || !pimpl_->session_.ready())return false;
+    auto& i=*pimpl_;const auto tile=luantiToCddaCoord(node);const auto base=cddaToLuantiCoord(tile.X,tile.Y,tile.Z);
+    const auto* label=i.ground_items_.storage(base); const auto player=i.entities_.find(1);
+    if(!label || player==i.entities_.end())return false;
+    const auto& p=player->second.target_pos;
+    if(base.Y!=std::round(p.Y) || std::abs(base.X-std::round(p.X))>1 || std::abs(base.Z-std::round(p.Z))>1)return false;
+    i.pointed_ground_=base;i.hover_hint_=utf8_to_wide(*label)+::cwm::wide(" — right click"," — tasto destro");return true;
+}
+
+std::string CddaBridge::activateGroundItems() {
+    if (!pimpl_ || !pimpl_->pointed_ground_ || pimpl_->pending_move_ || pimpl_->queued_pickup_)
+        return {};
+    auto& impl = *pimpl_;
+    const auto* items = impl.ground_items_.get(*impl.pointed_ground_);
+    const bool storage=impl.ground_items_.storage(*impl.pointed_ground_);
+    if (!storage && (!items || items->empty())) return {};
+    impl.last_ground_target_ = *impl.pointed_ground_;
+    // One loose native stack is one explicit pickup, including charged items.
+    // Its exact type/index/charges still go through native revalidation. Real
+    // containers and multi-item piles retain the storage/quantity interface.
+    if (!storage && items->size()==1 && !items->front().container) {
+        impl.queue_pickup(*impl.pointed_ground_,items->front());return {};
+    }
+    if(impl.equipment_open_ || impl.body_form_open_ || impl.crafting_open_ || impl.activity_token_ || impl.metrics_.pending_decision)return {};
+    const auto native=luantiToCddaCoord(*impl.pointed_ground_);
+    impl.dismiss_inventory_work();
+    impl.external_anchor_=v3s32(native.X+impl.scene_origin_.X,native.Y+impl.scene_origin_.Y,native.Z);
+    impl.equipment_open_=impl.equipment_dirty_=true;impl.equipment_close_=false;
+    impl.equipment_page_=impl.destination_page_=0;impl.transfer_form_=false;
+    setMenuPause(true);impl.query_inventory();return {};
+}
