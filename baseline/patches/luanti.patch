+void CddaBridge::traceCamera(const v3f& position, const v3f& direction) {
+    // Called every rendered frame after the native camera update. Camera
+    // offset changes alone are too rare to observe actor motion/lifecycle.
+    if (pimpl_ && pimpl_->entity_trace_.is_open()) {
+        const auto now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+        size_t scene_actors = 0, visible_actors = 0;
+        if (pimpl_->smgr_) {
+            for (const auto* node : pimpl_->smgr_->getRootSceneNode()->getChildren()) {
+                if (node->getID() == Impl::actor_scene_tag) {
+                    ++scene_actors;
+                    if (node->isVisible()) ++visible_actors;
+                }
+            }
+        }
+        for (const auto& [id, ent] : pimpl_->entities_) {
+            auto* node = static_cast<irr::scene::ISceneNode*>(ent.scene_node);
+            if (id == 1 && pimpl_->client_->getEnv().getLocalPlayer()->getCAO())
+                node = pimpl_->client_->getEnv().getLocalPlayer()->getCAO()->getSceneNode();
+            const auto pos = node ? node->getPosition() : v3f();
+            const auto texture = [&](unsigned layer) -> std::string {
+                if (!node || layer >= node->getMaterialCount() || !node->getMaterial(layer).getTexture(0)) return {};
+                return node->getMaterial(layer).getTexture(0)->getName().getPath().c_str();
+            };
+            const auto* animated = node && node->getType() == irr::scene::ESNT_ANIMATED_MESH ?
+                static_cast<irr::scene::IAnimatedMeshSceneNode*>(node) : nullptr;
+            pimpl_->entity_trace_ << now << ',' << pimpl_->metrics_.current_revision << ','
+                << pimpl_->session_.identity.session << ',' << pimpl_->session_.identity.connection << ','
+                << id << ',' << (ent.humanoid ? "npc" : id == 1 ? "player" : "monster") << ','
+                << ent.perceived << ',' << pimpl_->session_.ready() << ','
+                << ent.current_pos.X << ',' << ent.current_pos.Y << ',' << ent.current_pos.Z << ','
+                << ent.target_pos.X << ',' << ent.target_pos.Y << ',' << ent.target_pos.Z << ','
+                << ent.node_generation << ',' << (node && node->isVisible()) << ','
+                << pos.X << ',' << pos.Y << ',' << pos.Z << ',' << scene_actors << ',' << visible_actors
+                << ',' << (node ? node->getMaterialCount() : 0) << ',' << texture(0) << ',' << texture(1) << ',' << texture(2)
+                << ',' << (animated ? animated->getFrameNr() : -1.f) << ',' << (node ? node->getRotation().Y : 0.f)
+                << ',' << (node ? node->getBoundingBox().getExtent().Y * node->getScale().Y : 0.f) << ',' << ent.attack_seconds << ',' << ent.hurt_seconds << '\n';
+        }
+        pimpl_->entity_trace_.flush();
+    }
+    if (!pimpl_ || !pimpl_->trace_.is_open() || !pimpl_->entities_.count(1)) return;
+    const auto& entity = pimpl_->entities_.at(1);
+    const auto item_count = [&](const std::optional<v3s16>& pos) -> int {
+        if (!pos) return -1;
+        const auto* items = pimpl_->ground_items_.get(*pos);
+        return items ? static_cast<int>(items->size()) : 0;
+    };
+    size_t target_nodes = 0;
+    if (pimpl_->last_ground_target_) {
+        const auto visual = pimpl_->ground_item_visuals_.find(*pimpl_->last_ground_target_);
+        if (visual != pimpl_->ground_item_visuals_.end()) target_nodes = visual->second.nodes.size();
+    }
+    std::string target_type;
+    if (pimpl_->last_ground_target_) {
+        const auto* items = pimpl_->ground_items_.get(*pimpl_->last_ground_target_);
+        if (items && !items->empty()) target_type = items->front().type_id;
+    }
+    std::string csv_type = "\"";
+    for (const char c : target_type) {
+        if (c == '"') csv_type += '"';
+        csv_type += c;
+    }
+    csv_type += '"';
+    pimpl_->trace_ << std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count() << ','
+        << position.X << ',' << position.Y << ',' << position.Z << ','
+        << entity.target_pos.X << ',' << entity.target_pos.Y << ',' << entity.target_pos.Z << ','
+        << pimpl_->pending_move_ << ',' << direction.X << ',' << direction.Y << ','
+        << direction.Z << ',' << pimpl_->metrics_.current_revision << ','
+        << pimpl_->terrain_enriched_ << ',' << pimpl_->terrain_fog_ << ','
+        << pimpl_->metrics_.connected << ','
+        << (pimpl_->connection_ ? pimpl_->connection_->pending_input_bytes() : 0) << ','
+        << (pimpl_->connection_ ? pimpl_->connection_->queued_output_bytes() : 0) << ','
+        << pimpl_->ipc_work_.read_bytes << ',' << pimpl_->ipc_work_.written_bytes << ','
+        << pimpl_->ipc_work_.delivered_frames << ',' << pimpl_->ipc_work_.delivered_bytes << ','
+        << pimpl_->ipc_work_.read_calls << ',' << pimpl_->ipc_work_.write_calls << ','
+        << static_cast<int>(pimpl_->session_.state) << ',' << pimpl_->player_ready_ << ','
+        << pimpl_->session_.identity.session << ',' << pimpl_->session_.identity.player << ','
+        << pimpl_->session_.identity.connection << ',' << pimpl_->session_.sequence << ','
+        << pimpl_->session_.resync_count << ',' << pimpl_->entities_.size() << ',' << pimpl_->vehicles_.size()
+        << ',' << pimpl_->scene_origin_.X << ',' << pimpl_->scene_origin_.Y << ','
+        << pimpl_->metrics_.simulation_time << ',' << pimpl_->metrics_.realtime << ','
+        << pimpl_->metrics_.pause_reasons << ',' << pimpl_->metrics_.time_scale << ',' << pimpl_->sent_intent_ << ','
+        << pimpl_->metrics_.continuous_motion << ',' << pimpl_->sent_intent_x_ << ',' << pimpl_->sent_intent_y_ << ',' << pimpl_->metrics_.ipc_latency_ms << ',' << pimpl_->metrics_.projection_ms << ',' << pimpl_->ground_items_.tiles().size()
+        << ',' << pimpl_->owned_items_.size() << ',' << pimpl_->ground_container_open_
+        << ',' << pimpl_->pointed_ground_.has_value() << ',' << pimpl_->queued_pickup_.has_value()
+        << ',' << [&]() { size_t count = 0; for (const auto& [pos, visual] : pimpl_->ground_item_visuals_) count += visual.nodes.size(); return count; }()
+        << ',' << item_count(pimpl_->pointed_ground_) << ',' << item_count(pimpl_->last_ground_target_)
+        << ',' << target_nodes << ',' << csv_type
+        << ',' << pimpl_->avatar_status_.available << ',' << pimpl_->body_form_open_
+        << ',' << (pimpl_->survival_text_ && pimpl_->survival_text_->isVisible())
+        << ',' << pimpl_->avatar_status_.stamina.text
+        << ',' << [&]() { for (const auto& part : pimpl_->avatar_status_.parts) if (part.id == "head") return part.health.text; return std::string{}; }()
+        << ',' << [&]() { for (const auto& part : pimpl_->avatar_status_.parts) if (part.id == "arm_l") return part.health.text; return std::string{}; }()
+        << ',' << pimpl_->pointed_actor_ << ',' << pimpl_->attacks_sent_ << ',' << pimpl_->last_attack_target_
+        << ',' << [&]() { const auto it = pimpl_->entities_.find(pimpl_->last_attack_target_); return it == pimpl_->entities_.end() ? -1 : int(it->second.hp_percent); }() << ',' << pimpl_->last_attack_result_ << ',' << entity.state_flags << ',' << pimpl_->player_eye_offset_ << ',' << pimpl_->visual_animation_time_ << ',' << pimpl_->visual_animation_delta_ << ',' << pimpl_->ground_item_rotation_;
+    for (const auto* id : {"hunger", "thirst", "fatigue", "pain"}) {
+        int level = -1;
+        for (const auto& value : pimpl_->avatar_status_.needs)
+            if (value.id == id) level = value.perceived_level;
+        pimpl_->trace_ << ',' << level;
+    }
+    pimpl_->trace_ << ',' << std::count_if(pimpl_->hud_images_.begin(), pimpl_->hud_images_.end(),
+        [](const auto* image) { return image->isVisible(); })
+        << ',' << pimpl_->equipment_open_ << ',' << pimpl_->equipment_view_.view
+        << ',' << pimpl_->equipment_view_.entries.size() << ',' << pimpl_->equipment_selected_
+        << ',' << pimpl_->equipment_sent_ << ',' << pimpl_->metrics_.pending_decision
+        << ',' << ((pimpl_->first_aid_ || pimpl_->crafting_ || pimpl_->reloading_ || pimpl_->transferring_ || pimpl_->reading_) ? 0 : pimpl_->activity_token_) << ',' << ((pimpl_->first_aid_ || pimpl_->crafting_ || pimpl_->reloading_ || pimpl_->transferring_ || pimpl_->reading_) ? 0 : pimpl_->activity_total_) << ',' << ((pimpl_->first_aid_ || pimpl_->crafting_ || pimpl_->reloading_ || pimpl_->transferring_ || pimpl_->reading_) ? 0 : pimpl_->activity_remaining_)
+        << ',' << pimpl_->cancel_activity_sent_
+        << ',' << (pimpl_->first_aid_ ? pimpl_->activity_token_ : 0) << ',' << (pimpl_->first_aid_ ? pimpl_->activity_total_ : 0) << ',' << (pimpl_->first_aid_ ? pimpl_->activity_remaining_ : 0)
+        << ',' << pimpl_->crafting_open_ << ',' << pimpl_->crafting_view_.view << ',' << pimpl_->crafting_selected_
+        << ',' << pimpl_->crafting_sent_ << ',' << (pimpl_->crafting_ ? pimpl_->activity_token_ : 0)
+        << ',' << (pimpl_->crafting_ ? 10000000 - pimpl_->activity_remaining_ : 0)
+        << ',' << pimpl_->weapon_token_ << ',' << pimpl_->weapon_ammo_ << ',' << pimpl_->weapon_recoil_
+        << ',' << pimpl_->aim_sent_ << ',' << pimpl_->fire_sent_ << ',' << pimpl_->reload_sent_
+        << ',' << (pimpl_->reloading_ ? pimpl_->activity_token_ : 0) << ',' << (pimpl_->reloading_ ? pimpl_->activity_total_ : 0)
+        << ',' << (pimpl_->reloading_ ? pimpl_->activity_remaining_ : 0)
+        << ',' << pimpl_->transfer_form_ << ',' << pimpl_->transfers_sent_
+        << ',' << (pimpl_->transferring_ ? pimpl_->activity_token_ : 0) << ',' << (pimpl_->transferring_ ? pimpl_->activity_total_ : 0)
