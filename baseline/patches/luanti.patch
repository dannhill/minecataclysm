+void TestMapBlock::testCddaGroundItemProjection()
+{
+	using cdda_client::groundItemRegistration;
+	UASSERT(groundItemRegistration("101_carpentry") ==
+			"cdda_items:i_14cb52be98520222");
+	UASSERT(groundItemRegistration("10l_aluminum") ==
+			"cdda_items:i_c3b327eeed8313bb");
+
+    using cdda_client::GroundItemProjection;
+    using cdda_client::GroundItemView;
+
+    const v3s32 scene_origin(1000, 2000, -1);
+    GroundItemProjection projection;
+    GroundItemView bottle{0, "bottle_plastic", "plastic bottle", 0, false};
+
+    const v3s16 overlap =
+        cdda_client::CddaBridge::cddaToLuantiCoord(61, 60, 0);
+    const v3s16 exiting =
+        cdda_client::CddaBridge::cddaToLuantiCoord(5, 60, 0);
+
+    projection.apply(overlap, std::vector<GroundItemView>{bottle});
+    projection.apply(exiting, std::vector<GroundItemView>{bottle});
+    UASSERT(projection.size() == 2);
+
+    projection.pruneWindow(v3s32(1012, 2000, -1), scene_origin);
+    UASSERT(projection.size() == 1);
+    UASSERT(projection.get(overlap) != nullptr);
+    UASSERT(projection.get(exiting) == nullptr);
+
+    projection.apply(overlap, {});
+    UASSERT(projection.size() == 0);
+
+    projection.apply(overlap, std::vector<GroundItemView>{bottle});
+    projection.clear();
+    UASSERT(projection.size() == 0);
+
+}
+
+void TestMapBlock::testMeshResultOrder()
+{
+    // No renderer/workers are started. Reproduce the actual completion path
+    // for one block: older normal mesh, newer urgent authoritative projection.
+    MeshUpdateManager manager(nullptr);
+    MeshUpdateResult older, newer, result;
+    older.p = newer.p = v3s16(1, 2, 3);
+    older.urgent = false;
+    newer.urgent = true;
+    manager.putResult(older);
+    manager.putResult(newer);
+    UASSERT(manager.getNextResult(result));
+    UASSERT(!result.urgent);
+    UASSERT(manager.getNextResult(result));
+    UASSERT(result.urgent);
+    UASSERT(!manager.getNextResult(result));
+}
