+
+void CddaBridge::equipmentInventoryFields(const std::unordered_map<std::string, std::string>& fields) {
+    if (!pimpl_ || !pimpl_->equipment_open_) return;
+    auto& i = *pimpl_;
+    if (fields.count("quit")) {
+        i.equipment_open_ = i.equipment_close_ = i.equipment_dirty_ = false;
+        i.inventory_query_ = 0; i.equipment_view_ = {};
+        return;
+    }
+    if (fields.count("refresh")) { i.query_inventory(); return; }
+    if (fields.count("find") || fields.count("key_enter_field")) {
+        const auto search = fields.find("search");
+        if (search != fields.end()) i.equipment_search_ = search->second.substr(0, 256);
+        i.equipment_page_ = 0;
+    }
+    const auto filter = fields.find("filter");
+    if (filter != fields.end()) {
+        const std::array<std::string,4> names{{"Tutti", "Impugnati", "Indossati", "Nelle tasche"}};
+        const auto found = std::find(names.begin(), names.end(), filter->second);
+        if (found != names.end()) {
+            const int value = found - names.begin();
+            if (value != i.equipment_filter_) i.equipment_page_ = 0;
+            i.equipment_filter_ = value;
+        }
+    }
+    const auto ids = equipmentFilter(i.equipment_view_, i.equipment_search_, i.equipment_filter_);
+    if (fields.count("prev") && i.equipment_page_) --i.equipment_page_;
+    if (fields.count("next") && (i.equipment_page_ + 1) * 36 < ids.size()) ++i.equipment_page_;
+    for (const auto id : ids) if (fields.count("item_" + std::to_string(id))) i.equipment_selected_ = id;
+    if (const auto* selected = i.equipment_view_.entry(i.equipment_selected_)) {
+        for (int action = 0; action < 4; ++action) if (fields.count("action_" + std::to_string(action))) {
+            if (!(selected->actions & (1 << action))) i.equipment_notice_ = selected->reasons[action];
+            else if (i.metrics_.pause_reasons & ~uint32_t(2)) i.equipment_notice_ = "Riprendi il gioco prima di equipaggiare.";
+            else if (!i.session_.ready() || i.pending_move_) i.equipment_notice_ = "Attendi lo stato aggiornato e riapri l'inventario.";
+            else {
+                i.queued_equipment_ = Impl::QueuedEquipment{i.equipment_view_.view, selected->id, action};
+                i.equipment_close_ = true;
+                return;
+            }
+        }
+    }
+    i.equipment_dirty_ = true;
+}
+bool CddaBridge::takeEquipmentInventoryClose() {
+    if (!pimpl_ || !pimpl_->equipment_open_ || !pimpl_->equipment_close_) return false;
+    pimpl_->equipment_open_ = pimpl_->equipment_close_ = pimpl_->equipment_dirty_ = false;
+    return true;
+}
+std::string CddaBridge::takeEquipmentInventoryUpdate() {
+    if (!pimpl_ || !pimpl_->equipment_open_ || !pimpl_->equipment_dirty_) return {};
+    pimpl_->equipment_dirty_ = false;
+    return pimpl_->equipment_form();
+}
+
+std::string CddaBridge::openBodyStatus() {
+    if (!pimpl_ || !pimpl_->session_.ready() || !pimpl_->player_ready_ ||
+        !pimpl_->avatar_status_.available || pimpl_->ground_container_open_ || pimpl_->equipment_open_ ||
+        pimpl_->metrics_.pending_decision) return {};
+    pimpl_->body_form_open_ = true;
+    pimpl_->body_close_requested_ = false;
+    setMenuPause(true);
+    return avatarStatusForm(pimpl_->avatar_status_);
+}
+
+void CddaBridge::closeBodyStatus() {
+    if (pimpl_) pimpl_->body_form_open_ = false;
+}
+
+bool CddaBridge::takeBodyStatusClose() {
+    if (!pimpl_ || !pimpl_->body_form_open_ ||
+        (!pimpl_->body_close_requested_ && pimpl_->session_.ready())) return false;
+    pimpl_->body_form_open_ = pimpl_->body_close_requested_ = false;
+    return true;
+}
+
+CddaBridge::Metrics CddaBridge::getMetrics() const {
+    if (pimpl_) return pimpl_->metrics_;
+    return Metrics{};
+}
+
+} // namespace cdda_client
+
+namespace cdda_client {
+void CddaBridge::renderDebugOverlay(irr::gui::IGUIEnvironment* guienv) {
+    if (!guienv || !pimpl_) return;
+
+    const auto screen = guienv->getVideoDriver()->getScreenSize();
+    if (!pimpl_->posture_text_) {
+        pimpl_->posture_text_ = guienv->addStaticText(L"", irr::core::rect<irr::s32>(), true, true, nullptr, -1, true);
+        pimpl_->posture_text_->setOverrideColor(irr::video::SColor(255, 240, 245, 238));
+        pimpl_->posture_text_->setBackgroundColor(irr::video::SColor(220, 24, 35, 34));
+    }
+    const int posture_left = screen.Width >= 1000 ? 420 : 10;
+    const int posture_top = screen.Width >= 1000 ? 105 : 160;
+    pimpl_->posture_text_->setRelativePosition(irr::core::rect<irr::s32>(posture_left, posture_top,
+        std::min<int>(screen.Width - 10, posture_left + 680), posture_top + 50));
+    const auto player = pimpl_->entities_.find(1);
+    const uint32_t flags = player == pimpl_->entities_.end() ? 0 : player->second.state_flags;
+    const wchar_t* posture = flags & cdda::cwm::PRONE ? L"A terra" :
+        flags & cdda::cwm::CROUCHING ? L"Accovacciato" :
+        flags & cdda::cwm::RUNNING ? L"Corsa" : L"Cammino";
+    const auto key_label = [](const char* setting) {
+        auto key = g_settings->get(setting);
+        if (key == "KEY_LCONTROL") return std::wstring(L"Ctrl");
+        if (key == "KEY_LSHIFT") return std::wstring(L"Shift");
+        if (key.rfind("KEY_KEY_", 0) == 0) key.erase(0, 8);
+        else if (key.rfind("KEY_", 0) == 0) key.erase(0, 4);
+        return utf8_to_wide(key);
+    };
+    const std::wstring mode_text = std::wstring(posture) + L"\n" + key_label("keymap_cdda_run") + L": corsa (" + std::wstring(g_settings->getBool("cwm_run_toggle") ? L"toggle" : L"tieni") +
+        L") | " + key_label("keymap_cdda_crouch") + L": accovacciati (" + std::wstring(g_settings->getBool("cwm_crouch_toggle") ? L"toggle" : L"tieni") + L") | " + key_label("keymap_cdda_prone") + L": a terra";
+    pimpl_->posture_text_->setText(mode_text.c_str());
+    pimpl_->posture_text_->setVisible(pimpl_->session_.ready() && player != pimpl_->entities_.end() &&
+        !pimpl_->ground_container_open_ && !pimpl_->body_form_open_ && !pimpl_->equipment_open_ && !pimpl_->metrics_.pending_decision);
+
+    // Compact Minecraft-style rows above the possessions strip. All fills
+    // come from native display segments or native perceived categories.
+    const bool hud_visible = !pimpl_->ground_container_open_ && !pimpl_->body_form_open_ && !pimpl_->equipment_open_ &&
+        !pimpl_->metrics_.pending_decision;
+    const float scale = std::min(1.f, float(screen.Width - 20) / 396.f);
+    const auto px = [&](float value) { return int(std::round(value * scale)); };
+    const int slots = 9;
+    const int left = (int(screen.Width) - px(396)) / 2;
+    const int bottom = int(screen.Height) - px(54);
+    if (!pimpl_->survival_text_) {
+        pimpl_->survival_text_ = guienv->addStaticText(L"", irr::core::rect<irr::s32>(), false, false);
+        pimpl_->survival_text_->setOverrideColor(irr::video::SColor(255, 240, 245, 238));
+    }
+    pimpl_->survival_text_->setRelativePosition(irr::core::rect<irr::s32>(left,
+        bottom - px(104), left + px(396), bottom - px(76)));
+    pimpl_->survival_text_->setText(!pimpl_->session_.ready() ? L"Stato CDDA non sincronizzato" :
+        !pimpl_->avatar_status_.available ? L"Stato CDDA non disponibile" : L"");
+    pimpl_->survival_text_->setVisible(hud_visible);
+
+    size_t image_index = 0;
+    for (auto* image : pimpl_->hud_images_) image->setVisible(false);
+    auto image = [&](const std::string& texture, int x, int y, int w, int h, const std::wstring& tooltip = L"") {
+        if (image_index == pimpl_->hud_images_.size())
+            pimpl_->hud_images_.push_back(guienv->addImage(irr::core::rect<irr::s32>()));
+        auto* widget = pimpl_->hud_images_[image_index++];
+        widget->setImage(pimpl_->client_->getTextureSource()->getTexture(texture));
+        widget->setScaleImage(true);
+        widget->setRelativePosition(irr::core::rect<irr::s32>(x, y, x + w, y + h));
+        widget->setToolTipText(tooltip.c_str());
+        widget->setVisible(hud_visible && pimpl_->session_.ready());
+    };
+    auto bar = [&](const std::array<float, 10>& segments, const std::string& icon,
+            int column, int row, const std::string& marker, const std::wstring& tooltip,
+            const std::string& color, bool known = true) {
+        const int x = left + px(column * 210), y = bottom - px(96 - row * 23);
+        image(marker, x, y, px(19), px(19), tooltip);
+        for (size_t i = 0; i < segments.size(); ++i) {
+            const int ix = x + px(24 + i * 16);
+            image(icon + "^[colorize:#101018:180", ix, y, px(18), px(18), tooltip);
+            if (known && segments[i] > 0) {
+                const std::string fill = icon + "^[colorize:" + statusColor(color) + ":35";
+                image(fill + "^[opacity:0^[lowpart:" + std::to_string(int(segments[i] * 100)) + ":" + fill,
+                    ix, y, px(18), px(18), tooltip);
+            }
+        }
+        if (!known)
+            image("cdda_status_unknown.png", x + px(24), y, px(18), px(18), tooltip);
+    };
+    if (pimpl_->avatar_status_.available && pimpl_->session_.ready()) {
+        for (const auto& part : pimpl_->avatar_status_.parts)
+            if (part.id == "head" || part.id == "torso")
+                bar(statusHeartSegments(part.health.text), "heart.png", 0,
+                    part.id == "head" ? 1 : 2, bodyPartIcon(part.id), utf8_to_wide(part.label), part.health.color);
+        for (const auto& value : pimpl_->avatar_status_.needs) {
+            const char* icon = value.id == "hunger" ? "hbhunger_icon.png" :
+                value.id == "thirst" ? "cdda_status_water.png" :
+                value.id == "fatigue" ? "cdda_status_sleep.png" :
+                value.id == "pain" ? "cdda_status_comfort.png" : nullptr;
+            if (!icon) continue;
+            const int column = value.id == "pain" ? 0 : 1;
+            const int row = value.id == "pain" || value.id == "fatigue" ? 0 : value.id == "thirst" ? 1 : 2;
+            const auto tooltip = utf8_to_wide(value.label + ": " +
+                (value.text.empty() ? "-" : value.text) + " (piu icone = meglio)");
+            bar(statusNeedSegments(value.perceived_level), icon, column, row, icon,
+                tooltip, value.color, value.perceived_level >= 0);
+        }
+        const auto stamina = statusHeartSegments(pimpl_->avatar_status_.stamina.text);
+        for (size_t i = 0; i < stamina.size(); ++i) {
+            const int x = left + px(88 + i * 22), y = bottom - px(23);
+            const std::string icon = "mcl_hunger_icon_exhaustion.png";
+            image(icon + "^[colorize:#101018:180", x, y, px(19), px(19), L"Stamina");
+            if (stamina[i] > 0)
+                image(icon + "^[opacity:0^[lowpart:" + std::to_string(int(stamina[i] * 100)) + ":" + icon,
+                    x, y, px(19), px(19), L"Stamina");
+        }
+    }
+    // Read-only possessions: no Luanti selected-item or free wield operation.
+    if (pimpl_->possessions_text_) pimpl_->possessions_text_->setVisible(false);
+    const auto count = pimpl_->owned_items_.size();
+    for (int i = 0; i < slots; ++i) {
+        const int x = left + px(i * 44);
+        std::string tooltip = "Oggetti posseduti (vista)";
+        if (i == slots - 1 && count > size_t(slots)) tooltip += " +" + std::to_string(count - slots);
+        image("mcl_formspec_itemslot.png", x, bottom, px(42), px(42), utf8_to_wide(tooltip));
+        if (size_t(i) >= count) continue;
+        const auto& owned = pimpl_->owned_items_[i];
+        const auto name = pimpl_->ground_item_visual_name(owned.type_id);
+        const auto& def = pimpl_->client_->getItemDefManager()->get(name);
+        tooltip += "\n" + owned.name;
+        if (owned.count_by_charges) tooltip += " x" + std::to_string(owned.charges);
+        image(def.inventory_image.empty() ? "cdda_items_fallback.png" : def.inventory_image,
+            x + px(4), bottom + px(4), px(34), px(34), utf8_to_wide(tooltip));
+    }
+
+    if (!pimpl_->item_hint_text_)
+        pimpl_->item_hint_text_ = guienv->addStaticText(L"",
+            irr::core::rect<irr::s32>(10, 245, 1100, 280), false, true);
+    if (pimpl_->item_hint_text_) {
+        const auto& hint = pimpl_->queued_pickup_ || std::chrono::steady_clock::now() < pimpl_->item_hint_until_ ?
+            pimpl_->item_hint_ : pimpl_->hover_hint_;
+        pimpl_->item_hint_text_->setText(hint.c_str());
+        pimpl_->item_hint_text_->setVisible(pimpl_->session_.ready() &&
+            !pimpl_->metrics_.pending_decision && !pimpl_->ground_container_open_);
+    }
+
+    if (pimpl_->metrics_.realtime) {
+        if (!pimpl_->clock_text_) {
+            pimpl_->clock_text_ = guienv->addStaticText(L"", irr::core::rect<irr::s32>(420, 10, 1030, 95), true, true, nullptr, -1, true);
+            pimpl_->clock_text_->setOverrideColor(irr::video::SColor(255, 255, 255, 255));
+            pimpl_->clock_text_->setBackgroundColor(irr::video::SColor(225, 25, 35, 32));
+        }
+        wchar_t text[256];
+        swprintf(text, 256, L"TEMPO REALE %.2fx - %ls - %ls\nF7: pausa/riprendi | F8: velocita\nMinaccia: E per riprendere; rilascia prima WASD",
+            pimpl_->metrics_.time_scale, pimpl_->metrics_.pause_reasons ? L"IN PAUSA" : L"ATTIVO",
+            pimpl_->metrics_.continuous_motion ? L"MOVIMENTO CONTINUO" : L"GRIGLIA");
+        pimpl_->clock_text_->setText(text);
+        pimpl_->clock_text_->setVisible(!pimpl_->ground_container_open_ && !pimpl_->body_form_open_);
+    } else if (pimpl_->clock_text_) pimpl_->clock_text_->setVisible(false);
+
+    if (pimpl_->terrain_demo_) {
+        if (!pimpl_->terrain_text_) {
+            pimpl_->terrain_text_ = guienv->addStaticText(L"", irr::core::rect<irr::s32>(420, 10, 1010, 115),
+                true, true, nullptr, -1, true);
+            pimpl_->terrain_text_->setOverrideColor(irr::video::SColor(255, 255, 255, 255));
+            pimpl_->terrain_text_->setBackgroundColor(irr::video::SColor(225, 25, 35, 32));
+        }
+        const std::wstring text = std::wstring(L"CONFRONTO TERRENO: ") +
+            (pimpl_->terrain_enriched_ ? L"B - materiali e vegetazione" : L"A - resa attuale") +
+            L"\nF7: cambia A/B   |   F8: nebbia " + (pimpl_->terrain_fog_ ? L"ON" : L"OFF") +
+            L"\nWASD + mouse. Dal centro:\nNO bosco | NE campo | SO strada/casa | SE riva";
+        pimpl_->terrain_text_->setText(text.c_str());
+    }
+
+    if (!pimpl_->decision_text_) {
+        pimpl_->decision_text_ = guienv->addStaticText(L"", irr::core::rect<irr::s32>(100, 230, 850, 480),
+            true, true, nullptr, -1, true);
+        if (pimpl_->decision_text_) {
+            pimpl_->decision_text_->setOverrideColor(irr::video::SColor(255, 255, 255, 255));
+            pimpl_->decision_text_->setBackgroundColor(irr::video::SColor(245, 25, 25, 30));
+        }
+    }
+    if (pimpl_->decision_text_) {
+        pimpl_->decision_text_->setText(pimpl_->decision_body_.c_str());
+        pimpl_->decision_text_->setVisible(pimpl_->metrics_.pending_decision != 0);
+    }
+
+    if (!pimpl_->vertical_text_) {
+        pimpl_->vertical_text_ = guienv->addStaticText(L"",
+            irr::core::rect<irr::s32>(10, 210, 760, 240), false, true);
+        if (pimpl_->vertical_text_)
+            pimpl_->vertical_text_->setOverrideColor(irr::video::SColor(255, 180, 235, 255));
+    }
+    if (pimpl_->vertical_text_) {
+        const auto player = pimpl_->entities_.find(1);
+        const uint32_t flags = player == pimpl_->entities_.end() ? 0 : player->second.state_flags;
+        using namespace cdda::cwm;
+        std::wstring hint;
+        if (flags & UNDERWATER)
+            hint = L"Swim: Jump to rise/surface | Sneak + Jump to dive/descend";
+        else if (flags & SWIMMING)
+            hint = L"Swim: Sneak + Jump to dive";
+        else {
+            if (flags & ON_UP_CONNECTION) hint = L"Jump: ascend";
+            if (flags & ON_DOWN_CONNECTION) {
+                if (!hint.empty()) hint += L" | ";
+                hint += L"Sneak + Jump: descend";
+            }
+        }
+        pimpl_->vertical_text_->setText(hint.c_str());
+        pimpl_->vertical_text_->setVisible(pimpl_->player_ready_ &&
+            !pimpl_->metrics_.pending_decision && !pimpl_->metrics_.safety_stop && !hint.empty());
+    }
+
+    if (!pimpl_->safety_text_) {
+        pimpl_->safety_text_ = guienv->addStaticText(
+            L"CDDA: threat detected. Release movement, press Aux1 (default E) to resume.",
+            irr::core::rect<irr::s32>(10, 165, 650, 205), false, true);
+        if (pimpl_->safety_text_)
+            pimpl_->safety_text_->setOverrideColor(irr::video::SColor(255, 255, 210, 80));
+    }
+    if (pimpl_->safety_text_)
+        pimpl_->safety_text_->setVisible(pimpl_->metrics_.connected && pimpl_->metrics_.safety_stop);
+
+    if (!pimpl_->debug_text_) {
+        // Create static text at top left
+        irr::core::rect<irr::s32> rect(10, 10, 400, 150);
+        pimpl_->debug_text_ = guienv->addStaticText(L"F3 Overlay Initializing...", rect, false, true, nullptr, -1, true);
+        if (pimpl_->debug_text_) {
+            pimpl_->debug_text_->setOverrideColor(irr::video::SColor(255, 255, 255, 255));
+        }
+    }
+
+    if (pimpl_->debug_text_) {
+        wchar_t text[512];
+        swprintf(text, 512, L"[CDDA-Mineclonia F3 Overlay]\n"
+                             L"CWM IPC Connected: %ls\n"
+                             L"FPS: %u\n"
+                             L"Action result: %.2f ms; projection: %.2f ms\n"
+                             L"Revision: %llu\n"
+                             L"Chunks: %u\n"
+                             L"Entities: %u\n"
+                             L"Vehicles: %u",
+                 pimpl_->metrics_.connected ? L"YES" : L"NO",
+                 pimpl_->metrics_.fps,
+                 pimpl_->metrics_.ipc_latency_ms,
+                 pimpl_->metrics_.projection_ms,
+                 (unsigned long long)pimpl_->metrics_.current_revision,
+                 pimpl_->metrics_.chunks_loaded,
+                 pimpl_->metrics_.entities_count,
+                 pimpl_->metrics_.vehicles_count);
+        
+        pimpl_->debug_text_->setText(text);
+        pimpl_->debug_text_->setVisible(!pimpl_->ground_container_open_ && !pimpl_->body_form_open_);
+    }
+}
+
+} // namespace cdda_client
