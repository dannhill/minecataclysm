+std::recursive_mutex& CddaBridge::projectionMutex() {
+    static std::recursive_mutex mutex;
+    return mutex;
+}
+
+bool CddaBridge::initialize(Client* client, const std::string& socket_path) {
+    shutdown();
+    pimpl_ = std::make_unique<Impl>();
+    pimpl_->client_ = client;
+    pimpl_->socket_path_ = socket_path;
+    pimpl_->terrain_demo_ = g_settings->exists("cdda_terrain_comparison") &&
+                            g_settings->getBool("cdda_terrain_comparison");
+    // The approved B style is independent of the isolated native demo fixture.
+    // Only comparison mode keeps the additional cache needed for live A/B.
+    pimpl_->terrain_enriched_ = !g_settings->exists("cdda_terrain_enriched") ||
+                                g_settings->getBool("cdda_terrain_enriched");
+    pimpl_->terrain_fog_ = pimpl_->terrain_demo_;
+    std::string trace_path;
+    if (g_settings->getNoEx("cwm_trace_file", trace_path) && !trace_path.empty()) {
+        pimpl_->trace_.open(trace_path);
+        pimpl_->trace_ << "time_ns,camera_x,camera_y,camera_z,target_x,target_y,target_z,pending_move,dir_x,dir_y,dir_z,revision,terrain_style,terrain_fog,ipc_connected,ipc_input,ipc_output,ipc_read_bytes,ipc_write_bytes,ipc_frames,ipc_dispatch_bytes,ipc_read_calls,ipc_write_calls,session_state,input_ready,session_id,player_id,connection_id,sequence,resync_count,entity_cache,vehicle_cache,scene_origin_x,scene_origin_y,simulation_time,realtime,pause_reasons,time_scale,sent_intent,continuous_motion,intent_x,intent_y,ipc_latency_ms,projection_ms,ground_tiles,owned_items,ground_container,ground_hover,queued_pickup,ground_visual_nodes,ground_hover_items,ground_target_items,ground_target_visual_nodes,ground_target_first_type,status_available,body_form,survival_visible,status_stamina,status_head,status_arm_l,combat_hover,attacks_sent,attack_target,attack_target_hp,attack_result,player_state_flags,player_eye_offset,visual_animation_time,visual_animation_delta,ground_item_rotation,status_hunger_level,status_thirst_level,status_fatigue_level,status_pain_level,hud_images_active\n";
+    }
+    if (g_settings->getNoEx("cwm_entity_trace_file", trace_path) && !trace_path.empty()) {
+        pimpl_->entity_trace_.open(trace_path);
+        pimpl_->entity_trace_ << "time_ns,revision,session_id,connection_id,id,type,perceived,ready,current_x,current_y,current_z,target_x,target_y,target_z,node_generation,node_visible,node_x,node_y,node_z,scene_actors,visible_actors\n";
+    }
+    return pimpl_->connect();
+}
+
+void CddaBridge::shutdown() {
+    if (pimpl_) {
+        if (pimpl_->debug_text_) pimpl_->debug_text_->remove();
+        if (pimpl_->item_hint_text_) pimpl_->item_hint_text_->remove();
+        if (pimpl_->survival_text_) pimpl_->survival_text_->remove();
+        if (pimpl_->possessions_text_) pimpl_->possessions_text_->remove();
+        for (auto* image : pimpl_->hud_images_) image->remove();
+        if (pimpl_->clock_text_) pimpl_->clock_text_->remove();
+        if (pimpl_->safety_text_) pimpl_->safety_text_->remove();
+        if (pimpl_->decision_text_) pimpl_->decision_text_->remove();
+        if (pimpl_->posture_text_) pimpl_->posture_text_->remove();
+        if (pimpl_->vertical_text_) pimpl_->vertical_text_->remove();
+        if (pimpl_->terrain_text_) pimpl_->terrain_text_->remove();
+        for (auto& [id, ent] : pimpl_->entities_) if (ent.scene_node)
+            static_cast<irr::scene::ISceneNode*>(ent.scene_node)->remove();
+        for (auto& vehicle : pimpl_->vehicles_)
+            for (auto& component : vehicle.second.components)
+                if (component.scene_node)
+                    static_cast<irr::scene::ISceneNode*>(component.scene_node)->remove();
+        pimpl_.reset();
+    }
+}
+
+bool CddaBridge::restoreProjectedBlock(Client* client, MapBlock* block) {
+    return pimpl_ && pimpl_->client_ == client && pimpl_->restore_projected_block(block);
+}
+
+bool CddaBridge::ownsPlayer(const Client* client) const {
+    return pimpl_ && pimpl_->client_ == client;
+}
