+v3s16 CddaBridge::cddaToLuantiCoord(int x, int y, int z) {
+    // Luanti: X is East (+), Y is Up (+), Z is North (-)
+    return v3s16(x, z * 3, -y);
+}
+
+v3s16 CddaBridge::luantiToCddaCoord(v3s16 pos) {
+    // All three presentation nodes belong to the same native Z level,
+    // including the upper pane/door half and negative underground levels.
+    return v3s16(pos.X, -pos.Z, static_cast<int>(std::floor(pos.Y / 3.0f)));
