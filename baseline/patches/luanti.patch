+    void render_entity(VisualEntity& ent) {
+        if (!client_) return;
+        const bool zombie = ent.type_id.find("mon_zombie") == 0;
+        const auto visual = creatureVisual(ent.type_id, ent.humanoid);
+        const bool human = zombie || ent.humanoid || ent.id == 1;
+        auto cycle = human ? humanoidCycle(zombie, ent.walking, ent.state_flags) : (ent.walking ? visual.walk : visual.idle);
+        const bool attacking = ent.attack_seconds > 0.f;
+        if (attacking && human) cycle = zombie ? HumanoidCycle{50,59,20} : HumanoidCycle{189,198,30};
+        const auto animate = [&](irr::scene::IAnimatedMeshSceneNode* body) {
+            if (!body) return;
+            body->setAnimationSpeed(0); // Irrlicht wall time must not unpause it.
+            body->setFrameLoop(cycle.first, cycle.last);
+            const float frame = attacking && human ?
+                std::min(float(cycle.last), cycle.first + (.5f - ent.attack_seconds) * cycle.fps) :
+                humanoidFrame(cycle, ent.animation_seconds);
+            body->setCurrentFrame(frame);
+            body->animateJoints();
+        };
+        if (ent.id == 1) {
+            auto* avatar = client_->getEnv().getLocalPlayer()->getCAO();
+            auto* body = avatar ? avatar->getAnimatedMeshSceneNode() : nullptr;
+            if (body) {
+                if (!ent.avatar_model_scale) {
+                    const auto box = body->getMesh()->getBoundingBox();
+                    const float height = box.MaxEdge.Y - box.MinEdge.Y;
+                    ent.avatar_model_scale = height > .001f ? 18.f / height : 1.f;
+                    ent.model_y_offset = -box.MinEdge.Y * ent.avatar_model_scale;
+                }
+                body->setScale(v3f(ent.avatar_model_scale));
+                body->setPosition(v3f(0,ent.model_y_offset,0));
+                animate(body);
+            }
+            return;
+        }
+        if (!smgr_) smgr_ = client_->getSceneManager();
+        if (!smgr_) return;
+        if (!ent.scene_node && ent.perceived) {
+            irr::scene::ISceneNode* node = nullptr;
+            if (visual.mesh) {
+                auto* mesh = client_->getMesh(visual.mesh);
+                if (mesh) {
+                    auto* body = smgr_->addAnimatedMeshSceneNode(mesh);
+                    if (body) {
+                        const auto box = mesh->getBoundingBox();
+                        const float height = box.MaxEdge.Y - box.MinEdge.Y;
+                        const float scale = height > 0.001f ? visual.height / height : 1.0f;
+                        body->setScale(v3f(scale, scale, scale));
+                        body->setFrameLoop(0, 0);
+                        body->setAnimationSpeed(0);
+                        ent.model_y_offset = -box.MinEdge.Y * scale;
+                        setMeshColor(mesh, irr::video::SColor(255, 255, 255, 255));
+                        node = body;
+                        unsigned layer = 0;
+                        node->forEachMaterial([&](auto& material) {
+                            // Mineclonia zombie: armour, skin. Character:
+                            // skin, armour, clothing overlay. Never paint the
+                            // skin onto the empty overlay geometry as well.
+                            const bool skin = int(layer) == visual.skin_layer;
+                            material.setTexture(0, client_->getTextureSource()->getTextureForMesh(
+                                skin ? visual.skin : "blank.png"));
+                            material.MaterialType = irr::video::EMT_TRANSPARENT_ALPHA_CHANNEL_REF;
+                            material.UseMipMaps = false;
+                            material.TextureLayers[0].MinFilter = irr::video::ETMINF_NEAREST_MIPMAP_NEAREST;
+                            material.TextureLayers[0].MagFilter = irr::video::ETMAGF_NEAREST;
+                            ++layer;
+                        });
+                    }
+                    mesh->drop();
+                }
+            }
+            if (!node) {
+                auto* cube = createCubeMesh(v3f(7.0f, 10.0f, 7.0f));
+                auto* marker = smgr_->addMeshSceneNode(cube);
+                cube->drop();
+                if (marker) {
+                    setMeshColor(marker->getMesh(), irr::video::SColor(255, 220, 65, 180));
+                    ent.model_y_offset = 5.0f;
+                    node = marker;
+                }
+            }
+            if (node) {
+                node->setID(actor_scene_tag);
+                node->forEachMaterial([](auto& material) { material.FogEnable = true; });
+                ent.scene_node = node;
+                ent.node_generation = ++next_actor_node_;
+                infostream << "[Luanti-CDDA] Visual creature " << ent.id << ": " << ent.type_id << std::endl;
+            }
+        }
+        if (ent.scene_node) {
+            auto* node = static_cast<irr::scene::ISceneNode*>(ent.scene_node);
+            const v3s16 offset = client_->getEnv().getCameraOffset();
+            node->setVisible(session_.ready() && ent.perceived);
+            node->setPosition((ent.current_pos + v3f(0, .5f, 0) - v3f(offset.X, offset.Y, offset.Z)) * 10.0f +
+                              v3f(0, ent.model_y_offset, 0));
+            // A brief pose/skin cue, never an authoritative knockback or turn.
+            node->setRotation(v3f(ent.hurt_seconds > 0 ? -7.f : 0.f, ent.presentation_yaw, 0));
+            if (visual.mesh) {
+                unsigned layer = 0;
+                node->forEachMaterial([&](auto& material) {
+                    const std::string texture = int(layer++) == visual.skin_layer ?
+                        std::string(visual.skin) + (ent.hurt_seconds > 0 ? "^[colorize:#FF5555:120" : "") : "blank.png";
+                    material.setTexture(0,client_->getTextureSource()->getTextureForMesh(texture));
+                });
+            }
+            if (node->getType() == irr::scene::ESNT_ANIMATED_MESH)
+                animate(static_cast<irr::scene::IAnimatedMeshSceneNode*>(node));
+        }
+    }
