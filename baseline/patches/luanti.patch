+void CddaBridge::groundContainerFields(const std::unordered_map<std::string, std::string>& fields) {
+    if (!pimpl_) return;
+    auto& impl = *pimpl_;
+    if (fields.count("quit")) {
+        impl.ground_container_open_ = impl.ground_close_requested_ = impl.ground_form_dirty_ = false;
+        return;
+    }
+    const auto page = [&](size_t& current, size_t count, size_t size, const std::string& prefix) {
+        const size_t maximum = count ? (count - 1) / size : 0;
+        if (fields.count(prefix + "_prev") && current) --current;
+        if (fields.count(prefix + "_next") && current < maximum) ++current;
+    };
+    page(impl.ground_page_, impl.ground_selection_.size(), 27, "ground");
+    page(impl.owned_page_, impl.owned_items_.size(), 36, "owned");
+    impl.ground_form_dirty_ = true;
+}
