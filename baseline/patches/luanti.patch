@@ -0,0 +1,152 @@
+// Luanti C++ CWM Presentation Bridge
+// Licensed under Apache-2.0
+#pragma once
+
+#include <string>
+#include <memory>
+#include <vector>
+#include <unordered_map>
+#include <cstdint>
+#include <mutex>
+#include "irrlichttypes.h"
+#include "irr_v3d.h"
+#include <line3d.h>
+
+namespace irr { namespace gui { class IGUIEnvironment; class IGUIStaticText; } }
+
+class Client;
+class MapBlock;
+class Inventory;
+struct InventoryLocation;
+struct InventoryAction;
+
+namespace cdda_client {
+
+
+struct VisualVehicleComponent {
+    std::string name;
+    v3f mount_offset;
+    bool is_broken;
+    bool is_open;
+    void* scene_node{nullptr}; // Pointer to Irrlicht scene node
+};
+
+struct VisualVehicle {
+    uint64_t id{0};
+    std::string name;
+    v3f current_pos;
+    v3f target_pos;
+    float rotation{0.0f};
+    v3f velocity;
+    std::vector<VisualVehicleComponent> components;
+};
+
+struct VisualEntity {
+    uint64_t id{0};
+    std::string type_id;
+    v3f current_pos;
+    v3f target_pos;
+    v3f start_pos;
+    float interpolation_time{0.2f};
+    float motion_seconds{0.2f};
+    float rotation{0.0f};
+    uint8_t hp_percent{100};
+    uint32_t state_flags{0};
+    std::string name;
+    bool perceived{true};
+    bool humanoid{false};
+    void* scene_node{nullptr};
+    uint64_t node_generation{0};
+    float model_y_offset{0.0f};
+};
+
+class CddaBridge {
+public:
+    static CddaBridge& getInstance();
+    // Share one lock between projection/cache writers and mesh data capture.
+    // Workers release it before generating geometry from their private copy.
+    static std::recursive_mutex& projectionMutex();
+
+    bool initialize(Client* client, const std::string& socket_path);
+    void shutdown();
+    void update(float dtime);
+
+    // The local Luanti server supplies empty cache blocks, not gameplay terrain.
+    bool restoreProjectedBlock(Client* client, MapBlock* block);
+    // Once initialized, native physics/teleports cannot own this player,
+    // including while IPC is reconnecting.
+    bool ownsPlayer(const Client* client) const;
+    void traceCamera(const v3f& position, const v3f& direction);
+    void updateScenePositions();
+    bool terrainComparisonEnabled() const;
+    void toggleTerrainStyle();
+    void toggleTerrainFog();
+    float terrainFogDistance() const;
+
+    // Input hooks
+    bool handleMoveInput(int dir);
+    void handlePostureInput(bool run, bool crouch, bool prone);
+    double visualAnimationTime() const;
+    float visualAnimationDelta() const;
+    bool handleInteract(int x, int y, int z, int action);
+    bool handlePointedOpening(const v3s16& node, bool close);
+    bool pointCombatTarget(const irr::core::line3d<float>& ray);
+    bool attackPointedTarget();
+    bool pointGroundItems(const irr::core::line3d<float>& ray);
+    std::string activateGroundItems();
+    Inventory* getInventoryMirror(const InventoryLocation& location);
+    void handleInventoryAction(const InventoryAction& action);
+    void groundContainerFields(const std::unordered_map<std::string, std::string>& fields);
+    bool takeGroundContainerClose();
+    std::string takeGroundContainerUpdate();
+    bool acknowledgeThreat();
+    bool answerDecision(uint16_t choice);
+    void handleMovementIntent(int direction);
+    void handleContinuousIntent(float x, float y);
+    void setMenuPause(bool paused);
+    void toggleSimulationPause();
+    void cycleSimulationSpeed();
+    std::string openEquipmentInventory();
+    void equipmentInventoryFields(const std::unordered_map<std::string, std::string>& fields);
+    bool takeEquipmentInventoryClose();
+    std::string takeEquipmentInventoryUpdate();
+    std::string openBodyStatus();
+    void closeBodyStatus();
+    bool takeBodyStatusClose();
+
+    // Coordinate conversion
+    static v3s16 cddaToLuantiCoord(int x, int y, int z);
+    static v3s16 luantiToCddaCoord(v3s16 pos);
+
+    // Metrics for F3 Debug Overlay
+    struct Metrics {
+        bool realtime{false};
+        bool continuous_motion{false};
+        uint32_t pause_reasons{0};
+        float time_scale{1.f};
+        uint64_t simulation_time{0};
+        uint64_t current_revision{0};
+        uint32_t fps{60};
+        float ipc_latency_ms{0.0f};
+        float projection_ms{0.0f};
+        uint32_t chunks_loaded{0};
+        uint32_t entities_count{0};
+        uint32_t vehicles_count{0};
+        bool connected{false};
+        bool safety_stop{false};
+        uint64_t pending_decision{0};
+        uint16_t decision_choices{0};
+    };
+    Metrics getMetrics() const;
+
+    // F3 Debug Overlay
+    void renderDebugOverlay(irr::gui::IGUIEnvironment* guienv);
+
+
+private:
+    CddaBridge() = default;
+    class Impl;
+    std::unique_ptr<Impl> pimpl_;
+};
+
+} // namespace cdda_client
diff --git a/src/cdda/equipment_inventory.h b/src/cdda/equipment_inventory.h
new file mode 100644
index 0000000..2fae19b
--- /dev/null
+++ b/src/cdda/equipment_inventory.h
@@ -0,0 +1,132 @@
+#pragma once
+#include "avatar_status.h"
+#include "cwm/cwm_generated.h"
+#include <array>
+#include <algorithm>
+#include <cctype>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace cdda_client {
+struct EquipmentEntry {
+    uint32_t id{}, parent{}; int pocket{-1};
+    std::string type, name, category;
+    int charges{}, access{}; bool counted{}, worn{}, wielded{};
+    int64_t weight{}, volume{}, length{};
+    uint8_t actions{};
+    std::array<std::string, 4> reasons;
+};
+struct EquipmentPocket {
+    uint32_t owner{}, index{}; std::string name;
+    int64_t capacity{}, remaining{}, weight_capacity{}, weight_remaining{}, length{};
+    int access{}; bool sealed{}, rigid{}, watertight{};
+};
+struct EquipmentView {
+    uint64_t query{}, view{}; bool truncated{};
+    std::string error;
+    int64_t weight{}, weight_capacity{}, volume{}, volume_capacity{};
+    std::vector<EquipmentEntry> entries;
+    std::vector<EquipmentPocket> pockets;
+    void read(const CDDA::CWM::InventoryView& source) {
+        *this = {};
+        query = source.query_id(); view = source.view_id(); truncated = source.truncated();
+        error = source.error()->str(); weight = source.weight_grams(); weight_capacity = source.weight_capacity_grams();
+        volume = source.volume_ml(); volume_capacity = source.volume_capacity_ml();
+        for (const auto* e : *source.entries()) {
+            EquipmentEntry entry{e->id(), e->parent_id(), e->pocket_index(),
+                e->type_id()->str(), e->name()->str(), e->category()->str(), e->charges(), e->access_moves(),
+                e->count_by_charges(), e->worn(), e->wielded(), e->weight_grams(), e->volume_ml(), e->length_mm(), e->actions(), {}};
+            for (unsigned i = 0; i < 4; ++i) entry.reasons[i] = e->reasons()->Get(i)->str();
+            entries.push_back(std::move(entry));
+        }
+        for (const auto* p : *source.pockets()) pockets.push_back({p->owner_id(), p->index(), p->name()->str(),
+            p->capacity_ml(), p->remaining_ml(), p->capacity_grams(), p->remaining_grams(), p->max_length_mm(),
+            p->access_moves(), p->sealed(), p->rigid(), p->watertight()});
+    }
+    const EquipmentEntry* entry(uint32_t id) const {
+        return id && id <= entries.size() ? &entries[id - 1] : nullptr;
+    }
+    std::string source(uint32_t id) const {
+        const auto* e = entry(id); if (!e) return {};
+        if (!e->parent) return e->worn ? "Indossato" : e->wielded ? "Impugnato" : "Inventario";
+        std::string out;
+        for (unsigned depth = 0; e && e->parent && depth < 32; ++depth) {
+            const auto* parent = entry(e->parent); if (!parent) break;
+            std::string name = parent->name;
+            for (const auto& p : pockets) if (p.owner == parent->id && int(p.index) == e->pocket)
+                name += " / " + (p.name.empty() ? "tasca " + std::to_string(p.index + 1) : p.name);
+            out = name + (out.empty() ? "" : " > " + out); e = parent;
+        }
+        return out;
+    }
+};
+inline std::string equipmentLower(std::string text) {
+    for (auto& c : text) c = char(std::tolower(static_cast<unsigned char>(c)));
+    return text;
+}
+inline std::vector<uint32_t> equipmentFilter(const EquipmentView& view, const std::string& search, int filter) {
+    std::vector<uint32_t> ids;
+    const auto needle = equipmentLower(search);
+    for (const auto& e : view.entries) {
+        if ((filter == 1 && !e.wielded) || (filter == 2 && !e.worn) || (filter == 3 && !e.parent)) continue;
+        if (!needle.empty() && equipmentLower(e.name + " " + e.category + " " + view.source(e.id)).find(needle) == std::string::npos) continue;
+        ids.push_back(e.id);
+    }
+    return ids;
+}
+inline std::string equipmentForm(const EquipmentView& view, size_t page, uint32_t selected,
+        const std::string& search, int filter, const std::string& notice,
+        const std::function<std::string(const std::string&)>& icon) {
+    std::string f = "formspec_version[4]size[16,11]no_prepend[]bgcolor[#00000000]"
+        "background9[0,0;16,11;mcl_base_textures_background9.png;false;7]"
+        "style_type[label;textcolor=#323232]"
+        "style_type[button;border=false;bgimg=mcl_inventory_button9.png;bgimg_pressed=mcl_inventory_button9_pressed.png;bgimg_middle=2,2]"
+        "label[0.4,0.4;Inventario ed equipaggiamento]"
+        "field[0.4,1;5.6,0.65;search;;" + statusEscape(search) + "]field_close_on_enter[search;false]"
+        "button[6.1,1;1.6,0.65;find;Cerca]dropdown[8,1;3.3,0.65;filter;Tutti,Impugnati,Indossati,Nelle tasche;" + std::to_string(filter + 1) + "]"
+        "button[11.6,1;1.8,0.65;refresh;Aggiorna]button_exit[13.7,1;1.8,0.65;close;Chiudi]";
+    if (!view.view) return f + "label[0.5,2.2;" + statusEscape(view.error.empty() ? "Lettura inventario nativo..." : view.error) + "]";
+    f += "label[0.5,2;Peso " + std::to_string(view.weight / 1000.0) + " / " + std::to_string(view.weight_capacity / 1000.0) +
+        " kg - Volume " + std::to_string(view.volume / 1000.0) + " / " + std::to_string(view.volume_capacity / 1000.0) + " L]";
+    const auto ids = equipmentFilter(view, search, filter);
+    const size_t pages = std::max<size_t>(1, (ids.size() + 35) / 36);
+    page = std::min(page, pages - 1);
+    for (size_t i = page * 36; i < std::min(ids.size(), (page + 1) * 36); ++i) {
+        const auto& e = *view.entry(ids[i]);
+        const auto offset = i % 36;
+        const auto x = std::to_string(.5 + (offset % 6) * 1.18), y = std::to_string(2.7 + (offset / 6) * 1.12);
+        const std::string button = "item_" + std::to_string(e.id);
+        f += "image[" + x + "," + y + ";1.05,1.05;mcl_formspec_itemslot.png]";
+        if (selected == e.id) f += "box[" + x + "," + y + ";1.05,1.05;#E8CF5790]";
+        f += "item_image_button[" + x + "," + y + ";1.05,1.05;" + statusEscape(icon(e.type)) + ";" + button + ";]";
+        f += "tooltip[" + button + ";" + statusEscape(e.name + (e.counted ? " (" + std::to_string(e.charges) + ")" : "") + "\n" + view.source(e.id)) + "]";
+    }
+    f += "button[0.5,9.65;1.4,0.6;prev;<]label[2.15,9.95;" + std::to_string(page + 1) + " / " + std::to_string(pages) +
+        "]button[5.65,9.65;1.4,0.6;next;>]";
+    if (const auto* e = view.entry(selected)) {
+        std::string detail = e->name + "\n" + e->category + "\n" + view.source(e->id) + "\n" +
+            std::to_string(e->weight / 1000.0) + " kg / " + std::to_string(e->volume / 1000.0) + " L / " +
+            std::to_string(e->length) + " mm\nAccesso nativo: " + std::to_string(e->access) + " mosse";
+        if (e->counted) detail += "\nQuantita: " + std::to_string(e->charges);
+        for (const auto& p : view.pockets) if (p.owner == selected) {
+            detail += "\n" + (p.name.empty() ? "Tasca " + std::to_string(p.index + 1) : p.name) +
+                ": " + std::to_string(p.remaining / 1000.0) + " / " + std::to_string(p.capacity / 1000.0) + " L liberi; " +
+                std::to_string(p.weight_remaining / 1000.0) + " / " + std::to_string(p.weight_capacity / 1000.0) + " kg liberi" +
+                "; lunghezza max " + std::to_string(p.length) + " mm; accesso " + std::to_string(p.access) + " mosse" +
+                (p.sealed ? "; sigillata" : "") + (p.rigid ? "; rigida" : "") + (p.watertight ? "; stagna" : "");
+        }
+        f += "textarea[8,2.6;7.5,5.1;detail;;" + statusEscape(detail) + "]";
+        const std::array<std::string,4> names{{"Impugna", "Riponi", "Indossa", "Togli"}};
+        for (unsigned i = 0; i < 4; ++i) {
+            const auto x = std::to_string(8 + (i % 2) * 3.8), y = std::to_string(7.95 + (i / 2) * .85);
+            const auto key = "action_" + std::to_string(i);
+            // Unavailable actions have no clickable field. Their native reason remains inspectable.
+            if (e->actions & (1 << i)) f += "button[" + x + "," + y + ";3.4,0.65;" + key + ";" + names[i] + "]";
+            else f += "label[" + x + "," + y + ";" + names[i] + " (non disponibile)]tooltip[" + x + "," + y + ";3.4,0.65;" + statusEscape(e->reasons[i]) + "]";
+        }
+    } else f += "label[8,3;Seleziona un oggetto per i dettagli e le azioni.]";
+    f += "label[0.5,10.65;" + statusEscape(notice.empty() ? (view.truncated ? "Vista limitata: parte dei contenuti non mostrata." : "Le azioni usano tempi e vincoli CDDA. Nessun equipaggiamento istantaneo.") : notice) + "]";
+    return f;
+}
+} // namespace cdda_client
diff --git a/src/cdda/ground_item_formspec.h b/src/cdda/ground_item_formspec.h
new file mode 100644
index 0000000..3090d83
--- /dev/null
+++ b/src/cdda/ground_item_formspec.h
@@ -0,0 +1,42 @@
+#pragma once
+#include <algorithm>
+#include <string>
+
+namespace cdda_client {
+// Mineclonia mcl_chests single-chest layout and mcl_formspec slot spacing.
+// Inventory locations are client-owned projection mirrors; no Lua inventories.
+inline std::string groundContainerForm(size_t ground_count, size_t owned_count,
+        size_t ground_page, size_t owned_page)
+{
+    std::string form = "formspec_version[4]size[11.75,10.425]no_prepend[]"
+        "listcolors[#9990;#FFF7;#FFF0;#000;#FFF]"
+        "style_type[label;textcolor=#323232]"
+        "style_type[button;border=false;bgimg=mcl_inventory_button9.png;"
+        "bgimg_pressed=mcl_inventory_button9_pressed.png;bgimg_middle=2,2]"
+        "bgcolor[#00000000]"
+        "background9[0,0;11.75,10.425;mcl_base_textures_background9.png;false;7]";
+    const auto slots = [&](double x, double y, int w, int h) {
+        for (int i = 0; i < w; ++i) for (int j = 0; j < h; ++j)
+            form += "image[" + std::to_string(x + i * 1.25 - .05) + "," +
+                std::to_string(y + j * 1.25 - .05) +
+                ";1.1,1.1;mcl_formspec_itemslot.png]";
+    };
+    form += "label[0.375,0.375;Pila a terra (" + std::to_string(ground_count) + ")]";
+    slots(.375, .75, 9, 3);
+    form += "list[detached:cwm_ground;main;0.375,0.75;9,3;" +
+        std::to_string(ground_page * 27) + "]";
+    form += "label[0.375,4.7;Inventario / equipaggiamento - trascina qui una pila]";
+    slots(.375, 5.1, 9, 3);
+    form += "list[detached:cwm_owned;main;0.375,5.1;9,3;" +
+        std::to_string(owned_page * 36 + 9) + "]";
+    slots(.375, 9.05, 9, 1);
+    form += "list[detached:cwm_owned;main;0.375,9.05;9,1;" +
+        std::to_string(owned_page * 36) + "]"
+        "listring[detached:cwm_ground;main]listring[detached:cwm_owned;main]";
+    if (ground_count > 27)
+        form += "button[9,0.05;1.1,0.5;ground_prev;<]button[10.35,0.05;1.1,0.5;ground_next;>]";
+    if (owned_count > 36)
+        form += "button[9,4.1;1.1,0.5;owned_prev;<]button[10.35,4.1;1.1,0.5;owned_next;>]";
+    return form;
+}
+}
diff --git a/src/cdda/ground_item_projection.h b/src/cdda/ground_item_projection.h
new file mode 100644
index 0000000..ecf25ba
--- /dev/null
+++ b/src/cdda/ground_item_projection.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+#include "irr_v3d.h"
+
+namespace cdda_client {
+
+struct GroundItemView {
+	uint32_t stack_index{0};
+	std::string type_id;
+	std::string name;
+	int32_t charges{0};
+	bool count_by_charges{false};
+};
+
+class GroundItemProjection {
+	std::map<v3s16, std::vector<GroundItemView>> tiles_;
+
+public:
+	void clear() { tiles_.clear(); }
+	size_t size() const { return tiles_.size(); }
+	const auto &tiles() const { return tiles_; }
+
+	const std::vector<GroundItemView> *get(const v3s16 &pos) const
+	{
+		const auto it = tiles_.find(pos);
+		return it == tiles_.end() ? nullptr : &it->second;
+	}
+
+	void apply(const v3s16 &pos, std::vector<GroundItemView> items)
+	{
+		if (items.empty())
+			tiles_.erase(pos);
+		else
+			tiles_[pos] = std::move(items);
+	}
+
+	void pruneWindow(const v3s32 &origin, const v3s32 &scene_origin, int width = 132)
+	{
+		const int min_x = origin.X - scene_origin.X;
+		const int min_y = origin.Y - scene_origin.Y;
+		const int min_z = origin.Z;
+
+		for (auto it = tiles_.begin(); it != tiles_.end();) {
+			const v3s16 &p = it->first;
+			const int x = p.X;
+			const int y = -p.Z;
+			const int z = p.Y / 3;
+			if (x < min_x || x >= min_x + width ||
+					y < min_y || y >= min_y + width ||
+					z < min_z || z >= min_z + 3)
+				it = tiles_.erase(it);
+			else
+				++it;
+		}
+	}
+};
+
+} // namespace cdda_client
diff --git a/src/cdda/ground_item_visual.h b/src/cdda/ground_item_visual.h
new file mode 100644
index 0000000..a550994
--- /dev/null
+++ b/src/cdda/ground_item_visual.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace cdda_client {
+
+inline std::string groundItemRegistration(const std::string &type_id)
+{
+	uint64_t h = 14695981039346656037ULL;
+	for (unsigned char c : type_id) {
+		h ^= c;
+		h *= 1099511628211ULL;
+	}
+
+	static constexpr char hex[] = "0123456789abcdef";
+	std::string suffix(16, '0');
+	for (int i = 15; i >= 0; --i) {
+		suffix[i] = hex[h & 0xf];
+		h >>= 4;
+	}
+
+	return "cdda_items:i_" + suffix;
+}
+
+} // namespace cdda_client
diff --git a/src/cdda/posture_input.h b/src/cdda/posture_input.h
new file mode 100644
index 0000000..ca45474
--- /dev/null
+++ b/src/cdda/posture_input.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <array>
+
+namespace cdda_client {
+// Desired input only. The bridge still waits for native ACK + world state;
+// this class never changes authoritative posture or assumes a cost/speed.
+class PostureInput {
+    std::array<bool, 3> last_{};
+    std::array<bool, 2> blocked_{};
+    int latched_{0}, last_confirmed_{0};
+    bool initialized_{false};
+public:
+    void reject(int mode) {
+        if (mode == 1 || mode == 2) blocked_[mode - 1] = true;
+        if (latched_ == mode) latched_ = 0;
+    }
+    int sample(const std::array<bool, 3>& down, bool run_toggle,
+               bool crouch_toggle, bool allowed, int confirmed) {
+        if (!initialized_ && allowed) {
+            latched_ = confirmed == 3 || (confirmed == 1 && run_toggle) ||
+                (confirmed == 2 && crouch_toggle) ? confirmed : 0;
+            initialized_ = true;
+        }
+        if (!allowed) {
+            for (int i = 0; i < 2; ++i) blocked_[i] = down[i];
+            last_ = down;
+            last_confirmed_ = confirmed;
+            return -1; // Menu/recovery presses are never replayed.
+        }
+        for (int i = 0; i < 2; ++i) if (!down[i]) blocked_[i] = false;
+        // Native exhaustion may switch RUN to WALK inside a tile. Require a
+        // new physical press rather than retrying rejected RUN every frame.
+        if (last_confirmed_ == 1 && confirmed == 0 && down[0]) reject(1);
+        const bool toggle[] = {run_toggle, crouch_toggle};
+        for (int i = 0; i < 2; ++i)
+            if (toggle[i] && down[i] && !last_[i] && !blocked_[i])
+                latched_ = latched_ == i + 1 ? 0 : i + 1;
+        if (down[2] && !last_[2]) {
+            latched_ = latched_ == 3 ? 0 : 3;
+            for (int i = 0; i < 2; ++i) blocked_[i] = down[i];
+        }
+        last_ = down;
+        last_confirmed_ = confirmed;
+        if (!crouch_toggle && down[1] && !blocked_[1]) return 2;
+        if (!run_toggle && down[0] && !blocked_[0]) return 1;
+        return latched_;
+    }
+};
+} // namespace cdda_client
