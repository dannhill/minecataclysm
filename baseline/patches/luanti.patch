+    void rebuild_terrain_style() {
+        std::lock_guard<std::recursive_mutex> lock(CddaBridge::projectionMutex());
+        auto previous = std::move(projected_blocks_);
+        projected_blocks_.clear();
+        std::set<v3s16> changed;
+        for (const auto& [pos, tile] : terrain_tiles_)
+            place_cdda_tile(pos, tile.material_id(), tile.state_flags(),
+                            tile.light_level(), tile.orientation(), changed);
+        for (auto it = changed.begin(); it != changed.end();) {
+            auto old = previous.find(*it);
+            if (old != previous.end() && old->second == projected_blocks_.at(*it))
+                it = changed.erase(it);
+            else ++it;
+        }
+        for (const auto& [pos, nodes] : previous)
+            if (!projected_blocks_.count(pos)) changed.insert(pos);
+        commit_projection(changed);
+        infostream << "[Luanti-CDDA] Terrain comparison " << (terrain_enriched_ ? "B" : "A")
+                   << ": " << changed.size() << " changed mesh blocks; authoritative state unchanged" << std::endl;
+    }
