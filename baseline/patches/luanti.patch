+void CddaBridge::handleInventoryAction(const InventoryAction& action) {
+    if (!pimpl_ || !pimpl_->ground_container_open_ || !pimpl_->session_.ready() ||
+        pimpl_->queued_pickup_ || pimpl_->ground_close_requested_ || action.getType() != IAction::Move) return;
+    const auto& move = static_cast<const IMoveAction&>(action);
+    if (move.from_inv.type != InventoryLocation::DETACHED || move.from_inv.name != "cwm_ground" ||
+        move.to_inv.type != InventoryLocation::DETACHED || move.to_inv.name != "cwm_owned" ||
+        move.from_list != "main" || move.to_list != "main" || move.from_i < 0 ||
+        static_cast<size_t>(move.from_i) >= pimpl_->ground_selection_.size()) return;
+    pimpl_->queue_pickup(pimpl_->ground_container_pos_, pimpl_->ground_selection_[move.from_i]);
+    pimpl_->ground_close_requested_ = true;
+}
