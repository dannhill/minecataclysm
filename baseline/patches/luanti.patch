+void TestMapBlock::testCddaAimInput()
+{
+    cdda_client::AimInput input;
+    auto sample = [&](bool right, bool pressed = false, bool f = false, bool context = false,
+                      bool allowed = true, bool fire = false, bool reload = false) {
+        return input.sample(right, pressed, f, context, allowed, fire, reload);
+    };
+    sample(false);
+    UASSERT(sample(false,true,false,true).context_pressed); // Down/up in one frame remains a click.
+    sample(false);
+    UASSERT(sample(true,true).aiming);
+    UASSERT(sample(true).aiming);
+    UASSERT(!sample(true,false,false,false,true,true).aiming); // One shot takes priority.
+    UASSERT(sample(true).aiming); // Holding resumes aim after the shot.
+    UASSERT(!sample(false).aiming);
+    UASSERT(sample(true,true,false,true).context_pressed);
+    UASSERT(!sample(true,false,false,false).aiming); // Camera changed during context hold.
+    UASSERT(!sample(true,false,true).aiming); // F cannot steal the context gesture.
+    sample(false,false,false);
+    UASSERT(sample(true,true).aiming);
+    UASSERT(!sample(true,false,false,false,false).aiming);
+    UASSERT(!sample(true,true).aiming); // Paused press/repeat cannot rearm.
+    sample(false);
+    UASSERT(sample(true,true).aiming);
+    UASSERT(!sample(true,false,false,false,true,false,true).aiming); // Reload disarms.
+    UASSERT(!sample(true,true).aiming);
+    sample(false);
+    UASSERT(sample(false,false,true).aiming); // F is still a held fallback.
+    UASSERT(!sample(false,false,true,false,false).aiming);
+    UASSERT(!sample(false,false,true).aiming);
+    sample(false,false,false);
+    UASSERT(sample(false,false,true).aiming);
