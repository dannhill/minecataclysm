+    UASSERTEQ(int, toggle.sample({true,false,false},true,true,true,1), 1);
+    UASSERTEQ(int, toggle.sample({false,false,false},true,true,true,1), 1);
+    UASSERTEQ(int, toggle.sample({true,false,false},true,true,true,1), 0);
