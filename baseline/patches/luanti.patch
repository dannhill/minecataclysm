+
+#include "client/client.h"
+#include "client/clientmap.h"
+#include "client/clientenvironment.h"
+#include "client/localplayer.h"
+#include "mapblock.h"
+#include "mapsector.h"
+#include "nodedef.h"
+#include "log.h"
+
+#include <IGUIEnvironment.h>
+#include <IGUIStaticText.h>
+#include <ISceneManager.h>
+#include <IMeshSceneNode.h>
+
+
+#include <iostream>
+#include <chrono>
+#include <cmath>
+#include <set>
+#include <map>
+#include <unordered_map>
+
+namespace cdda_client {
+
+v3s16 CddaBridge::cddaToLuantiCoord(int x, int y, int z) {
+    // Luanti: X is East (+), Y is Up (+), Z is North (-)
+    return v3s16(x, z * 3, -y);
+}
+
+v3s16 CddaBridge::luantiToCddaCoord(v3s16 pos) {
+    return v3s16(pos.X, -pos.Z, static_cast<int>(std::round(pos.Y / 3.0f)));
+}
+
+class CddaBridge::Impl {
+public:
+    Client* client_{nullptr};
+    std::string socket_path_;
+    std::unique_ptr<cdda::cwm::IpcConnection> connection_;
+    Metrics metrics_;
+    uint64_t command_counter_{1};
+    uint64_t pending_move_{0};
+    bool move_acked_{false};
+    std::chrono::steady_clock::time_point next_move_{};
+    std::chrono::steady_clock::time_point sent_move_{};
+    std::ofstream trace_;
+    bool player_ready_{false};
+    static constexpr float step_duration = 0.2f;
+
+    std::unordered_map<uint64_t, VisualEntity> entities_;
+    std::unordered_map<uint64_t, VisualVehicle> vehicles_;
+    irr::gui::IGUIStaticText* debug_text_{nullptr};
+    irr::gui::IGUIStaticText* safety_text_{nullptr};
+    irr::scene::ISceneManager* smgr_{nullptr};
+    std::unordered_map<uint16_t, content_t> material_map_;
+    // The projection uses reality-bubble-local XY and absolute CDDA z-levels
+    // for terrain, camera and vehicles alike. Origin is rebase metadata only.
+    v3s32 projection_origin_;
+    bool origin_valid_{false};
+    std::map<v3s16, std::vector<MapNode>> projected_blocks_;
+
+    static void apply_nodes(MapBlock& block, const std::vector<MapNode>* nodes) {
+        for (s16 z = 0; z < MAP_BLOCKSIZE; ++z)
+            for (s16 y = 0; y < MAP_BLOCKSIZE; ++y)
+                for (s16 x = 0; x < MAP_BLOCKSIZE; ++x) {
+                    const size_t index = z * MapBlock::zstride + y * MapBlock::ystride + x;
+                    block.setNodeNoCheck(x, y, z, nodes ? (*nodes)[index] : MapNode(CONTENT_AIR, 0xff));
+                }
+        // Network deserialization can cache an empty block as isAir=true.
+        block.expireIsAirCache();
+        block.resetUsageTimer();
+    }
+
+    bool restore_projected_block(MapBlock* block) {
+        std::lock_guard<std::recursive_mutex> lock(CddaBridge::projectionMutex());
+        if (!block) return false;
+        const auto it = projected_blocks_.find(block->getPos());
+        if (it == projected_blocks_.end()) return false;
+        apply_nodes(*block, &it->second);
+        return true;
+    }
+
+    void commit_projection(const std::set<v3s16>& modified_blocks) {
+        if (!client_) return;
+        std::lock_guard<std::recursive_mutex> lock(CddaBridge::projectionMutex());
+        Map& map = client_->getEnv().getMap();
+        for (const auto& bp : modified_blocks) {
+            MapSector* sector = map.emergeSector(v2s16(bp.X, bp.Z));
+            if (!sector) continue;
+            MapBlock* block = sector->getBlockNoCreateNoEx(bp.Y);
+            if (!block) block = sector->createBlankBlock(bp.Y);
+            const auto it = projected_blocks_.find(bp);
+            apply_nodes(*block, it == projected_blocks_.end() ? nullptr : &it->second);
+            client_->addUpdateMeshTaskWithEdge(bp, false, true);
+        }
+    }
+
+    content_t get_node_for_material(uint16_t mat_id) {
+        if (mat_id == 0) return CONTENT_AIR;
+        auto it = material_map_.find(mat_id);
+        if (it != material_map_.end()) return it->second;
+
+        if (!client_) return CONTENT_AIR;
+        const NodeDefManager* ndef = client_->getNodeDefManager();
+        if (!ndef) return CONTENT_AIR;
+
+        content_t cid = CONTENT_AIR;
+        switch (mat_id) {
+            case 1: cid = ndef->getId("cdda_nodes:dirt"); break;
+            case 2: cid = ndef->getId("cdda_nodes:grass_block"); break;
+            case 3: cid = ndef->getId("cdda_nodes:brick_wall"); break;
+            case 4: cid = ndef->getId("cdda_nodes:wood_planks"); break;
+            case 5: cid = ndef->getId("cdda_nodes:door_wood_closed"); break;
+            case 6: cid = ndef->getId("cdda_nodes:door_wood_open"); break;
+            case 7: cid = ndef->getId("cdda_nodes:glass"); break;
+            case 8: cid = ndef->getId("cdda_nodes:stone"); break;
+            case 9: cid = ndef->getId("cdda_nodes:furniture_wood"); break;
+            case 10: cid = CONTENT_AIR; break;
+            case 11: cid = ndef->getId("cdda_nodes:wood_planks"); break;
+            case 12: cid = ndef->getId("cdda_nodes:stone"); break;
+            case 13: cid = ndef->getId("cdda_nodes:glass"); break;
+            case 14: cid = ndef->getId("cdda_nodes:water"); break;
+            case 15: cid = ndef->getId("cdda_nodes:stone"); break;
+            default: cid = ndef->getId("cdda_nodes:stone"); break;
+        }
+        if (cid == CONTENT_IGNORE) cid = CONTENT_AIR;
+        material_map_[mat_id] = cid;
+        return cid;
+    }
+
+    void set_voxel(const v3s16& lpos, content_t cid, uint8_t light, uint8_t param2, std::set<v3s16>& modified_blocks) {
+        v3s16 bp, offset;
+        getNodeBlockPosWithOffset(lpos, bp, offset);
+        auto& nodes = projected_blocks_.try_emplace(bp, size_t(MapBlock::nodecount),
+                                                    MapNode(CONTENT_AIR, 0xff)).first->second;
+        // Same light in day and night banks: CDDA, not Luanti's clock, decides brightness.
+        const uint8_t l = light & 0x0F;
+        const size_t index = offset.Z * MapBlock::zstride + offset.Y * MapBlock::ystride + offset.X;
+        nodes[index] = MapNode(cid, (uint8_t)(l | (l << 4)), param2);
+        modified_blocks.insert(bp);
+    }
+
+    void place_cdda_tile(const v3s16& base, uint16_t material, uint32_t flags,
+                         uint8_t light, uint8_t orientation, std::set<v3s16>& modified) {
+        using namespace cdda::cwm;
+        // Each nodebox stays inside its own cell; split doors avoid cross-cell
+        // occlusion, and ordinary cubes retain faces visible from either side.
+        const uint8_t facedir = orientation == 1 ? 1 : 0;
+        content_t floor = material == AIR ? CONTENT_AIR : get_node_for_material(FLOOR);
+        content_t lower = CONTENT_AIR, upper = CONTENT_AIR;
+        switch (material) {
+            case AIR: break;
+            case WALL: case OBSTACLE: case GLASS_WALL:
+                floor = lower = upper = get_node_for_material(material); break;
+            case DOOR_CLOSED: case DOOR_OPEN:
+                lower = get_node_for_material(material);
+                upper = get_node_for_material(WALL); break;
+            case WINDOW: case WINDOW_OPEN: case WINDOW_BOARDED:
+                // A passable window has a genuinely open aperture.
+                floor = get_node_for_material(WALL);
+                lower = get_node_for_material(material);
+                upper = lower; break;
+            case LEGACY_FURNITURE:
+                lower = get_node_for_material(LEGACY_FURNITURE); break;
+            case LOW_OBSTACLE:
+                lower = get_node_for_material(LOW_OBSTACLE); break;
+            default: floor = get_node_for_material(material); break;
+        }
+        if (flags & FURNITURE) {
+            lower = get_node_for_material(LEGACY_FURNITURE);
+            if (flags & TALL_FURNITURE) upper = lower;
+        }
+        set_voxel(base, floor, light, 0, modified);
+        set_voxel(base + v3s16(0, 1, 0), lower, light, facedir, modified);
+        // Door covers both headroom cells using two independent nodeboxes.
+        if (material == DOOR_CLOSED || material == DOOR_OPEN)
+            upper = client_->getNodeDefManager()->getId(material == DOOR_CLOSED ?
+                "cdda_nodes:door_wood_closed_top" : "cdda_nodes:door_wood_open_top");
+        set_voxel(base + v3s16(0, 2, 0), upper, light, facedir, modified);
+    }
+
+    void apply_tile(const CDDA::CWM::TileDelta* delta, std::set<v3s16>& modified) {
+        if (!delta || !delta->coord() || !delta->block()) return;
+        const auto* p = delta->coord();
+        const auto* block = delta->block();
+        place_cdda_tile(CddaBridge::cddaToLuantiCoord(p->x(), p->y(), p->z()),
+                       block->material_id(), block->state_flags(), block->light_level(),
+                       block->orientation(), modified);
+    }
+
+    bool connect() {
+        connection_ = cdda::cwm::IpcClient::connect_unix(socket_path_);
+        if (connection_ && connection_->is_valid()) {
+            metrics_.connected = true;
+            pending_move_ = 0;
+            player_ready_ = false;
+
+            // Send Hello
+            cdda::cwm::MessageBuilder builder(command_counter_++, 0);
+            auto hello = builder.build_hello_request("luanti_cdda_client_5.10.0");
+            connection_->send_message(hello.data(), hello.size());
+            return true;
+        }
+        metrics_.connected = false;
+        return false;
+    }
+
+    void update(float dtime) {
+        if (!connection_ || !connection_->is_valid()) {
+            // Periodic reconnect attempt
+            static float reconnect_timer = 0.0f;
+            reconnect_timer += dtime;
+            if (reconnect_timer > 2.0f) {
+                reconnect_timer = 0.0f;
+                connect();
+            }
+            return;
+        }
+
+        std::vector<std::vector<uint8_t>> incoming;
+        bool ok = connection_->poll_and_receive(incoming, 0);
+        if (!ok) {
+            metrics_.connected = false;
+            player_ready_ = false;
+            pending_move_ = 0;
+            connection_.reset();
+            return;
+        }
+
+        for (const auto& frame : incoming) {
+            process_message(frame.data(), frame.size());
+        }
+
+        // Interpolate visual entities
+        for (auto& [id, ent] : entities_) {
+            ent.interpolation_time = std::min(step_duration, ent.interpolation_time + dtime);
+            ent.current_pos = ent.start_pos + (ent.target_pos - ent.start_pos) *
+                              (ent.interpolation_time / step_duration);
+            
+            // Sync Luanti camera to CDDA player (id == 1)
+            if (id == 1 && client_) {
+                auto* local_player = client_->getEnv().getLocalPlayer();
+                if (local_player) {
+                    // BS = 10.0f. Player camera typically is +1.5 blocks up, but CDDA handles Z
+                    local_player->setPosition((ent.current_pos + v3f(0, 0.5f, 0)) * 10.0f); // feet on top of floor node
+                }
+            }
+        }
+
+        // Interpolate visual vehicles and manage scene nodes
+        if (client_ && !smgr_) {
+            smgr_ = client_->getSceneManager();
+        }
+
+        for (auto& [id, veh] : vehicles_) {
+            v3f diff = veh.target_pos - veh.current_pos;
+            veh.current_pos += diff * std::min(1.0f, dtime * 12.0f);
+
+            if (smgr_) {
+                for (auto& comp : veh.components) {
+                    if (!comp.scene_node) {
+                        // Create a simple cube node for the vehicle component
+                        // BS (Block Size) is 10.0f
+                        irr::scene::ISceneNode* node = smgr_->addEmptySceneNode();
+                        if (node) {
+                            // node->getMaterial(0).setFlag(irr::video::EMF_LIGHTING, false);
+                            if (comp.is_broken) {
+                                // Maybe darker color, just handle node creation
+                            }
+                            comp.scene_node = node;
+                        }
+                    }
+                    if (comp.scene_node) {
+                        irr::scene::ISceneNode* node = static_cast<irr::scene::ISceneNode*>(comp.scene_node);
+                        
+                        // Calculate world position based on pivot and rotation
+                        // CDDA rotations: 0 is East, 90 is South, etc.
+                        float rad = veh.rotation * irr::core::DEGTORAD;
+                        float cos_r = std::cos(rad);
+                        float sin_r = std::sin(rad);
+                        
+                        // Apply rotation to mount offset
+                        // Mount offset X is forward/back, Y is left/right in CDDA
+                        float ox = comp.mount_offset.X;
+                        float oz = comp.mount_offset.Z;
+                        
+                        float rx = ox * cos_r - oz * sin_r;
+                        float rz = ox * sin_r + oz * cos_r;
+                        
+                        v3f world_pos(
+                            (veh.current_pos.X + rx) * 10.0f, // Luanti uses BS=10.0f
+                            (veh.current_pos.Y) * 10.0f,
+                            (veh.current_pos.Z + rz) * 10.0f
+                        );
+                        
+                        node->setPosition(world_pos);
+                        node->setRotation(v3f(0.0f, -veh.rotation, 0.0f));
+                    }
+                }
+            }
+        }
+    }
+
+    void process_message(const uint8_t* data, size_t size) {
+        if (!cdda::cwm::MessageVerifier::verify(data, size)) return;
+        const auto* msg = cdda::cwm::MessageVerifier::parse(data, size);
+        if (!msg) return;
+
+        metrics_.current_revision = msg->world_revision();
+
+        switch (msg->payload_type()) {
+            case CDDA::CWM::Payload::HelloResponse: {
+                const auto* resp = msg->payload_as_HelloResponse();
+                if (resp && resp->accepted()) {
+                    std::cout << "[Luanti-CDDA] Handshake accepted by server: "
+                              << (resp->server_build_id() ? resp->server_build_id()->str() : "") << std::endl;
+                }
+                break;
+            }
+
+            case CDDA::CWM::Payload::WorldSnapshot: {
+                const auto* snap = msg->payload_as_WorldSnapshot();
+                if (!snap || !snap->origin()) {
+                    warningstream << "[Luanti-CDDA] Ignoring snapshot without origin" << std::endl;
+                    break;
+                }
+                metrics_.safety_stop = snap->safety_stop();
+                const v3s32 origin(snap->origin()->x(), snap->origin()->y(), snap->origin()->z());
+                const bool rebased = !origin_valid_ || origin.X != projection_origin_.X ||
+                                     origin.Y != projection_origin_.Y;
+                projection_origin_ = origin;
+                origin_valid_ = true;
+
+                if (snap->chunks() && snap->chunks()->size() > 0)
+                    metrics_.chunks_loaded = snap->chunks()->size();
+                metrics_.entities_count = snap->entities() ? snap->entities()->size() : 0;
+
+                // Ingest chunk voxels into Luanti ClientMap
+                if (client_ && snap->chunks() && snap->chunks()->size() > 0) {
+                    std::set<v3s16> modified_blocks;
+                    // Full terrain replaces the presentation cache, including
+                    // areas absent from the new bubble. Partial snapshots keep it.
+                    for (const auto& entry : projected_blocks_)
+                        modified_blocks.insert(entry.first);
+                    projected_blocks_.clear();
+
+                    for (size_t ci = 0; ci < snap->chunks()->size(); ++ci) {
+                        const auto* chunk = snap->chunks()->Get(ci);
+                        if (!chunk || !chunk->blocks()) continue;
+
+                        int cx = chunk->chunk_x();
+                        int cy = chunk->chunk_y();
+                        int cz = chunk->chunk_z();
+                        uint8_t sx = chunk->size_x();
+                        uint8_t sy = chunk->size_y();
+                        uint8_t sz = chunk->size_z();
+
+                        size_t block_idx = 0;
+                        for (uint8_t bz = 0; bz < sz; ++bz) {
+                            for (uint8_t by = 0; by < sy; ++by) {
+                                for (uint8_t bx = 0; bx < sx; ++bx) {
+                                    if (block_idx >= chunk->blocks()->size()) break;
+                                    const auto* b = chunk->blocks()->Get(block_idx++);
+
+                                    uint16_t mat_id = b->material_id();
+                                    int gx = cx * sx + bx;
+                                    int gy = cy * sy + by;
+                                    int gz = cz + bz;
+
+                                    v3s16 lpos = CddaBridge::cddaToLuantiCoord(gx, gy, gz);
+                                    uint8_t light = b->light_level();
+                                    uint8_t param2 = b->orientation();
+
+                                    place_cdda_tile(lpos, mat_id, b->state_flags(), light, param2, modified_blocks);
+                                }
+                            }
+                        }
+                    }
+
+                    commit_projection(modified_blocks);
+                    infostream << "[Luanti-CDDA] Installed terrain projection in "
+                               << projected_blocks_.size() << " local map blocks" << std::endl;
+                }
+
+                if (client_ && snap->tiles()) {
+                    std::set<v3s16> modified_blocks;
+                    for (const auto* delta : *snap->tiles()) apply_tile(delta, modified_blocks);
+                    commit_projection(modified_blocks);
+                }
+
+                // Sync vehicles
+                if (snap->vehicles()) {
+                    metrics_.vehicles_count = snap->vehicles()->size();
+                    for (size_t i = 0; i < snap->vehicles()->size(); ++i) {
+                        const auto* veh_state = snap->vehicles()->Get(i);
+                        if (!veh_state || !veh_state->pivot()) continue;
+                        uint64_t vid = veh_state->id();
+                        v3f target = v3f(
+                            veh_state->pivot()->x(),
+                            veh_state->pivot()->z() * 3.0f,
+                            -veh_state->pivot()->y()
+                        );
+
+                        auto it = vehicles_.find(vid);
+                        if (it == vehicles_.end()) {
+                            VisualVehicle vv;
+                            vv.id = vid;
+                            vv.name = veh_state->name() ? veh_state->name()->str() : "";
+                            vv.current_pos = target;
+                            vv.target_pos = target;
+                            vv.rotation = veh_state->rotation();
+                            if (veh_state->components()) {
+                                for (size_t ci = 0; ci < veh_state->components()->size(); ++ci) {
+                                    const auto* comp = veh_state->components()->Get(ci);
+                                    if (!comp || !comp->offset()) continue;
+                                    VisualVehicleComponent vc;
+                                    vc.name = comp->part_id() ? comp->part_id()->str() : "";
+                                    vc.mount_offset = v3f(comp->offset()->x(), 0.0f, -comp->offset()->y());
+                                    vc.is_broken = comp->broken();
+                                    vc.is_open = comp->open();
+                                    vc.scene_node = nullptr; // Initialize lazily
+                                    vv.components.push_back(vc);
+                                }
+                            }
+                            vehicles_[vid] = vv;
+                        } else {
+                            if (rebased) it->second.current_pos = target;
+                            it->second.target_pos = target;
+                            it->second.rotation = veh_state->rotation();
+                            // Assuming components don't change frequently for this prototype, or update them here
+                        }
+                    }
+                }
+
+                // Sync entities
+                if (snap->entities()) {
+                    for (size_t i = 0; i < snap->entities()->size(); ++i) {
+                        const auto* ent_state = snap->entities()->Get(i);
+                        if (!ent_state || !ent_state->pos()) continue;
+                        uint64_t eid = ent_state->id();
+                        v3f target = v3f(
+                            ent_state->pos()->x(),
+                            ent_state->pos()->z() * 3.0f,
+                            -ent_state->pos()->y()
+                        );
+                        if (eid == 1 && rebased)
+                            infostream << "[Luanti-CDDA] Player projected at local ("
+                                       << target.X << ", " << target.Y << ", " << target.Z
+                                       << ")" << std::endl;
+
+                        auto it = entities_.find(eid);
+                        if (it == entities_.end()) {
+                            VisualEntity ve;
+                            ve.id = eid;
+                            ve.type_id = ent_state->type_id() ? ent_state->type_id()->str() : "";
+                            ve.name = ent_state->name() ? ent_state->name()->str() : "";
+                            ve.current_pos = target;
+                            ve.target_pos = target;
+                            ve.start_pos = target;
+                            ve.rotation = ent_state->rotation();
+                            ve.hp_percent = ent_state->hp_percent();
+                            entities_[eid] = ve;
+                        } else {
+                            if (rebased) it->second.current_pos = target;
+                            if (rebased || target != it->second.target_pos) {
+                                it->second.start_pos = it->second.current_pos;
+                                it->second.interpolation_time = rebased ? step_duration : 0.0f;
+                            }
+                            it->second.target_pos = target;
+                            it->second.rotation = ent_state->rotation();
+                            it->second.hp_percent = ent_state->hp_percent();
+                        }
+                    }
+                }
+                player_ready_ = entities_.count(1) != 0;
+                // ACK can arrive before simulation ends. Unlock only when its
+                // authoritative result has also arrived; never queue held keys.
+                if (pending_move_ && move_acked_) {
+                    metrics_.ipc_latency_ms = std::chrono::duration<float, std::milli>(
+                        std::chrono::steady_clock::now() - sent_move_).count();
+                    pending_move_ = 0;
+                }
+                break;
+            }
+
+            case CDDA::CWM::Payload::TileDelta: {
+                const auto* delta = msg->payload_as_TileDelta();
+                if (client_) {
+                    std::set<v3s16> modified_blocks;
+                    apply_tile(delta, modified_blocks);
+                    commit_projection(modified_blocks);
+                }
+                break;
+            }
+
+            case CDDA::CWM::Payload::CommandAck: {
+                const auto* ack = msg->payload_as_CommandAck();
+                if (ack) {
+                    if (ack->command_id() == pending_move_) move_acked_ = true;
+                }
+                break;
+            }
+
+            default:
+                break;
+        }
+    }
+
+    bool send_move_request(int dir) {
+        const auto now = std::chrono::steady_clock::now();
+        if (!connection_ || !connection_->is_valid() || !player_ready_ ||
+            pending_move_ || now < next_move_) return false;
+        const uint64_t command = command_counter_++;
+        cdda::cwm::MessageBuilder builder(command, metrics_.current_revision);
+        auto req = builder.build_move_request(command, static_cast<CDDA::CWM::MoveDirection>(dir));
+        if (!connection_->send_message(req.data(), req.size())) return false;
+        pending_move_ = command;
+        move_acked_ = false;
+        sent_move_ = now;
+        next_move_ = now + std::chrono::milliseconds(200);
+        return true;
+    }
+
+    bool send_interact_request(int x, int y, int z, int action) {
+        if (!connection_ || !connection_->is_valid()) return false;
+        const uint64_t command = command_counter_++;
+        cdda::cwm::MessageBuilder builder(command, metrics_.current_revision);
+        auto req = builder.build_interact_request(
+            command,
+            x, y, z,
+            static_cast<CDDA::CWM::InteractAction>(action)
+        );
+        return connection_->send_message(req.data(), req.size());
+    }
+
+    bool acknowledge_threat() {
+        if (!connection_ || !connection_->is_valid() || !player_ready_ || pending_move_)
+            return false;
+        const uint64_t command = command_counter_++;
+        cdda::cwm::MessageBuilder builder(command, metrics_.current_revision);
+        const auto request = builder.finish_message(CDDA::CWM::Payload::AcknowledgeThreatRequest,
+            CDDA::CWM::CreateAcknowledgeThreatRequest(builder.builder(), command).Union());
+        if (!connection_->send_message(request.data(), request.size())) return false;
+        pending_move_ = command;
+        move_acked_ = false;
+        sent_move_ = std::chrono::steady_clock::now();
+        return true;
+    }
+};
+
+CddaBridge& CddaBridge::getInstance() {
+    static CddaBridge instance;
+    return instance;
+}
+
+std::recursive_mutex& CddaBridge::projectionMutex() {
+    static std::recursive_mutex mutex;
+    return mutex;
+}
+
+bool CddaBridge::initialize(Client* client, const std::string& socket_path) {
+    shutdown();
+    pimpl_ = std::make_unique<Impl>();
+    pimpl_->client_ = client;
+    pimpl_->socket_path_ = socket_path;
+    std::string trace_path;
+    if (g_settings->getNoEx("cwm_trace_file", trace_path) && !trace_path.empty()) {
+        pimpl_->trace_.open(trace_path);
+        pimpl_->trace_ << "time_ns,camera_x,camera_y,camera_z,target_x,target_y,target_z,pending_move,dir_x,dir_y,dir_z\n";
+    }
+    return pimpl_->connect();
+}
+
+void CddaBridge::shutdown() {
+    if (pimpl_) {
+        if (pimpl_->debug_text_) pimpl_->debug_text_->remove();
+        if (pimpl_->safety_text_) pimpl_->safety_text_->remove();
+        for (auto& vehicle : pimpl_->vehicles_)
+            for (auto& component : vehicle.second.components)
+                if (component.scene_node)
+                    static_cast<irr::scene::ISceneNode*>(component.scene_node)->remove();
+        pimpl_.reset();
+    }
+}
+
+bool CddaBridge::restoreProjectedBlock(Client* client, MapBlock* block) {
+    return pimpl_ && pimpl_->client_ == client && pimpl_->restore_projected_block(block);
+}
+
+bool CddaBridge::ownsPlayer(const Client* client) const {
+    return pimpl_ && pimpl_->client_ == client;
+}
+
+void CddaBridge::traceCamera(const v3f& position, const v3f& direction) {
+    if (!pimpl_ || !pimpl_->trace_.is_open() || !pimpl_->entities_.count(1)) return;
+    const auto& entity = pimpl_->entities_.at(1);
+    pimpl_->trace_ << std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count() << ','
+        << position.X << ',' << position.Y << ',' << position.Z << ','
+        << entity.target_pos.X << ',' << entity.target_pos.Y << ',' << entity.target_pos.Z << ','
+        << pimpl_->pending_move_ << ',' << direction.X << ',' << direction.Y << ','
+        << direction.Z << '\n';
+    pimpl_->trace_.flush();
+}
+
+void CddaBridge::update(float dtime) {
+    if (pimpl_) {
+        pimpl_->update(dtime);
+    }
+}
+
+bool CddaBridge::handleMoveInput(int dir) {
+    if (pimpl_) {
+        return pimpl_->send_move_request(dir);
+    }
+    return false;
+}
+
+bool CddaBridge::handleInteract(int x, int y, int z, int action) {
+    if (pimpl_) {
+        return pimpl_->send_interact_request(x, y, z, action);
+    }
+    return false;
+}
+
+bool CddaBridge::acknowledgeThreat() {
+    return pimpl_ && pimpl_->acknowledge_threat();
+}
+
+CddaBridge::Metrics CddaBridge::getMetrics() const {
+    if (pimpl_) return pimpl_->metrics_;
+    return Metrics{};
+}
+
+} // namespace cdda_client
+
+namespace cdda_client {
+void CddaBridge::renderDebugOverlay(irr::gui::IGUIEnvironment* guienv) {
+    if (!guienv || !pimpl_) return;
+
+    if (!pimpl_->safety_text_) {
+        pimpl_->safety_text_ = guienv->addStaticText(
+            L"CDDA: threat detected. Release movement, press Aux1 (default E) to resume.",
+            irr::core::rect<irr::s32>(10, 165, 650, 205), false, true);
+        if (pimpl_->safety_text_)
+            pimpl_->safety_text_->setOverrideColor(irr::video::SColor(255, 255, 210, 80));
+    }
+    if (pimpl_->safety_text_)
+        pimpl_->safety_text_->setVisible(pimpl_->metrics_.connected && pimpl_->metrics_.safety_stop);
+
+    if (!pimpl_->debug_text_) {
+        // Create static text at top left
+        irr::core::rect<irr::s32> rect(10, 10, 400, 150);
+        pimpl_->debug_text_ = guienv->addStaticText(L"F3 Overlay Initializing...", rect, false, true, nullptr, -1, true);
+        if (pimpl_->debug_text_) {
+            pimpl_->debug_text_->setOverrideColor(irr::video::SColor(255, 255, 255, 255));
+        }
+    }
+
+    if (pimpl_->debug_text_) {
+        wchar_t text[512];
+        swprintf(text, 512, L"[CDDA-Mineclonia F3 Overlay]\n"
+                             L"CWM IPC Connected: %ls\n"
+                             L"FPS: %u\n"
+                             L"IPC Latency: %.2f ms\n"
+                             L"Revision: %llu\n"
+                             L"Chunks: %u\n"
+                             L"Entities: %u\n"
+                             L"Vehicles: %u",
+                 pimpl_->metrics_.connected ? L"YES" : L"NO",
+                 pimpl_->metrics_.fps,
+                 pimpl_->metrics_.ipc_latency_ms,
+                 (unsigned long long)pimpl_->metrics_.current_revision,
+                 pimpl_->metrics_.chunks_loaded,
+                 pimpl_->metrics_.entities_count,
+                 pimpl_->metrics_.vehicles_count);
+        
+        pimpl_->debug_text_->setText(text);
+    }
+}
