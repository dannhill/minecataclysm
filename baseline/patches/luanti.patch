+void CddaBridge::update(float dtime) {
+    if (pimpl_) {
+        pimpl_->update(dtime);
+        if(pimpl_->crafting_favorite_refresh_ && !pimpl_->pending_move_) {
+            pimpl_->crafting_favorite_refresh_=false;pimpl_->crafting_favorite_command_=0;
+            if(pimpl_->crafting_open_)pimpl_->query_crafting(true);
+        }
+        if (pimpl_->quick_bind_refresh_ && !pimpl_->pending_move_) {
+            pimpl_->quick_bind_refresh_ = false;
+            if (pimpl_->equipment_open_) {
+                const auto notice = pimpl_->equipment_notice_;
+                pimpl_->query_inventory(true);
+                pimpl_->equipment_notice_ = notice;
+            }
+        }
+        auto& i = *pimpl_;
+        if (i.crafting_open_ && i.crafting_search_due_ && !i.crafting_query_pending_ &&
+            !i.crafting_favorite_command_ && !i.pending_move_ &&
+            std::chrono::steady_clock::now() >= *i.crafting_search_due_) {
+            if (i.query_crafting(true)) i.crafting_search_due_.reset();
+        }
+        // I pauses immediately even while the equipment result is in flight.
+        // Read only after that result, so inspection cannot retain a pre-action
+        // inventory. MENU_OPEN can also reject a command not yet executed.
+        if (i.inventory_inspection_pending_ && !i.pending_move_) {
+            i.inventory_inspection_pending_ = false;
+            if (i.equipment_open_) {
+                if (!i.query_inventory()) i.equipment_view_.error = ::cwm::text("Inventory unavailable: try again.", "Inventario non disponibile: riprova.");
+                if (i.inventory_work_rejected_) i.equipment_notice_ = i.inventory_work_error_;
+                i.equipment_dirty_ = true;
+            }
+        }
+        if (i.inventory_work_command_ && i.inventory_work_settled_ && !i.pending_move_ &&
+            i.session_.ready() && i.player_ready_ && !i.metrics_.pending_decision && !i.metrics_.pause_reasons &&
+            !i.activity_token_ && i.sent_menu_pause_ != 1 && !i.equipment_open_ && !i.crafting_open_ &&
+            !i.body_form_open_ && !i.ground_container_open_) {
+            const bool returning = i.inventory_return_requested_;
+            const auto error = i.inventory_work_error_;
+            i.dismiss_inventory_work();
+            if (returning) {
+                i.equipment_open_ = i.equipment_dirty_ = true; i.equipment_close_ = false;
+                setMenuPause(true);
+                if (!i.query_inventory()) i.equipment_view_.error = (::cwm::text("Inventory unavailable: try again.", "Inventario non disponibile: riprova."));
+                i.equipment_notice_ = error.empty() ? ::cwm::text("Native work finished. Review the updated inventory.","Lavoro nativo terminato. Controlla l'inventario aggiornato.") : error;
+            }
+        }
+    }
+}
