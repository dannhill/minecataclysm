+    UASSERT(segments[0] == 1.f && segments[2] == .5f && segments[3] == 0.f);
+    UASSERT(cdda_client::statusSegments("-----")[0] == 0.f);
+    UASSERT(cdda_client::statusSegments(":")[0] == .25f);
