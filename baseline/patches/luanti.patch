+
+bool CddaBridge::isPointedOpening(const v3s16& node) const {
+    if (!pimpl_) return false;
+    const auto tile = luantiToCddaCoord(node);
+    const auto base = cddaToLuantiCoord(tile.X, tile.Y, tile.Z);
+    const auto player = pimpl_->entities_.find(1);
+    if (player == pimpl_->entities_.end() || !pimpl_->opening_tiles_.count(base)) return false;
+    const auto& p = player->second.target_pos;
+    // Presentation eligibility only. CDDA still validates current range/state.
+    return base.Y == std::round(p.Y) &&
+        std::abs(base.X - std::round(p.X)) <= 1 && std::abs(base.Z - std::round(p.Z)) <= 1;
+}
+
+std::optional<v3s16> CddaBridge::pointOpening(const irr::core::line3d<float>& ray) {
+    std::optional<v3s16> result;
+    if (!pimpl_ || !pimpl_->session_.ready()) return result;
+    float closest=1.f;
+    // The pane disappears on opening. Hit the semantic two-node opening,
+    // using the already occlusion-limited world ray, not just solid voxels.
+    for (const auto& [base, open] : pimpl_->opening_tiles_) {
+        if (!isPointedOpening(base)) continue;
+        const v3f start=ray.start/10.f, delta=ray.getVector()/10.f;
+        const float origin[]={start.X,start.Y,start.Z};
+        const float dir[]={delta.X,delta.Y,delta.Z};
+        const float lo[]={base.X-.5f,base.Y+.5f,base.Z-.5f};
+        const float hi[]={base.X+.5f,base.Y+2.5f,base.Z+.5f};
+        float begin=0.f,end=1.f; bool hit=true;
+        for(int axis=0;axis<3 && hit;++axis) {
+            if(std::abs(dir[axis])<1e-6f)hit=origin[axis]>=lo[axis] && origin[axis]<=hi[axis];
+            else {
+                float a=(lo[axis]-origin[axis])/dir[axis],b=(hi[axis]-origin[axis])/dir[axis];
+                if(a>b)std::swap(a,b);
+                begin=std::max(begin,a);end=std::min(end,b);hit=begin<=end;
+            }
+        }
+        if(hit && begin<=closest){closest=begin;result=base;}
+    }
+    if(result) pimpl_->hover_hint_=::cwm::wide("Opening — right click: open / close; ",
+        "Apertura — destro: apri / chiudi; ")+utf8_to_wide(getKeySetting("keymap_cdda_close").name())+
+        ::cwm::wide(": close / draw curtains", ": chiudi / tira le tende");
+    return result;
+}
+
+bool CddaBridge::handleAimInput(bool right, bool pressed, bool fallback, bool context,
+                               bool focused, bool fire, bool reload) {
+    if (!pimpl_) return false;
+    auto& i = *pimpl_;
+    const bool allowed = focused && i.connection_ && i.connection_->is_valid() &&
+        i.session_.ready() && i.player_ready_ && !i.activity_token_ && !i.metrics_.pending_decision &&
+        !i.metrics_.pause_reasons && i.sent_menu_pause_ != 1 && !i.equipment_open_ &&
+        !i.crafting_open_ && !i.ground_container_open_ && !i.body_form_open_;
+    const auto intent = i.aim_input_.sample(right, pressed, fallback, context, allowed, fire, reload);
+    if (!allowed || intent.context_pressed ||
+        (i.deferred_ranged_ && (i.weapon_token_ != i.deferred_ranged_->weapon ||
+          (i.deferred_ranged_->action == 1 && i.pointed_actor_ != i.deferred_ranged_->target) ||
+          std::chrono::steady_clock::now() >= i.deferred_ranged_->expires))) i.deferred_ranged_.reset();
+    if (i.deferred_ranged_) {
+        if (!i.pending_move_ && std::chrono::steady_clock::now() >= i.next_move_) {
+            const auto action = i.deferred_ranged_->action;
+            i.deferred_ranged_.reset();
+            i.send_ranged_request(action); // Current native token/target are revalidated.
+        }
+    } else if (intent.aiming) i.send_ranged_request(0);
+    // Read-only ground consultation remains available under manual pause.
+    // Physical OPEN/CLOSE/pickup still use their existing native pause guards.
+    const bool paused_context = !allowed && focused && i.session_.ready() && i.player_ready_ &&
+        !i.metrics_.pending_decision && pressed && context;
+    return intent.context_pressed || paused_context;
+}
