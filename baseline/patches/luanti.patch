+        }
+        const auto native = CddaBridge::luantiToCddaCoord(pos);
+        queued_pickup_ = QueuedPickup{v3s32(native.X + scene_origin_.X,
+            native.Y + scene_origin_.Y, native.Z), item};
+        item_hint_ = (::cwm::wide("Pickup selected. Time resumes to perform the action.", "Raccolta selezionata. Il tempo riprende per eseguire l'azione."));
+        item_hint_until_ = std::chrono::steady_clock::now() + std::chrono::seconds(3);
+    }
+
+    void flush_pickup() {
+        if (queued_pickup_ && (metrics_.pause_reasons & ~uint32_t(2))) {
+            cancel_pickup_selection(); return;
+        }
+        if (!queued_pickup_ || !session_.ready() || !player_ready_ || pending_move_ ||
+            metrics_.pending_decision || metrics_.pause_reasons || ground_container_open_) return;
+        const auto selected = *queued_pickup_;
+        auto builder = session_.builder();
+        const uint64_t id = session_.next_command++;
+        const auto bytes = builder.build_interact_request(id,
+            selected.absolute.X - projection_origin_.X,
+            selected.absolute.Y - projection_origin_.Y, selected.absolute.Z,
+            CDDA::CWM::InteractAction::PICKUP, selected.item.stack_index,
+            selected.item.type_id, selected.item.charges, selected.item.count_by_charges);
+        if (!connection_->send_message(bytes.data(), bytes.size())) return;
+        infostream << "CWM pickup request " << id << " item " << selected.item.type_id << std::endl;
+        pending_move_ = id; move_acked_ = false;
+        sent_move_ = std::chrono::steady_clock::now();
+        queued_pickup_.reset();
+    }
