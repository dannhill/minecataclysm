+        f += ("label[0.5,9.55;" + ::cwm::text("Quantity", "Quantita") + "]field[0.5,9.8;1.5,0.55;quantity;;") + std::to_string(quantity) + "]field_close_on_enter[quantity;false]";
+        if (e->transfer_reason.empty() && !activity_token) {
+            f += ("button[2.3,9.65;4.7,0.65;drag_ground;" + ::cwm::text("Ground: drag here", "Terra: trascina qui") + "]cwm_drag[drag_ground;0;;1]");
+            if (destination) f += ("button[8,9.65;7.5,0.65;insert;" + ::cwm::text("Transfer into container", "Trasferisci nel contenitore") + "]");
+        }
+    }
+    if (!notice.empty()) f += "box[0.4,10.4;15.1,0.5;#F2CEAAFF]hypertext[0.5,10.42;14.9,0.48;;" +
+        statusEscape("<global color=#6B2915 size=18><b>" + equipmentMarkup(notice) + "</b>") + "]";
+    else f += ("label[0.5,10.6;" + ::cwm::text("Choose quantity and destination. CDDA checks capacity and charges access/transfer costs.", "Scegli quantita e destinazione. CDDA verifica capacita e paga accesso/trasferimento.") + "]");
+    return f;
+}
+} // namespace cdda_client
diff --git a/src/cdda/ground_item_formspec.h b/src/cdda/ground_item_formspec.h
new file mode 100644
index 0000000..d9aeac8
--- /dev/null
+++ b/src/cdda/ground_item_formspec.h
@@ -0,0 +1,43 @@
+#pragma once
+#include "cwm/product_language.hpp"
+#include <algorithm>
+#include <string>
+
+namespace cdda_client {
+// Mineclonia mcl_chests single-chest layout and mcl_formspec slot spacing.
+// Inventory locations are client-owned projection mirrors; no Lua inventories.
+inline std::string groundContainerForm(size_t ground_count, size_t owned_count,
+        size_t ground_page, size_t owned_page)
+{
+    std::string form = "formspec_version[4]size[11.75,10.425]no_prepend[]"
+        "listcolors[#9990;#FFF7;#FFF0;#000;#FFF]"
+        "style_type[label;textcolor=#323232]"
+        "style_type[button;border=false;bgimg=mcl_inventory_button9.png;"
+        "bgimg_pressed=mcl_inventory_button9_pressed.png;bgimg_middle=2,2]"
+        "bgcolor[#00000000]"
+        "background9[0,0;11.75,10.425;mcl_base_textures_background9.png;false;7]";
+    const auto slots = [&](double x, double y, int w, int h) {
+        for (int i = 0; i < w; ++i) for (int j = 0; j < h; ++j)
+            form += "image[" + std::to_string(x + i * 1.25 - .05) + "," +
+                std::to_string(y + j * 1.25 - .05) +
+                ";1.1,1.1;mcl_formspec_itemslot.png]";
+    };
+    form += ("label[0.375,0.375;" + ::cwm::text("Ground stack (", "Pila a terra (")) + std::to_string(ground_count) + ")]";
+    slots(.375, .75, 9, 3);
+    form += "list[detached:cwm_ground;main;0.375,0.75;9,3;" +
+        std::to_string(ground_page * 27) + "]";
+    form += ("label[0.375,4.7;" + ::cwm::text("Inventory / equipment - drag a stack here", "Inventario / equipaggiamento - trascina qui una pila") + "]");
+    slots(.375, 5.1, 9, 3);
+    form += "list[detached:cwm_owned;main;0.375,5.1;9,3;" +
+        std::to_string(owned_page * 36 + 9) + "]";
+    slots(.375, 9.05, 9, 1);
+    form += "list[detached:cwm_owned;main;0.375,9.05;9,1;" +
+        std::to_string(owned_page * 36) + "]"
+        "listring[detached:cwm_ground;main]listring[detached:cwm_owned;main]";
+    if (ground_count > 27)
+        form += "button[9,0.05;1.1,0.5;ground_prev;<]button[10.35,0.05;1.1,0.5;ground_next;>]";
+    if (owned_count > 36)
+        form += "button[9,4.1;1.1,0.5;owned_prev;<]button[10.35,4.1;1.1,0.5;owned_next;>]";
+    return form;
+}
+}
diff --git a/src/cdda/ground_item_projection.h b/src/cdda/ground_item_projection.h
new file mode 100644
index 0000000..c7e4f07
--- /dev/null
+++ b/src/cdda/ground_item_projection.h
@@ -0,0 +1,71 @@
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+#include "irr_v3d.h"
+
+namespace cdda_client {
+
+struct GroundItemView {
+	uint32_t stack_index{0};
+	std::string type_id;
+	std::string name;
+	int32_t charges{0};
+	bool count_by_charges{false};
+    std::string category; bool wielded{false}, rotten{false}, container{false};
+};
+
+class GroundItemProjection {
+	std::map<v3s16, std::vector<GroundItemView>> tiles_;
+    std::map<v3s16, std::string> storage_;
+
+public:
+	void clear() { tiles_.clear(); storage_.clear(); }
+    const std::string* storage(const v3s16& pos) const {
+        const auto it=storage_.find(pos);return it==storage_.end()?nullptr:&it->second;
+    }
+	size_t size() const { return tiles_.size(); }
+	const auto &tiles() const { return tiles_; }
+
+	const std::vector<GroundItemView> *get(const v3s16 &pos) const
+	{
+		const auto it = tiles_.find(pos);
+		return it == tiles_.end() ? nullptr : &it->second;
+	}
+
+	void apply(const v3s16 &pos, std::vector<GroundItemView> items, bool storage=false, const std::string& label={})
+	{
+        if(storage) storage_[pos]=label; else storage_.erase(pos);
+		if (items.empty())
+			tiles_.erase(pos);
+		else
+			tiles_[pos] = std::move(items);
+	}
+
+	void pruneWindow(const v3s32 &origin, const v3s32 &scene_origin, int width = 132)
+	{
+		const int min_x = origin.X - scene_origin.X;
+		const int min_y = origin.Y - scene_origin.Y;
+		const int min_z = origin.Z;
+
+		const auto prune = [&](auto& entries) {
+        for (auto it = entries.begin(); it != entries.end();) {
+			const v3s16 &p = it->first;
+			const int x = p.X;
+			const int y = -p.Z;
+			const int z = p.Y / 3;
+			if (x < min_x || x >= min_x + width ||
+					y < min_y || y >= min_y + width ||
+					z < min_z || z >= min_z + 3)
+				it = entries.erase(it);
+			else
+				++it;
+		}
+        }; prune(tiles_); prune(storage_);
+	}
+};
+
+} // namespace cdda_client
diff --git a/src/cdda/ground_item_visual.h b/src/cdda/ground_item_visual.h
new file mode 100644
index 0000000..a550994
--- /dev/null
+++ b/src/cdda/ground_item_visual.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace cdda_client {
+
+inline std::string groundItemRegistration(const std::string &type_id)
+{
+	uint64_t h = 14695981039346656037ULL;
+	for (unsigned char c : type_id) {
+		h ^= c;
+		h *= 1099511628211ULL;
+	}
+
+	static constexpr char hex[] = "0123456789abcdef";
+	std::string suffix(16, '0');
+	for (int i = 15; i >= 0; --i) {
+		suffix[i] = hex[h & 0xf];
+		h >>= 4;
+	}
+
+	return "cdda_items:i_" + suffix;
+}
+
+} // namespace cdda_client
diff --git a/src/cdda/humanoid_animation.h b/src/cdda/humanoid_animation.h
new file mode 100644
index 0000000..7d869d1
--- /dev/null
+++ b/src/cdda/humanoid_animation.h
@@ -0,0 +1,22 @@
+#pragma once
+#include "cwm/tile_semantics.hpp"
+#include <cmath>
+#include <cstdint>
+
+namespace cdda_client {
+struct HumanoidCycle { int first, last; float fps; };
+
+// Frame ranges from pinned Mineclonia mobs_mc/zombie.lua and
+// mcl_armor/player.lua. These select presentation only, never gameplay.
+inline HumanoidCycle humanoidCycle(bool zombie, bool walking, uint32_t flags) {
+    if (zombie) return walking ? HumanoidCycle{0,39,25} : HumanoidCycle{40,49,2};
+    if (flags & cdda::cwm::PRONE) return {162,166,8};
+    if (flags & cdda::cwm::CROUCHING)
+        return walking ? HumanoidCycle{304,323,30} : HumanoidCycle{222,302,30};
+    if (walking && (flags & cdda::cwm::RUNNING)) return {440,459,30};
+    return walking ? HumanoidCycle{168,187,30} : HumanoidCycle{0,79,30};
+}
+inline float humanoidFrame(HumanoidCycle cycle, double seconds) {
+    return cycle.first + std::fmod(seconds * cycle.fps, cycle.last - cycle.first + 1);
+}
+} // namespace cdda_client
diff --git a/src/cdda/posture_input.h b/src/cdda/posture_input.h
new file mode 100644
index 0000000..ca45474
--- /dev/null
+++ b/src/cdda/posture_input.h
@@ -0,0 +1,49 @@
+#pragma once
+#include <array>
+
+namespace cdda_client {
+// Desired input only. The bridge still waits for native ACK + world state;
+// this class never changes authoritative posture or assumes a cost/speed.
+class PostureInput {
+    std::array<bool, 3> last_{};
+    std::array<bool, 2> blocked_{};
+    int latched_{0}, last_confirmed_{0};
+    bool initialized_{false};
+public:
+    void reject(int mode) {
+        if (mode == 1 || mode == 2) blocked_[mode - 1] = true;
+        if (latched_ == mode) latched_ = 0;
+    }
+    int sample(const std::array<bool, 3>& down, bool run_toggle,
+               bool crouch_toggle, bool allowed, int confirmed) {
+        if (!initialized_ && allowed) {
+            latched_ = confirmed == 3 || (confirmed == 1 && run_toggle) ||
+                (confirmed == 2 && crouch_toggle) ? confirmed : 0;
+            initialized_ = true;
+        }
+        if (!allowed) {
+            for (int i = 0; i < 2; ++i) blocked_[i] = down[i];
+            last_ = down;
+            last_confirmed_ = confirmed;
+            return -1; // Menu/recovery presses are never replayed.
+        }
+        for (int i = 0; i < 2; ++i) if (!down[i]) blocked_[i] = false;
+        // Native exhaustion may switch RUN to WALK inside a tile. Require a
+        // new physical press rather than retrying rejected RUN every frame.
+        if (last_confirmed_ == 1 && confirmed == 0 && down[0]) reject(1);
+        const bool toggle[] = {run_toggle, crouch_toggle};
+        for (int i = 0; i < 2; ++i)
+            if (toggle[i] && down[i] && !last_[i] && !blocked_[i])
+                latched_ = latched_ == i + 1 ? 0 : i + 1;
+        if (down[2] && !last_[2]) {
+            latched_ = latched_ == 3 ? 0 : 3;
+            for (int i = 0; i < 2; ++i) blocked_[i] = down[i];
+        }
+        last_ = down;
+        last_confirmed_ = confirmed;
+        if (!crouch_toggle && down[1] && !blocked_[1]) return 2;
+        if (!run_toggle && down[0] && !blocked_[0]) return 1;
+        return latched_;
+    }
+};
+} // namespace cdda_client
diff --git a/src/cdda/quickbar.h b/src/cdda/quickbar.h
new file mode 100644
index 0000000..2338ed6
--- /dev/null
+++ b/src/cdda/quickbar.h
@@ -0,0 +1,16 @@
+#pragma once
+#include "equipment_inventory.h"
+namespace cdda_client {
+struct QuickSlotView {
+    std::string binding;
+    EquipmentEntry item;
+    explicit operator bool() const { return !binding.empty(); }
+};
+using QuickbarView = std::array<QuickSlotView, 9>;
+inline int quickDefaultAction(const EquipmentEntry& item) {
+    // Native action availability decides eligibility; selection itself is free.
+    if (item.worn && (item.actions & 8)) return 3;
+    for (int action : {4, 6, 2, 5, 0, 1, 3}) if (item.actions & (1 << action)) return action;
+    return -1;
+}
+} // namespace cdda_client
