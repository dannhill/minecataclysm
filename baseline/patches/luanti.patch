+++ b/src/cdda/equipment_inventory.h
@@ -0,0 +1,421 @@
+#pragma once
+#include "cwm/product_language.hpp"
+#include "avatar_status.h"
+#include "cwm/cwm_generated.h"
+#include <array>
+#include <algorithm>
+#include <cctype>
+#include <functional>
+#include <iomanip>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace cdda_client {
+struct EquipmentEntry {
+    uint32_t id{}, parent{}; int pocket{-1};
+    std::string type, name, category;
+    int charges{}, access{}; bool counted{}, worn{}, wielded{};
+    int64_t weight{}, volume{}, length{};
+    uint8_t actions{};
+    std::array<std::string, 7> reasons;
+    int consume_moves{}; std::string consume_label, consume_warning;
+    std::string transfer_reason; bool container{};
+    unsigned quick_slot{}; bool rotten{}; uint32_t ui_order{}; bool external{};
+    bool book{}, book_identified{}; int chapter_moves{}; std::string book_summary;
+};
+struct EquipmentPocket {
+    uint32_t owner{}, index{}; std::string name;
+    int64_t capacity{}, remaining{}, weight_capacity{}, weight_remaining{}, length{};
+    int access{}; bool sealed{}, rigid{}, watertight{};
+};
+struct EquipmentView {
+    uint64_t query{}, view{}; bool truncated{};
+    std::string error, external_label;
+    int64_t external_capacity{}, external_remaining{};
+    int64_t weight{}, weight_capacity{}, volume{}, volume_capacity{};
+    std::vector<EquipmentEntry> entries;
+    std::vector<EquipmentPocket> pockets;
+    void read(const CDDA::CWM::InventoryView& source) {
+        *this = {};
+        query = source.query_id(); view = source.view_id(); truncated = source.truncated();
+        error = source.error()->str(); weight = source.weight_grams(); weight_capacity = source.weight_capacity_grams();
+        volume = source.volume_ml(); volume_capacity = source.volume_capacity_ml();
+        external_label=source.external_label()?source.external_label()->str():"";
+        external_capacity=source.external_capacity_ml(); external_remaining=source.external_remaining_ml();
+        for (const auto* e : *source.entries()) {
+            EquipmentEntry entry{e->id(), e->parent_id(), e->pocket_index(),
+                e->type_id()->str(), e->name()->str(), e->category()->str(), e->charges(), e->access_moves(),
+                e->count_by_charges(), e->worn(), e->wielded(), e->weight_grams(), e->volume_ml(), e->length_mm(), e->actions(), {}, e->consume_moves(), e->consume_label()->str(), e->consume_warning()->str(), e->transfer_reason()->str(), e->container(), e->quick_slot(), e->rotten(), e->ui_order(), e->external()};
+            for (unsigned i = 0; i < 7; ++i) entry.reasons[i] = e->reasons()->Get(i)->str();
+            if (const auto* book=e->book()) {
+                entry.book=true;entry.book_identified=book->identified();
+                entry.chapter_moves=book->chapter_moves();entry.book_summary=book->summary()->str();
+            }
+            entries.push_back(std::move(entry));
+        }
+        for (const auto* p : *source.pockets()) pockets.push_back({p->owner_id(), p->index(), p->name()->str(),
+            p->capacity_ml(), p->remaining_ml(), p->capacity_grams(), p->remaining_grams(), p->max_length_mm(),
+            p->access_moves(), p->sealed(), p->rigid(), p->watertight()});
+    }
+    const EquipmentEntry* entry(uint32_t id) const {
+        return id && id <= entries.size() ? &entries[id - 1] : nullptr;
+    }
+    std::string source(uint32_t id) const {
+        const auto* e = entry(id); if (!e) return {};
+        if (!e->parent && e->external) return external_label;
+        if (!e->parent) return e->worn ? (::cwm::text("Worn", "Indossato")) : e->wielded ? (::cwm::text("Wielded", "Impugnato")) : (::cwm::text("Inventory", "Inventario"));
+        std::string out;
+        for (unsigned depth = 0; e && e->parent && depth < 32; ++depth) {
+            const auto* parent = entry(e->parent); if (!parent) break;
+            std::string name = parent->name;
+            for (const auto& p : pockets) if (p.owner == parent->id && int(p.index) == e->pocket)
+                name += " / " + (p.name.empty() ? (::cwm::text("pocket ", "tasca ")) + std::to_string(p.index + 1) : p.name);
+            out = name + (out.empty() ? "" : " > " + out); e = parent;
+        }
+        if (e && !e->parent && (e->worn || e->wielded))
+            out = std::string(e->worn ? (::cwm::text("Worn", "Indossato")) : (::cwm::text("In hand", "In mano"))) + " > " + out;
+        if (e && e->external) out = external_label + " > " + out;
+        return out;
+    }
+};
+inline std::string equipmentLower(std::string text) {
+    for (auto& c : text) c = char(std::tolower(static_cast<unsigned char>(c)));
+    return text;
+}
+// Wire categories are native IDs. Translate only their displayed labels.
+inline std::string equipmentCategoryLabel(const std::string& category) {
+    if (category == "guns") return ::cwm::text("Guns", "Armi da fuoco");
+    if (category == "magazines") return ::cwm::text("Magazines", "Caricatori");
+    if (category == "ammo") return ::cwm::text("Ammo", "Munizioni");
+    if (category == "weapons") return ::cwm::text("Weapons", "Armi");
+    if (category == "tools") return ::cwm::text("Tools", "Attrezzi");
+    if (category == "clothing") return ::cwm::text("Clothing", "Vestiti");
+    if (category == "food") return ::cwm::text("Food", "Cibo");
+    if (category == "drugs") return ::cwm::text("Drugs", "Farmaci");
+    if (category == "manuals") return ::cwm::text("Manuals", "Manuali");
+    if (category == "books") return ::cwm::text("Books", "Libri");
+    if (category == "maps") return ::cwm::text("Maps", "Mappe");
+    if (category == "container") return ::cwm::text("Containers", "Contenitori");
+    if (category == "armor") return ::cwm::text("Armor", "Armature");
+    return category;
+}
+inline std::vector<uint32_t> equipmentFilter(const EquipmentView& view, const std::string& search, int filter) {
+    std::vector<uint32_t> ids;
+    const auto needle = equipmentLower(search);
+    for (const auto& e : view.entries) {
+        if (e.external) continue;
+        if ((filter == 1 && !e.wielded && !e.worn) || (filter == 2 && !e.container)) continue;
+        if (!needle.empty() && equipmentLower(e.name + " " + e.category + " " + equipmentCategoryLabel(e.category) + " " + view.source(e.id)).find(needle) == std::string::npos) continue;
+        ids.push_back(e.id);
+    }
+    return ids;
+}
+inline std::string equipmentAmount(int64_t milliunits) {
+    std::ostringstream out; out << std::fixed << std::setprecision(2) << milliunits / 1000.0;
+    return out.str();
+}
+// Escape text for the hypertext parser BEFORE formspec escaping. Native names
+// must never become markup/actions (nor formspec elements).
+inline std::string equipmentMarkup(const std::string& text) {
+    std::string out;
+    for (const char c : text) {
+        if (c == '<' || c == '>' || c == '\\') out += '\\';
+        out += c;
+    }
+    return out;
+}
+// Category art uses native category IDs, independent of the selected language.
+// Unknown IDs use a neutral question mark; type mappings remain primary.
+inline std::string equipmentCategoryIcon(const EquipmentEntry& entry) {
+    const auto category = equipmentLower(entry.category);
+    if (category == "clothing") return "mcl_armor_inv_chestplate_leather.png";
+    if (category == "weapons" || category == "guns") return "default_tool_steelsword.png";
+    if (category == "tools") return "default_tool_steelaxe.png";
+    if (category == "ammo" || category == "magazines") return "mcl_bows_arrow_inv.png";
+    if (category == "food") return "default_apple.png";
+    if (category == "drugs") return "mcl_potions_potion_bottle.png";
+    if (category == "books" || category == "manuals" || category == "maps") return "default_book.png";
+    return "cdda_status_unknown.png";
+}
+inline std::vector<uint32_t> equipmentGridIds(const EquipmentView& view, const std::string& search, int filter) {
+    auto ids = equipmentFilter(view, search, filter);
+    ids.erase(std::remove_if(ids.begin(), ids.end(), [&](unsigned id) { return view.entry(id)->quick_slot != 0; }), ids.end());
+    std::stable_sort(ids.begin(), ids.end(), [&](unsigned a, unsigned b) {
+        const auto x = view.entry(a)->ui_order, y = view.entry(b)->ui_order;
+        return (x ? x : 4096 + a) < (y ? y : 4096 + b);
+    });
+    return ids;
+}
+inline std::string equipmentDrag(const std::string& name, const EquipmentEntry* e,
+        const std::function<std::string(const std::string&)>& icon) {
+    const auto visual = e ? icon(e->type) : std::string{};
+    const bool generic = visual.empty() || visual == "cdda_items:fallback_generic";
+    return "cwm_drag[" + name + ";" + std::to_string(e ? e->id : 0) + ";" +
+        statusEscape(e ? (generic ? equipmentCategoryIcon(*e) : visual) : "") + ";" + (generic ? "1" : "0") + ";" + std::to_string(e ? e->actions : 0) + ";" +
+        std::to_string(e ? (e->container ? 1 : 0) | (e->transfer_reason.empty() ? 2 : 0) : 0) + "]";
+}
+inline constexpr size_t equipmentPageSize = 27;
+// Both grids are projections. Dragging schedules a native actor after menu pause.
+inline std::string externalStorageForm(const EquipmentView& view, size_t external_page, size_t owned_page,
+        uint32_t selected, int quantity, const std::string& notice,
+        const std::function<std::string(const std::string&)>& icon) {
+    std::string f="formspec_version[4]size[22,9]no_prepend[]bgcolor[#00000000]"
+        "background9[0,0;22,9;mcl_base_textures_background9.png;false;7]"
+        "style_type[label;textcolor=#323232]style_type[button;border=false;bgimg=mcl_inventory_button9.png;bgimg_pressed=mcl_inventory_button9_pressed.png;bgimg_middle=2,2]"
+        "style_type[image_button;border=false;bgimg=;bgimg_pressed=]";
+    f+="label[0.5,0.4;"+statusEscape(view.external_label.empty()?::cwm::text("Storage / ground","Contenitore / terra"):view.external_label)+"]";
+    f+="label[11.5,0.4;"+::cwm::text("Your inventory","Il tuo inventario")+"]";
+    f+="button[17.5,0.15;1.8,0.65;refresh;"+::cwm::text("Refresh","Aggiorna")+"]button_exit[19.6,0.15;1.9,0.65;close;"+::cwm::text("Close","Chiudi")+"]set_focus[refresh;false]";
+    if(!view.view)return f+"label[0.5,2;"+statusEscape(view.error.empty()?::cwm::text("Reading storage...","Lettura contenitore..."):view.error)+"]";
+    f+="cwm_inventory["+std::to_string(view.view)+";"+std::to_string(selected)+";1]";
+    std::vector<const EquipmentEntry*> ext,own;
+    for(const auto& e:view.entries)(e.external?ext:own).push_back(&e);
+    const auto pane=[&](const auto& items,double x,size_t page,const std::string& prefix,const std::string& destination,const std::string& label) {
+        const size_t pages=std::max<size_t>(1,(items.size()+26)/27);page=std::min(page,pages-1);
+        f+="button["+std::to_string(x)+",1;0.7,0.6;"+prefix+"_prev;<]label["+std::to_string(x+1)+",1.3;"+std::to_string(page+1)+" / "+std::to_string(pages)+"]button["+std::to_string(x+9.25)+",1;0.7,0.6;"+prefix+"_next;>]";
+        for(size_t n=0;n<27;++n) {
+            const size_t index=page*27+n;const auto* e=index<items.size()?items[index]:nullptr;
+            const double sx=x+(n%9)*1.12,sy=2+(n/9)*1.15;
+            const auto pos=std::to_string(sx)+","+std::to_string(sy);
+            const std::string key=e?"item_"+std::to_string(e->id):destination+"_empty_"+std::to_string(n);
+            f+="image["+pos+";1.05,1.05;mcl_formspec_itemslot.png]";
+            if(!e) {f+="button["+pos+";1.05,1.05;"+key+";]cwm_drag["+key+";0;;1]";continue;}
+            f+=equipmentDrag(key,e,icon);
+            if(selected==e->id)f+="box["+pos+";1.05,1.05;#E8CF5790]";
+            const auto visual=icon(e->type);const bool generic=visual.empty()||visual=="cdda_items:fallback_generic";
+            f+=std::string(generic?"image_button[":"item_image_button[")+pos+";1.05,1.05;"+statusEscape(generic?equipmentCategoryIcon(*e):visual)+";"+key+";]";
+            if(e->counted)f+="label["+std::to_string(sx+.05)+","+std::to_string(sy+.86)+";"+std::to_string(e->charges)+"]";
+            f+="tooltip["+key+";"+statusEscape(e->name+"\n"+view.source(e->id)+(e->transfer_reason.empty()?"":"\n"+e->transfer_reason))+ "]";
+        }
+        f+="button["+std::to_string(x)+",5.65;10,0.65;"+destination+";"+label+"]cwm_drag["+destination+";0;;1]";
+    };
+    pane(ext,.5,external_page,"ext","drag_external",::cwm::text("Deposit here · or drag onto a container above","Deposita qui · oppure trascina su un contenitore sopra"));
+    pane(own,11.5,owned_page,"own","drag_owned",::cwm::text("Collect here · or drag onto a container above","Raccogli qui · oppure trascina su un contenitore sopra"));
+    f+="label[0.5,6.8;"+::cwm::text("Free space: ","Spazio libero: ")+equipmentAmount(view.external_remaining)+" / "+equipmentAmount(view.external_capacity)+" L]";
+    if(const auto* e=view.entry(selected)) {
+        f+="label[0.5,7.45;"+statusEscape(e->name)+"]";
+        f+="label[11.5,6.6;"+::cwm::text("Quantity to move","Quantita da spostare")+"]field[11.5,6.95;2.2,0.65;quantity;;"+std::to_string(quantity)+"]field_close_on_enter[quantity;false]button[14,6.95;1.8,0.65;all;"+::cwm::text("All","Tutto")+"]";
+    }
+    f+="hypertext[0.5,8.05;21,0.7;;"+statusEscape("<global color=#963F25 size=18><b>"+equipmentMarkup(notice)+"</b>")+"]";
+    if(view.truncated)f+="label[11.5,7.9;"+::cwm::text("View limit reached; collect items and refresh.","Limite vista raggiunto; raccogli oggetti e aggiorna.")+"]";
+    return f;
+}
+inline std::string equipmentForm(const EquipmentView& view, size_t page, uint32_t selected,
+        const std::string& search, int filter, const std::string& notice,
+        const std::function<std::string(const std::string&)>& icon, uint64_t consumption_token = 0,
+        bool first_aid = false, bool crafting = false, bool reloading = false, bool transferring = false,
+        bool search_open = false, bool details_open = false, size_t worn_page = 0, bool focus_search = false, unsigned quick_slot = 1,
+        bool action_time_pending = false, bool reading = false) {
