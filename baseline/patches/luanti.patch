+        ("label[0.5,0.4;" + ::cwm::text("Quantities and transfers", "Quantita e trasferimenti") + "]button[8,0.2;3.4,0.6;back;" + ::cwm::text("Equipment", "Equipaggiamento") + "]") +
+        ("button[11.6,0.2;1.8,0.6;refresh;" + ::cwm::text("Refresh", "Aggiorna") + "]button_exit[13.7,0.2;1.8,0.6;close;" + ::cwm::text("Close", "Chiudi") + "]") +
+        ("label[0.5,1.2;" + ::cwm::text("Item to move", "Oggetto da spostare") + "]label[8,1.2;" + ::cwm::text("Owned destination container", "Contenitore posseduto di destinazione") + "]");
+    if (activity_token) f += ("button[8,1.65;7.5,0.6;cancel_consume;" + ::cwm::text("Interrupt activity", "Interrompi attivita") + "]");
+    if (!view.view) return f + "label[0.5,2.2;" + statusEscape(view.error.empty() ? (::cwm::text("Reading native inventory...", "Lettura inventario nativo...")) : view.error) + "]";
+    f += "cwm_inventory[" + std::to_string(view.view) + ";" + std::to_string(source) + ";1]";
+    const auto ids = equipmentFilter(view, "", 0);
+    const size_t pages = std::max<size_t>(1, (ids.size() + 35) / 36);
+    page = std::min(page, pages - 1);
+    for (size_t n = page * 36; n < std::min(ids.size(), (page + 1) * 36); ++n) {
+        const auto& e = *view.entry(ids[n]);
+        const auto x = std::to_string(.5 + (n % 6) * 1.18), y = std::to_string(2.7 + ((n % 36) / 6) * 1.0);
+        if (source == e.id) f += "box[" + x + "," + y + ";1.05,1.0;#E8CF5790]";
+        f += "item_image_button[" + x + "," + y + ";1.05,1.0;" + statusEscape(icon(e.type)) + ";item_" + std::to_string(e.id) + ";]";
