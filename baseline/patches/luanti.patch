new file mode 100644
index 0000000..ff43f9c
--- /dev/null
+++ b/src/cdda/aim_input.h
@@ -0,0 +1,38 @@
+#pragma once
+
+namespace cdda_client {
+// Classify a physical RMB gesture once. Context clicks must never turn into
+// paid aim steps because the camera/scene changes while the button is held.
+class AimInput {
+    enum class Gesture { None, Aim, Context };
+    Gesture gesture_{Gesture::None};
+    bool blocked_right_{true}, blocked_f_{true}, aiming_{false};
+public:
+    struct Result { bool context_pressed{}, aiming{}; };
+    Result sample(bool right, bool pressed, bool fallback, bool context, bool allowed,
+                  bool fire, bool reload) {
+        aiming_ = false;
+        if (!allowed || reload) {
+            gesture_ = Gesture::None;
+            blocked_right_ = blocked_f_ = true;
+            return {};
+        }
+        if (!right) { gesture_ = Gesture::None; blocked_right_ = false; }
+        if (!fallback) blocked_f_ = false;
+        Result result;
+        if (pressed && !blocked_right_ && gesture_ == Gesture::None) {
+            gesture_ = context ? Gesture::Context : Gesture::Aim;
+            result.context_pressed = context;
+        }
+        if (gesture_ == Gesture::Context) {
+            // Explicit mouse interaction wins over an overlapping F hold.
+            if (fallback) blocked_f_ = true;
+            return result;
+        }
+        aiming_ = (gesture_ == Gesture::Aim && right) || (fallback && !blocked_f_);
+        result.aiming = aiming_ && !fire;
+        return result;
+    }
+    bool aiming() const { return aiming_; }
+};
+} // namespace cdda_client
diff --git a/src/cdda/avatar_status.h b/src/cdda/avatar_status.h
new file mode 100644
index 0000000..e1e7236
--- /dev/null
+++ b/src/cdda/avatar_status.h
@@ -0,0 +1,122 @@
+#pragma once
+#include "cwm/product_language.hpp"
+#include <string>
+#include <array>
+#include <algorithm>
+#include <vector>
+
+namespace cdda_client {
+struct StatusView { std::string id, label, text, color; int perceived_level{-1}; };
+struct BodyPartView { std::string id, label; StatusView health, temperature; std::vector<std::string> conditions; };
+struct AvatarStatusView {
+    bool available{false};
+    StatusView stamina;
+    std::vector<StatusView> needs;
+    std::vector<BodyPartView> parts;
+};
+inline std::string statusColor(std::string name) {
+    if (name.substr(0, 2) == "c_") name.erase(0, 2);
+    if (name == "red") return "#ef6666";
+    if (name == "light_red") return "#ff9898";
+    if (name == "yellow" || name == "brown") return "#f6d56f";
+    if (name == "green" || name == "light_green") return "#8adca8";
+    if (name == "blue" || name == "light_blue") return "#8bbcff";
+    if (name == "cyan" || name == "light_cyan") return "#88dfe8";
+    if (name == "magenta" || name == "pink") return "#e9a0ea";
+    return "#eeeeee";
+}
+inline std::string statusEscape(const std::string& text) {
+    std::string result;
+    for (char c : text) {
+        if (c == '\\' || c == '[' || c == ']' || c == ';' || c == ',') result += '\\';
+        result += c;
+    }
+    return result;
+}
+inline std::string statusBarText(const std::string& native) {
+    // Pad the native five-segment UI bar; never reconstruct HP from it.
+    return "[" + native + std::string(native.size() < 5 ? 5 - native.size() : 0, '.') + "]";
+}
+// Native get_bar output: full pipe, half slash, tiny colon, zero dashes.
+// These are display segments, not reconstructed exact HP or stamina.
+inline std::array<float, 5> statusSegments(const std::string& text) {
+    std::array<float, 5> result{};
+    size_t i = 0;
+    for (char c : text) {
+        if (i == result.size()) break;
+        result[i++] = c == '|' ? 1.f : c == '\\' ? .5f : c == ':' ? .25f : 0.f;
+    }
+    return result;
+}
+// Ten icons retain exactly the native five-segment health/stamina resolution.
+inline std::array<float, 10> statusHeartSegments(const std::string& text) {
+    std::array<float, 10> result{};
+    const auto native = statusSegments(text);
+    for (size_t i = 0; i < result.size(); ++i)
+        result[i] = std::clamp(native[i / 2] * 2.f - float(i % 2), 0.f, 1.f);
+    return result;
+}
+inline std::array<float, 10> statusNeedSegments(int perceived_level) {
+    std::array<float, 10> result{};
+    for (int i = 0; i < 10; ++i) result[i] = i < perceived_level ? 1.f : 0.f;
+    return result;
+}
+inline std::string bodyPartIcon(const std::string& id) {
+    const char* kind = id == "head" ? "helmet" : id == "leg_l" || id == "leg_r" ? "leggings" : "chestplate";
+    return std::string("mcl_armor_inv_") + kind + "_iron.png";
+}
+inline std::string statusIconRow(double x, double y, const std::string& text,
+        const std::string& icon) {
+    std::string form;
+    const auto segments = statusSegments(text);
+    for (size_t i = 0; i < segments.size(); ++i) {
+        const auto position = std::to_string(x + .42 * i) + "," + std::to_string(y);
+        form += "image[" + position + ";0.36,0.36;" + icon + "^[opacity:45]";
+        if (segments[i] > 0) {
+            // Half/tiny fills keep native display resolution, with no invented HP.
+            const auto pct = std::to_string(int(segments[i] * 100));
+            form += "image[" + position + ";0.36,0.36;" + icon + "^[opacity:0^[lowpart:" + pct + ":" + icon + "]";
+        }
+    }
+    return form;
+}
+inline std::string avatarStatusForm(const AvatarStatusView& status) {
+    std::string form = "formspec_version[4]size[12,10]no_prepend[]"
+        "bgcolor[#182322f5;true]style_type[label;textcolor=#eeeeee]"
+        "box[0,0;12,10;#182322f5]" +
+        ("label[0.4,0.4;" + ::cwm::text("Body and survival", "Corpo e sopravvivenza") + "]") +
+        ("label[0.4,0.9;" + ::cwm::text("Time paused - descriptions perceived by your character", "Tempo in pausa - descrizioni percepite dal personaggio") + "]") +
+        "label[0.4,1.5;Stamina]";
+    form += statusIconRow(2.1, 1.3, status.stamina.text, "mcl_hunger_icon_exhaustion.png");
+    form += "scrollbaroptions[min=0;max=" + std::to_string(std::max(0, (int(status.needs.size()) * 75 + 20 - 630 + 9) / 10)) +
+        ";smallstep=8;largestep=24]scrollbar[5.5,2;0.25,6.3;vertical;needs_scroll;0]"
+        "scroll_container[0.4,2;5,6.3;needs_scroll;vertical;0.1]";
+    double y = .2;
+    for (const auto& value : status.needs) {
+        form += "style_type[label;textcolor=" + statusColor(value.color) + "]";
+        form += "label[0," + std::to_string(y) + ";" + statusEscape(value.label) + ": " +
+            statusEscape(value.text.empty() ? "-" : value.text) + "]";
+        y += .75;
+    }
+    double parts_height = .1;
+    for (const auto& part : status.parts) parts_height += 1.1 + .4 * part.conditions.size();
+    form += "scroll_container_end[]style_type[label;textcolor=#eeeeee]scrollbaroptions[min=0;max=" + std::to_string(std::max(0, int((parts_height - 6.3) * 10 + .9))) +
+        ";smallstep=8;largestep=24]scrollbar[11.3,2;0.25,6.3;vertical;parts_scroll;0]"
+        "scroll_container[6,2;5.1,6.3;parts_scroll;vertical;0.1]";
+    y = .1;
+    for (const auto& part : status.parts) {
+        form += "image[0," + std::to_string(y) + ";0.5,0.5;" + bodyPartIcon(part.id) + "]";
+        form += "label[0.6," + std::to_string(y + .25) + ";" + statusEscape(part.label) + "]";
+        form += statusIconRow(2.5, y + .05, part.health.text, "heart.png");
+        form += "label[0.6," + std::to_string(y + .72) + ";" + statusEscape(part.temperature.text) + "]";
+        for (const auto& condition : part.conditions) {
+            form += "label[0.6," + std::to_string(y + 1.1) + ";" + statusEscape(condition) + "]";
+            y += .4;
+        }
+        y += 1.1;
+    }
+    form += ("scroll_container_end[]label[0.4,8.8;" + ::cwm::text("Five icons represent five native segments. Conditions and temperature are separate.", "Cinque icone = cinque segmenti nativi. Condizioni e temperatura separate.") + "]") +
+        ("button_exit[4.3,9.2;3.4,0.6;close;" + ::cwm::text("Return to game", "Torna al gioco") + "]");
+    return form;
+}
