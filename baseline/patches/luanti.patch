+    content_t get_node_for_material(uint16_t mat_id) {
+        if (mat_id == 0) return CONTENT_AIR;
+        auto it = material_map_.find(mat_id);
+        if (it != material_map_.end()) return it->second;
+
+        if (!client_) return CONTENT_AIR;
+        const NodeDefManager* ndef = client_->getNodeDefManager();
+        if (!ndef) return CONTENT_AIR;
+
+        content_t cid = CONTENT_AIR;
+        switch (mat_id) {
+            case 1: cid = ndef->getId("cdda_nodes:dirt"); break;
+            case 2: cid = ndef->getId("cdda_nodes:grass_block"); break;
+            case 3: cid = ndef->getId("cdda_nodes:brick_wall"); break;
+            case 4: cid = ndef->getId("cdda_nodes:wood_planks"); break;
+            case 5: cid = ndef->getId("cdda_nodes:door_wood_closed"); break;
+            case 6: cid = ndef->getId("cdda_nodes:door_wood_open"); break;
+            case 7: cid = ndef->getId("cdda_nodes:glass"); break;
+            case 8: cid = ndef->getId("cdda_nodes:stone"); break;
+            case 9: cid = ndef->getId("cdda_nodes:furniture_wood"); break;
+            case 10: cid = CONTENT_AIR; break;
+            case 11: cid = ndef->getId("cdda_nodes:wood_planks"); break;
+            case 12: cid = ndef->getId("cdda_nodes:stone"); break;
+            case 13: cid = ndef->getId("cdda_nodes:glass"); break;
+            case 14: cid = ndef->getId("cdda_nodes:water"); break;
+            case 15: cid = ndef->getId("cdda_nodes:stone"); break;
+            default: cid = ndef->getId("cdda_nodes:stone"); break;
+        }
+        if (cid == CONTENT_IGNORE) cid = CONTENT_AIR;
+        material_map_[mat_id] = cid;
+        return cid;
+    }
+
+    void set_voxel(const v3s16& lpos, content_t cid, uint8_t light, uint8_t param2, std::set<v3s16>& modified_blocks) {
+        v3s16 bp, offset;
+        getNodeBlockPosWithOffset(lpos, bp, offset);
+        auto& nodes = projected_blocks_.try_emplace(bp, size_t(MapBlock::nodecount),
+                                                    MapNode(CONTENT_AIR, 0xff)).first->second;
+        // Same light in day and night banks: CDDA, not Luanti's clock, decides brightness.
+        const uint8_t l = light & 0x0F;
+        const size_t index = offset.Z * MapBlock::zstride + offset.Y * MapBlock::ystride + offset.X;
+        nodes[index] = MapNode(cid, (uint8_t)(l | (l << 4)), param2);
+        modified_blocks.insert(bp);
+    }
