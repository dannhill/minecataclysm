+// A read-only pair of panels; destinations are real owned container identities.
+inline std::string transferForm(const EquipmentView& view, size_t page, uint32_t source,
+        uint32_t destination, size_t destination_page, int quantity, const std::string& notice,
+        const std::function<std::string(const std::string&)>& icon, uint64_t activity_token = 0) {
+    std::string f = "formspec_version[4]size[16,11]no_prepend[]bgcolor[#00000000]"
